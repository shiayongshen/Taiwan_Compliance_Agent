[
  {
    "id": "insurance:capital_level_severe_insufficiency",
    "desc": "資本等級為嚴重不足",
    "expr": [
      "EQ",
      "capital_level_severe_insufficiency",
      [
        "LT",
        "capital_level",
        2
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_severe_insufficiency",
    "desc": "資本等級為嚴重不足",
    "expr": [
      "EQ",
      "capital_level_severe_insufficiency",
      [
        "EQ",
        "capital_level",
        4
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_significant_insufficiency",
    "desc": "資本等級為顯著不足",
    "expr": [
      "EQ",
      "capital_level_significant_insufficiency",
      [
        "EQ",
        "capital_level",
        3
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_insufficient",
    "desc": "資本等級為不足",
    "expr": [
      "EQ",
      "capital_level_insufficient",
      [
        "EQ",
        "capital_level",
        2
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_adequate",
    "desc": "資本等級為適足",
    "expr": [
      "EQ",
      "capital_level_adequate",
      [
        "EQ",
        "capital_level",
        1
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_completed",
    "desc": "增資、財務或業務改善計畫或合併已於主管機關規定期限完成",
    "expr": [
      "EQ",
      "improvement_plan_completed",
      [
        "EQ",
        "improvement_plan_submitted",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_executed",
    "desc": "增資、財務或業務改善計畫或合併已執行完成",
    "expr": [
      "EQ",
      "improvement_plan_executed",
      [
        "EQ",
        "improvement_plan_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:severe_insufficiency_penalty_condition",
    "desc": "資本嚴重不足且未於期限完成增資或改善計畫",
    "expr": [
      "EQ",
      "severe_insufficiency_penalty_condition",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_completed",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:significant_deterioration_condition",
    "desc": "財務或業務狀況顯著惡化且不能支付債務或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "significant_deterioration_condition",
      [
        "AND",
        [
          "EQ",
          "financial_or_business_deterioration",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "unable_to_pay_debt",
            true
          ],
          [
            "EQ",
            "risk_to_insured",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_approved",
    "desc": "主管機關核定財務或業務改善計畫",
    "expr": [
      "EQ",
      "improvement_plan_approved",
      [
        "EQ",
        "improvement_plan_approved_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:accelerated_deterioration_or_no_improvement",
    "desc": "損益、淨值加速惡化或經輔導仍未改善",
    "expr": [
      "EQ",
      "accelerated_deterioration_or_no_improvement",
      [
        "OR",
        [
          "EQ",
          "profit_loss_accelerated_deterioration",
          true
        ],
        [
          "EQ",
          "no_improvement_after_guidance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:regulatory_action_condition",
    "desc": "應為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "regulatory_action_condition",
      [
        "OR",
        "severe_insufficiency_penalty_condition",
        [
          "AND",
          [
            "NOT",
            "severe_insufficiency_penalty_condition"
          ],
          "significant_deterioration_condition",
          "improvement_plan_approved",
          "accelerated_deterioration_or_no_improvement"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:regulatory_action_taken",
    "desc": "主管機關已為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "regulatory_action_taken",
      [
        "EQ",
        "regulatory_action_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_acts_without_regulator_consent",
    "desc": "保險業非經監管人同意不得為禁止行為",
    "expr": [
      "EQ",
      "prohibited_acts_without_regulator_consent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "regulator_consent_payment_exceed_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "regulator_consent_contract_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "regulator_consent_other_major_financial_matters",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_system_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:derivative_financial_product_management_compliant",
    "desc": "衍生性金融商品交易管理符合主管機關規定",
    "expr": [
      "EQ",
      "derivative_financial_product_management_compliant",
      [
        "AND",
        [
          "EQ",
          "application_submitted",
          true
        ],
        [
          "EQ",
          "required_documents_submitted",
          true
        ],
        [
          "EQ",
          "board_approval_obtained",
          true
        ],
        [
          "EQ",
          "internal_procedures_established",
          true
        ],
        [
          "EQ",
          "risk_management_policies_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_and_other_transaction_limits_compliant",
    "desc": "同一人、同一關係人或同一關係企業之放款及其他交易限額符合規定",
    "expr": [
      "EQ",
      "loan_and_other_transaction_limits_compliant",
      [
        "AND",
        [
          "LE",
          "single_transaction_amount",
          [
            "MUL",
            "owner_equity",
            0.35
          ]
        ],
        [
          "LE",
          "total_transaction_balance",
          [
            "MUL",
            "owner_equity",
            0.7
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_investment_limits_compliant",
    "desc": "不動產投資限額符合規定",
    "expr": [
      "EQ",
      "real_estate_investment_limits_compliant",
      [
        "OR",
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            "statutory_standard"
          ],
          [
            "LE",
            "single_real_estate_transaction_amount",
            [
              "MUL",
              "funds",
              0.015
            ]
          ],
          [
            "LE",
            "total_real_estate_transaction_amount",
            [
              "MUL",
              "funds",
              0.03
            ]
          ]
        ],
        [
          "AND",
          [
            "LT",
            "capital_adequacy_ratio",
            "statutory_standard"
          ],
          [
            "GT",
            "owner_equity",
            0.0
          ],
          [
            "EQ",
            "capital_increase_plan_submitted",
            true
          ],
          [
            "LE",
            "single_real_estate_transaction_amount",
            [
              "MUL",
              "funds",
              0.01
            ]
          ],
          [
            "LE",
            "total_real_estate_transaction_amount",
            [
              "MUL",
              "funds",
              0.02
            ]
          ],
          [
            "EQ",
            "public_tender_or_auction",
            true
          ],
          [
            "EQ",
            "real_estate_transaction_procedures_compliant",
            true
          ],
          [
            "EQ",
            "board_approval_obtained",
            true
          ],
          [
            "EQ",
            "board_decision_documents_complete",
            true
          ]
        ],
        [
          "AND",
          [
            "LT",
            "capital_adequacy_ratio",
            "statutory_standard"
          ],
          [
            "LE",
            "owner_equity",
            0.0
          ],
          [
            "EQ",
            "capital_increase_plan_submitted",
            true
          ],
          [
            "LE",
            "single_real_estate_transaction_amount",
            [
              "CASE",
              [
                "LE",
                [
                  "MUL",
                  "funds",
                  0.01
                ],
                5000000000.0
              ],
              [
                "MUL",
                "funds",
                0.01
              ],
              5000000000.0
            ]
          ],
          [
            "LE",
            "total_real_estate_transaction_amount",
            [
              "CASE",
              [
                "LE",
                [
                  "MUL",
                  "funds",
                  0.02
                ],
                10000000000.0
              ],
              [
                "MUL",
                "funds",
                0.02
              ],
              10000000000.0
            ]
          ],
          [
            "EQ",
            "public_tender_or_auction",
            true
          ],
          [
            "EQ",
            "real_estate_transaction_procedures_compliant",
            true
          ],
          [
            "EQ",
            "board_approval_obtained",
            true
          ],
          [
            "EQ",
            "board_decision_documents_complete",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_audit_system_implemented",
    "desc": "建立自行查核制度並執行",
    "expr": [
      "EQ",
      "internal_audit_system_implemented",
      [
        "AND",
        [
          "EQ",
          "internal_audit_system_established",
          true
        ],
        [
          "GE",
          "internal_audit_frequency_per_year",
          1
        ],
        [
          "EQ",
          "audit_report_retained_5_years",
          true
        ],
        [
          "EQ",
          "audit_training_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:legal_compliance_evaluation_performed",
    "desc": "依法令遵循計畫執行自行評估",
    "expr": [
      "EQ",
      "legal_compliance_evaluation_performed",
      [
        "AND",
        [
          "EQ",
          "legal_compliance_evaluation_plan_established",
          true
        ],
        [
          "GE",
          "legal_compliance_evaluation_frequency_per_half_year",
          1
        ],
        [
          "EQ",
          "legal_compliance_evaluation_results_reported",
          true
        ],
        [
          "EQ",
          "legal_compliance_evaluation_data_retained_5_years",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反資本嚴重不足未完成改善計畫、財務或業務顯著惡化未改善、未建立內部控制或處理制度、違反衍生性金融商品管理規定、不符交易限額、不符不動產投資限額、未執行自行查核或法令遵循評估時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "regulatory_action_taken",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "derivative_financial_product_management_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "loan_and_other_transaction_limits_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_limits_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_audit_system_implemented",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "legal_compliance_evaluation_performed",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]