[
  {
    "id": "aml:high_risk_country_definition",
    "desc": "洗錢或資恐高風險國家或地區定義",
    "expr": [
      "EQ",
      "high_risk_country",
      [
        "OR",
        "international_aml_org_announced_serious_deficiency",
        "international_aml_org_announced_non_compliance",
        "other_concrete_evidence_high_risk"
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_cdd_required",
    "desc": "對洗錢或資恐高風險國家或地區客戶應採取強化確認客戶身分措施",
    "expr": [
      "EQ",
      "enhanced_cdd_required",
      [
        "EQ",
        "customer_from_high_risk_country",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_cdd_measures_high_risk",
    "desc": "高風險情形應採取強化確認客戶身分措施",
    "expr": [
      "EQ",
      "enhanced_cdd_measures_high_risk",
      [
        "AND",
        [
          "EQ",
          "high_risk_situation",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "senior_management_approval_obtained",
            true
          ],
          [
            "EQ",
            "reasonable_measures_to_understand_wealth_and_funds_source",
            true
          ],
          [
            "EQ",
            "enhanced_ongoing_monitoring",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:simplified_cdd_not_allowed_conditions",
    "desc": "不得採取簡化確認客戶身分措施之情形",
    "expr": [
      "EQ",
      "simplified_cdd_not_allowed",
      [
        "OR",
        "customer_from_high_risk_country_not_effective_aml_measures",
        "suspected_money_laundering_or_terrorist_financing"
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:simplified_cdd_allowed",
    "desc": "較低風險情形得採取簡化措施",
    "expr": [
      "EQ",
      "simplified_cdd_allowed",
      [
        "AND",
        [
          "EQ",
          "low_risk_situation",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "simplified_cdd_not_allowed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:stored_value_card_named_registration_exemption",
    "desc": "辦理儲值卡記名作業時，不適用高風險國家強化措施規定",
    "expr": [
      "EQ",
      "stored_value_card_named_registration_exemption",
      [
        "EQ",
        "stored_value_card_named_registration",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_cdd_required_for_stored_value_card",
    "desc": "儲值卡記名作業不適用高風險國家強化措施",
    "expr": [
      "EQ",
      "enhanced_cdd_required_for_stored_value_card",
      [
        "IMPLIES",
        [
          "EQ",
          "stored_value_card_named_registration",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "enhanced_cdd_required",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:insurance_beneficiary_considered_for_enhanced_cdd",
    "desc": "保險業應將人壽保險契約受益人納入強化確認客戶身分措施考量",
    "expr": [
      "EQ",
      "insurance_beneficiary_considered_for_enhanced_cdd",
      [
        "EQ",
        "insurance_industry",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_cdd_for_high_risk_beneficiary",
    "desc": "人壽保險契約受益人為法人或信託受託人且評估為較高風險者，應採取強化確認客戶身分措施",
    "expr": [
      "EQ",
      "enhanced_cdd_for_high_risk_beneficiary",
      [
        "AND",
        [
          "EQ",
          "beneficiary_is_legal_person_or_trustee",
          true
        ],
        [
          "EQ",
          "beneficiary_assessed_high_risk",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_cdd_measures_for_high_risk_beneficiary",
    "desc": "對高風險受益人採取強化措施，包括給付保險金前辨識及驗證實質受益人身分",
    "expr": [
      "EQ",
      "enhanced_cdd_measures_for_high_risk_beneficiary",
      [
        "AND",
        [
          "EQ",
          "enhanced_cdd_for_high_risk_beneficiary",
          true
        ],
        [
          "EQ",
          "reasonable_measures_to_identify_and_verify_beneficial_owner_before_payment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定採取強化確認客戶身分措施或持續審查措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "enhanced_cdd_required",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "enhanced_cdd_measures_high_risk",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "enhanced_cdd_for_high_risk_beneficiary",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "enhanced_cdd_measures_for_high_risk_beneficiary",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]