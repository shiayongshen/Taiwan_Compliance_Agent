[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_established",
          true
        ],
        [
          "EQ",
          "outsourcing_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "derivative_business_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_personnel_qualification",
    "desc": "銀行辦理衍生性金融商品業務人員具備專業資格條件",
    "expr": [
      "EQ",
      "bank:derivative_personnel_qualification",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_license_held",
          true
        ],
        [
          "GE",
          "derivative_internship_years",
          1
        ],
        [
          "GE",
          "derivative_experience_months",
          6
        ],
        [
          "AND",
          [
            "EQ",
            "is_structured_product_staff",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "derivative_license_held",
              true
            ],
            [
              "EQ",
              "passed_structured_product_exam",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_unit_mandatory",
    "desc": "銀行設置獨立專責風險控管單位並定期向董監事會報告",
    "expr": [
      "EQ",
      "bank:risk_control_unit_mandatory",
      [
        "AND",
        [
          "EQ",
          "risk_control_unit_established",
          true
        ],
        [
          "EQ",
          "risk_control_report_to_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_principles",
    "desc": "銀行風險控管機制符合五項原則",
    "expr": [
      "EQ",
      "bank:risk_control_mechanism_principles",
      [
        "AND",
        [
          "EQ",
          "capital_adequacy_monitored",
          true
        ],
        [
          "EQ",
          "liquidity_management_mechanism_established",
          true
        ],
        [
          "EQ",
          "asset_allocation_and_risk_management_established",
          true
        ],
        [
          "EQ",
          "asset_quality_and_loss_provisioning_established",
          true
        ],
        [
          "EQ",
          "information_security_and_emergency_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:compliance_unit_duties",
    "desc": "法令遵循單位履行法令傳達、更新、評估、訓練及督導等職責",
    "expr": [
      "EQ",
      "bank:compliance_unit_duties",
      [
        "AND",
        [
          "EQ",
          "law_regulation_communication_system_established",
          true
        ],
        [
          "EQ",
          "operation_regulations_updated_timely",
          true
        ],
        [
          "EQ",
          "compliance_opinion_signed_before_new_business",
          true
        ],
        [
          "EQ",
          "compliance_evaluation_and_supervision_established",
          true
        ],
        [
          "EQ",
          "compliance_training_provided",
          true
        ],
        [
          "EQ",
          "compliance_supervision_implemented",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:compliance_foreign_units_supervision",
    "desc": "法令遵循單位督導國外營業單位法令遵循及風險監控",
    "expr": [
      "EQ",
      "bank:compliance_foreign_units_supervision",
      [
        "AND",
        [
          "EQ",
          "foreign_unit_financial_regulations_collected",
          true
        ],
        [
          "EQ",
          "foreign_unit_compliance_self_assessment_implemented",
          true
        ],
        [
          "EQ",
          "foreign_unit_compliance_supervisor_qualified",
          true
        ],
        [
          "EQ",
          "foreign_unit_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "foreign_unit_compliance_risk_monitoring_mechanism_established",
          true
        ],
        [
          "EQ",
          "foreign_unit_external_expert_verification_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:compliance_self_assessment_frequency",
    "desc": "法令遵循自行評估每半年至少辦理一次且資料保存五年",
    "expr": [
      "EQ",
      "bank:compliance_self_assessment_frequency",
      [
        "AND",
        [
          "GE",
          "compliance_self_assessment_frequency_per_year",
          2
        ],
        [
          "GE",
          "compliance_self_assessment_data_retention_years",
          5
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policy_and_procedure",
    "desc": "內部控制制度涵蓋所有營運活動並訂定適當政策及程序且適時檢討修訂",
    "expr": [
      "EQ",
      "bank:internal_control_policy_and_procedure",
      [
        "AND",
        [
          "EQ",
          "organization_rules_established",
          true
        ],
        [
          "EQ",
          "business_regulations_and_handbooks_established",
          true
        ],
        [
          "EQ",
          "periodic_review_and_revision_implemented",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policy_details",
