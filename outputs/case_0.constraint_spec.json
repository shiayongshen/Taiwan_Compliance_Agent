[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=資本適足, 2=資本不足, 3=資本顯著不足, 4=資本嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            0.5
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              0.5
            ],
            [
              "LT",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              1.5
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "CASE",
                [
                  "LE",
                  "net_worth_prev",
                  "net_worth"
                ],
                "net_worth_prev",
                "net_worth"
              ],
              0.03
            ],
            [
              "GE",
              [
                "CASE",
                [
                  "LE",
                  "net_worth_prev",
                  "net_worth"
                ],
                "net_worth_prev",
                "net_worth"
              ],
              0.0
            ]
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              1.5
            ],
            [
              "LT",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              2.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "CASE",
                [
                  "LE",
                  "net_worth_prev",
                  "net_worth"
                ],
                "net_worth_prev",
                "net_worth"
              ],
              0.02
            ],
            [
              "GE",
              [
                "CASE",
                [
                  "LE",
                  "net_worth_prev",
                  "net_worth"
                ],
                "net_worth_prev",
                "net_worth"
              ],
              0.02
            ]
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            2.0
          ],
          [
            "GE",
            [
              "CASE",
              [
                "GE",
                "net_worth_prev",
                "net_worth"
              ],
              "net_worth_prev",
              "net_worth"
            ],
            0.03
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_2_measures_ok",
    "desc": "資本不足等級措施執行完成",
    "expr": [
      "EQ",
      "level_2_measures_ok",
      [
        "AND",
        [
          "EQ",
          "capital_insufficient_plan_submitted",
          true
        ],
        [
          "EQ",
          "capital_insufficient_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_3_measures_ok",
    "desc": "資本顯著不足等級措施執行完成",
    "expr": [
      "EQ",
      "level_3_measures_ok",
      [
        "AND",
        [
          "EQ",
          "level_2_measures_ok",
          true
        ],
        [
          "EQ",
          "capital_significantly_insufficient_additional_measures_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_4_measures_ok",
    "desc": "資本嚴重不足等級措施執行完成",
    "expr": [
      "EQ",
      "level_4_measures_ok",
      [
        "AND",
        [
          "EQ",
          "level_3_measures_ok",
          true
        ],
        [
          "EQ",
          "capital_severely_insufficient_additional_measures_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本不足等級且未執行對應措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "level_4_measures_ok",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "level_3_measures_ok",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "level_2_measures_ok",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]