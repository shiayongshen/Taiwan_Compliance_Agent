[
  {
    "id": "insurance:capital_adequacy_ratio_calc",
    "desc": "資本適足率計算 = (自有資本 / 風險資本) * 100",
    "expr": [
      "EQ",
      "capital_adequacy_ratio",
      [
        "MUL",
        [
          "DIV",
          [
            "VAR",
            "own_capital"
          ],
          [
            "VAR",
            "risk_capital"
          ]
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio_calc",
    "desc": "淨值比率計算 = 業主權益 / 不含投資型保險專設帳簿資產總額 * 100",
    "expr": [
      "EQ",
      "net_worth_ratio",
      [
        "MUL",
        [
          "DIV",
          [
            "VAR",
            "owner_equity"
          ],
          [
            "VAR",
            "total_assets_excluding_investment"
          ]
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severe_insufficient",
    "desc": "資本嚴重不足 = (資本適足率 < 50%) OR (淨值 < 0)",
    "expr": [
      "OR",
      [
        "LT",
        "capital_adequacy_ratio",
        50.0
      ],
      [
        "LT",
        [
          "VAR",
          "net_worth"
        ],
        0.0
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significant_insufficient",
    "desc": "資本顯著不足 = (資本適足率 ≥ 50% 且 < 150%) OR (最近二期淨值比率均 < 2% 且 ≥ 0%)",
    "expr": [
      "OR",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          150.0
        ]
      ],
      [
        "AND",
        [
          "LT",
          "net_worth_ratio",
          2.0
        ],
        [
          "LT",
          "net_worth_ratio_prev",
          2.0
        ],
        [
          "GE",
          "net_worth_ratio",
          0.0
        ],
        [
          "GE",
          "net_worth_ratio_prev",
          0.0
        ]
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient",
    "desc": "資本不足 = (資本適足率 ≥ 150% 且 < 200%) OR (最近二期淨值比率均 < 3% 且至少一期 ≥ 2%)",
    "expr": [
      "OR",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          150.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          200.0
        ]
      ],
      [
        "AND",
        [
          "LT",
          "net_worth_ratio",
          3.0
        ],
        [
          "LT",
          "net_worth_ratio_prev",
          3.0
        ],
        [
          "OR",
          [
            "GE",
            "net_worth_ratio",
            2.0
          ],
          [
            "GE",
            "net_worth_ratio_prev",
            2.0
          ]
        ]
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequate",
    "desc": "資本適足 = (資本適足率 ≥ 200%) 且 (最近二期淨值比率至少一期 ≥ 3%)",
    "expr": [
      "AND",
      [
        "GE",
        "capital_adequacy_ratio",
        200.0
      ],
      [
        "OR",
        [
          "GE",
          "net_worth_ratio",
          3.0
        ],
        [
          "GE",
          "net_worth_ratio_prev",
          3.0
        ]
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級依序為嚴重不足=1、顯著不足=2、不足=3、適足=4，若同時符合多等級，取最低等級",
    "expr": [
      "CASE",
      [
        "VAR",
        "insurance:capital_severe_insufficient"
      ],
      1,
      [
        "VAR",
        "insurance:capital_significant_insufficient"
      ],
      2,
      [
        "VAR",
        "insurance:capital_insufficient"
      ],
      3,
      [
        "VAR",
        "insurance:capital_adequate"
      ],
      4,
      0
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_capital_insufficient",
    "desc": "資本不足者應採取監理措施之一部或全部",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "capital_level",
        3
      ],
      [
        "VAR",
        "supervisory_measures_insufficient"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_capital_significant_insufficient",
    "desc": "資本顯著不足者應採取監理措施之一部或全部及其他特定措施",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "capital_level",
        2
      ],
      [
        "VAR",
        "supervisory_measures_significant_insufficient"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_capital_severe_insufficient",
    "desc": "資本嚴重不足者應採取資本顯著不足措施及第149條第3項第1款規定之處分",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "capital_level",
        1
      ],
      [
        "AND",
        [
          "VAR",
          "supervisory_measures_significant_insufficient"
        ],
        [
          "VAR",
          "disposition_article_149_3_1"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequacy_ratio_minimum",
    "desc": "資本適足率及淨值比率不得低於主管機關定之一定比率",
    "expr": [
      "AND",
      [
        "GE",
        "capital_adequacy_ratio",
        [
          "VAR",
          "minimum_capital_adequacy_ratio"
        ]
      ],
      [
        "GE",
        "net_worth_ratio",
        [
          "VAR",
          "minimum_net_worth_ratio"
        ]
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severe_insufficient_additional",
    "desc": "資本嚴重不足條件補充：資本適足率低於一定比率的25%",
    "expr": [
      "OR",
      [
        "LT",
        "capital_adequacy_ratio",
        [
          "MUL",
          [
            "VAR",
            "minimum_capital_adequacy_ratio"
          ],
          0.25
        ]
      ],
      [
        "LT",
        [
          "VAR",
          "net_worth"
        ],
        0.0
      ]
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_adjusted",
    "desc": "資本等級調整，若同時符合多等級，以較低等級為資本等級",
    "expr": [
      "CASE",
      [
        "VAR",
        "insurance:capital_severe_insufficient_additional"
      ],
      1,
      [
        "VAR",
        "insurance:capital_severe_insufficient"
      ],
      1,
      [
        "VAR",
        "insurance:capital_significant_insufficient"
      ],
      2,
      [
        "VAR",
        "insurance:capital_insufficient"
      ],
      3,
      [
        "VAR",
        "insurance:capital_adequate"
      ],
      4,
      0
    ],
    "weight": 2,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有 constraint 成立則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_severe_insufficient"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_significant_insufficient"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_insufficient"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_adequate"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_level_adjusted"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_adequacy_ratio_calc"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:net_worth_ratio_calc"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_adequacy_ratio_minimum"
            ]
          ],
          [
            "NOT",
            [
              "VAR",
              "insurance:capital_severe_insufficient_additional"
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]