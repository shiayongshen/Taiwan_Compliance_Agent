    "expr": [
      "EQ",
      "bank:internal_control_policy_details",
      [
        "AND",
        [
          "EQ",
          "organization_system_defined",
          true
        ],
        [
          "EQ",
          "clear_authority_and_responsibility_defined",
          true
        ],
        [
          "EQ",
          "investment_guidelines_defined",
          true
        ],
        [
          "EQ",
          "customer_data_confidentiality_defined",
          true
        ],
        [
          "EQ",
          "related_party_transaction_rules_defined",
          true
        ],
        [
          "EQ",
          "equity_management_defined",
          true
        ],
        [
          "EQ",
          "financial_statement_management_defined",
          true
        ],
        [
          "EQ",
          "general_affairs_it_hr_management_defined",
          true
        ],
        [
          "EQ",
          "external_information_disclosure_management_defined",
          true
        ],
        [
          "EQ",
          "financial_inspection_report_management_defined",
          true
        ],
        [
          "EQ",
          "financial_consumer_protection_management_defined",
          true
        ],
        [
          "EQ",
          "major_incident_handling_mechanism_defined",
          true
        ],
        [
          "EQ",
          "anti_money_laundering_and_terrorism_financing_defined",
          true
        ],
        [
          "EQ",
          "other_business_regulations_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:subsidiary_control_and_aml_program",
    "desc": "對子公司控制作業及集團整體防制洗錢及打擊資恐計畫建立",
    "expr": [
      "EQ",
      "bank:subsidiary_control_and_aml_program",
      [
        "AND",
        [
          "EQ",
          "subsidiary_control_operations_defined",
          true
        ],
        [
          "EQ",
          "subsidiary_foreign_law_considered",
          true
        ],
        [
          "EQ",
          "group_aml_and_cft_program_established",
          true
        ],
        [
          "EQ",
          "group_aml_information_sharing_policy_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_supervision_and_audit",
    "desc": "內部控制制度應包含監督作業及內部稽核缺失溝通與改善",
    "expr": [
      "EQ",
      "bank:internal_control_supervision_and_audit",
      [
        "AND",
        [
          "EQ",
          "continuous_and_individual_evaluations_implemented",
          true
        ],
        [
          "EQ",
          "internal_audit_findings_communicated_to_management_and_board",
          true
        ],
        [
          "EQ",
          "internal_control_deficiencies_timely_corrected",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_management",
    "desc": "銀行辦理衍生性金融商品業務應訂定內部作業制度及程序",
    "expr": [
      "EQ",
      "bank:derivative_business_management",
      [
        "AND",
        [
          "EQ",
          "derivative_business_scope_defined",
          true
        ],
        [
          "EQ",
          "derivative_business_personnel_management_defined",
          true
        ],
        [
          "EQ",
          "derivative_business_customer_protection_defined",
          true
        ],
        [
          "EQ",
          "derivative_business_risk_management_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_derivative_business_approval",
    "desc": "銀行辦理外匯衍生性商品業務應依類別申請許可或函報備查",
    "expr": [
      "EQ",
      "bank:foreign_exchange_derivative_business_approval",
      [
        "AND",
        [
          "EQ",
          "pre_opening_permit_applied_for_restricted_products",
          true
        ],
        [
          "EQ",
          "pre_opening_filing_for_permitted_products",
          true
        ],
        [
          "EQ",
          "post_opening_filing_for_permitted_products",
          true
        ],
        [
          "EQ",
          "professional_investor_and_high_net_worth_client_restrictions_followed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:penalty_condition_violation",
    "desc": "銀行未依規定建立或執行內部控制及稽核制度等，應處罰",
    "expr": [
      "EQ",
      "bank:penalty_condition_violation",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "internal_handling_system_established",
            true
          ],
          [
            "EQ",
            "outsourcing_internal_procedures_established",
            true
          ],
          [
            "EQ",
            "derivative_business_internal_procedures_established",
            true
          ],
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有 constraint 成立則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_and_audit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:derivative_personnel_qualification",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_unit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_mechanism_principles",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:compliance_unit_duties",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:compliance_foreign_units_supervision",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:compliance_self_assessment_frequency",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policy_and_procedure",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policy_details",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:subsidiary_control_and_aml_program",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_supervision_and_audit",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:derivative_business_management",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_derivative_business_approval",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:penalty_condition_violation",
              false
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]