[
  {
    "id": "insurance:agent_license_and_insurance_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_license_and_insurance_compliance",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_deposit_minimum"
        ],
        [
          "EQ",
          "relevant_insurance_subscribed",
          true
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_compliance",
    "desc": "相關保險類型符合規定：代理人、公證人為責任保險；經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_type_responsibility",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance_type_guarantee",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "EQ",
            "insurance_type_responsibility",
            true
          ],
          [
            "EQ",
            "insurance_type_guarantee",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_type_responsibility",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance_type_guarantee",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit_and_insurance_amount_set_by_authority",
    "desc": "保證金及相關保險最低金額及實施方式由主管機關依經營業務範圍及規模定之",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit_and_insurance_amount_set_by_authority",
      [
        "EQ",
        "guarantee_deposit_minimum_set_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_management_rules_set_by_authority",
    "desc": "代理人資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則由主管機關定之",
    "expr": [
      "EQ",
      "agent_management_rules_set_by_authority",
      [
        "EQ",
        "management_rules_set_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_engage_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_engage_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_engage_agent",
            true
          ],
          [
            "EQ",
            "bank_engage_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fiduciary",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fiduciary",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fulfill_fiduciary_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_and_disclose_fee",
    "desc": "保險經紀人洽訂契約前應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_provide_written_analysis_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_analysis_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosed_clearly",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_rules",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定、同條第七項規定，或違反第165條第一項或第163條第五項準用規定",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rules",
          true
        ],
        [
          "EQ",
          "violate_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_article_165_1",
          true
        ],
        [
          "EQ",
          "violate_article_163_5",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_penalty_applicable",
    "desc": "違反財務或業務管理規定者應限期改正或處罰鍰，情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "violation_penalty_applicable",
      [
        "IMPLIES",
        [
          "EQ",
          "violation_financial_or_business_management_rules",
          true
        ],
        [
          "EQ",
          "penalty_applicable",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_prohibited_behaviors",
    "desc": "代理人不得有申領證照不實、未核准登記經營、未核准業務、隱匿重要事項、不當強迫或引誘、誇大不實宣傳、不當慫恿退保、挪用保險費、證照供他人使用、侵占詐欺偽造文書、經營範圍外業務、非法收取報酬、不法保險給付、散播不實言論、授權第三人代經營、招攬非所屬保險業務、聘用未具資格者、未依規定繳銷證照、擅自停業或解散、未依規定報備、使用未經同意廣告、支付佣酬予非實際招攬者、未確認金融消費者適合度、銷售未許可國外保單貼現商品、提報不實資料、任職保險業或公會現職、勸誘解除契約、未據實填寫招攬報告、其他違反規則或損保險形象行為",
    "expr": [
      "EQ",
      "agent_prohibited_behaviors",
      [
        "NOT",
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "false_report_on_license_application",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "operate_without_approval_registration",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "execute_unapproved_insurance_business",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "conceal_important_contract_info",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "improper_coercion_or_inducement",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "exaggerated_or_false_promotion",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "improper_inducement_to_cancel_or_transfer",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "misappropriation_of_premiums_or_claims",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "certificate_used_by_others",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "embezzlement_fraud_forgery_conviction",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "operate_outside_license_scope",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "illegal_collection_of_funds_or_benefits",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "illegal_insurance_payment",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "spread_false_information_disturb_financial_order",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "authorize_others_to_operate",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "submit_non_affiliated_proposal_documents",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "employ_unqualified_recruiters",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "fail_to_cancel_license_within_deadline",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "unauthorized_suspension_or_termination_of_business",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "fail_to_report_to_trade_association",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "use_unapproved_advertisement",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "pay_commission_to_non_actual_recruiters",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "fail_to_confirm_consumer_suitability",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "sell_unapproved_foreign_policy_discount_products",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "submit_false_or_incomplete_financial_reports",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "hold_positions_in_insurance_or_association",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "induce_contract_termination_or_loan_payment",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "fail_to_fill_recruitment_report_truthfully",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "other_violations_or_damage_insurance_image",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未經主管機關許可、未繳存保證金、未投保相關保險、未領執業證照、違反管理規則財務或業務管理規定、或有代理人禁止行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_license_and_insurance_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_management_rules_set_by_authority",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_financial_or_business_management_rules",
            false
          ]
        ],
        [
          "EQ",
          "agent_prohibited_behaviors",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]