[
  {
    "id": "insurance:agent_broker_notary_license_and_guarantee",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_notary_license_and_guarantee",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_minimum_amount"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "has_practice_certificate",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_correct",
    "desc": "相關保險類型正確：代理人、公證人為責任保險；經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_correct",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "is_agent",
            true
          ],
          [
            "EQ",
            "is_notary",
            false
          ],
          [
            "EQ",
            "insurance_type",
            "liability_insurance"
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_agent",
            false
          ],
          [
            "EQ",
            "is_notary",
            true
          ],
          [
            "EQ",
            "insurance_type",
            "liability_insurance"
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              "liability_insurance"
            ],
            [
              "EQ",
              "insurance_type",
              "guarantee_insurance"
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_minimum_amount_by_period",
    "desc": "經紀人公司最低實收資本額依申請期間及業務類型分段",
    "expr": [
      "EQ",
      "capital_minimum_amount_by_period",
      [
        "CASE",
        [
          "AND",
          [
            "GE",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            1
          ]
        ],
        20000000,
        [
          "AND",
          [
            "GE",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            2
          ]
        ],
        20000000,
        [
          "AND",
          [
            "GE",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            3
          ]
        ],
        30000000,
        [
          "AND",
          [
            "LT",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            1
          ]
        ],
        5000000,
        [
          "AND",
          [
            "LT",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            2
          ]
        ],
        10000000,
        [
          "AND",
          [
            "LT",
            "application_date",
            20210303
          ],
          [
            "EQ",
            "business_type",
            3
          ]
        ],
        10000000,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adjustment_required",
    "desc": "已領有執業證照之經紀人公司於規定期限內完成資本額調整",
    "expr": [
      "EQ",
      "capital_adjustment_required",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "has_practice_certificate",
            true
          ],
          [
            "LT",
            "application_date",
            20210303
          ],
          [
            "LE",
            "capital_adjustment_completed_date",
            20180624
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "has_practice_certificate",
            true
          ],
          [
            "GE",
            "application_date",
            20210303
          ],
          [
            "OR",
            [
              "AND",
              [
                "EQ",
                "share_or_capital_transfer",
                true
              ],
              [
                "LE",
                "capital_adjustment_completed_date",
                [
                  "ADD",
                  "share_or_capital_transfer_date",
                  183
                ]
              ]
            ],
            [
              "EQ",
              "share_or_capital_transfer",
              false
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_amount_cash_only",
    "desc": "經紀人公司發起人及股東出資以現金為限",
    "expr": [
      "EQ",
      "capital_amount_cash_only",
      [
        "EQ",
        "capital_contributed_in_cash",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:management_rules_compliance",
    "desc": "遵守主管機關定之管理規則",
    "expr": [
      "EQ",
      "management_rules_compliance",
      [
        "AND",
        [
          "EQ",
          "financial_management_compliant",
          true
        ],
        [
          "EQ",
          "business_management_compliant",
          true
        ],
        [
          "EQ",
          "qualification_conditions_met",
          true
        ],
        [
          "EQ",
          "application_procedures_met",
          true
        ],
        [
          "EQ",
          "required_documents_submitted",
          true
        ],
        [
          "EQ",
          "board_and_manager_qualifications_met",
          true
        ],
        [
          "EQ",
          "dismissal_reasons_compliant",
          true
        ],
        [
          "EQ",
          "branch_establishment_conditions_met",
          true
        ],
        [
          "EQ",
          "education_training_compliant",
          true
        ],
        [
          "EQ",
          "license_revocation_compliant",
          true
        ],
        [
          "EQ",
          "other_compliance_matters_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "AND",
        [
          "EQ",
          "agent_broker_notary_license_and_guarantee",
          true
        ],
        [
          "EQ",
          "relevant_insurance_type_correct",
          true
        ],
        [
          "GE",
          "capital_minimum_amount_by_period",
          1
        ],
        [
          "EQ",
          "capital_adjustment_required",
          true
        ],
        [
          "EQ",
          "capital_amount_cash_only",
          true
        ],
        [
          "EQ",
          "management_rules_compliance",
          true
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險、執業證照或管理規則規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_broker_notary_license_and_guarantee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "relevant_insurance_type_correct",
            true
          ]
        ],
        [
          "NOT",
          [
            "GE",
            "capital_minimum_amount_by_period",
            1
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_adjustment_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_amount_cash_only",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "management_rules_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]