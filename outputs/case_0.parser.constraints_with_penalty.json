[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_audit_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_system_mandatory",
    "desc": "銀行是否建立資產品質評估、損失準備提列、逾期放款催收及呆帳轉銷之內部處理制度及程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_handling_system_mandatory",
      [
        "AND",
        [
          "EQ",
          "asset_quality_evaluation_established",
          true
        ],
        [
          "EQ",
          "loss_provision_established",
          true
        ],
        [
          "EQ",
          "overdue_loan_collection_established",
          true
        ],
        [
          "EQ",
          "bad_debt_writeoff_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_system_mandatory",
    "desc": "銀行是否建立作業委託及衍生性金融商品業務之內部作業制度及程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_operation_system_mandatory",
      [
        "AND",
        [
          "EQ",
          "outsourcing_operation_system_established",
          true
        ],
        [
          "EQ",
          "derivative_financial_operation_system_established",
          true
        ],
        [
          "EQ",
          "internal_operation_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_comprehensive_policies",
    "desc": "銀行內部控制制度涵蓋組織規程、業務規範及作業程序等政策且適時檢討修訂",
    "expr": [
      "EQ",
      "bank:internal_control_comprehensive_policies",
      [
        "AND",
        [
          "EQ",
          "organization_regulations_established",
          true
        ],
        [
          "EQ",
          "business_standards_and_manuals_established",
          true
        ],
        [
          "EQ",
          "policies_and_procedures_reviewed_and_updated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_business_manuals_included",
    "desc": "銀行業務規範及處理手冊包含出納、存款、匯兌、授信、外匯、新種金融商品及委外作業管理",
    "expr": [
      "EQ",
      "bank:internal_control_business_manuals_included",
      [
        "AND",
        [
          "EQ",
          "cashier_management_included",
          true
        ],
        [
          "EQ",
          "deposit_management_included",
          true
        ],
        [
          "EQ",
          "remittance_management_included",
          true
        ],
        [
          "EQ",
          "credit_management_included",
          true
        ],
        [
          "EQ",
          "foreign_exchange_management_included",
          true
        ],
        [
          "EQ",
          "new_financial_products_management_included",
          true
        ],
        [
          "EQ",
          "outsourcing_management_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_subsidiary_management",
    "desc": "銀行應訂定子公司必要控制作業並督促子公司建立內部控制制度",
    "expr": [
      "EQ",
      "bank:internal_control_subsidiary_management",
      [
        "AND",
        [
          "EQ",
          "subsidiary_control_operations_established",
          true
        ],
        [
          "EQ",
          "subsidiary_internal_control_supervised",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_aml_ctf_program",
    "desc": "銀行應建立集團整體性防制洗錢及打擊資恐計畫及相關政策程序",
    "expr": [
      "EQ",
      "bank:internal_control_aml_ctf_program",
      [
        "AND",
        [
          "EQ",
          "group_aml_ctf_program_established",
          true
        ],
        [
          "EQ",
          "group_aml_ctf_info_sharing_policy_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policy_revision_participation",
    "desc": "銀行內部控制相關作業及管理規章訂定、修訂或廢止時，法令遵循、內部稽核及風險管理單位參與",
    "expr": [
      "EQ",
      "bank:internal_control_policy_revision_participation",
      [
        "AND",
        [
          "EQ",
          "legal_compliance_unit_participated",
          true
        ],
        [
          "EQ",
          "internal_audit_unit_participated",
          true
        ],
        [
          "EQ",
          "risk_management_unit_participated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_compliance",
    "desc": "銀行是否符合內部控制及稽核制度、內部處理制度及程序、內部作業制度及程序之規定且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "bank:internal_control_and_audit_mandatory",
          true
        ],
        [
          "EQ",
          "bank:internal_handling_system_mandatory",
          true
        ],
        [
          "EQ",
          "bank:internal_operation_system_mandatory",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_control_mandatory",
    "desc": "未依規定建立或未確實執行內部控制及稽核制度、內部處理制度及程序、內部作業制度及程序視為違反",
    "expr": [
      "EQ",
      "bank:violation_internal_control_mandatory",
      [
        "NOT",
        [
          "EQ",
          "bank:internal_control_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有合規要求成立且無違法或互斥條件則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_and_audit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_handling_system_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_operation_system_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_comprehensive_policies",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_business_manuals_included",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_subsidiary_management",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_aml_ctf_program",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policy_revision_participation",
              true
            ]
          ],
          [
            "EQ",
            "bank:violation_internal_control_mandatory",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]