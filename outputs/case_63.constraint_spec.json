[
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_subscribed",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_compliance",
    "desc": "保險代理人、公證人應投保責任保險；保險經紀人應投保責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "liability_insurance_subscribed",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "guarantee_insurance_subscribed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "EQ",
            "liability_insurance_subscribed",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_subscribed",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "liability_insurance_subscribed",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "guarantee_insurance_subscribed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit_defined",
    "desc": "主管機關定最低保證金及實施方式，考量經營業務範圍及規模",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit_defined",
      [
        "EQ",
        "minimum_guarantee_deposit",
        "defined_by_authority"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:management_rules_defined",
    "desc": "主管機關定管理規則，包括資格、申請、程序、文件、董事監察人資格、解任、分支機構、財務業務管理、教育訓練、廢止許可等事項",
    "expr": [
      "EQ",
      "management_rules_defined",
      [
        "EQ",
        "management_rules_set_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_and_application",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permission_and_application",
      [
        "AND",
        [
          "EQ",
          "bank_approved_by_authority",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_engage_agent",
            true
          ],
          [
            "EQ",
            "bank_engage_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fulfill_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂契約前應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_provide_written_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management",
    "desc": "違反管理規則中財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_financial_or_business_management",
      [
        "EQ",
        "violate_financial_or_business_management_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_written_report_or_fee_disclosure",
    "desc": "違反保險經紀人書面分析報告或報酬告知規定",
    "expr": [
      "EQ",
      "violation_written_report_or_fee_disclosure",
      [
        "EQ",
        "violate_written_report_or_fee_disclosure_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_other_related_provisions",
    "desc": "違反第一百六十五條第一項或第一百六十三條第五項準用規定",
    "expr": [
      "EQ",
      "violation_other_related_provisions",
      [
        "EQ",
        "violate_other_related_provisions",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:correction_or_penalty_imposed",
    "desc": "違反規定者應限期改正或處罰，情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "correction_or_penalty_imposed",
      [
        "OR",
        [
          "EQ",
          "correction_ordered",
          true
        ],
        [
          "EQ",
          "penalty_imposed",
          true
        ],
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "EQ",
          "certificate_canceled",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反財務或業務管理規定、違反書面報告或報酬告知規定，或違反其他相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_financial_or_business_management",
          true
        ],
        [
          "EQ",
          "violation_written_report_or_fee_disclosure",
          true
        ],
        [
          "EQ",
          "violation_other_related_provisions",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]