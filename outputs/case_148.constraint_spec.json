  {
    "id": "insurance:real_estate_investment_limit_ok",
    "desc": "不動產投資符合即時利用且有收益，且投資總額除自用不動產外不超過資金30%，自用不動產不超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit_ok",
      [
        "AND",
        [
          "EQ",
          "real_estate_investment_in_use_and_income",
          true
        ],
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "total_funds",
            0.3
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
