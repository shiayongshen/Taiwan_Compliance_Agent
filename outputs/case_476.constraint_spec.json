[
  {
    "id": "securities:violation_affects_business",
    "desc": "董事、監察人及受僱人違反法令且影響證券業務正常執行",
    "expr": [
      "EQ",
      "violation_affects_business",
      [
        "AND",
        [
          "EQ",
          "director_violation",
          true
        ],
        [
          "EQ",
          "violation_affects_normal_business",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:supervisor_order_stop_or_dismiss",
    "desc": "主管機關得命令停止一年以下業務或解除職務",
    "expr": [
      "EQ",
      "supervisor_order_stop_or_dismiss",
      [
        "OR",
        [
          "EQ",
          "order_stop_business_within_one_year",
          true
        ],
        [
          "EQ",
          "order_dismiss_officer",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_imposed",
    "desc": "依情節輕重對證券商處以第六十六條所定處分",
    "expr": [
      "EQ",
      "penalty_imposed",
      [
        "AND",
        [
          "EQ",
          "violation_affects_business",
          true
        ],
        [
          "EQ",
          "penalty_according_to_article_66",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令且影響業務正常執行，且未依規定處分時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "AND",
        [
          "EQ",
          "violation_affects_business",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "penalty_imposed",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]