[
  {
    "id": "insurance:license_and_guarantee_required",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可、繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_required",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type",
    "desc": "相關保險種類依身份區分：保險代理人、公證人為責任保險；保險經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_covered",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "responsibility_insurance_covered",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker",
            true
          ],
          [
            "EQ",
            "responsibility_insurance_covered",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_covered",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit",
    "desc": "繳存保證金及投保相關保險之最低金額及實施方式由主管機關定之",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit",
      [
        "VAR",
        "authority_defined_minimum_guarantee_deposit"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:qualification_and_management_rules_defined",
    "desc": "資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則由主管機關定之",
    "expr": [
      "EQ",
      "qualification_and_management_rules_defined",
      [
        "EQ",
        "authority_defined_management_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_for_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permission_for_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_approved_by_authority",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂契約或提供服務，並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂契約前，於主管機關指定範圍內，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_written_report_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:fixed_office_and_accounting_required",
    "desc": "保險代理人、經紀人、公證人應有固定業務處所，並專設帳簿記載業務收支",
    "expr": [
      "EQ",
      "fixed_office_and_accounting_required",
      [
        "AND",
        [
          "EQ",
          "fixed_office_established",
          true
        ],
        [
          "EQ",
          "special_accounting_book_kept",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_license_for_multiple_qualifications",
    "desc": "兼有保險代理人、經紀人、公證人資格者，僅得擇一申領執業證照",
    "expr": [
      "EQ",
      "single_license_for_multiple_qualifications",
      [
        "LE",
        [
          "SUM",
          [
            "IF",
            [
              "EQ",
              "has_agent_qualification",
              true
            ],
            1,
            0
          ],
          [
            "IF",
            [
              "EQ",
              "has_broker_qualification",
              true
            ],
            1,
            0
          ],
          [
            "IF",
            [
              "EQ",
              "has_notary_qualification",
              true
            ],
            1,
            0
          ]
        ],
        1
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_required_for_large_companies",
    "desc": "保險代理人公司、經紀人公司為公開發行公司或具一定規模者，應建立內部控制、稽核制度與招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_and_audit_required",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "is_publicly_listed",
            true
          ],
          [
            "EQ",
            "has_certain_scale",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "audit_system_established",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_penalty_167_2",
    "desc": "違反管理規則財務或業務管理規定、書面分析報告規定、固定業務處所及帳簿記載規定，應限期改正或處罰，情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "violation_167_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "qualification_and_management_rules_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_written_report_and_fee_disclosure",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fixed_office_and_accounting_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_permission_for_agent_or_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_penalty_167_3",
    "desc": "違反未建立或未確實執行內部控制、稽核制度、招攬處理制度或程序者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_167_3",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_handling_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "finance:compensation_system_requirements",
    "desc": "金融服務業應訂定業務人員酬金制度並提報董（理）事會通過，酬金制度應衡平考量客戶權益及風險，不得僅考量業績目標",
    "expr": [
      "EQ",
      "compensation_system_requirements",
      [
        "AND",
        [
          "EQ",
          "compensation_system_established",
          true
        ],
        [
          "EQ",
          "compensation_system_approved_by_board",
          true
        ],
        [
          "EQ",
          "compensation_system_considers_customer_interest",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "compensation_system_only_considers_performance",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance"
  },
  {
    "id": "finance:compensation_system_principles_defined",
    "desc": "金融服務業業務人員酬金制度應遵行之原則由同業公會擬訂或主管機關指定公會擬訂，報主管機關核定",
    "expr": [
      "EQ",
      "compensation_system_principles_defined",
      [
        "EQ",
        "compensation_principles_defined_by_association",
        true
      ]
    ],
    "weight": 1,
    "domain": "finance"
  },
  {
    "id": "finance:penalty_for_violation_30_1",
    "desc": "金融服務業違反廣告招攬規定、未充分瞭解消費者資料及適合度、未充分說明揭露風險、未訂定或未執行酬金制度者，處罰",
    "expr": [
      "EQ",
      "violation_30_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "advertising_and_solicitation_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "consumer_data_and_suitability_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "disclosure_and_risk_explanation_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "compensation_system_requirements",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance"
  },
  {
    "id": "finance:penalty_for_formal_appearance_violation",
    "desc": "金融服務業協助不符合條件者創造形式外觀者處罰",
    "expr": [
      "EQ",
      "violation_formal_appearance",
      [
        "EQ",
        "assisted_formal_appearance_violation",
        true
      ]
    ],
    "weight": 1,
    "domain": "finance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反保險法第167-2條、第167-3條及金融消費者保護法第30-1條規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_167_2",
          true
        ],
        [
          "EQ",
          "violation_167_3",
          true
        ],
        [
          "EQ",
          "violation_30_1",
          true
        ],
        [
          "EQ",
          "violation_formal_appearance",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]