        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_amount",
            [
              "MUL",
              "capital_fund",
              1.0
            ]
          ],
          [
            "LE",
            "foreign_real_estate_investment_amount",
            [
              "MUL",
              "owner_equity",
              10.0
            ]
          ]
        ],
        [
          "AND",
          [
            "GE",
            "capital_to_risk_capital_ratio",
            1.25
          ],
          [
            "LT",
            "capital_to_risk_capital_ratio",
            1.5
          ]
        ],
        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_amount",
            [
              "MUL",
              "capital_fund",
              2.5
            ]
          ],
          [
            "LE",
            "foreign_real_estate_investment_amount",
            [
              "MUL",
              "owner_equity",
              40.0
            ]
          ]
        ],
        [
          "GE",
          "capital_to_risk_capital_ratio",
          1.5
        ],
        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_amount",
            [
              "MUL",
              "capital_fund",
              3.0
