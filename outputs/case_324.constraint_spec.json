[
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "不動產投資總額除自用不動產外不得超過資金30%，自用不動產不得超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "capital_fund",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_use_and_income",
    "desc": "不動產投資以即時利用並有收益者為限，住宅法興辦社會住宅且僅供租賃者除外",
    "expr": [
      "EQ",
      "real_estate_use_and_income",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "real_estate_invested_use",
            true
          ],
          [
            "EQ",
            "real_estate_invested_income",
            true
          ]
        ],
        [
          "EQ",
          "social_housing_rental_only",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_valuation_required",
    "desc": "不動產取得及處分應經合法不動產鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_valuation_required",
      [
        "EQ",
        "real_estate_valuation_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_type_limit_per_loan",
    "desc": "放款每一單位金額不得超過資金5%",
    "expr": [
      "EQ",
      "loan_type_limit_per_loan",
      [
        "LE",
        "single_loan_amount",
        [
          "MUL",
          "capital_fund",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_total_limit",
    "desc": "放款總額不得超過資金35%",
    "expr": [
      "EQ",
      "loan_total_limit",
      [
        "LE",
        "total_loan_amount",
        [
          "MUL",
          "capital_fund",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_conditions",
    "desc": "對負責人、職員或主要股東等利害關係人擔保放款應有十足擔保且條件不得優於其他同類放款",
    "expr": [
      "EQ",
      "loan_guarantee_conditions",
      [
        "AND",
        [
          "EQ",
          "guarantee_sufficient",
          true
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "guarantee_condition",
              true
            ],
            [
              "NOT",
              [
                "EQ",
                "other_similar_loan_condition",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_board_approval_required",
    "desc": "擔保放款達主管機關規定金額以上須經三分之二以上董事出席及四分之三以上同意",
    "expr": [
      "EQ",
      "loan_board_approval_required",
      [
        "IMPLIES",
        [
          "GE",
          "guaranteed_loan_amount",
          "regulatory_threshold"
        ],
        [
          "AND",
          [
            "GE",
            "board_attendance_ratio",
            0.6667
          ],
          [
            "GE",
            "board_approval_ratio",
            0.75
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_related_party_limit",
    "desc": "依規定對負責人、職員或主要股東等利害關係人擔保放款限額及總餘額應遵行主管機關辦法",
    "expr": [
      "EQ",
      "loan_related_party_limit",
      [
        "EQ",
        "loan_related_party_limit_complied",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:securities_and_loan_combined_limit",
    "desc": "有價證券投資與以該公司有價證券為質放款合併計算不得超過資金10%及公司業主權益10%",
    "expr": [
      "EQ",
      "securities_and_loan_combined_limit",
      [
        "AND",
        [
          "LE",
          "combined_investment_amount",
          [
            "MUL",
            "capital_fund",
            10.0
          ]
        ],
        [
          "LE",
          "combined_investment_amount",
          [
            "MUL",
            "company_owner_equity",
            10.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_types",
    "desc": "國外投資限於外匯存款、國外有價證券、核准保險相關事業及其他核准投資",
    "expr": [
      "EQ",
      "foreign_investment_types",
      [
        "OR",
        [
          "EQ",
          "foreign_investment_foreign_currency_deposit",
          true
        ],
        [
          "EQ",
          "foreign_investment_foreign_securities",
          true
        ],
        [
          "EQ",
          "foreign_investment_approved_insurance_related",
          true
        ],
        [
          "EQ",
          "foreign_investment_other_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_total_limit",
    "desc": "國外投資總額最高不得超過資金45%，特定金額及項目不計入限額",
    "expr": [
      "EQ",
      "foreign_investment_total_limit",
      [
        "LE",
        "foreign_investment_total_amount",
        [
          "MUL",
          "capital_fund",
          45.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_exclusions",
