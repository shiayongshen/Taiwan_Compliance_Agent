    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_conditions",
    "desc": "國外及大陸地區不動產投資須合法利用並產生效益，且符合資本與風險資本比率標準及內部控制要求",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_conditions",
      [
        "AND",
        [
          "EQ",
          "foreign_real_estate_legal_use_and_benefit",
          true
        ],
        [
          "GE",
          "capital_to_risk_capital_ratio",
          "statutory_standard"
        ],
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "major_violation_in_last_two_years",
              true
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "violation_corrected",
              true
            ],
            [
              "EQ",
              "correction_approved",
              true
            ]
          ]
        ],
        [
          "OR",
          [
            "EQ",
            "board_risk_management_committee_established",
            true
          ],
          [
            "EQ",
            "internal_risk_management_department_established",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_total_limit",
