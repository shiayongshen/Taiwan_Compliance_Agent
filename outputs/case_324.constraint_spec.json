[
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "不動產投資總額除自用不動產外不得超過資金30%，自用不動產不得超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "capital_fund",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_investment_usable",
    "desc": "不動產投資以即時利用並有收益者為限，除依住宅法興辦社會住宅且僅供租賃者不受此限",
    "expr": [
      "EQ",
      "real_estate_investment_usable",
      [
        "OR",
        [
          "EQ",
          "social_housing_only_rental",
          true
        ],
        [
          "EQ",
          "real_estate_investment_usable_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_valuation_required",
    "desc": "不動產取得及處分應經合法不動產鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_valuation_required",
      [
        "EQ",
        "real_estate_valuation_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_type_limit",
    "desc": "放款限於銀行或主管機關認可信用保證機構保證、以動產不動產擔保、有價證券質押、人壽保險單質押",
    "expr": [
      "EQ",
      "loan_type_limit",
      [
        "OR",
        [
          "EQ",
          "loan_guaranteed_by_bank_or_authority",
          true
        ],
        [
          "EQ",
          "loan_secured_by_property",
          true
        ],
        [
          "EQ",
          "loan_secured_by_approved_securities",
          true
        ],
        [
          "EQ",
          "loan_secured_by_life_insurance_policy",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_loan_amount_limit",
    "desc": "每一單位放款金額不得超過資金5%",
    "expr": [
      "EQ",
      "single_loan_amount_limit",
      [
        "LE",
        "single_loan_amount",
        [
          "MUL",
          "capital_fund",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:total_loan_amount_limit",
    "desc": "放款總額不得超過資金35%",
    "expr": [
      "EQ",
      "total_loan_amount_limit",
      [
        "LE",
        "total_loan_amount",
        [
          "MUL",
          "capital_fund",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_guarantee",
    "desc": "對負責人、職員、主要股東及利害關係人擔保放款應有十足擔保且條件不得優於其他同類放款",
    "expr": [
      "EQ",
      "related_party_loan_guarantee",
      [
        "AND",
        [
          "EQ",
          "related_party_loan_full_guarantee",
          true
        ],
        [
          "EQ",
          "related_party_loan_conditions_not_preferential",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_approval",
    "desc": "利害關係人放款達主管機關規定金額以上，須經三分之二以上董事出席及出席董事四分之三以上同意",
    "expr": [
      "EQ",
      "related_party_loan_approval",
      [
        "IMPLIES",
        [
          "GE",
          "related_party_loan_amount",
          "authority_threshold_amount"
        ],
        [
          "AND",
          [
            "GE",
            "board_directors_attendance_ratio",
            0.6666667
          ],
          [
            "GE",
            "board_directors_approval_ratio",
            0.75
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:combined_investment_limit",
    "desc": "同一公司有價證券投資與以該公司有價證券為質放款合併計算不得超過資金10%及公司業主權益10%",
    "expr": [
      "EQ",
      "combined_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "ADD",
            "investment_in_company_securities",
            "loan_secured_by_company_securities"
          ],
          [
            "MUL",
            "capital_fund",
            10.0
          ]
        ],
        [
          "LE",
          [
            "ADD",
            "investment_in_company_securities",
            "loan_secured_by_company_securities"
          ],
          [
            "MUL",
            "company_owner_equity",
            10.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_types_limit",
    "desc": "國外投資限於外匯存款、國外有價證券、核准之國外保險相關事業及其他核准投資",
    "expr": [
      "EQ",
      "foreign_investment_types_limit",
      [
        "OR",
        [
          "EQ",
          "foreign_investment_foreign_currency_deposit",
          true
        ],
        [
          "EQ",
          "foreign_investment_foreign_securities",
          true
        ],
        [
          "EQ",
          "foreign_investment_approved_foreign_insurance_related",
          true
        ],
        [
          "EQ",
          "foreign_investment_other_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_total_limit",
    "desc": "國外投資總額最高不得超過資金45%，但有核准不計入項目除外",
    "expr": [
      "EQ",
      "foreign_investment_total_limit",
      [
        "LE",
        "foreign_investment_total",
        [
          "MUL",
          "capital_fund",
          45.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_exclusion",
    "desc": "核准不計入國外投資限額之金額",
    "expr": [
      "EQ",
      "foreign_investment_exclusion",
      [
        "ADD",
        [
          "ADD",
          [
            "ADD",
            "approved_non_investment_foreign_currency_insurance_amount",
            "approved_foreign_currency_securities_amount"
          ],
          "approved_foreign_insurance_related_investment_amount"
        ],
        "other_approved_exclusion_amount"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_net_limit",
    "desc": "國外投資淨額不得超過資金45%減除核准不計入金額",
    "expr": [
      "EQ",
      "foreign_investment_net_limit",
      [
        "LE",
        "foreign_investment_total",
        [
          "SUB",
          [
            "MUL",
            "capital_fund",
            45.0
          ],
          "foreign_investment_exclusion"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_and_transaction_limit",
    "desc": "主管機關得限制同一人、同一關係人或同一關係企業之放款及其他交易",
    "expr": [
      "EQ",
      "related_party_loan_and_transaction_limit",
      [
        "EQ",
        "authority_limit_enforced",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_shareholder_rights_actions",
    "desc": "不得以信託、委任或其他方式進行股權交換或利益輸送，不得損及要保人等利益",
    "expr": [
      "EQ",
      "prohibited_shareholder_rights_actions",
      [
        "NOT",
        [
          "EQ",
          "prohibited_actions_occurred",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholder_meeting_vote_documentation",
    "desc": "出席股東會前應作成表決權評估分析，會後應提報董事會書面紀錄",
    "expr": [
      "EQ",
      "shareholder_meeting_vote_documentation",
      [
        "AND",
        [
          "EQ",
          "vote_evaluation_done_before_meeting",
          true
        ],
        [
          "EQ",
          "vote_record_reported_after_meeting",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_proxy_actions",
    "desc": "不得擔任被投資公司委託書徵求人或委託他人擔任",
    "expr": [
      "EQ",
      "prohibited_proxy_actions",
      [
        "NOT",
        [
          "EQ",
          "proxy_actions_occurred",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "建立資產品質評估、準備金提存、逾期放款催收、呆帳轉銷及保單招攬核保理賠之內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反不動產投資限制、放款限制、國外投資限制、內部控制及稽核制度等規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_usable",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_valuation_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "loan_type_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "single_loan_amount_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "total_loan_amount_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_loan_guarantee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_loan_approval",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "combined_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_types_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_net_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_loan_and_transaction_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_shareholder_rights_actions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholder_meeting_vote_documentation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_proxy_actions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]