        [
          "EQ",
          "foreign_investment_non_investment_type_approved",
          true
        ],
        [
          "EQ",
          "foreign_investment_domestic_foreign_currency_securities_approved",
          true
        ],
        [
          "EQ",
          "foreign_investment_approved_foreign_insurance_related",
          true
        ],
        [
          "EQ",
          "foreign_investment_other_approved_items",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_and_transaction_limit",
