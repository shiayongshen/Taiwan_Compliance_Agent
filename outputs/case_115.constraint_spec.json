[
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_covered",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_covered",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "liability_insurance_covered",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "AND",
            [
              "EQ",
              "liability_insurance_covered",
              true
            ],
            [
              "EQ",
              "guarantee_insurance_covered",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "liability_insurance_covered",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit",
    "desc": "主管機關定最低保證金及實施方式，考量經營業務範圍及規模",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit",
      [
        "CASE",
        [
          "EQ",
          "agent_type",
          1
        ],
        "min_deposit_agent",
        [
          "EQ",
          "agent_type",
          2
        ],
        "min_deposit_broker",
        [
          "EQ",
          "agent_type",
          3
        ],
        "min_deposit_notary",
        0.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:good_faith_and_diligence",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "good_faith_and_diligence",
      [
        "AND",
        [
          "EQ",
          "duty_of_care",
          true
        ],
        [
          "EQ",
          "duty_of_loyalty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:written_analysis_report_provided",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，主動提供書面分析報告",
    "expr": [
      "EQ",
      "written_analysis_report_provided",
      [
        "IMPLIES",
        [
          "EQ",
          "within_authority_scope",
          true
        ],
        [
          "EQ",
          "analysis_report_provided",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:disclose_fee_standard",
    "desc": "保險經紀人向要保人或被保險人收取報酬時，應明確告知報酬收取標準",
    "expr": [
      "EQ",
      "disclose_fee_standard",
      [
        "IMPLIES",
        [
          "EQ",
          "fee_charged",
          true
        ],
        [
          "EQ",
          "fee_standard_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_finance_or_business_management",
    "desc": "違反財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_finance_or_business_management",
      [
        "OR",
        [
          "EQ",
          "violate_finance_management",
          true
        ],
        [
          "EQ",
          "violate_business_management",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_broker_duties",
    "desc": "違反保險經紀人善良管理人注意義務或忠實義務",
    "expr": [
      "EQ",
      "violation_broker_duties",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "good_faith_and_diligence",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "written_analysis_report_provided",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:document_retention_compliance",
    "desc": "個人執業經紀人、經紀人公司及銀行應留存文件備查",
    "expr": [
      "EQ",
      "document_retention_compliance",
      [
        "EQ",
        "documents_retained",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:contact_info_collection_compliance",
    "desc": "電子保單出單時，應取得要保人及被保險人聯絡方式並提供保險人",
    "expr": [
      "EQ",
      "contact_info_collection_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "policy_issued_electronically",
          true
        ],
        [
          "AND",
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "applicant_phone",
                false
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "applicant_email",
                false
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "applicant_other_contact",
                false
              ]
            ]
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "insured_phone",
                false
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "insured_email",
                false
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "insured_other_contact",
                false
              ]
            ]
          ],
          [
            "EQ",
            "contact_info_provided_to_insurer",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_operation_compliance",
    "desc": "經紀人公司及銀行應訂定並落實內部作業規範，確保遵循法令及保障高齡消費者權益",
    "expr": [
      "EQ",
      "internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_operation_rules_established",
          true
        ],
        [
          "EQ",
          "internal_operation_rules_executed",
          true
        ],
        [
          "EQ",
          "senior_consumer_protection_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_understanding_and_reporting",
    "desc": "經紀人洽訂保險契約前應充分瞭解要保人及被保險人基本資料、需求及風險屬性，並依主管機關規定提供書面分析報告及報酬標準",
    "expr": [
      "EQ",
      "broker_understanding_and_reporting",
      [
        "AND",
        [
          "EQ",
          "basic_info_understood",
          true
        ],
        [
          "EQ",
          "needs_and_risk_understood",
          true
        ],
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholding_disclosure",
    "desc": "經紀人於洽訂保險契約前，應揭露與保險公司持股超過10%之資訊",
    "expr": [
      "EQ",
      "shareholding_disclosure",
      [
        "OR",
        [
          "AND",
          [
            "GT",
            "broker_company_shareholding_in_insurer",
            10.0
          ],
          [
            "EQ",
            "disclosed_to_applicant",
            true
          ]
        ],
        [
          "AND",
          [
            "GT",
            "insurer_shareholding_in_broker_company",
            10.0
          ],
          [
            "EQ",
            "disclosed_to_applicant",
            true
          ]
        ],
        [
          "AND",
          [
            "LE",
            "broker_company_shareholding_in_insurer",
            10.0
          ],
          [
            "LE",
            "insurer_shareholding_in_broker_company",
            10.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險投保、執業證照規定，或違反財務、業務管理規定，或違反經紀人義務，或未留存文件，或未取得聯絡方式，或未訂定或執行內部作業規範，或未揭露持股資訊時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_and_guarantee_compliance",
            true
          ]
        ],
        [
          "EQ",
          "violation_finance_or_business_management",
          true
        ],
        [
          "EQ",
          "violation_broker_duties",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "document_retention_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contact_info_collection_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_disclosure",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]