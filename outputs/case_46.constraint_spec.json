[
  {
    "id": "fhc:violation_occurred",
    "desc": "金融控股公司有違反法令、章程或有礙健全經營之虞",
    "expr": [
      "EQ",
      "violation_occurred",
      [
        "EQ",
        "fhc_violation_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_measures",
    "desc": "主管機關可採取之處分措施",
    "expr": [
      "EQ",
      "penalty_measures",
      [
        "OR",
        [
          "EQ",
          "revoke_statutory_meeting_resolution",
          true
        ],
        [
          "EQ",
          "suspend_subsidiary_business",
          true
        ],
        [
          "EQ",
          "remove_manager_or_staff",
          true
        ],
        [
          "EQ",
          "remove_or_suspend_director_supervisor",
          true
        ],
        [
          "EQ",
          "dispose_subsidiary_shares",
          true
        ],
        [
          "EQ",
          "revoke_license",
          true
        ],
        [
          "EQ",
          "other_necessary_measures",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:director_supervisor_removal_notify",
    "desc": "依第四款解除董事、監察人職務時，主管機關通知經濟部廢止登記",
    "expr": [
      "EQ",
      "director_supervisor_removal_notify",
      [
        "IMPLIES",
        [
          "EQ",
          "remove_or_suspend_director_supervisor",
          true
        ],
        [
          "EQ",
          "notify_economic_ministry_to_revoke_registration",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:license_revocation_requirements",
    "desc": "廢止許可時，應令金融控股公司於期限內處分股份及董事人數不符規定，並不得再使用名稱及辦理變更登記",
    "expr": [
      "EQ",
      "license_revocation_requirements_met",
      [
        "AND",
        [
          "EQ",
          "revoke_license",
          true
        ],
        [
          "EQ",
          "dispose_shares_and_reduce_directors",
          true
        ],
        [
          "EQ",
          "prohibit_use_name_and_change_registration",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:license_revocation_penalty",
    "desc": "未於期限內完成處分者，應令解散及清算",
    "expr": [
      "EQ",
      "license_revocation_penalty",
      [
        "AND",
        [
          "EQ",
          "revoke_license",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "dispose_shares_and_reduce_directors",
            true
          ]
        ],
        [
          "EQ",
          "dissolution_and_liquidation_ordered",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令或未依規定完成廢止許可相關處分時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "penalty_measures",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "revoke_license",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "dispose_shares_and_reduce_directors",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]