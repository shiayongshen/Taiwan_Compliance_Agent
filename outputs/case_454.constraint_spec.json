[
  {
    "id": "insurance:agent_license_and_guarantee",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_license_and_guarantee",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_minimum_amount"
        ],
        [
          "EQ",
          "related_insurance_purchased",
          true
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_insurance_type_compliance",
    "desc": "相關保險類型符合代理人、公證人為責任保險，經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "related_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_type",
            "liability_insurance"
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              "liability_insurance"
            ],
            [
              "EQ",
              "insurance_type",
              "guarantee_insurance"
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_type",
            "liability_insurance"
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_type",
    "desc": "代理人類型分類（1=保險代理人, 2=保險經紀人, 3=保險公證人）",
    "expr": [
      "EQ",
      "agent_type",
      [
        "CASE",
        [
          "EQ",
          "is_insurance_agent",
          true
        ],
        1,
        [
          "EQ",
          "is_insurance_broker",
          true
        ],
        2,
        [
          "EQ",
          "is_insurance_notary",
          true
        ],
        3,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:guarantee_minimum_amount",
    "desc": "主管機關定最低保證金及保險金額",
    "expr": [
      "EQ",
      "guarantee_minimum_amount",
      [
        "CASE",
        [
          "GE",
          "guarantee_minimum_amount",
          0.0
        ],
        "guarantee_minimum_amount",
        0.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_and_bank_compliance",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並應分別準用相關規定",
    "expr": [
      "EQ",
      "agent_company_and_bank_compliance",
      [
        "OR",
        [
          "EQ",
          "bank_permitted_as_agent",
          true
        ],
        [
          "EQ",
          "bank_permitted_as_broker",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duties",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duties_complied",
      [
        "AND",
        [
          "EQ",
          "broker_duty_care",
          true
        ],
        [
          "EQ",
          "broker_duty_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_report_and_fee_disclosure",
    "desc": "保險經紀人於主管機關指定範圍內洽訂契約前，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_disclosure_complied",
      [
        "AND",
        [
          "EQ",
          "broker_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_fee_charged",
            true
          ],
          [
            "EQ",
            "broker_fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_qualification_and_management_rules_compliance",
    "desc": "代理人資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則遵行",
    "expr": [
      "EQ",
      "agent_qualification_and_management_rules_complied",
      [
        "EQ",
        "management_rules_complied",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_finance_or_business_management",
    "desc": "違反財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_finance_or_business_management",
      [
        "OR",
        [
          "EQ",
          "violate_finance_management",
          true
        ],
        [
          "EQ",
          "violate_business_management",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_broker_duties",
    "desc": "違反保險經紀人忠實義務",
    "expr": [
      "EQ",
      "violation_broker_duties",
      [
        "NOT",
        [
          "EQ",
          "broker_duties_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_management_rules_or_broker_duties",
    "desc": "違反管理規則或保險經紀人義務",
    "expr": [
      "EQ",
      "violation_management_or_broker",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_qualification_and_management_rules_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duties_complied",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_personal_and_company_employment_restriction",
    "desc": "個人執業代理人及受代理人公司或銀行任用代理人不得同時受任於其他代理人公司、經紀人公司、公證人公司或銀行",
    "expr": [
      "EQ",
      "agent_employment_restriction_complied",
      [
        "NOT",
        [
          "EQ",
          "agent_employed_multiple_companies",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_must_employ_minimum_agents",
    "desc": "代理人公司及銀行應任用代理人至少一人，並視業務規模及品質調整，主管機關得要求增加",
    "expr": [
      "EQ",
      "agent_company_employment_complied",
      [
        "AND",
        [
          "GE",
          "agent_company_employed_agents",
          1
        ],
        [
          "EQ",
          "agent_company_adjusted_as_required",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_registration_compliance",
    "desc": "依規定辦理許可登記後，依法向公司登記主管機關辦理登記",
    "expr": [
      "EQ",
      "agent_company_registration_complied",
      [
        "AND",
        [
          "EQ",
          "license_registration_done",
          true
        ],
        [
          "EQ",
          "company_registration_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_contract_content_compliance",
    "desc": "保險代理合約內容符合規定至少包括指定項目",
    "expr": [
      "EQ",
      "agent_contract_content_complied",
      [
        "AND",
        [
          "EQ",
          "contract_party_names_included",
          true
        ],
        [
          "EQ",
          "contract_term_included",
          true
        ],
        [
          "EQ",
          "contract_authority_scope_included",
          true
        ],
        [
          "EQ",
          "commission_payment_standard_included",
          true
        ],
        [
          "EQ",
          "commission_payment_method_included",
          true
        ],
        [
          "EQ",
          "law_compliance_clause_included",
          true
        ],
        [
          "EQ",
          "prohibited_acts_clause_included",
          true
        ],
        [
          "EQ",
          "conflict_of_interest_prevention_included",
          true
        ],
        [
          "EQ",
          "breach_liability_clause_included",
          true
        ],
        [
          "EQ",
          "dispute_resolution_clause_included",
          true
        ],
        [
          "EQ",
          "contract_termination_clause_included",
          true
        ],
        [
          "EQ",
          "financial_account_included",
          true
        ],
        [
          "EQ",
          "other_regulatory_requirements_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險、執業證照、管理規則、經紀人義務或代理人限制規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_license_and_guarantee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_insurance_type_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_qualification_and_management_rules_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_finance_or_business_management",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duties_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_report_and_fee_disclosure_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_employment_restriction_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_company_employment_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_company_registration_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_contract_content_complied",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]