[
  {
    "id": "insurance:agent_license_and_insurance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_license_and_insurance",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_deposit_minimum"
        ],
        [
          "EQ",
          "insurance_policy_valid",
          true
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_type_correct",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_type_correct",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_policy_type",
            1
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "AND",
            [
              "EQ",
              "insurance_policy_type",
              1
            ],
            [
              "EQ",
              "insurance_policy_type_guarantee",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_policy_type",
            1
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_qualification_and_management_rules",
    "desc": "保險代理人、經紀人、公證人資格取得、申請許可條件及管理規則遵守",
    "expr": [
      "EQ",
      "agent_qualification_and_management_rules",
      [
        "AND",
        [
          "EQ",
          "qualification_conditions_met",
          true
        ],
        [
          "EQ",
          "application_procedure_followed",
          true
        ],
        [
          "EQ",
          "required_documents_submitted",
          true
        ],
        [
          "EQ",
          "board_and_manager_qualifications_met",
          true
        ],
        [
          "EQ",
          "dismissal_reasons_absent",
          true
        ],
        [
          "EQ",
          "branch_establishment_conditions_met",
          true
        ],
        [
          "EQ",
          "financial_and_business_management_compliant",
          true
        ],
        [
          "EQ",
          "education_and_training_compliant",
          true
        ],
        [
          "EQ",
          "license_revocation_procedures_compliant",
          true
        ],
        [
          "EQ",
          "other_mandatory_compliance_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_and_compliance",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permission_and_compliance",
      [
        "AND",
        [
          "EQ",
          "bank_permission_granted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_as_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_as_broker",
            true
          ]
        ],
        [
          "EQ",
          "agent_regulations_applied",
          true
        ],
        [
          "EQ",
          "broker_regulations_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duties",
    "desc": "保險經紀人應以善良管理人注意義務洽訂保險契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duties_complied",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_met",
          true
        ],
        [
          "EQ",
          "duty_of_fidelity_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_report_and_fee_disclosure",
    "desc": "保險經紀人洽訂保險契約前應主動提供書面分析報告並明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_disclosure_complied",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosure_made",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_management_rule_qualification",
    "desc": "代理人具備資格且無禁止情事，得以個人名義或受代理人公司或銀行任用執行業務",
    "expr": [
      "EQ",
      "agent_management_rule_qualification_met",
      [
        "AND",
        [
          "EQ",
          "agent_qualification_met",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_circumstances_present",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_and_bank_must_employ_agents",
    "desc": "代理人公司及銀行應任用代理人至少一人，並視業務規模及品質適當調整",
    "expr": [
      "EQ",
      "agent_company_and_bank_employment_compliant",
      [
        "AND",
        [
          "GE",
          "number_of_agents_employed",
          1
        ],
        [
          "EQ",
          "employment_adjusted_appropriately",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_registration_compliance",
    "desc": "依規定辦理許可登記並依法向公司登記主管機關辦理登記",
    "expr": [
      "EQ",
      "agent_registration_compliant",
      [
        "AND",
        [
          "EQ",
          "permission_registration_done",
          true
        ],
        [
          "EQ",
          "company_registration_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_exclusivity",
    "desc": "個人執業代理人及受代理人公司或銀行任用代理人不得同時受任於其他代理人公司、保險經紀人公司、公證人公司或銀行",
    "expr": [
      "EQ",
      "agent_exclusivity_complied",
      [
        "NOT",
        [
          "EQ",
          "agent_has_multiple_employers",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_contract_content",
    "desc": "保險代理合約內容應包括法定十二項目",
    "expr": [
      "EQ",
      "agent_contract_content_compliant",
      [
        "AND",
        [
          "EQ",
          "contract_party_names_included",
          true
        ],
        [
          "EQ",
          "contract_period_included",
          true
        ],
        [
          "EQ",
          "contract_authority_scope_included",
          true
        ],
        [
          "EQ",
          "commission_payment_standard_included",
          true
        ],
        [
          "EQ",
          "commission_payment_method_included",
          true
        ],
        [
          "EQ",
          "legal_compliance_clause_included",
          true
        ],
        [
          "EQ",
          "prohibited_acts_clause_included",
          true
        ],
        [
          "EQ",
          "conflict_of_interest_prevention_included",
          true
        ],
        [
          "EQ",
          "breach_of_contract_liability_included",
          true
        ],
        [
          "EQ",
          "dispute_resolution_clause_included",
          true
        ],
        [
          "EQ",
          "contract_termination_clause_included",
          true
        ],
        [
          "EQ",
          "financial_institution_account_included",
          true
        ],
        [
          "EQ",
          "other_mandated_items_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險投保、執業證照、保險種類、資格條件、管理規則、銀行許可、經紀人義務、代理人資格、代理人公司及銀行任用、登記、代理人排他性或合約內容規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_license_and_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_type_correct",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_qualification_and_management_rules",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_permission_and_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duties_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_report_and_fee_disclosure_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_management_rule_qualification_met",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_company_and_bank_employment_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_registration_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_exclusivity_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_contract_content_compliant",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]