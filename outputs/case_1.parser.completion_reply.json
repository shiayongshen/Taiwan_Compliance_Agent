[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行應建立內部控制及稽核制度並確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_audit_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_system_mandatory",
    "desc": "銀行應建立資產品質評估、損失準備提列、逾期放款催收及呆帳轉銷之內部處理制度及程序並確實執行",
    "expr": [
      "EQ",
      "bank:internal_handling_system_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_handling_system_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operating_system_mandatory",
    "desc": "銀行應訂定委託作業及衍生性金融商品業務之內部作業制度及程序並確實執行",
    "expr": [
      "EQ",
      "bank:internal_operating_system_mandatory",
      [
        "AND",
        [
          "EQ",
          "outsourcing_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "derivative_business_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "internal_operating_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_comprehensive_policies",
    "desc": "內部控制制度應涵蓋所有營運活動並訂定適當政策及作業程序",
    "expr": [
      "EQ",
      "bank:internal_control_comprehensive_policies",
      [
        "AND",
        [
          "EQ",
          "organization_rules_established",
          true
        ],
        [
          "EQ",
          "business_regulations_and_manuals_established",
          true
        ],
        [
          "EQ",
          "periodic_review_and_revision",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_organization_rules",
    "desc": "組織規程包括明確組織系統、單位職掌、業務範圍及授權分層負責辦法",
    "expr": [
      "EQ",
      "bank:internal_control_organization_rules",
      [
        "AND",
        [
          "EQ",
          "clear_organization_system",
          true
        ],
        [
          "EQ",
          "clear_unit_responsibilities",
          true
        ],
        [
          "EQ",
          "clear_business_scope",
          true
        ],
        [
          "EQ",
          "clear_authority_and_hierarchical_responsibility",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_business_regulations",
    "desc": "業務規範及處理手冊應包括投資準則、客戶資料保密、利害關係人交易規範、股權管理、財務報表管理等項目",
    "expr": [
      "EQ",
      "bank:internal_control_business_regulations",
      [
        "AND",
        [
          "EQ",
          "investment_guidelines_established",
          true
        ],
        [
          "EQ",
          "customer_data_confidentiality_established",
          true
        ],
        [
          "EQ",
          "related_party_transaction_regulations_established",
          true
        ],
        [
          "EQ",
          "equity_management_established",
          true
        ],
        [
          "EQ",
          "financial_statement_management_established",
          true
        ],
        [
          "EQ",
          "general_affairs_information_personnel_management_established",
          true
        ],
        [
          "EQ",
          "external_information_disclosure_management_established",
          true
        ],
        [
          "EQ",
          "financial_inspection_report_management_established",
          true
        ],
        [
          "EQ",
          "financial_consumer_protection_management_established",
          true
        ],
        [
          "EQ",
          "major_incident_handling_mechanism_established",
          true
        ],
        [
          "EQ",
          "anti_money_laundering_and_counter_terrorism_financing_established",
          true
        ],
        [
          "EQ",
          "other_business_regulations_and_procedures_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_additional_manuals",
    "desc": "銀行業務規範及處理手冊應包括出納、存款、匯兌、授信、外匯、新種金融商品及委外作業管理",
    "expr": [
      "EQ",
      "bank:internal_control_additional_manuals",
      [
        "AND",
        [
          "EQ",
          "cashier_management_included",
          true
        ],
        [
          "EQ",
          "deposit_management_included",
          true
        ],
        [
          "EQ",
          "remittance_management_included",
          true
        ],
        [
          "EQ",
          "credit_management_included",
          true
        ],
        [
          "EQ",
          "foreign_exchange_management_included",
          true
        ],
        [
          "EQ",
          "new_financial_products_management_included",
          true
        ],
        [
          "EQ",
          "outsourcing_management_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_subsidiary_management",
    "desc": "金融控股公司及銀行業應訂定子公司必要控制作業並督促子公司建立內部控制制度",
    "expr": [
      "EQ",
      "bank:internal_control_subsidiary_management",
      [
        "AND",
        [
          "EQ",
          "subsidiary_control_operations_established",
          true
        ],
        [
          "EQ",
          "subsidiary_internal_control_supervised",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_anti_money_laundering_group_plan",
    "desc": "應建立集團整體性防制洗錢及打擊資恐計畫及資訊分享政策程序",
    "expr": [
      "EQ",
      "bank:internal_control_anti_money_laundering_group_plan",
      [
        "AND",
        [
          "EQ",
          "group_anti_money_laundering_plan_established",
          true
        ],
        [
          "EQ",
          "group_information_sharing_policy_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policy_revision_participation",
    "desc": "作業及管理規章訂定修訂廢止應有法令遵循、內部稽核及風險管理單位參與",
    "expr": [
      "EQ",
      "bank:internal_control_policy_revision_participation",
      [
        "AND",
        [
          "EQ",
          "legal_compliance_participation",
          true
        ],
        [
          "EQ",
          "internal_audit_participation",
          true
        ],
        [
          "EQ",
          "risk_management_participation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_control_and_audit",
    "desc": "未依規定建立或執行內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序視為違反",
    "expr": [
      "EQ",
      "bank:violation_internal_control_and_audit",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "internal_audit_established",
            true
          ],
          [
            "EQ",
            "internal_handling_system_established",
            true
          ],
          [
            "EQ",
            "internal_operating_system_established",
            true
          ],
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  }
]