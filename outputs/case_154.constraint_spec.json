      [
        "AND",
        [
          "EQ",
          "violation_163_4_7_165_1_163_5",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "correction_order_issued",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:severe_violation",
