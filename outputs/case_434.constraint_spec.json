[
  {
    "id": "securities:investment_decision_recorded",
    "desc": "投資決定依據分析作成且交付執行時有紀錄",
    "expr": [
      "EQ",
      "investment_decision_recorded",
      [
        "AND",
        [
          "EQ",
          "investment_decision_based_on_analysis",
          true
        ],
        [
          "EQ",
          "execution_recorded",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:monthly_review_submitted",
    "desc": "按月提出檢討",
    "expr": [
      "EQ",
      "monthly_review_submitted",
      [
        "EQ",
        "monthly_review_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_defined_and_executed",
    "desc": "內部控制制度訂定且確實執行，控制作業留存紀錄並保存期限符合規定",
    "expr": [
      "EQ",
      "internal_control_defined_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_defined",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "control_operation_recorded",
          true
        ],
        [
          "GE",
          "control_record_retention_period_years",
          "regulator_defined_min_years"
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_qualification_compliant",
    "desc": "人員資格條件、行為規範、訓練、登記期限及程序符合主管機關規定",
    "expr": [
      "EQ",
      "personnel_qualification_compliant",
      [
        "AND",
        [
          "EQ",
          "personnel_qualification_met",
          true
        ],
        [
          "EQ",
          "personnel_behavior_compliant",
          true
        ],
        [
          "EQ",
          "personnel_training_completed",
          true
        ],
        [
          "EQ",
          "personnel_registration_valid",
          true
        ],
        [
          "EQ",
          "personnel_procedures_followed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_penalty_conditions",
    "desc": "違反本法或主管機關命令者處分條件",
    "expr": [
      "EQ",
      "violation_penalty_conditions",
      [
        "OR",
        [
          "EQ",
          "violation_of_law",
          true
        ],
        [
          "EQ",
          "violation_of_regulator_orders",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_misconduct",
    "desc": "董事、監察人、經理人或受僱人有違反法令且影響業務正常執行之行為",
    "expr": [
      "EQ",
      "personnel_misconduct",
      [
        "AND",
        [
          "EQ",
          "personnel_violated_law",
          true
        ],
        [
          "EQ",
          "personnel_behavior_affects_business",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_for_personnel_misconduct",
