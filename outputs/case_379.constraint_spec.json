[
  {
    "id": "fhc:shareholding_over_10_percent_declaration_at_conversion",
    "desc": "金融機構轉換為金融控股公司時，同一人或同一關係人持股超過10%應申報",
    "expr": [
      "EQ",
      "shareholding_over_10_percent_declaration_at_conversion",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent_at_conversion",
          10.0
        ],
        [
          "EQ",
          "declaration_made_at_conversion",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_5_percent_declaration_after_establishment",
    "desc": "金融控股公司設立後，同一人或同一關係人持股超過5%應10日內申報",
    "expr": [
      "EQ",
      "shareholding_over_5_percent_declaration_after_establishment",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent_after_establishment",
          5.0
        ],
        [
          "LE",
          "days_since_shareholding_over_5_percent",
          10
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_accumulated_change_over_1_percent_declaration",
    "desc": "持股超過5%後累積增減逾1%應申報",
    "expr": [
      "EQ",
      "shareholding_accumulated_change_over_1_percent_declaration",
      [
        "IMPLIES",
        [
          "AND",
          [
            "GT",
            "shareholding_percent_after_establishment",
            5.0
          ],
          [
            "GT",
            [
              "ABS",
              "shareholding_percent_change_since_last_declaration"
            ],
            1.0
          ]
        ],
        [
          "EQ",
          "declaration_made_for_accumulated_change",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_threshold_prior_approval_10_25_50",
    "desc": "持股超過10%、25%、50%應事先申請核准",
    "expr": [
      "EQ",
      "shareholding_over_threshold_prior_approval",
      [
        "IMPLIES",
        [
          "OR",
          [
            "GT",
            "shareholding_percent_intended",
            50.0
          ],
          [
            "GT",
            "shareholding_percent_intended",
            25.0
          ],
          [
            "GT",
            "shareholding_percent_intended",
            10.0
          ]
        ],
        [
          "EQ",
          "prior_approval_obtained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:trust_and_agreement_included_in_related_person",
    "desc": "第三人以信託、委任等方式持股應併入同一關係人範圍",
    "expr": [
      "EQ",
      "trust_and_agreement_included_in_related_person",
      [
        "EQ",
        "related_person_includes_trust_and_agreement",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_10_percent_pledge_restriction",
    "desc": "持股超過10%不得設定質權予子公司，例外於轉換前原質權存續期限內",
    "expr": [
      "EQ",
      "shareholding_over_10_percent_pledge_restriction",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent",
          10.0
        ],
        [
          "OR",
          [
            "AND",
            [
              "EQ",
              "pledge_to_subsidiary",
              false
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "pledge_to_subsidiary",
              true
            ],
            [
              "EQ",
              "pledge_obtained_before_conversion",
              true
            ],
            [
              "EQ",
              "pledge_within_original_term",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_eligibility_condition",
    "desc": "同一人或同一關係人申請核准應符合主管機關定適格條件",
    "expr": [
      "EQ",
      "shareholding_eligibility_condition",
      [
        "EQ",
        "eligibility_conditions_met",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_no_increase_if_not_eligible",
    "desc": "不符適格條件者得繼續持有但不得增加持股",
    "expr": [
      "EQ",
      "shareholding_no_increase_if_not_eligible",
      [
        "IMPLIES",
        [
          "EQ",
          "eligibility_conditions_met",
          false
        ],
        [
          "LE",
          "shareholding_percent_change",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:approval_deemed_if_no_objection_within_15_business_days",
    "desc": "主管機關15營業日內未反對視為核准",
    "expr": [
      "EQ",
      "approval_deemed_if_no_objection_within_15_business_days",
      [
        "IMPLIES",
        [
          "GE",
          "days_since_application_received",
          15
        ],
        [
          "EQ",
          "objection_made",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_5_to_10_percent_declaration_before_2009",
    "desc": "修正施行前持股5%至10%者應於6個月內申報",
    "expr": [
      "EQ",
      "shareholding_5_to_10_percent_declaration_before_2009",
      [
        "IMPLIES",
        [
          "AND",
          [
            "GE",
            "shareholding_percent_before_2009",
            5.0
          ],
          [
            "LE",
            "shareholding_percent_before_2009",
            10.0
          ],
          [
            "LT",
            "date_of_shareholding",
            "2009-01-01"
          ]
        ],
        [
          "LE",
          "days_since_2009_revision",
          180
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_declaration_required",
    "desc": "未依規定申報或未經核准持股者，其超過部分無表決權且須限期處分",
    "expr": [
      "EQ",
      "shareholding_declaration_required",
      [
        "IMPLIES",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "shareholding_over_5_percent_declaration_after_establishment",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "shareholding_5_to_10_percent_declaration_before_2009",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "shareholding_over_threshold_prior_approval",
              true
            ]
          ]
        ],
        [
          "EQ",
          "excess_shares_no_voting_right",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_6_1_not_applied_for_establishment",
    "desc": "違反第六條第一項規定，未申請設立金融控股公司",
    "expr": [
      "EQ",
      "violation_6_1_not_applied_for_establishment",
      [
        "EQ",
        "applied_for_establishment",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16_3_no_approval",
    "desc": "違反第十六條第三項規定，未經主管機關核准而持有股份",
    "expr": [
      "EQ",
      "violation_16_3_no_approval",
      [
        "AND",
        [
          "GT",
          "shareholding_percent",
          0.0
        ],
        [
          "NOT",
          [
            "EQ",
            "prior_approval_obtained",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16_1_2_9_no_declaration_or_increase",
    "desc": "違反第十六條第一、二、九項規定未申報或違反第七項但書規定增加持股",
    "expr": [
      "EQ",
      "violation_16_1_2_9_no_declaration_or_increase",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "shareholding_over_10_percent_declaration_at_conversion",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_over_5_percent_declaration_after_establishment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_5_to_10_percent_declaration_before_2009",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "eligibility_conditions_met",
            false
          ],
          [
            "GT",
            "shareholding_percent_change",
            0.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16_10_not_dispose_in_time",
    "desc": "違反第十六條第十項規定，未依主管機關所定期限處分",
    "expr": [
      "EQ",
      "violation_16_10_not_dispose_in_time",
      [
        "NOT",
        [
          "EQ",
          "disposed_excess_shares_in_time",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16_5_reporting_announcement",
    "desc": "違反第十六條第五項所定辦法中有關申報或公告之規定",
    "expr": [
      "EQ",
      "violation_16_5_reporting_announcement",
      [
        "NOT",
        [
          "EQ",
          "reporting_and_announcement_compliant",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16_6_pledge_prohibition",
    "desc": "違反第十六條第六項規定，為質權之設定",
    "expr": [
      "EQ",
      "violation_16_6_pledge_prohibition",
      [
        "EQ",
        "pledge_to_subsidiary",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融控股公司法第16條及第60條相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_6_1_not_applied_for_establishment",
          true
        ],
        [
          "EQ",
          "violation_16_3_no_approval",
          true
        ],
        [
          "EQ",
          "violation_16_1_2_9_no_declaration_or_increase",
          true
        ],
        [
          "EQ",
          "violation_16_10_not_dispose_in_time",
          true
        ],
        [
          "EQ",
          "violation_16_5_reporting_announcement",
          true
        ],
        [
          "EQ",
          "violation_16_6_pledge_prohibition",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]