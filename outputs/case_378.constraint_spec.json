[
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            0.25
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            0.25
          ],
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.0
          ],
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.5
          ]
        ],
        2,
        [
          "GE",
          [
            "DIV",
            "own_capital",
            "risk_capital"
          ],
          1.5
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_ratio_minimum_met",
    "desc": "自有資本與風險資本比率及淨值比率均不低於最低標準",
    "expr": [
      "EQ",
      "capital_ratio_minimum_met",
      [
        "AND",
        [
          "GE",
          [
            "DIV",
            "own_capital",
            "risk_capital"
          ],
          0.25
        ],
        [
          "GE",
          "net_worth_ratio",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reporting_annual_compliance",
    "desc": "每營業年度終了後三個月內申報經會計師查核之資本適足率及淨值比率",
    "expr": [
      "EQ",
      "reporting_annual_compliance",
      [
        "AND",
        [
          "EQ",
          "annual_report_submitted",
          true
        ],
        [
          "EQ",
          "annual_report_audited",
          true
        ],
        [
          "LE",
          "annual_report_submission_days",
          90
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reporting_semiannual_compliance",
    "desc": "每半營業年度終了後二個月內申報經會計師核閱之資本適足率及經會計師查核之淨值比率",
    "expr": [
      "EQ",
      "reporting_semiannual_compliance",
      [
        "AND",
        [
          "EQ",
          "semiannual_report_submitted",
          true
        ],
        [
          "EQ",
          "semiannual_report_reviewed",
          true
        ],
        [
          "EQ",
          "semiannual_report_audited_net_worth",
          true
        ],
        [
          "LE",
          "semiannual_report_submission_days",
          60
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reporting_exemption",
    "desc": "依法接管之保險業不適用申報規定",
    "expr": [
      "EQ",
      "reporting_exemption",
      [
        "EQ",
        "under_supervision",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reporting_compliance",
    "desc": "申報符合規定（申報合規或依法接管免申報）",
    "expr": [
      "EQ",
      "reporting_compliance",
      [
        "OR",
        "reporting_exemption",
        [
          "AND",
          "reporting_annual_compliance",
          "reporting_semiannual_compliance"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本比率低於最低標準或未依規定申報時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "capital_ratio_minimum_met",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "reporting_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]