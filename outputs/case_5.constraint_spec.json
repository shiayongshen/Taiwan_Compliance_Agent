[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_established",
          true
        ],
        [
          "EQ",
          "outsourcing_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "derivative_business_internal_procedures_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_unit_mandatory",
    "desc": "銀行應設置獨立專責風險控管單位並定期向董監事會報告",
    "expr": [
      "EQ",
      "bank:risk_control_unit_mandatory",
      [
        "AND",
        [
          "EQ",
          "independent_risk_control_unit_established",
          true
        ],
        [
          "EQ",
          "risk_control_reported_to_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_principles",
    "desc": "銀行風險控管機制應包含資本適足性監控、流動性風險管理、資產配置、資產品質評估及資訊安全防護",
    "expr": [
      "EQ",
      "bank:risk_control_mechanism_principles",
      [
        "AND",
        [
          "EQ",
          "capital_adequacy_monitored",
          true
        ],
        [
          "EQ",
          "liquidity_risk_management_established",
          true
        ],
        [
          "EQ",
          "asset_allocation_risk_management_established",
          true
        ],
        [
          "EQ",
          "asset_quality_and_loss_provisioning_established",
          true
        ],
        [
          "EQ",
          "information_security_and_emergency_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_unit_duties",
    "desc": "法令遵循單位應建立法令傳達系統、更新作業規章、出具法令遵循意見、訂定評估程序、施行法規訓練及督導執行",
    "expr": [
      "EQ",
      "bank:law_compliance_unit_duties",
      [
        "AND",
        [
          "EQ",
          "law_regulation_communication_system_established",
          true
        ],
        [
          "EQ",
          "operation_rules_updated_timely",
          true
        ],
        [
          "EQ",
          "law_compliance_opinion_issued",
          true
        ],
        [
          "EQ",
          "law_compliance_evaluation_procedure_established",
          true
        ],
        [
          "EQ",
          "law_regulation_training_conducted",
          true
        ],
        [
          "EQ",
          "law_compliance_implementation_supervised",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_foreign_units_supervision",
    "desc": "法令遵循單位應督導國外營業單位執行法令遵循及風險評估",
    "expr": [
      "EQ",
      "bank:law_compliance_foreign_units_supervision",
      [
        "AND",
        [
          "EQ",
          "foreign_units_financial_regulations_collected",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_self_assessment",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_supervisor_qualified",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_risk_monitoring_mechanism_established",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_external_verification_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_self_assessment_frequency",
    "desc": "法令遵循自行評估每半年至少辦理一次，並保存資料五年",
    "expr": [
      "AND",
      [
        "GE",
        "law_compliance_self_assessment_frequency_per_year",
        2
      ],
      [
        "GE",
        "law_compliance_self_assessment_data_retention_years",
        5
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_staff_qualification",
    "desc": "銀行辦理衍生性金融商品業務人員具備專業資格條件之一",
    "expr": [
      "EQ",
      "bank:derivative_business_staff_qualified",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_business_license_held",
          true
        ],
        [
          "GE",
          "derivative_business_internship_years",
          1
        ],
        [
          "GE",
          "derivative_business_experience_months",
          6
        ],
        [
          "AND",
          [
            "EQ",
            "structural_product_staff",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "derivative_business_license_held",
              true
            ],
            [
              "EQ",
              "structural_product_sales_exam_passed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_business_permit",
    "desc": "銀行辦理外匯業務應依規定申請許可或完成備查程序",
    "expr": [
      "EQ",
      "bank:foreign_exchange_business_permit",
      [
        "OR",
        [
          "EQ",
          "foreign_exchange_business_permit_obtained",
          true
        ],
        [
          "EQ",
          "foreign_exchange_business_filing_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_derivative_business_permit",
    "desc": "指定銀行辦理外匯衍生性商品業務應依類別申請許可或完成備查",
    "expr": [
      "EQ",
      "bank:foreign_exchange_derivative_business_permit",
      [
        "AND",
        [
          "EQ",
          "foreign_exchange_derivative_business_permit_obtained",
          true
        ],
        [
          "EQ",
          "foreign_exchange_derivative_business_reporting_compliant",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_client_qualification",
    "desc": "專業客戶資格符合銀行辦理衍生性金融商品業務應注意事項",
    "expr": [
      "EQ",
      "bank:professional_client_qualified",
      [
        "OR",
        [
          "EQ",
          "professional_institution_investor",
          true
        ],
        [
          "GT",
          "latest_audited_total_assets",
          50000000.0
        ],
        [
          "AND",
          [
            "OR",
            [
              "GE",
              "financial_capacity_ntd",
              30000000.0
            ],
            [
              "AND",
              [
                "GT",
                "single_transaction_amount_ntd",
                3000000.0
              ],
              [
                "GT",
                "total_deposit_and_investment_ntd",
                15000000.0
              ],
              [
                "GE",
                "financial_capacity_declaration_ntd",
                30000000.0
              ]
            ]
          ],
          [
            "EQ",
            "financial_knowledge_or_experience",
            true
          ],
          [
            "EQ",
            "signed_professional_client_agreement",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "trust_contract_signed",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "professional_client_qualification_type2",
              true
            ],
            [
              "EQ",
              "professional_client_qualification_type3",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_composition_elements",
    "desc": "內部控制制度應包含控制環境、風險評估、控制作業、資訊與溝通及監督作業五大組成要素",
