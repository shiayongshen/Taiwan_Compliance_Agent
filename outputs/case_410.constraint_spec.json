    "expr": [
      "EQ",
      "insider_trading_restriction",
      [
        "NOT",
        [
          "EQ",
          "engage_restricted_stock_derivative_trading",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:insider_trading_declaration",
