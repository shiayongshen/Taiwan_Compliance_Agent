            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_use_client_account",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_delegate_or_transfer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_illegal_order_transfer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_no_reason_investment_decision",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_other_harmful_behavior",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
