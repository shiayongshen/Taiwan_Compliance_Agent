[
  {
    "id": "securities:violation_penalty_level",
    "desc": "主管機關依違反法令情節輕重決定處分等級（1=警告,2=解除職務,3=停止募集或新增業務,4=停業,5=廢止營業許可,6=其他處置）",
    "expr": [
      "EQ",
      "violation_penalty_level",
      [
        "CASE",
        [
          "EQ",
          "violation_warning",
          true
        ],
        1,
        [
          "EQ",
          "violation_dismiss_officer",
          true
        ],
        2,
        [
          "EQ",
          "violation_suspend_fund_or_business",
          true
        ],
        3,
        [
          "EQ",
          "violation_suspend_operation",
          true
        ],
        4,
        [
          "EQ",
          "violation_revoke_license",
          true
        ],
        5,
        [
          "EQ",
          "violation_other_measures",
          true
        ],
        6,
        0
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_warning",
    "desc": "違反法令情節輕重達警告標準",
    "expr": [
      "EQ",
      "violation_warning",
      [
        "EQ",
        "violation_level_warning",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_dismiss_officer",
    "desc": "違反法令情節輕重達解除董事、監察人或經理人職務標準",
    "expr": [
      "EQ",
      "violation_dismiss_officer",
      [
        "EQ",
        "violation_level_dismiss_officer",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_suspend_fund_or_business",
    "desc": "違反法令情節輕重達停止募集或新增受託業務標準",
    "expr": [
      "EQ",
      "violation_suspend_fund_or_business",
      [
        "EQ",
        "violation_level_suspend_fund_or_business",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_suspend_operation",
    "desc": "違反法令情節輕重達停業標準",
    "expr": [
      "EQ",
      "violation_suspend_operation",
      [
        "EQ",
        "violation_level_suspend_operation",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_revoke_license",
    "desc": "違反法令情節輕重達廢止營業許可標準",
    "expr": [
      "EQ",
      "violation_revoke_license",
      [
        "EQ",
        "violation_level_revoke_license",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_other_measures",
    "desc": "違反法令情節輕重達其他必要處置標準",
    "expr": [
      "EQ",
      "violation_other_measures",
      [
        "EQ",
        "violation_level_other_measures",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_violation_affect_business",
    "desc": "董事、監察人、經理人或受僱人違反法令且足以影響業務正常執行",
    "expr": [
      "EQ",
      "personnel_violation_affect_business",
      [
        "EQ",
        "personnel_violation",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_violation_penalty",
    "desc": "主管機關命令停止執行業務或解除職務",
    "expr": [
      "EQ",
      "personnel_violation_penalty",
      [
        "OR",
        [
          "EQ",
          "order_stop_business_within_one_year",
          true
        ],
        [
          "EQ",
          "order_dismiss_personnel",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_fine_and_improvement",
    "desc": "違反第111條規定之違法行為",
    "expr": [
      "EQ",
      "violation_111",
      [
        "OR",
        [
          "EQ",
          "violate_unapproved_business",
          true
        ],
        [
          "EQ",
          "violate_investment_scope_limit_14_1_18_1_56_1",
          true
        ],
        [
          "EQ",
          "violate_investment_scope_limit_16_4",
          true
        ],
        [
          "EQ",
          "violate_16_1_19_1_51_1_59",
          true
        ],
        [
          "EQ",
          "violate_diversification_58_2",
          true
        ],
        [
          "EQ",
          "operate_without_license_63_1",
          true
        ],
        [
          "EQ",
          "violate_behavior_rules_69",
          true
        ],
        [
          "EQ",
          "violate_restriction_rules_70",
          true
        ],
        [
          "EQ",
          "violate_branch_establishment_72_1",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:fine_imposed",
    "desc": "違反第111條規定處罰罰鍰並責令限期改善",
    "expr": [
      "EQ",
      "fine_imposed",
      [
        "AND",
        [
          "EQ",
          "violation_111",
          true
        ],
        [
          "EQ",
          "improvement_ordered",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:fine_double_penalty",
    "desc": "屆期不改善按次處二倍至五倍罰鍰",
    "expr": [
      "EQ",
      "fine_double_penalty",
      [
        "AND",
        [
          "EQ",
          "improvement_ordered",
          true
        ],
        [
          "EQ",
          "improvement_not_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:fiduciary_duty_compliance",
    "desc": "負責人及業務人員遵守善良管理人注意義務及忠實義務",
    "expr": [
      "EQ",
      "fiduciary_duty_compliance",
      [
        "EQ",
        "duty_of_care_and_loyalty",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors",
    "desc": "負責人及業務人員未有禁止行為",
    "expr": [
      "EQ",
      "no_prohibited_behavior",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "leak_confidential_info",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "self_dealing_or_relative_trading",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fraudulent_behavior",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "not_return_commission_to_fund",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "provide_special_benefits_to_promote",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sell_proxy_votes_for_benefits",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "manipulate_market_price",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "transfer_orders_to_other_accounts",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "public_recommendation_or_forecast",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "use_nonprofessional_to_recruit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unreasonable_commission",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_as_agent_except_legal_agent",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_harmful_behavior",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_obligation",
    "desc": "負責人及業務人員保守受益人及客戶資料秘密",
    "expr": [
      "EQ",
      "confidentiality_obligation",
