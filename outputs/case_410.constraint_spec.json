            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insider_trading_relation_definition",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "full_discretion_prohibited_behavior_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
