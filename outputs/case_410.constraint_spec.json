  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令或命令，或違反人員義務，或違反第111條規定，或未遵守禁止行為及申報義務時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
