[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "internal_handling_system_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_executed",
          true
        ],
        [
          "EQ",
          "internal_operation_system_established",
          true
        ],
        [
          "EQ",
          "internal_operation_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_financial_product_staff_qualification",
    "desc": "銀行辦理衍生性金融商品業務人員具備專業資格條件",
    "expr": [
      "EQ",
      "bank:derivative_financial_product_staff_qualification",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_business_license",
          true
        ],
        [
          "GE",
          "derivative_internship_years",
          1
        ],
        [
          "GE",
          "derivative_work_experience_months",
          6
        ],
        [
          "AND",
          [
            "EQ",
            "is_structured_product_staff",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "derivative_business_license",
              true
            ],
            [
              "EQ",
              "passed_structured_product_exam",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_business_permit",
    "desc": "銀行辦理外匯業務應依規定申請許可或完成備查",
    "expr": [
      "EQ",
      "bank:foreign_exchange_business_permit",
      [
        "OR",
        [
          "EQ",
          "foreign_exchange_permit_obtained",
          true
        ],
        [
          "EQ",
          "foreign_exchange_filing_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_derivative_business_permit",
    "desc": "指定銀行辦理外匯衍生性商品業務應依類別申請許可或完成備查",
    "expr": [
      "EQ",
      "bank:foreign_exchange_derivative_business_permit",
      [
        "OR",
        [
          "EQ",
          "foreign_exchange_derivative_permit_obtained",
          true
        ],
        [
          "EQ",
          "foreign_exchange_derivative_filing_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:independent_risk_control_unit_established",
    "desc": "銀行設置獨立專責風險控管單位並定期向董監事會報告",
    "expr": [
      "EQ",
      "bank:independent_risk_control_unit_established",
      [
        "AND",
        [
          "EQ",
          "independent_risk_control_unit_established",
          true
        ],
        [
          "EQ",
          "risk_control_report_to_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_compliance",
    "desc": "銀行風險控管機制符合規定原則",
    "expr": [
      "EQ",
      "bank:risk_control_mechanism_compliance",
      [
        "AND",
        [
          "EQ",
          "capital_adequacy_monitored",
          true
        ],
        [
          "EQ",
          "liquidity_management_mechanism_established",
          true
        ],
        [
          "EQ",
          "asset_allocation_and_risk_management_established",
          true
        ],
        [
          "EQ",
          "asset_quality_and_loss_provisioning_established",
          true
        ],
        [
          "EQ",
          "information_security_and_emergency_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_composition_elements",
    "desc": "銀行內部控制制度包含控制環境、風險評估、控制作業、資訊與溝通、監督作業等組成要素",
    "expr": [
      "EQ",
      "bank:internal_control_composition_elements",
      [
        "AND",
        [
          "EQ",
          "control_environment_established",
          true
        ],
        [
          "EQ",
          "risk_assessment_established",
          true
        ],
        [
          "EQ",
          "control_activities_established",
          true
        ],
        [
          "EQ",
          "information_and_communication_established",
          true
        ],
        [
          "EQ",
          "monitoring_activities_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policies_and_procedures",
    "desc": "銀行內部控制制度訂定並適時檢討組織規程、業務規範及處理手冊等政策及程序",
    "expr": [
      "EQ",
      "bank:internal_control_policies_and_procedures",
      [
        "AND",
        [
          "EQ",
          "organization_rules_established",
          true
        ],
        [
          "EQ",
          "business_regulations_and_manuals_established",
          true
        ],
        [
          "EQ",
          "policies_and_procedures_reviewed_and_updated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_unit_duties",
    "desc": "銀行法令遵循單位履行法令傳達、更新、評估、訓練及督導等職責",
    "expr": [
      "EQ",
      "bank:legal_compliance_unit_duties",
      [
        "AND",
        [
          "EQ",
          "legal_regulations_communication_established",
          true
        ],
        [
          "EQ",
          "regulations_updated_timely",
          true
        ],
        [
          "EQ",
          "legal_compliance_evaluation_and_supervision",
          true
        ],
        [
          "EQ",
          "legal_training_provided",
          true
        ],
        [
          "EQ",
          "legal_compliance_supervision_implemented",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_foreign_units_supervision",
    "desc": "銀行法令遵循單位督導國外營業單位執行法令遵循及風險監控",
    "expr": [
      "EQ",
      "bank:legal_compliance_foreign_units_supervision",
      [
        "AND",
        [
          "EQ",
          "foreign_units_financial_regulations_collected",
          true
        ],
        [
          "EQ",
          "foreign_units_legal_compliance_evaluated",
          true
        ],
        [
          "EQ",
          "foreign_units_legal_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "foreign_units_legal_compliance_risk_monitoring_effective",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_self_assessment_frequency",
    "desc": "銀行法令遵循自行評估每半年至少辦理一次並保存資料五年",
    "expr": [
      "EQ",
      "bank:legal_compliance_self_assessment_frequency",
      [
        "AND",
        [
          "GE",
          "legal_compliance_self_assessment_frequency_per_year",
          2
        ],
        [
          "GE",
          "legal_compliance_data_retention_years",
          5
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:board_must_notify_deregistration_on_director_removal",
    "desc": "主管機關解除董事、監察人職務時，應通知公司登記主管機關撤銷或廢止其登記",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "director_or_supervisor_removed",
        true
      ],
      [
        "EQ",
        "regulatory_authority_notified_deregistration",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:regulatory_authority_may_impose_sanctions",
    "desc": "主管機關得依違規情節輕重，對銀行為撤銷決議、停止業務、限制投資等處分",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "bank_violated_law_or_regulation",
        true
      ],
      [
        "OR",
        [
          "EQ",
          "sanction_revocation_of_meeting_resolution",
          true
        ],
        [
          "EQ",
          "sanction_partial_business_suspension",
          true
        ],
        [
          "EQ",
          "sanction_investment_restriction",
          true
        ],
        [
          "EQ",
          "sanction_asset_disposal_restriction",
          true
        ],
        [
          "EQ",
          "sanction_branch_closure_order",
          true
        ],
        [
          "EQ",
          "sanction_manager_or_staff_dismissal_or_suspension",
          true
        ],
        [
          "EQ",
          "sanction_director_or_supervisor_dismissal_or_suspension",
          true
        ],
        [
          "EQ",
          "sanction_mandatory_reserve_provision",
          true
        ],
        [
          "EQ",
          "sanction_other_necessary_measures",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:improvement_guidance_may_be_assigned",
    "desc": "主管機關得指定機構辦理銀行營運缺失之業務輔導",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "bank_operational_deficiency_identified",
        true
      ],
      [
        "EQ",
        "regulatory_authority_assigned_guidance",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有 constraint 成立則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_and_audit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:derivative_financial_product_staff_qualification",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_business_permit",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_derivative_business_permit",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:independent_risk_control_unit_established",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_mechanism_compliance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_composition_elements",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policies_and_procedures",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:legal_compliance_unit_duties",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:legal_compliance_foreign_units_supervision",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:legal_compliance_self_assessment_frequency",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:board_must_notify_deregistration_on_director_removal",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:regulatory_authority_may_impose_sanctions",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:improvement_guidance_may_be_assigned",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]