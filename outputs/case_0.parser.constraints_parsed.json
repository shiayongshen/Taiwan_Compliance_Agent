[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級依自有資本與風險資本比率及淨值比率劃分，依較低等級原則決定",
    "expr": [
      "EQ",
      "insurance:capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            150.0
          ],
          [
            "LT",
            "NWR",
            2.0
          ],
          [
            "GE",
            "NWR",
            0.0
          ],
          [
            "LT",
            "NWR_prev",
            2.0
          ],
          [
            "GE",
            "NWR_prev",
            0.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            150.0
          ],
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            200.0
          ]
        ],
        2,
        [
          "OR",
          [
            "AND",
            [
              "LT",
              "NWR",
              3.0
            ],
            [
              "LT",
              "NWR_prev",
              3.0
            ],
            [
              "GE",
              "NWR",
              2.0
            ],
            [
              "GE",
              "NWR_prev",
              2.0
            ]
          ],
          [
            "AND",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "own_capital",
                  "risk_capital"
                ],
                100.0
              ],
              200.0
            ],
            [
              "OR",
              [
                "GE",
                "NWR",
                3.0
              ],
              [
                "GE",
                "NWR_prev",
                3.0
              ]
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_ratio_minimum",
    "desc": "自有資本與風險資本比率不得低於最低一定比率（50%）",
    "expr": [
      "EQ",
      "insurance:capital_ratio_minimum",
      [
        "GE",
        [
          "MUL",
          [
            "DIV",
            "own_capital",
            "risk_capital"
          ],
          100.0
        ],
        50.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio_minimum",
    "desc": "淨值比率不得低於零",
    "expr": [
      "EQ",
      "insurance:net_worth_ratio_minimum",
      [
        "GE",
        "net_worth",
        0.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequacy_minimums",
    "desc": "資本適足率及淨值比率不得低於主管機關規定之最低比率",
    "expr": [
      "EQ",
      "insurance:capital_adequacy_minimums",
      [
        "AND",
        [
          "GE",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          200.0
        ],
        [
          "OR",
          [
            "GE",
            "NWR",
            3.0
          ],
          [
            "GE",
            "NWR_prev",
            3.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient_measures",
    "desc": "資本不足者應採取之監理措施",
    "expr": [
      "EQ",
      "insurance:capital_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          2
        ],
        [
          "AND",
          [
            "EQ",
            "plan_required",
            true
          ],
          [
            "EQ",
            "plan_submitted",
            true
          ],
          [
            "EQ",
            "plan_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significantly_insufficient_measures",
    "desc": "資本顯著不足者應採取之監理措施",
    "expr": [
      "EQ",
      "insurance:capital_significantly_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          3
        ],
        [
          "AND",
          [
            "EQ",
            "capital_insufficient_measures",
            true
          ],
          [
            "EQ",
            "remove_responsible_person",
            true
          ],
          [
            "EQ",
            "notify_authority_cancel_registration",
            true
          ],
          [
            "EQ",
            "suspend_responsible_person_duties",
            true
          ],
          [
            "EQ",
            "approval_required_for_asset_transactions",
            true
          ],
          [
            "EQ",
            "dispose_specific_assets",
            true
          ],
          [
            "EQ",
            "restrict_or_prohibit_related_party_transactions",
            true
          ],
          [
            "EQ",
            "reduce_responsible_person_compensation",
            true
          ],
          [
            "LE",
            "reduced_compensation",
            [
              "MUL",
              "average_compensation_last_12_months",
              0.7
            ]
          ],
          [
            "EQ",
            "restrict_branch_office_expansion_or_closure",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severely_insufficient_measures",
    "desc": "資本嚴重不足者應採取之處分措施",
    "expr": [
      "EQ",
      "insurance:capital_severely_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          4
        ],
        [
          "AND",
          [
            "EQ",
            "capital_significantly_insufficient_measures",
            true
          ],
          [
            "EQ",
            "apply_article_149_3_1",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  }
]