[
  {
    "id": "insurance:capital_adequacy_ratio",
    "desc": "資本適足率計算（自有資本／風險資本×100）",
    "expr": [
      "EQ",
      "insurance:capital_adequacy_ratio",
      [
        "MUL",
        [
          "DIV",
          "own_capital",
          "risk_capital"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio",
    "desc": "淨值比率計算（業主權益／不含投資型保險專設帳簿之資產總額×100）",
    "expr": [
      "EQ",
      "insurance:net_worth_ratio",
      [
        "MUL",
        [
          "DIV",
          "owner_equity",
          "total_assets_excluding_investment_insurance"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級依自有資本與風險資本比率及淨值比率劃分，依低等級原則決定",
    "expr": [
      "EQ",
      "insurance:capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "insurance:capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "owner_equity",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "insurance:capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "insurance:capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "insurance:net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "insurance:net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "insurance:capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "insurance:capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "AND",
          [
            "LT",
            "insurance:net_worth_ratio",
            3.0
          ],
          [
            "LT",
            "insurance:net_worth_ratio_prev",
            3.0
          ],
          [
            "GE",
            "insurance:net_worth_ratio",
            2.0
          ],
          [
            "GE",
            "insurance:net_worth_ratio_prev",
            2.0
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            "insurance:capital_adequacy_ratio",
            200.0
          ],
          [
            "OR",
            [
              "GE",
              "insurance:net_worth_ratio",
              3.0
            ],
            [
              "GE",
              "insurance:net_worth_ratio_prev",
              3.0
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequacy_minimum",
    "desc": "資本適足率不得低於一定比率（200%）",
    "expr": [
      "EQ",
      "insurance:capital_adequacy_minimum",
      [
        "GE",
        "insurance:capital_adequacy_ratio",
        200.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio_minimum",
    "desc": "淨值比率不得低於一定比率（3%）",
    "expr": [
      "EQ",
      "insurance:net_worth_ratio_minimum",
      [
        "OR",
        [
          "GE",
          "insurance:net_worth_ratio",
          3.0
        ],
        [
          "GE",
          "insurance:net_worth_ratio_prev",
          3.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequacy_and_net_worth_minimum",
    "desc": "資本適足率及淨值比率均不得低於一定比率",
    "expr": [
      "EQ",
      "insurance:capital_adequacy_and_net_worth_minimum",
      [
        "AND",
        [
          "GE",
          "insurance:capital_adequacy_ratio",
          200.0
        ],
        [
          "OR",
          [
            "GE",
            "insurance:net_worth_ratio",
            3.0
          ],
          [
            "GE",
            "insurance:net_worth_ratio_prev",
            3.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient_measures",
    "desc": "資本不足者應採取增資或改善計畫等措施",
    "expr": [
      "EQ",
      "insurance:capital_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          2
        ],
        [
          "AND",
          [
            "EQ",
            "capital_increase_plan_submitted",
            true
          ],
          [
            "EQ",
            "capital_increase_plan_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significantly_insufficient_measures",
    "desc": "資本顯著不足者應採取停止負責人職務、限制授信等措施",
    "expr": [
      "EQ",
      "insurance:capital_significantly_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          3
        ],
        [
          "AND",
          [
            "EQ",
            "capital_insufficient_measures",
            true
          ],
          [
            "EQ",
            "responsible_person_removed",
            true
          ],
          [
            "EQ",
            "responsible_person_suspended",
            true
          ],
          [
            "EQ",
            "special_asset_approval_required",
            true
          ],
          [
            "EQ",
            "special_asset_disposal_ordered",
            true
          ],
          [
            "EQ",
            "credit_restriction_with_related_parties",
            true
          ],
          [
            "LE",
            "responsible_person_compensation",
            [
              "MUL",
              "average_compensation_last_12_months",
              0.7
            ]
          ],
          [
            "EQ",
            "branch_office_restriction_or_closure",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severely_insufficient_measures",
    "desc": "資本嚴重不足者應採取主管機關規定之處分措施",
    "expr": [
      "EQ",
      "insurance:capital_severely_insufficient_measures",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance:capital_level",
          4
        ],
        [
          "EQ",
          "supervisory_disposition_149_3_1",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  }
]