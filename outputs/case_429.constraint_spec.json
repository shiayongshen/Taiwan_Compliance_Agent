            "bank_terminate_broker_business_approved",
            true
          ],
          [
            "EQ",
            "bank_broker_license_revoked",
            true
          ]
        ],
        [
          "EQ",
          "bank_cancel_broker_license_within_30_days",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:individual_broker_annual_training_hours",
    "desc": "個人執業經紀人每年平均參加在職教育訓練16小時以上，且換證前2年每年平均法令課程時數不低於8小時",
    "expr": [
      "EQ",
      "individual_broker_annual_training_hours",
      [
        "AND",
        [
          "GE",
          "individual_broker_avg_annual_training_hours",
          16.0
        ],
        [
          "GE",
          "individual_broker_avg_annual_law_course_hours_2years",
          8.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:compliance_officer_annual_training_hours",
    "desc": "法令遵循人員每年參加在職教育訓練15小時以上",
    "expr": [
      "EQ",
      "compliance_officer_annual_training_hours",
      [
        "GE",
        "compliance_officer_annual_training_hours_value",
        15.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_attend_and_pass_elderly_customer_training",
    "desc": "經紀人每年應參加並通過公平對待65歲以上客戶相關教育訓練2小時",
    "expr": [
      "EQ",
      "broker_must_attend_and_pass_elderly_customer_training",
      [
        "EQ",
        "broker_attended_and_passed_elderly_customer_training",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_or_bank_cancel_broker_elderly_customer_qualification_if_not_attend",
    "desc": "未依規定參加並通過該2小時教育訓練者，次年度不得對65歲以上客戶招攬保險商品，所屬經紀人公司或銀行應取消其資格",
    "expr": [
      "EQ",
      "broker_company_or_bank_cancel_broker_elderly_customer_qualification_if_not_attend",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "broker_attended_and_passed_elderly_customer_training",
            true
          ]
        ],
        [
          "EQ",
          "broker_elderly_customer_qualification_canceled_next_year",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_reinsurance_rate_compliance",
    "desc": "財產保險業承接再保險分入業務時，再保險費率應符合適足性及合理性並反映各項成本",
    "expr": [
      "EQ",
      "property_insurance_reinsurance_rate_compliance",
      [
        "EQ",
        "reinsurance_rate_adequate_and_reasonable",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_proportional_reinsurance_retention_rate_limit",
    "desc": "財產保險業以比例性再保險方式安排分出時，自留費率不得低於再保險費率及出單費率",
    "expr": [
      "EQ",
      "property_insurance_proportional_reinsurance_retention_rate_limit",
      [
        "AND",
        [
          "GE",
          "retention_rate",
          "reinsurance_rate"
        ],
        [
          "GE",
          "retention_rate",
          "ceding_commission_rate"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_nonproportional_reinsurance_rate_limit",
    "desc": "財產保險業以非比例性再保險方式安排分出時，各自留層費率不得低於高層費率及同層加權平均再保險費率",
    "expr": [
      "EQ",
      "property_insurance_nonproportional_reinsurance_rate_limit",
      [
        "AND",
        [
          "GE",
          "retention_layer_rate",
          "higher_layer_rate"
        ],
        [
          "GE",
          "retention_layer_rate",
          "weighted_avg_reinsurance_rate_same_layer"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_no_temporary_reinsurance_after_temporary_cession",
    "desc": "財產保險業原簽單業務安排臨時再保險分出後，不得以任何臨時再保或分保方式承接該分出風險，航空、核能及專屬再保險業務不在此限",
    "expr": [
      "EQ",
      "property_insurance_no_temporary_reinsurance_after_temporary_cession",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "temporary_cession_arranged",
            true
          ],
          [
            "NOT",
            [
              "OR",
              [
                "EQ",
                "aviation_insurance",
                true
              ],
              [
                "EQ",
                "nuclear_insurance",
                true
              ],
              [
                "EQ",
                "exclusive_reinsurance",
                true
              ]
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "temporary_reinsurance_accepted",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_reinsurance_rate_violation_penalty",
    "desc": "財產保險業未符合再保險費率適足性、合理性及比例性、非比例性費率限制者，依保險法第170條之一處分並由簽證精算人員於年度精算簽證報告中提出說明",
    "expr": [
      "EQ",
      "property_insurance_reinsurance_rate_violation_penalty",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "property_insurance_reinsurance_rate_compliance",
            true
          ],
          [
            "EQ",
            "property_insurance_proportional_reinsurance_retention_rate_limit",
            true
          ],
          [
            "EQ",
            "property_insurance_nonproportional_reinsurance_rate_limit",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
