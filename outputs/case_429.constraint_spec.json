[
  {
    "id": "insurance:agent_broker_not_permitted_without_license",
    "desc": "保險代理人、經紀人、公證人未經主管機關許可、未繳存保證金、未投保相關保險或未領執業證照不得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_not_permitted_without_license",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "license_permitted",
            true
          ],
          [
            "EQ",
            "deposit_guarantee",
            true
          ],
          [
            "EQ",
            "insurance_policy_subscribed",
            true
          ],
          [
            "EQ",
            "license_issued",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_policy_type_correct",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_policy_type_correct",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "is_agent_or_notary",
            true
          ],
          [
            "EQ",
            "insurance_policy_type",
            "liability_insurance"
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "insurance_policy_type",
              "liability_insurance"
            ],
            [
              "EQ",
              "insurance_policy_type_guarantee",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_duty_of_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_must_provide_written_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_report_stop_resume_dissolve",
    "desc": "經紀人公司停業、復業、解散應報主管機關核准並辦理登記",
    "expr": [
      "EQ",
      "broker_company_must_report_stop_resume_dissolve",
      [
        "OR",
        [
          "EQ",
          "broker_company_stop_reported",
          true
        ],
        [
          "EQ",
          "broker_company_resume_reported",
          true
        ],
        [
          "EQ",
          "broker_company_dissolve_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_period_limit_and_extension",
    "desc": "經紀人公司停業期間以一年為限，得申請一次展延，應於屆滿前十五日提出",
    "expr": [
      "EQ",
      "broker_company_stop_period_limit_and_extension",
      [
        "AND",
        [
          "LE",
          "broker_company_stop_period_days",
          365
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_stop_extension_applied",
            true
          ],
          [
            "LE",
            "broker_company_stop_extension_times",
            1
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_stop_period_expiring",
            true
          ],
          [
            "GE",
            "days_before_expiry_to_apply",
            15
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_reappoint_broker_on_resume",
    "desc": "經紀人公司停業屆滿未申請復業並依規定任用經紀人者，主管機關廢止許可並註銷執照",
    "expr": [
      "EQ",
      "broker_company_must_reappoint_broker_on_resume",
      [
        "IMPLIES",
        [
          "EQ",
          "broker_company_resume_applied",
          true
        ],
        [
          "EQ",
          "broker_reappointed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_cancel_broker_license_on_stop_or_dissolve",
    "desc": "經紀人公司停業或解散應繳銷所任用經紀人執業證照",
    "expr": [
      "EQ",
      "broker_company_must_cancel_broker_license_on_stop_or_dissolve",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_stop_applied",
            true
          ],
          [
            "EQ",
            "broker_license_cancelled",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_dissolve_applied",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "broker_license_cancelled",
              true
            ],
            [
              "EQ",
              "company_license_cancelled",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_cancel_license_within_30_days_after_company_stop_dissolve_or_license_revoked",
    "desc": "經紀人公司停業、解散或主管機關註銷許可後30日內，受任用經紀人應辦理執業證照註銷登記",
    "expr": [
      "EQ",
      "broker_must_cancel_license_within_30_days_after_company_stop_dissolve_or_license_revoked",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "broker_company_stop",
            true
          ],
          [
            "EQ",
            "broker_company_dissolve",
            true
          ],
          [
            "EQ",
            "broker_company_license_revoked",
            true
          ]
        ],
        [
          "LE",
          "days_since_event",
          30
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_must_report_stop_or_terminate_brokerage",
    "desc": "銀行申請暫停或終止兼營保險經紀業務應報主管機關核准",
    "expr": [
      "EQ",
      "bank_must_report_stop_or_terminate_brokerage",
      [
        "OR",
        [
          "EQ",
          "bank_stop_brokerage_reported",
          true
        ],
        [
          "EQ",
          "bank_terminate_brokerage_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_must_cancel_broker_license_on_stop_or_terminate",
    "desc": "銀行暫停兼營保險經紀業務應繳銷經紀人執業證照，終止應繳銷經紀人及兼營保險經紀業務執業證照",
    "expr": [
      "EQ",
      "bank_must_cancel_broker_license_on_stop_or_terminate",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "bank_stop_brokerage_applied",
            true
          ],
          [
            "EQ",
            "broker_license_cancelled",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "bank_terminate_brokerage_applied",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "broker_license_cancelled",
              true
            ],
            [
              "EQ",
              "brokerage_license_cancelled",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_cancel_license_within_30_days_after_bank_stop_terminate_or_license_revoked",
    "desc": "銀行暫停、終止兼營保險經紀業務或主管機關註銷許可後30日內，受任用經紀人應辦理執業證照註銷登記",
    "expr": [
      "EQ",
      "broker_must_cancel_license_within_30_days_after_bank_stop_terminate_or_license_revoked",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "bank_stop_brokerage",
            true
          ],
          [
            "EQ",
            "bank_terminate_brokerage",
            true
          ],
          [
            "EQ",
            "bank_brokerage_license_revoked",
            true
          ]
        ],
        [
          "LE",
          "days_since_event",
          30
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:individual_broker_training_hours",
    "desc": "個人執業經紀人每年平均參加在職教育訓練16小時以上，且前二年每年平均法令課程時數不低於8小時",
    "expr": [
      "EQ",
      "individual_broker_training_hours",
      [
        "AND",
        [
          "GE",
          "avg_annual_onjob_training_hours",
          16.0
        ],
        [
          "GE",
          "avg_annual_legal_training_hours_last_2_years",
          8.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:compliance_officer_training_hours",
    "desc": "法令遵循人員每年參加在職教育訓練15小時以上",
    "expr": [
      "EQ",
      "compliance_officer_training_hours",
      [
        "GE",
        "compliance_officer_training_hours",
        15.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:training_organization_approved",
    "desc": "教育訓練機構及內容須報主管機關核可",
    "expr": [
      "EQ",
      "training_organization_approved",
      [
        "EQ",
        "training_organization_approved_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_attend_and_pass_fair_treatment_training",
    "desc": "經紀人每年應參加並通過公平對待65歲以上客戶相關教育訓練2小時",
    "expr": [
      "EQ",
      "broker_must_attend_and_pass_fair_treatment_training",
      [
        "GE",
        "fair_treatment_training_hours_passed",
        2.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_restriction_if_not_attend_fair_treatment_training",
    "desc": "未依規定參加公平對待教育訓練者，次年度不得對65歲以上客戶招攬保險商品",
    "expr": [
      "EQ",
      "broker_restriction_if_not_attend_fair_treatment_training",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "broker_must_attend_and_pass_fair_treatment_training",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "allowed_to_solicit_65_plus",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_or_bank_must_cancel_broker_65_plus_qualification_if_training_not_met",
    "desc": "經紀人公司或銀行應取消未參加公平對待教育訓練經紀人次年度招攬65歲以上客戶資格",
    "expr": [
      "EQ",
      "broker_company_or_bank_must_cancel_broker_65_plus_qualification_if_training_not_met",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "broker_must_attend_and_pass_fair_treatment_training",
            true
          ]
        ],
        [
          "EQ",
          "broker_65_plus_qualification_cancelled",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_reinsurance_rate_compliance",
    "desc": "財產保險業承接再保險分入業務時，再保險費率應符合適足性及合理性並反映成本",
    "expr": [
      "EQ",
      "property_insurance_reinsurance_rate_compliance",
      [
        "EQ",
        "reinsurance_rate_adequate_and_reasonable",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_retention_rate_proportional_reinsurance",
    "desc": "財產保險業以比例性再保險分出時，自留費率不得低於再保險費率及出單費率",
    "expr": [
      "EQ",
      "property_insurance_retention_rate_proportional_reinsurance",
      [
        "AND",
        [
          "GE",
          "retention_rate",
          "reinsurance_rate"
        ],
        [
          "GE",
          "retention_rate",
          "policy_issuance_fee_rate"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_retention_rate_nonproportional_reinsurance",
    "desc": "財產保險業以非比例性再保險分出時，各自留層費率不得低於高層費率及同層加權平均再保險費率",
    "expr": [
      "EQ",
      "property_insurance_retention_rate_nonproportional_reinsurance",
      [
        "AND",
        [
          "GE",
          "retention_rate_layer",
          "higher_layer_rate"
        ],
        [
          "GE",
          "retention_rate_layer",
          "weighted_avg_reinsurance_rate_same_layer"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:property_insurance_original_policy_no_temporary_reinsurance",
    "desc": "財產保險業原簽單業務安排臨時再保險分出後，不得以臨時再保或分保方式承接該分出風險，航空、核能及專屬再保險業務除外",
    "expr": [
      "EQ",
      "property_insurance_original_policy_no_temporary_reinsurance",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              "aviation"
            ],
            [
              "EQ",
              "insurance_type",
              "nuclear"
            ],
            [
              "EQ",
              "insurance_type",
              "exclusive_reinsurance"
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "temporary_reinsurance_accepted",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
