        [
          "EQ",
          "bank_apply_stop_or_terminate_broker_business",
          true
        ],
        [
          "EQ",
          "bank_report_to_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
