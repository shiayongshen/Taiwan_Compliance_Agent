[
  {
    "id": "insurance:agent_broker_not_permitted_without_license_and_guarantee",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可、繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_not_permitted_without_license_and_guarantee",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "EQ",
          "guarantee_deposit_paid",
          true
        ],
        [
          "EQ",
          "related_insurance_purchased",
          true
        ],
        [
          "EQ",
          "license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_insurance_type_correct",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "related_insurance_type_correct",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "is_agent_or_notary",
            true
          ],
          [
            "EQ",
            "liability_insurance_purchased",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "liability_insurance_purchased",
              true
            ],
            [
              "EQ",
              "guarantee_insurance_purchased",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_license_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務洽訂保險契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fulfill_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_provide_written_analysis_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "broker_provide_written_analysis_report",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_finance_or_business_management_or_broker_rules",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定、同條第七項規定，或違反第165條第一項或第163條第五項準用規定",
    "expr": [
      "EQ",
      "violate_finance_or_business_management_or_broker_rules",
      [
        "OR",
        [
          "EQ",
          "violate_finance_management_rule",
          true
        ],
        [
          "EQ",
          "violate_business_management_rule",
          true
        ],
        [
          "EQ",
          "violate_broker_rule_163_7",
          true
        ],
        [
          "EQ",
          "violate_rule_165_1",
          true
        ],
        [
          "EQ",
          "violate_rule_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_report_stop_resume_dissolve",
    "desc": "經紀人公司停業、復業、解散應報主管機關核准並辦理登記",
    "expr": [
      "EQ",
      "broker_company_must_report_stop_resume_dissolve",
      [
        "OR",
        [
          "EQ",
          "broker_company_report_stop",
          true
        ],
        [
          "EQ",
          "broker_company_report_resume",
          true
        ],
        [
          "EQ",
          "broker_company_report_dissolve",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_period_limit_and_extension",
    "desc": "經紀人公司停業期間以一年為限，正當理由得申請一次展延，應於屆滿前十五日提出",
    "expr": [
      "EQ",
      "broker_company_stop_period_limit_and_extension",
      [
        "AND",
        [
          "LE",
          "broker_company_stop_period_days",
          365
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_stop_extension_applied",
            true
          ],
          [
            "EQ",
            "broker_company_stop_extension_once",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_stop_period_expiring_soon",
            true
          ],
          [
            "EQ",
            "broker_company_stop_extension_applied",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_cancel_license_if_stop_or_dissolve",
    "desc": "經紀人公司停業或解散應繳銷所任用經紀人執業證照及公司執業證照",
    "expr": [
      "EQ",
      "broker_company_must_cancel_license_if_stop_or_dissolve",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "broker_company_stop_applied",
            true
          ],
          [
            "EQ",
            "broker_company_dissolve_applied",
            true
          ]
        ],
        [
          "EQ",
          "broker_company_cancel_broker_license",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_company_dissolve_applied",
            true
          ],
          [
            "EQ",
            "broker_company_cancel_company_license",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_cancel_broker_license_with_revocation",
    "desc": "經紀人公司被主管機關註銷許可未辦理繳銷所任用經紀人執業證照者，應於三十日內委由公會辦理註銷登記",
    "expr": [
      "EQ",
      "broker_company_must_cancel_broker_license_with_revocation",
      [
        "IMPLIES",
        [
          "EQ",
          "broker_company_license_revoked",
          true
        ],
        [
          "EQ",
          "broker_company_cancel_broker_license_within_30_days",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_or_dissolve_or_revocation_must_cancel_broker_license",
    "desc": "經紀人公司停業、解散或主管機關註銷許可，未辦理繳銷所任用經紀人執業證照者，應於三十日內委由公會辦理註銷登記",
    "expr": [
      "EQ",
      "broker_company_stop_or_dissolve_or_revocation_must_cancel_broker_license",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "broker_company_stop",
            true
          ],
          [
            "EQ",
            "broker_company_dissolve",
            true
          ],
          [
            "EQ",
            "broker_company_license_revoked",
            true
          ]
        ],
        [
          "EQ",
          "broker_company_cancel_broker_license_within_30_days",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_apply_stop_or_terminate_broker_business_must_report",
    "desc": "銀行申請暫時停止或終止兼營保險經紀業務應報主管機關核准並檢具相關文件",
    "expr": [
      "EQ",
      "bank_apply_stop_or_terminate_broker_business_must_report",
      [
