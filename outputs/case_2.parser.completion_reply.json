[
  {
    "id": "fhc:capital_level",
    "desc": "金融控股公司子公司資本等級判定",
    "expr": [
      "EQ",
      "fhc:capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "insurance_capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "insurance_net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "insurance_capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "insurance_capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "insurance_net_worth",
            0.0
          ],
          [
            "LT",
            "insurance_net_worth",
            2.0
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              "insurance_capital_adequacy_ratio",
              150.0
            ],
            [
              "LT",
              "insurance_capital_adequacy_ratio",
              200.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              "insurance_net_worth",
              3.0
            ],
            [
              "LT",
              "insurance_net_worth_prev",
              3.0
            ],
            [
              "GE",
              "insurance_net_worth",
              2.0
            ],
            [
              "GE",
              "insurance_net_worth_prev",
              2.0
            ]
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            "insurance_capital_adequacy_ratio",
            200.0
          ],
          [
            "OR",
            [
              "GE",
              "insurance_net_worth",
              3.0
            ],
            [
              "GE",
              "insurance_net_worth_prev",
              3.0
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "fhc:accumulated_loss_exceeds_one_third",
    "desc": "金融控股公司累積虧損逾實收資本額三分之一",
    "expr": [
      "EQ",
      "fhc:accumulated_loss_exceeds_one_third",
      [
        "GT",
        "accumulated_loss",
        [
          "MUL",
          [
            "DIV",
            "paid_in_capital",
            3.0
          ],
          1.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:board_meeting_required",
    "desc": "累積虧損逾三分之一時須召開董事會並通知監察人",
    "expr": [
      "EQ",
      "fhc:board_meeting_required",
      [
        "EQ",
        "fhc:accumulated_loss_exceeds_one_third",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:report_to_authority_required",
    "desc": "累積虧損逾三分之一時須將董事會決議事項等函報主管機關",
    "expr": [
      "EQ",
      "fhc:report_to_authority_required",
      [
        "EQ",
        "fhc:accumulated_loss_exceeds_one_third",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_replenishment_ordered",
    "desc": "主管機關限期令金融控股公司補足資本",
    "expr": [
      "EQ",
      "fhc:capital_replenishment_ordered",
      [
        "EQ",
        "fhc:accumulated_loss_exceeds_one_third",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_replenishment_approved",
    "desc": "主管機關核准金融控股公司減資及增資以補足資本",
    "expr": [
      "EQ",
      "fhc:capital_replenishment_approved",
      [
        "AND",
        [
          "EQ",
          "capital_replenishment_reported_to_authority",
          true
        ],
        [
          "EQ",
          "capital_replenishment_approved_by_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_replenishment_process",
    "desc": "金融控股公司得以累積虧損減資及銷除股份並增資補足",
    "expr": [
      "EQ",
      "fhc:capital_replenishment_process",
      [
        "AND",
        [
          "EQ",
          "fhc:capital_replenishment_approved",
          true
        ],
        [
          "EQ",
          "capital_replenishment_includes_accumulated_loss",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_occurred",
    "desc": "金融控股公司違反法令、章程或有礙健全經營之虞",
    "expr": [
      "EQ",
      "fhc:violation_occurred",
      [
        "OR",
        [
          "EQ",
          "violate_law",
          true
        ],
        [
          "EQ",
          "violate_articles",
          true
        ],
        [
          "EQ",
          "impair_sound_operation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:regulatory_measures_required",
    "desc": "主管機關得予以糾正、限期改善及其他處分",
    "expr": [
      "EQ",
      "fhc:regulatory_measures_required",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_revoke_meeting_resolution",
    "desc": "撤銷法定會議之決議",
    "expr": [
      "EQ",
      "fhc:penalty_revoke_meeting_resolution",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_suspend_subsidiary_business",
    "desc": "停止子公司一部或全部業務",
    "expr": [
      "EQ",
      "fhc:penalty_suspend_subsidiary_business",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_remove_manager_or_staff",
    "desc": "解除經理人或職員職務",
    "expr": [
      "EQ",
      "fhc:penalty_remove_manager_or_staff",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_remove_director_or_supervisor",
    "desc": "解除董事、監察人職務或停止執行職務",
    "expr": [
      "EQ",
      "fhc:penalty_remove_director_or_supervisor",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_dispose_subsidiary_shares",
    "desc": "處分持有子公司股份",
    "expr": [
      "EQ",
      "fhc:penalty_dispose_subsidiary_shares",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_revoke_license",
    "desc": "廢止許可",
    "expr": [
      "EQ",
      "fhc:penalty_revoke_license",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_other_measures",
    "desc": "其他必要處置",
    "expr": [
      "EQ",
      "fhc:penalty_other_measures",
      [
        "EQ",
        "fhc:violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:notify_ministry_for_removal",
    "desc": "解除董事、監察人職務時通知經濟部廢止登記",
    "expr": [
      "EQ",
      "fhc:notify_ministry_for_removal",
      [
        "EQ",
        "fhc:penalty_remove_director_or_supervisor",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:dispose_shares_after_license_revocation",
    "desc": "廢止許可後限期處分持股及董事人數不符規定",
    "expr": [
      "EQ",
      "fhc:dispose_shares_after_license_revocation",
      [
        "EQ",
        "fhc:penalty_revoke_license",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:prohibit_use_name_and_company_change",
    "desc": "廢止許可後不得使用金融控股公司名稱及辦理公司變更登記",
    "expr": [
      "EQ",
      "fhc:prohibit_use_name_and_company_change",
      [
        "EQ",
        "fhc:penalty_revoke_license",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:liquidation_if_not_disposed_in_time",
    "desc": "未於期限內處分完成者，應解散及清算",
    "expr": [
      "EQ",
      "fhc:liquidation_if_not_disposed_in_time",
      [
        "AND",
        [
          "EQ",
          "fhc:penalty_revoke_license",
          true
        ],
        [
          "EQ",
          "not_disposed_in_time",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_capital_inadequate_or_deteriorated",
    "desc": "子公司資本適足率未達標或財務狀況顯著惡化",
    "expr": [
      "EQ",
      "fhc:subsidiary_capital_inadequate_or_deteriorated",
      [
        "OR",
        [
          "LT",
          "subsidiary_capital_adequacy_ratio",
          "minimum_capital_adequacy_ratio"
        ],
        [
          "EQ",
          "subsidiary_financial_condition_deteriorated",
          true
        ],
        [
          "EQ",
          "subsidiary_cannot_pay_debt",
          true
        ],
        [
          "EQ",
          "subsidiary_risk_to_depositors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:assist_subsidiary_recover",
    "desc": "金融控股公司應協助子公司回復正常營運",
    "expr": [
      "EQ",
      "fhc:assist_subsidiary_recover",
      [
        "EQ",
        "fhc:subsidiary_capital_inadequate_or_deteriorated",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:authority_order_assist_or_dispose",
    "desc": "主管機關得命金融控股公司履行協助義務或處分其他投資事業股份",
    "expr": [
      "EQ",
      "fhc:authority_order_assist_or_dispose",
      [
        "EQ",
        "fhc:subsidiary_capital_inadequate_or_deteriorated",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_adequacy_ratio_below_minimum",
    "desc": "金融控股公司合併基礎資本適足率低於主管機關規定",
    "expr": [
      "EQ",
      "fhc:capital_adequacy_ratio_below_minimum",
      [
        "LT",
        "fhc_consolidated_capital_adequacy_ratio",
        "fhc_minimum_capital_adequacy_ratio"
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:authority_measures_for_low_capital_adequacy",
    "desc": "主管機關得命增資、限制盈餘分配、停止或限制投資等處置",
    "expr": [
      "EQ",
      "fhc:authority_measures_for_low_capital_adequacy",
      [
        "EQ",
        "fhc:capital_adequacy_ratio_below_minimum",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "insurance:capital_adequacy_ratio",
    "desc": "保險業資本適足率計算公式",
    "expr": [
      "EQ",
      "insurance:capital_adequacy_ratio",
      [
        "MUL",
        [
          "DIV",
          "own_capital",
          "risk_capital"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio",
    "desc": "保險業淨值比率計算公式",
    "expr": [
      "EQ",
      "insurance:net_worth_ratio",
      [
        "MUL",
        [
          "DIV",
          "owner_equity",
          "total_assets_excluding_investment_type_special_accounts"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級依低等級原則決定",
    "expr": [
      "EQ",
      "insurance:capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "insurance:capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "insurance_net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "insurance:capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "insurance:capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "insurance_net_worth",
            0.0
          ],
          [
            "LT",
            "insurance_net_worth",
            2.0
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              "insurance:capital_adequacy_ratio",
              150.0
            ],
            [
              "LT",
              "insurance:capital_adequacy_ratio",
              200.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              "insurance_net_worth",
              3.0
            ],
            [
              "LT",
              "insurance_net_worth_prev",
              3.0
            ],
            [
              "GE",
              "insurance_net_worth",
              2.0
            ],
            [
              "GE",
              "insurance_net_worth_prev",
              2.0
            ]
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            "insurance:capital_adequacy_ratio",
            200.0
          ],
          [
            "OR",
            [
              "GE",
              "insurance_net_worth",
              3.0
            ],
            [
              "GE",
              "insurance_net_worth_prev",
              3.0
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "fhc:fundraising_within_shareholding_ratio",
    "desc": "金融控股公司應於持股比例範圍內為子公司籌募資金",
    "expr": [
      "EQ",
      "fhc:fundraising_within_shareholding_ratio",
      [
        "LE",
        "funds_raised_for_subsidiary",
        [
          "MUL",
          "shareholding_ratio",
          "subsidiary_capital_requirement"
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  }
]