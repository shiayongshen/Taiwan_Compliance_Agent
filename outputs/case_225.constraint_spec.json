[
  {
    "id": "fhc:reporting_required",
    "desc": "金融控股公司子公司對特定對象交易達一定金額或比率須申報揭露",
    "expr": [
      "EQ",
      "reporting_required",
      [
        "AND",
        [
          "EQ",
          "transaction_amount_or_ratio_reached",
          true
        ],
        [
          "EQ",
          "report_submitted_within_30_days_after_quarter",
          true
        ],
        [
          "EQ",
          "disclosure_made_via_official_channel",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_party_scope_defined",
    "desc": "同一人、同一關係人及同一關係企業定義範圍",
    "expr": [
      "EQ",
      "related_party_scope_defined",
      [
        "AND",
        [
          "EQ",
          "same_person_defined",
          true
        ],
        [
          "EQ",
          "same_related_person_defined",
          true
        ],
        [
          "EQ",
          "same_related_corporate_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_person_definition",
    "desc": "同一關係人範圍包含本人、配偶、二親等以內血親及本人或配偶負責企業",
    "expr": [
      "EQ",
      "related_person_definition",
      [
        "AND",
        [
          "EQ",
          "self_included",
          true
        ],
        [
          "EQ",
          "spouse_included",
          true
        ],
        [
          "EQ",
          "second_degree_blood_relative_included",
          true
        ],
        [
          "EQ",
          "enterprises_controlled_by_self_or_spouse_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_corporate_definition",
    "desc": "同一關係企業範圍依公司法相關條文規定",
    "expr": [
      "EQ",
      "related_corporate_definition",
      true
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "fhc:penalty_conditions",
    "desc": "處罰條件：未依規定申報或揭露交易行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "reporting_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_scope_defined",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]