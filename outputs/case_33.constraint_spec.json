          "EQ",
          "deposit_no_pledge",
          true
        ],
        [
          "EQ",
          "deposit_not_distributed",
          true
        ],
        [
          "EQ",
          "deposit_change_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:financial_report_compliance",
    "desc": "證券投資顧問事業財務報告依規定編製並申報",
    "expr": [
      "EQ",
      "financial_report_compliance",
      [
        "AND",
        [
          "EQ",
          "financial_report_audited",
          true
        ],
        [
          "EQ",
          "financial_report_board_approved",
          true
        ],
        [
          "EQ",
          "financial_report_supervisor_approved",
          true
        ],
        [
          "LE",
          "financial_report_submission_months_after_year_end",
          3
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:net_asset_value_improvement_required",
    "desc": "每股淨值低於面額者應於一年內改善",
    "expr": [
      "EQ",
      "net_asset_value_improvement_required",
      [
        "AND",
        [
          "LT",
          "net_asset_value_per_share",
          "par_value_per_share"
        ],
        [
          "LE",
          "improvement_period_months",
          12
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:net_asset_value_improvement_exempt",
    "desc": "取得營業執照未滿一年者，不適用淨值改善規定",
    "expr": [
      "EQ",
      "net_asset_value_improvement_exempt",
      [
        "LT",
        "business_operation_months",
        12
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:net_asset_value_improvement_penalty",
    "desc": "淨值低於面額且未改善者限制證券投資分析活動",
    "expr": [
      "EQ",
      "net_asset_value_improvement_penalty",
      [
        "AND",
        [
          "LT",
          "net_asset_value_per_share",
          "par_value_per_share"
        ],
        [
          "NOT",
          [
            "EQ",
            "net_asset_value_improved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "net_asset_value_improvement_exempt",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:asset_insufficient_penalty",
    "desc": "資產不足抵償負債且未改善者，得廢止營業許可",
    "expr": [
      "EQ",
      "asset_insufficient_penalty",
      [
        "AND",
        [
          "LT",
          "assets",
          "liabilities"
        ],
        [
          "NOT",
          [
            "EQ",
            "asset_insufficient_improved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
