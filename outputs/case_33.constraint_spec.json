[
  {
    "id": "securities:business_sanction_level",
    "desc": "主管機關對違反法令事業之處分等級（1=警告,2=解除職務,3=停止募集或新增業務,4=停業,5=廢止營業許可,6=其他處置）",
    "expr": [
      "EQ",
      "business_sanction_level",
      [
        "CASE",
        [
          "EQ",
          "violation_warning",
          true
        ],
        1,
        [
          "EQ",
          "violation_dismissal",
          true
        ],
        2,
        [
          "EQ",
          "violation_suspend_fund_or_new_business",
          true
        ],
        3,
        [
          "EQ",
          "violation_suspend_operation",
          true
        ],
        4,
        [
          "EQ",
          "violation_revoke_license",
          true
        ],
        5,
        [
          "EQ",
          "violation_other_measures",
          true
        ],
        6,
        0
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:advisor_change_approval_required",
    "desc": "證券投資顧問事業變更事項需先報請本會核准",
    "expr": [
      "EQ",
      "advisor_change_approval_required",
      [
        "OR",
        [
          "EQ",
          "change_company_name",
          true
        ],
        [
          "EQ",
          "change_capital",
          true
        ],
        [
          "EQ",
          "change_business_scope",
          true
        ],
        [
          "EQ",
          "change_office_location",
          true
        ],
        [
          "EQ",
          "transfer_major_business_or_assets",
          true
        ],
        [
          "EQ",
          "dissolution_or_merger",
          true
        ],
        [
          "EQ",
          "suspend_resume_cease_business",
          true
        ],
        [
          "EQ",
          "other_approval_matters",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:advisor_suspend_limit",
    "desc": "證券投資顧問事業停業申請限制及期限",
    "expr": [
      "EQ",
      "advisor_suspend_limit",
      [
        "AND",
        [
          "EQ",
          "suspend_application_once_only",
          true
        ],
        [
          "LE",
          "suspend_period_months",
          12
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:advisor_revoke_license_for_illegal_suspend",
    "desc": "未依規定申請停業且自行停業超過三個月者，得廢止營業許可",
    "expr": [
      "EQ",
      "advisor_revoke_license_for_illegal_suspend",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "suspend_application_submitted",
            true
          ]
        ],
        [
          "GT",
          "self_suspend_duration_months",
          3
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:business_guarantee_deposit_required",
    "desc": "證券投資顧問事業應向符合條件金融機構提存營業保證金",
    "expr": [
      "EQ",
      "business_guarantee_deposit_required",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "exempted_by_other_regulations",
            true
          ]
        ],
        [
          "EQ",
          "deposit_guarantee",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:business_guarantee_deposit_amount",
    "desc": "營業保證金提存金額依實收資本額分級",
    "expr": [
      "EQ",
      "guarantee_deposit_amount",
      [
        "CASE",
        [
          "LT",
          "paid_in_capital",
          100000000.0
        ],
        10000000.0,
        [
          "AND",
          [
            "GE",
            "paid_in_capital",
            100000000.0
          ],
          [
            "LT",
            "paid_in_capital",
            200000000.0
          ]
        ],
        15000000.0,
        [
          "AND",
          [
            "GE",
            "paid_in_capital",
            200000000.0
          ],
          [
            "LT",
            "paid_in_capital",
            300000000.0
          ]
        ],
        20000000.0,
        [
          "GE",
          "paid_in_capital",
          300000000.0
        ],
        25000000.0,
        0.0
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:business_guarantee_deposit_restrictions",
    "desc": "營業保證金不得設定質權或分散提存，變更須報本會核准",
    "expr": [
      "EQ",
      "guarantee_deposit_restrictions_ok",
      [
        "AND",
