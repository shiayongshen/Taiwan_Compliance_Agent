        ],
        [
          "EQ",
          "net_worth_accelerated_deterioration",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "received_guidance",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_after_guidance",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_applicable",
    "desc": "主管機關得為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervisory_measures_applicable",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level_severe_insufficient",
            true
          ],
          [
            "NOT",
