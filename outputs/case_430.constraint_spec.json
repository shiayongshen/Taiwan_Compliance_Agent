      "EQ",
      "significant_worsening",
      [
        "OR",
        [
          "EQ",
          "financial_status_deteriorated",
          true
        ],
        [
          "EQ",
          "business_status_deteriorated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:unable_to_pay_debt_or_fulfill_contract",
