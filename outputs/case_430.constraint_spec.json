              "EQ",
              "capital_increase_or_improvement_plan_completed",
              true
            ]
          ],
          [
            "LE",
            "deadline_days_after_expiry",
            90
          ]
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "capital_level_severe_insufficient",
              true
            ]
          ],
          [
            "EQ",
            "significant_worsening",
            true
          ],
          [
            "EQ",
            "unable_to_pay_or_fulfill",
            true
          ],
          [
            "EQ",
            "potential_harm_to_insured",
            true
          ],
          [
            "EQ",
            "improvement_plan_approved",
            true
          ],
          [
            "EQ",
            "accelerated_deterioration_or_no_improvement",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
