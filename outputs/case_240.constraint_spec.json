[
  {
    "id": "fhc:violation_exists",
    "desc": "金融控股公司有違反法令、章程或有礙健全經營之虞",
    "expr": [
      "EQ",
      "violation_exists",
      [
        "EQ",
        "violation_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:correction_ordered",
    "desc": "主管機關已予以糾正並限期改善",
    "expr": [
      "EQ",
      "correction_ordered",
      [
        "EQ",
        "correction_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_measures_case",
    "desc": "主管機關處分種類分類（1=撤銷會議決議, 2=停止子公司業務, 3=解除經理人職務, 4=解除董事監察人職務, 5=處分子公司股份, 6=廢止許可, 7=其他處置, 0=無處分）",
    "expr": [
      "EQ",
      "penalty_measures_case",
      [
        "CASE",
        [
          "EQ",
          "penalty_measure_1",
          true
        ],
        1,
        [
          "EQ",
          "penalty_measure_2",
          true
        ],
        2,
        [
          "EQ",
          "penalty_measure_3",
          true
        ],
        3,
        [
          "EQ",
          "penalty_measure_4",
          true
        ],
        4,
        [
          "EQ",
          "penalty_measure_5",
          true
        ],
        5,
        [
          "EQ",
          "penalty_measure_6",
          true
        ],
        6,
        [
          "EQ",
          "penalty_measure_7",
          true
        ],
        7,
        0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:notification_to_economic_ministry",
    "desc": "依第四款解除董事監察人職務時，主管機關通知經濟部廢止登記",
    "expr": [
      "EQ",
      "notification_to_economic_ministry",
      [
        "AND",
        [
          "EQ",
          "penalty_measure_4",
          true
        ],
        [
          "EQ",
          "notification_sent",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:disposal_requirement_met",
    "desc": "依第六款廢止許可時，已於期限內完成處分股份及董事人數調整",
    "expr": [
      "EQ",
      "disposal_requirement_met",
      [
        "AND",
        [
          "EQ",
          "penalty_measure_6",
          true
        ],
        [
          "EQ",
          "shares_disposed_within_deadline",
          true
        ],
        [
          "EQ",
          "board_members_adjusted_within_deadline",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:disposal_requirement_not_met",
    "desc": "依第六款廢止許可時，未於期限內完成處分股份及董事人數調整",
    "expr": [
      "EQ",
      "disposal_requirement_not_met",
      [
        "AND",
        [
          "EQ",
          "penalty_measure_6",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "shares_disposed_within_deadline",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:dissolution_and_liquidation_ordered",
    "desc": "未於期限內完成處分者，主管機關令其解散及清算",
    "expr": [
      "EQ",
      "dissolution_and_liquidation_ordered",
      [
        "AND",
        [
          "EQ",
          "disposal_requirement_not_met",
          true
        ],
        [
          "EQ",
          "dissolution_order_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_objectives_met",
    "desc": "金融控股公司及銀行業內部控制達成營運效果、報導可靠及法令遵循目標",
    "expr": [
      "EQ",
      "internal_control_objectives_met",
      [
        "AND",
        [
          "EQ",
          "operational_effectiveness_met",
          true
        ],
        [
          "EQ",
          "reporting_reliability_met",
          true
        ],
        [
          "EQ",
          "legal_compliance_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:operational_effectiveness_met",
    "desc": "營運效果及效率目標達成（含獲利、績效及資產安全）",
    "expr": [
      "EQ",
      "operational_effectiveness_met",
      [
        "EQ",
        "operational_effectiveness_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:reporting_reliability_met",
    "desc": "報導具可靠性、及時性、透明性及符合相關規範",
    "expr": [
      "EQ",
      "reporting_reliability_met",
      [
        "EQ",
        "reporting_reliability_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:legal_compliance_met",
    "desc": "相關法令規章遵循",
    "expr": [
      "EQ",
      "legal_compliance_met",
      [
        "EQ",
        "legal_compliance_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:control_shareholder_definition",
    "desc": "控制性持股定義成立",
    "expr": [
      "EQ",
      "control_shareholder",
      [
        "OR",
        [
          "GT",
          "voting_shares_percentage",
          25.0
        ],
        [
          "GT",
          "capital_percentage",
          25.0
        ],
        [
          "GT",
          "direct_indirect_board_majority",
          0
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:financial_holding_company_definition",
    "desc": "金融控股公司定義成立",
    "expr": [
      "EQ",
      "financial_holding_company",
      [
        "AND",
        [
          "EQ",
          "control_shareholder",
          true
        ],
        [
          "EQ",
          "established_under_law",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:financial_institution_definition",
    "desc": "金融機構定義成立（銀行、保險公司、證券商）",
    "expr": [
      "EQ",
      "financial_institution",
      [
        "OR",
        [
          "EQ",
          "is_bank",
          true
        ],
        [
          "EQ",
          "is_insurance_company",
          true
        ],
        [
          "EQ",
          "is_securities_firm",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_definition",
    "desc": "子公司定義成立（銀行子公司、保險子公司、證券子公司、其他控制子公司）",
    "expr": [
      "EQ",
      "subsidiary",
      [
        "OR",
        [
          "EQ",
          "is_bank_subsidiary",
          true
        ],
        [
          "EQ",
          "is_insurance_subsidiary",
          true
        ],
        [
          "EQ",
          "is_securities_subsidiary",
          true
        ],
        [
          "EQ",
          "is_other_controlled_subsidiary",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:same_person_definition",
    "desc": "同一人定義成立（同一自然人或同一法人）",
    "expr": [
      "EQ",
      "same_person",
      [
        "OR",
        [
          "EQ",
          "same_natural_person",
          true
        ],
        [
          "EQ",
          "same_legal_person",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_person_definition",
    "desc": "同一關係人定義成立",
    "expr": [
      "EQ",
      "related_person",
      [
        "OR",
        [
          "EQ",
          "related_natural_person",
          true
        ],
        [
          "EQ",
          "related_legal_person",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_natural_person_definition",
    "desc": "同一自然人之關係人範圍成立",
    "expr": [
      "EQ",
      "related_natural_person",
      [
        "AND",
        [
          "EQ",
          "natural_person",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "spouse_or_second_degree_relative",
            true
          ],
          [
            "GE",
            "ownership_percentage",
            33.33
          ],
          [
            "EQ",
            "chairman_or_majority_board_member",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_legal_person_definition",
    "desc": "同一法人之關係人範圍成立",
    "expr": [
      "EQ",
      "related_legal_person",
      [
        "AND",
        [
          "EQ",
          "legal_person",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "chairman_general_manager_and_relatives",
            true
          ],
          [
            "GE",
            "ownership_percentage",
            33.33
          ],
          [
            "EQ",
            "chairman_or_majority_board_member",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_enterprise_definition",
    "desc": "關係企業定義成立",
    "expr": [
      "EQ",
      "related_enterprise",
      [
        "EQ",
        "applicable_company_law_provisions",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:major_shareholder_definition",
    "desc": "大股東定義成立",
    "expr": [
      "EQ",
      "major_shareholder",
      [
        "AND",
        [
          "GE",
          "ownership_percentage",
          5.0
        ],
        [
          "OR",
          [
            "EQ",
            "shareholder_is_legal_person",
            true
          ],
          [
            "EQ",
            "shareholder_is_natural_person",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：有違反法令章程或有礙健全經營之虞且未限期改善，或未依規定完成廢止許可後之處分，或未於期限內完成處分股份及董事人數調整，或未依規定解散清算時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_exists",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "correction_ordered",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "penalty_measure_6",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "disposal_requirement_met",
              true
            ]
          ]
        ],
        [
          "EQ",
          "dissolution_and_liquidation_ordered",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]