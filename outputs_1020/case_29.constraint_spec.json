[
  {
    "id": "insurance:agent_broker_not_permitted_without_license",
    "desc": "保險代理人、經紀人、公證人未經主管機關許可、未繳存保證金或未投保相關保險，不得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_not_permitted_without_license",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_permitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "deposit_guarantee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_policy_subscribed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_policy_type_correct",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_policy_type_correct",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "is_agent_or_notary",
            true
          ],
          [
            "EQ",
            "subscribed_policy_type",
            "liability_insurance"
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "subscribed_policy_type_liability",
              true
            ],
            [
              "EQ",
              "subscribed_policy_type_guarantee",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_rules_compliance",
    "desc": "遵守主管機關定之資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他應遵行事項",
    "expr": [
      "EQ",
      "internal_rules_compliance",
      [
        "EQ",
        "internal_rules_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_license_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_duty_of_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_report",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，主動提供書面分析報告",
    "expr": [
      "EQ",
      "broker_provide_written_analysis_report",
      [
        "IMPLIES",
        [
          "EQ",
          "broker_before_contract",
          true
        ],
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_disclose_fee_standard",
    "desc": "保險經紀人向要保人或被保險人收取報酬者，應明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_disclose_fee_standard",
      [
        "IMPLIES",
        [
          "EQ",
          "broker_charge_fee",
          true
        ],
        [
          "EQ",
          "fee_standard_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_rules",
    "desc": "違反財務或業務管理規定或相關規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rules",
          true
        ],
        [
          "EQ",
          "violate_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_related_regulations",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity_management_rule_33",
    "desc": "經紀人應盡善良管理人注意及忠實義務，維護被保險人利益，充分說明及揭露資訊",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity_management_rule_33",
      [
        "EQ",
        "broker_duty_of_care_and_fidelity_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_document_retention",
    "desc": "經紀人應將有關文件留存建檔備查",
    "expr": [
      "EQ",
      "broker_document_retention",
      [
        "EQ",
        "broker_documents_retained",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_obtain_contact_info_for_e_policy",
    "desc": "招攬保險業務以電子保單出單者，應取得要保人及被保險人聯絡方式並提供保險人",
    "expr": [
      "EQ",
      "broker_obtain_contact_info_for_e_policy",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance_policy_electronic",
          true
        ],
        [
          "EQ",
          "contact_info_obtained_and_provided",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_internal_operation_compliance",
    "desc": "經紀人公司及銀行應訂定內部作業規範並落實執行，包含保障高齡消費者投保權益規定",
    "expr": [
      "EQ",
      "broker_internal_operation_compliance",
      [
        "EQ",
        "internal_operation_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_report_management_rule_33",
    "desc": "經紀人洽訂保險契約前應充分瞭解要保人及被保險人資料並依規定提供書面分析報告及告知報酬標準",
    "expr": [
      "EQ",
      "broker_provide_written_analysis_report_management_rule_33",
      [
        "AND",
        [
          "EQ",
          "broker_understand_client_info",
          true
        ],
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_disclose_shareholding_info",
    "desc": "經紀人於洽訂保險契約前應向要保人揭露持股超過10%之資訊",
    "expr": [
      "EQ",
      "broker_disclose_shareholding_info",
      [
        "IMPLIES",
        [
          "EQ",
          "shareholding_exceeds_10_percent",
          true
        ],
        [
          "EQ",
          "shareholding_info_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_understand_client_needs_and_suitability",
    "desc": "經紀人應確實瞭解要保人需求及商品或服務適合度，並於文件簽章或電子方式確認",
    "expr": [
      "EQ",
      "broker_understand_client_needs_and_suitability",
      [
        "OR",
        [
          "EQ",
          "exempted_by_authority",
          true
        ],
        [
          "EQ",
          "client_needs_and_suitability_confirmed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_required_documents_property_insurance",
    "desc": "財產保險相關文件應包含主管機關指定之六類文件",
    "expr": [
      "EQ",
      "broker_required_documents_property_insurance",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_required_documents_life_insurance",
    "desc": "人身保險相關文件應包含主管機關指定之六類文件",
    "expr": [
      "EQ",
      "broker_required_documents_life_insurance",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_understand_client_needs_and_suitability",
    "desc": "代理人應確實瞭解要保人需求及商品或服務適合度，並於文件簽章或電子方式確認",
    "expr": [
      "EQ",
      "agent_understand_client_needs_and_suitability",
      [
        "OR",
        [
          "EQ",
          "exempted_by_authority",
          true
        ],
        [
          "EQ",
          "client_needs_and_suitability_confirmed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_required_documents_property_insurance",
    "desc": "代理人財產保險相關文件應包含主管機關指定之五類文件",
    "expr": [
      "EQ",
      "agent_required_documents_property_insurance",
      [
        "EQ",
        "property_insurance_documents_complete",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_required_documents_life_insurance",
    "desc": "代理人人身保險相關文件應包含主管機關指定之五類文件",
    "expr": [
      "EQ",
      "agent_required_documents_life_insurance",
      [
        "EQ",
        "life_insurance_documents_complete",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_confirm_documents_correctness",
    "desc": "代理人公司及銀行代收保費或辦理核保、理賠等業務時，應確認執行業務相關文件正確性",
    "expr": [
      "EQ",
      "agent_confirm_documents_correctness",
      [
        "EQ",
        "documents_correctness_confirmed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "agent_broker_not_permitted_without_license",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "internal_rules_compliance",
              true
            ]
          ],
          [
            "EQ",
            "violation_financial_or_business_management_rules",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_duty_of_care_and_fidelity",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_provide_written_analysis_report",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_disclose_fee_standard",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_document_retention",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_obtain_contact_info_for_e_policy",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_internal_operation_compliance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_disclose_shareholding_info",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_understand_client_needs_and_suitability",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_required_documents_property_insurance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_required_documents_life_insurance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "agent_understand_client_needs_and_suitability",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "agent_required_documents_property_insurance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "agent_required_documents_life_insurance",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "agent_confirm_documents_correctness",
              true
            ]
          ]
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未經主管機關許可、未繳存保證金、未投保相關保險，或違反財務業務管理規定，或未遵守管理規則，或未盡善良管理人及忠實義務，或未提供書面分析報告，或未明確告知報酬標準，或未留存文件，或未取得聯絡方式，或未訂定內部作業規範，或未揭露持股資訊，或未確實瞭解需求及適合度，或文件不完整或不正確時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "agent_broker_not_permitted_without_license",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_rules_compliance",
            true
          ]
        ],
        [
          "EQ",
          "violation_financial_or_business_management_rules",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fidelity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_provide_written_analysis_report",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_document_retention",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_obtain_contact_info_for_e_policy",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_disclose_shareholding_info",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_understand_client_needs_and_suitability",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_required_documents_property_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_required_documents_life_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_understand_client_needs_and_suitability",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_required_documents_property_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_required_documents_life_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_confirm_documents_correctness",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
