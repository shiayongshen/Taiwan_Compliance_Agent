[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=資本適足, 2=資本不足, 3=資本顯著不足, 4=資本嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            150.0
          ],
          [
            "GE",
            "net_worth_ratio_prev1",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio_prev1",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            150.0
          ],
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            200.0
          ]
        ],
        2,
        [
          "GE",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequate",
    "desc": "資本適足：資本適足率≥200且最近二期淨值比率至少一期≥3",
    "expr": [
      "EQ",
      "capital_adequate",
      [
        "AND",
        [
          "GE",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          200.0
        ],
        [
          "OR",
          [
            "GE",
            "net_worth_ratio_prev1",
            3.0
          ],
          [
            "GE",
            "net_worth_ratio_prev2",
            3.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient",
    "desc": "資本不足：資本適足率≥150且<200，或最近二期淨值比率均未達3且至少一期≥2",
    "expr": [
      "EQ",
      "capital_insufficient",
      [
        "OR",
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            150.0
          ],
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "own_capital",
                "risk_capital"
              ],
              100.0
            ],
            200.0
          ]
        ],
        [
          "AND",
          [
            "LT",
            "net_worth_ratio_prev1",
            3.0
          ],
          [
            "LT",
            "net_worth_ratio_prev2",
            3.0
          ],
          [
            "OR",
            [
              "GE",
              "net_worth_ratio_prev1",
              2.0
            ],
            [
              "GE",
              "net_worth_ratio_prev2",
              2.0
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significantly_insufficient",
    "desc": "資本顯著不足：資本適足率≥50且<150，且最近二期淨值比率均未達2且≥0",
    "expr": [
      "EQ",
      "capital_significantly_insufficient",
      [
        "AND",
        [
          "GE",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          50.0
        ],
        [
          "LT",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          150.0
        ],
        [
          "LT",
          "net_worth_ratio_prev1",
          2.0
        ],
        [
          "LT",
          "net_worth_ratio_prev2",
          2.0
        ],
        [
          "GE",
          "net_worth_ratio_prev1",
          0.0
        ],
        [
          "GE",
          "net_worth_ratio_prev2",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severely_insufficient",
    "desc": "資本嚴重不足：資本適足率<50或淨值<0",
    "expr": [
      "EQ",
      "capital_severely_insufficient",
      [
        "OR",
        [
          "LT",
          [
            "MUL",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            100.0
          ],
          50.0
        ],
        [
          "LT",
          "net_worth",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本嚴重不足或資本顯著不足或資本不足時未採取主管機關規定措施",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_severely_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "measures_for_severely_insufficient_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_significantly_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "measures_for_significantly_insufficient_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "measures_for_insufficient_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]