        ],
        [
          "EQ",
          "foreign_compliance_self_evaluation_done",
          true
        ],
        [
          "EQ",
          "foreign_compliance_supervisor_qualified",
          true
        ],
        [
          "EQ",
          "foreign_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "foreign_compliance_risk_monitoring_established",
          true
        ],
        [
          "EQ",
          "foreign_compliance_risk_assessment_verified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:compliance_self_evaluation_done",
    "desc": "法令遵循自行評估每半年至少辦理一次且結果送備查",
    "expr": [
      "EQ",
      "compliance_self_evaluation_done",
      [
        "AND",
        [
          "EQ",
          "self_evaluation_at_least_twice_per_year",
          true
        ],
        [
          "EQ",
          "self_evaluation_results_reported",
          true
        ],
        [
          "EQ",
          "self_evaluation_responsible_person_assigned",
          true
        ],
        [
          "EQ",
          "self_evaluation_records_kept_5_years",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_systems_compliant",
    "desc": "內部控制、內部處理及內部作業制度均建立且確實執行",
    "expr": [
      "EQ",
      "internal_systems_compliant",
      [
        "AND",
        [
          "EQ",
          "internal_control_ok",
          true
        ],
        [
          "EQ",
          "internal_handling_ok",
          true
        ],
        [
          "EQ",
          "internal_operation_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定建立或執行內部控制、內部處理或內部作業制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "EQ",
          "internal_systems_compliant",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]