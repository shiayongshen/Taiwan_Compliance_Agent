        ],
        [
          "EQ",
          "operation_rules_updated",
          true
        ],
        [
          "EQ",
          "compliance_supervisor_opinion_signed",
          true
        ],
        [
          "EQ",
          "compliance_evaluation_and_supervision_done",
          true
        ],
        [
          "EQ",
          "staff_training_done",
          true
        ],
        [
          "EQ",
          "compliance_supervisor_implementation_supervised",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_compliance_supervised",
