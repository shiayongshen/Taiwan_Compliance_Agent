[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures_established",
          true
        ],
        [
          "EQ",
          "training_held_regularly",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_designated_matters_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "bank:internal_control_established",
    "desc": "銀行建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "bank_internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_established",
    "desc": "銀行建立內部處理制度及程序",
    "expr": [
      "EQ",
      "bank_internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_established",
    "desc": "銀行建立內部作業制度及程序",
    "expr": [
      "EQ",
      "bank_internal_operation_established",
      [
        "EQ",
        "internal_operation_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_executed",
    "desc": "銀行內部控制制度確實執行",
    "expr": [
      "EQ",
      "bank_internal_control_executed",
      [
        "EQ",
        "internal_control_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_executed",
    "desc": "銀行內部處理制度確實執行",
    "expr": [
      "EQ",
      "bank_internal_handling_executed",
      [
        "EQ",
        "internal_handling_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_executed",
    "desc": "銀行內部作業制度確實執行",
    "expr": [
      "EQ",
      "bank_internal_operation_executed",
      [
        "EQ",
        "internal_operation_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "aml:compliance_ok",
    "desc": "洗錢防制內部控制制度建立且確實執行",
    "expr": [
      "EQ",
      "aml_compliance_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "bank:compliance_ok",
    "desc": "銀行內部控制、處理及作業制度建立且確實執行",
    "expr": [
      "EQ",
      "bank_compliance_ok",
      [
        "AND",
        [
          "EQ",
          "bank_internal_control_established",
          true
        ],
        [
          "EQ",
          "bank_internal_control_executed",
          true
        ],
        [
          "EQ",
          "bank_internal_handling_established",
          true
        ],
        [
          "EQ",
          "bank_internal_handling_executed",
          true
        ],
        [
          "EQ",
          "bank_internal_operation_established",
          true
        ],
        [
          "EQ",
          "bank_internal_operation_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立或未確實執行洗錢防制內部控制制度，或銀行未建立或未確實執行內部控制、處理及作業制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "aml_compliance_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_compliance_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]