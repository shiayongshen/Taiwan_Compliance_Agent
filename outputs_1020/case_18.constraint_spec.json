  {
    "id": "fhc:adjustment_ordered",
    "desc": "主管機關限期命其調整",
    "expr": [
      "EQ",
      "adjustment_ordered",
      [
        "IMPLIES",
        [
          "EQ",
          "subsidiary_business_or_investment_exceed_limit",
          true
        ],
        [
          "EQ",
          "adjustment_order_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:adjustment_period_limit",
    "desc": "調整期限最長三年，得申請延長二次，每次二年",
    "expr": [
      "EQ",
      "adjustment_period_limit",
      [
        "AND",
        [
          "LE",
          "adjustment_period_years",
          3
        ],
        [
          "OR",
          [
            "EQ",
            "extension_times",
            0
          ],
          [
            "LE",
            "extension_times",
            2
          ]
        ],
        [
          "LE",
          "extension_period_years",
          2
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
