  },
  {
    "id": "fhc:control_holding_definition",
    "desc": "控制性持股定義",
    "expr": [
      "EQ",
      "control_holding",
      [
        "OR",
        [
          "GT",
          "voting_shares_percentage",
          25
        ],
        [
          "GT",
          "capital_percentage",
          25
        ],
        [
          "GT",
          "directly_or_indirectly_appointed_board_members",
          50
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
