    "expr": [
      "EQ",
      "financial_holding_company",
      [
        "AND",
        [
          "EQ",
          "control_holding",
          true
        ],
        [
          "EQ",
          "established_under_fhc_law",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
