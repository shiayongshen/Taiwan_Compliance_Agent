      [
        "OR",
        [
          "EQ",
          "banking_institution",
          true
        ],
        [
          "EQ",
          "insurance_company",
          true
        ],
        [
          "EQ",
          "securities_firm",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
