  {
    "id": "fhc:investment_approval_status",
    "desc": "投資行為須經主管機關核准或視為核准",
    "expr": [
      "EQ",
      "investment_approval_status",
      [
        "OR",
        [
          "EQ",
          "approval_granted",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "application_submitted",
            true
          ],
          [
            "OR",
            [
              "AND",
              [
                "GE",
                "business_type_code",
                1
              ],
              [
                "LE",
                "business_type_code",
                9
              ],
              [
                "LE",
                "business_days_since_application",
                15
              ],
              [
                "NOT",
                [
                  "EQ",
                  "disapproval_expressed",
                  true
                ]
              ]
            ],
            [
              "AND",
              [
                "GE",
                "business_type_code",
                10
              ],
              [
                "LE",
                "business_type_code",
                11
              ],
              [
                "LE",
                "business_days_since_application",
                30
              ],
              [
                "NOT",
                [
                  "EQ",
                  "disapproval_expressed",
                  true
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:investment_without_approval_prohibited",
    "desc": "未經核准不得進行投資行為",
    "expr": [
      "EQ",
      "investment_without_approval_prohibited",
      [
        "IMPLIES",
        [
          "EQ",
          "investment_made",
          true
        ],
        [
          "EQ",
          "investment_approval_status",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_business_or_investment_exceed_limit",
