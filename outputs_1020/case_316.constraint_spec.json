[
  {
    "id": "insurance:same_person_definition",
    "desc": "同一人定義為同一自然人或同一法人",
    "expr": [
      "EQ",
      "same_person",
      [
        "OR",
        [
          "EQ",
          "person_type",
          1
        ],
        [
          "EQ",
          "person_type",
          2
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:same_related_person_definition",
    "desc": "同一關係人範圍包含本人、配偶、二親等以內血親及以本人或配偶為負責人之事業",
    "expr": [
      "EQ",
      "same_related_person",
      [
        "OR",
        [
          "EQ",
          "is_self",
          true
        ],
        [
          "EQ",
          "is_spouse",
          true
        ],
        [
          "LE",
          "blood_relation_degree",
          2
        ],
        [
          "EQ",
          "is_responsible_person_of_business",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:same_related_enterprise_definition",
    "desc": "同一關係企業範圍依公司法相關條文規定",
    "expr": [
      "EQ",
      "same_related_enterprise",
      [
        "OR",
        [
          "EQ",
          "company_law_369_1_applied",
          true
        ],
        [
          "EQ",
          "company_law_369_2_applied",
          true
        ],
        [
          "EQ",
          "company_law_369_3_applied",
          true
        ],
        [
          "EQ",
          "company_law_369_9_applied",
          true
        ],
        [
          "EQ",
          "company_law_369_11_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_and_other_transaction_limit_defined",
    "desc": "主管機關得對同一人、同一關係人或同一關係企業之放款或其他交易予以限制",
    "expr": [
      "EQ",
      "loan_and_other_transaction_limit_defined",
      [
        "AND",
        [
          "EQ",
          "loan_limit_set_by_authority",
          true
        ],
        [
          "EQ",
          "other_transaction_scope_set_by_authority",
          true
        ],
        [
          "EQ",
          "other_must_follow_matters_set_by_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_other_transaction_limit_defined",
    "desc": "主管機關得對保險業與利害關係人從事放款以外之其他交易予以限制",
    "expr": [
      "EQ",
      "related_party_other_transaction_limit_defined",
      [
        "AND",
        [
          "EQ",
          "related_party_defined_by_authority",
          true
        ],
        [
          "EQ",
          "transaction_scope_defined_by_authority",
          true
        ],
        [
          "EQ",
          "resolution_procedure_defined_by_authority",
          true
        ],
        [
          "EQ",
          "limit_defined_by_authority",
          true
        ],
        [
          "EQ",
          "other_must_follow_matters_defined_by_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_types_limited",
    "desc": "保險業資金辦理國外投資限於外匯存款、國外有價證券、核准之保險相關事業及其他核准投資",
    "expr": [
      "EQ",
      "foreign_investment_types_limited",
      [
        "AND",
        [
          "EQ",
          "foreign_exchange_deposit",
          true
        ],
        [
          "EQ",
          "foreign_securities",
          true
        ],
        [
          "EQ",
          "approved_foreign_insurance_related_investment",
          true
        ],
        [
          "EQ",
          "other_approved_foreign_investment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_total_limit",
    "desc": "國外投資總額不得超過資金45%，特定項目不計入限額",
    "expr": [
      "EQ",
      "foreign_investment_total_limit",
      [
        "AND",
        [
          "LE",
          [
            "DIV",
            "foreign_investment_amount",
            "total_funds"
          ],
          0.45
        ],
        [
          "EQ",
          "excluded_amount_approved_foreign_currency_non_investment_insurance",
          true
        ],
        [
          "EQ",
          "excluded_amount_foreign_currency_domestic_securities",
          true
        ],
        [
          "EQ",
          "excluded_amount_approved_foreign_insurance_related_investment",
          true
        ],
        [
          "EQ",
          "excluded_amount_other_approved_investment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_regulations_defined",
    "desc": "主管機關定國外投資規範、投資額度、審核及其他應遵行事項",
    "expr": [
      "EQ",
      "foreign_investment_regulations_defined",
      [
        "AND",
        [
          "EQ",
          "foreign_investment_regulations_set",
          true
        ],
        [
          "EQ",
          "financial_condition_limit_for_second_item",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "保險業應建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "保險業應建立資產品質評估、準備金提存、逾期放款等內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_system_and_procedure_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures",
    "desc": "主管機關得對違反法令或有礙健全經營之保險業採取監管、接管、勒令停業清理或命令解散等處分",
    "expr": [
      "EQ",
      "supervisory_measures",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_increase_or_improvement_plan_completed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_condition_significantly_deteriorated",
            true
          ],
          [
            "EQ",
            "cannot_pay_debt_or_fulfill_contract",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_condition_significantly_deteriorated",
            true
          ],
          [
            "EQ",
            "cannot_pay_debt_or_fulfill_contract",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_approved_by_authority",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_procedure_defined",
    "desc": "主管機關定監管、接管、停業清理或解散程序及相關事項",
    "expr": [
      "EQ",
      "supervisory_measures_procedure_defined",
      [
        "EQ",
        "supervisory_measures_procedure_set_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_acts_without_supervisor_consent",
    "desc": "監管處分期間非經監管人同意不得超限額支付款項或處分財產等行為",
    "expr": [
      "EQ",
      "prohibited_acts_without_supervisor_consent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "payment_exceeding_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contract_or_major_obligation_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_major_financial_impacting_matters",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_violation_of_regulations_146_7",
    "desc": "違反146-7條放款或其他交易限額規定處罰",
    "expr": [
      "EQ",
      "violation_146_7",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "loan_and_other_transaction_limit_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_other_transaction_limit_defined",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_violation_of_regulations_146_4",
    "desc": "違反146-4條國外投資限額及規範處罰",
    "expr": [
      "EQ",
      "violation_146_4",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_types_limited",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_total_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_regulations_defined",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_violation_of_regulations_148_3",
    "desc": "違反148-3條內部控制及內部處理制度規定處罰",
    "expr": [
      "EQ",
      "violation_148_3",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反146-7、146-4或148-3條規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_146_7",
          true
        ],
        [
          "EQ",
          "violation_146_4",
          true
        ],
        [
          "EQ",
          "violation_148_3",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]