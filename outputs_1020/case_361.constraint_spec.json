        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_executed",
    "desc": "內部處理制度及程序確實執行",
    "expr": [
      "EQ",
      "internal_handling_executed",
      [
        "EQ",
        "internal_handling_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_established",
    "desc": "建立內部作業制度及程序",
    "expr": [
      "EQ",
      "internal_operation_established",
      [
        "EQ",
        "internal_operation_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_executed",
    "desc": "內部作業制度及程序確實執行",
    "expr": [
      "EQ",
      "internal_operation_executed",
      [
        "EQ",
        "internal_operation_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_compliance",
    "desc": "內部控制及稽核制度建立且確實執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_compliance",
    "desc": "內部處理制度及程序建立且確實執行",
    "expr": [
      "EQ",
      "internal_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_compliance",
    "desc": "內部作業制度及程序建立且確實執行",
    "expr": [
      "EQ",
      "internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_operation_established",
          true
        ],
        [
          "EQ",
          "internal_operation_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_staff_qualified",
    "desc": "衍生性金融商品業務人員具備專業資格",
    "expr": [
      "EQ",
      "derivative_business_staff_qualified",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_license_held",
          true
        ],
        [
          "GE",
          "derivative_internship_years",
          1
        ],
        [
          "GE",
          "derivative_experience_months",
          6
        ],
        [
          "EQ",
          "structured_product_sales_passed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_management_qualified",
    "desc": "衍生性金融商品業務經辦及管理人員具備資格",
    "expr": [
      "EQ",
      "derivative_business_management_qualified",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_license_held",
          true
        ],
        [
          "GE",
          "derivative_internship_years",
          1
        ],
        [
          "GE",
          "derivative_experience_months",
          6
        ],
        [
          "EQ",
          "structured_product_sales_passed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_derivative_permit_required",
    "desc": "外匯衍生性商品業務申請許可或函報備查",
    "expr": [
      "EQ",
      "foreign_exchange_derivative_permit_required",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "foreign_exchange_derivative_type",
            1
          ],
          [
            "NOT",
            [
              "EQ",
              "foreign_exchange_derivative_permit_obtained",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "foreign_exchange_derivative_type",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "foreign_exchange_derivative_filing_done",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "foreign_exchange_derivative_type",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "foreign_exchange_derivative_filing_done",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定建立或執行內部控制、內部處理、內部作業制度或未具備衍生性金融商品業務人員資格，或未依規定申請外匯衍生性商品業務許可時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "derivative_business_staff_qualified",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "derivative_business_management_qualified",
            true
          ]
        ],
        [
          "EQ",
          "foreign_exchange_derivative_permit_required",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]