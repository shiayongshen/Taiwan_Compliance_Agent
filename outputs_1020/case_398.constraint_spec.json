[
  {
    "id": "insurance:agent_broker_not_permitted_without_license",
    "desc": "保險代理人、經紀人、公證人未經主管機關許可、未繳存保證金、未投保相關保險或未領執業證照不得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_not_permitted_without_license",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "broker",
            true
          ]
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "license_permitted",
              true
            ],
            [
              "EQ",
              "deposit_guarantee",
              true
            ],
            [
              "EQ",
              "insurance_subscribed",
              true
            ],
            [
              "EQ",
              "license_issued",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_type_for_agent_broker_not_permitted",
    "desc": "保險代理人、公證人未投保責任保險，保險經紀人未投保責任保險及保證保險不得經營或執行業務",
    "expr": [
      "EQ",
      "insurance_type_for_agent_broker_not_permitted",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "broker",
            true
          ]
        ],
        [
          "NOT",
          [
            "OR",
            [
              "AND",
              [
                "EQ",
                "agent_or_notary",
                true
              ],
              [
                "EQ",
                "liability_insurance_subscribed",
                true
              ]
            ],
            [
              "AND",
              [
                "EQ",
                "broker",
                true
              ],
              [
                "EQ",
                "liability_insurance_subscribed",
                true
              ],
              [
                "EQ",
                "guarantee_insurance_subscribed",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "IMPLIES",
        [
          "EQ",
          "bank_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_must_follow_agent_broker_rules",
    "desc": "銀行兼營保險代理人或經紀人業務時，應分別準用本法有關保險代理人、保險經紀人之規定",
    "expr": [
      "EQ",
      "bank_must_follow_agent_broker_rules",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ],
        [
          "EQ",
          "bank_follow_agent_broker_rules",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_duty_of_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前，應於主管機關指定範圍內主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_must_provide_written_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "broker_provide_written_report",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "EQ",
          "deposit_guarantee",
          true
        ],
        [
          "EQ",
          "insurance_subscribed",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ],
        [
          "OR",
          [
            "AND",
            [
              "EQ",
              "agent_or_notary",
              true
            ],
            [
              "EQ",
              "liability_insurance_subscribed",
              true
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "broker",
              true
            ],
            [
              "EQ",
              "liability_insurance_subscribed",
              true
            ],
            [
              "EQ",
              "guarantee_insurance_subscribed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker_duty_of_care",
            true
          ],
          [
            "EQ",
            "broker_duty_of_fidelity",
            true
          ]
        ],
        [
          "EQ",
          "broker_provide_written_report",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未經主管機關許可、未繳存保證金、未投保相關保險、未領執業證照，或保險經紀人未履行善良管理人注意義務及忠實義務，或未提供書面分析報告及報酬標準告知時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "license_permitted",
              true
            ],
            [
              "EQ",
              "deposit_guarantee",
              true
            ],
            [
              "EQ",
              "insurance_subscribed",
              true
            ],
            [
              "EQ",
              "license_issued",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "OR",
            [
              "AND",
              [
                "EQ",
                "agent_or_notary",
                true
              ],
              [
                "EQ",
                "liability_insurance_subscribed",
                true
              ]
            ],
            [
              "AND",
              [
                "EQ",
                "broker",
                true
              ],
              [
                "EQ",
                "liability_insurance_subscribed",
                true
              ],
              [
                "EQ",
                "guarantee_insurance_subscribed",
                true
              ]
            ]
          ]
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "broker_duty_of_care",
              true
            ],
            [
              "EQ",
              "broker_duty_of_fidelity",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_provide_written_report",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
