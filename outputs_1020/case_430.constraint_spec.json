[
  {
    "id": "insurance:capital_level_severe_insufficient",
    "desc": "資本等級嚴重不足判定",
    "expr": [
      "EQ",
      "capital_level_severe_insufficient",
      [
        "OR",
        [
          "LT",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "net_worth",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_significant_deterioration",
    "desc": "資本等級顯著惡化判定",
    "expr": [
      "EQ",
      "capital_level_significant_deterioration",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          150.0
        ],
        [
          "GE",
          "net_worth_ratio",
          0.0
        ],
        [
          "LT",
          "net_worth_ratio",
          2.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_insufficient",
    "desc": "資本等級不足判定",
    "expr": [
      "EQ",
      "capital_level_insufficient",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          150.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          200.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_adequate",
    "desc": "資本等級適足判定",
    "expr": [
      "EQ",
      "capital_level_adequate",
      [
        "GE",
        "capital_adequacy_ratio",
        200.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著惡化, 4=嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_4_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_4_measures_executed",
      [
        "EQ",
        "level_4_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_3_measures_executed",
    "desc": "資本顯著惡化等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_3_measures_executed",
      [
        "EQ",
        "level_3_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_2_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_completed",
    "desc": "增資、財務或業務改善計畫或合併已於主管機關規定期限內完成",
    "expr": [
      "EQ",
      "improvement_plan_completed",
      [
        "EQ",
        "plan_completed_within_deadline",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_or_business_deterioration",
    "desc": "財務或業務狀況顯著惡化且不能支付債務或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "financial_or_business_deterioration",
      [
        "OR",
        [
          "EQ",
          "cannot_pay_debt",
          true
        ],
        [
          "EQ",
          "cannot_fulfill_contract",
          true
        ],
        [
          "EQ",
          "risk_to_insured_rights",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_action_required",
    "desc": "應由主管機關為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervisory_action_required",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level_severe_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_completed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "capital_level_severe_insufficient",
              true
            ]
          ],
          [
            "EQ",
            "financial_or_business_deterioration",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_action_taken",
    "desc": "主管機關已為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervisory_action_taken",
      [
        "EQ",
        "supervisory_action_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_actions_without_supervisor_consent",
    "desc": "監管處分期間未經監管人同意禁止之行為",
    "expr": [
      "EQ",
      "prohibited_actions_without_supervisor_consent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_payment_exceed_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_contract_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_other_major_financial_matters",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_ok",
    "desc": "已建立且執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "已建立且執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_public_debt",
    "desc": "公債、國庫券投資限額符合規定",
    "expr": [
      "EQ",
      "investment_limit_public_debt",
      [
        "EQ",
        "public_debt_investment_ok",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_financial_bonds",
    "desc": "金融債券等投資總額不超過資金35%",
    "expr": [
      "EQ",
      "investment_limit_financial_bonds",
      [
        "LE",
        "financial_bonds_investment_ratio",
        35.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_per_company",
    "desc": "每一公司股票投資不超過資金5%且不超過該公司已發行股份10%",
    "expr": [
      "EQ",
      "investment_limit_stock_per_company",
      [
        "AND",
        [
          "LE",
          "stock_investment_ratio_per_company",
          5.0
        ],
        [
          "LE",
          "stock_investment_ratio_of_issued_shares",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_bond_per_company",
    "desc": "每一公司公司債及免保證商業本票投資不超過資金5%且不超過公司業主權益10%",
    "expr": [
      "EQ",
      "investment_limit_bond_per_company",
      [
        "AND",
        [
          "LE",
          "bond_investment_ratio_per_company",
          5.0
        ],
        [
          "LE",
          "bond_investment_ratio_of_owner_equity",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_fund_total",
    "desc": "證券投資信託基金及共同信託基金投資總額不超過資金10%且每一基金受益憑證不超過10%",
    "expr": [
      "EQ",
      "investment_limit_fund_total",
      [
        "AND",
        [
          "LE",
          "fund_investment_ratio_total",
          10.0
        ],
        [
          "LE",
          "fund_investment_ratio_per_fund",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_securitized_and_others",
    "desc": "證券化商品及其他核准有價證券投資總額不超過資金10%",
    "expr": [
      "EQ",
      "investment_limit_securitized_and_others",
      [
        "LE",
        "securitized_and_others_investment_ratio",
        10.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_and_bond_combined",
    "desc": "股票及公司債投資總額不超過資金35%",
    "expr": [
      "EQ",
      "investment_limit_stock_and_bond_combined",
      [
        "LE",
        [
          "ADD",
          "stock_investment_ratio_total",
          "bond_investment_ratio_total"
        ],
        35.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_prohibited_roles",
    "desc": "禁止保險業或代表人擔任被投資公司董事、監察人等角色",
    "expr": [
      "EQ",
      "investment_prohibited_roles",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "acting_as_director",
            true
          ],
          [
            "EQ",
            "acting_as_supervisor",
            true
          ],
          [
            "EQ",
            "exercising_voting_rights",
            true
          ],
          [
            "EQ",
            "appointing_manager",
            true
          ],
          [
            "EQ",
            "acting_as_trust_supervisor",
            true
          ],
          [
            "EQ",
            "participating_in_management_agreement",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反資本等級改善計畫、財務或業務惡化未改善、內部控制制度、投資限額及禁止角色規定等任一規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level_severe_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_completed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "capital_level_severe_insufficient",
              true
            ]
          ],
          [
            "EQ",
            "financial_or_business_deterioration",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_public_debt",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_financial_bonds",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_per_company",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_bond_per_company",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_fund_total",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_securitized_and_others",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_and_bond_combined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_prohibited_roles",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]