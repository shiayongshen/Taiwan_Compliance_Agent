  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：銀行或票券金融公司違反法令、章程或有礙健全經營且主管機關採取處分措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_of_law_or_regulation",
            true
          ],
          [
            "EQ",
            "penalty_measures",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "violation_of_law_or_regulation",
            true
          ],
          [
