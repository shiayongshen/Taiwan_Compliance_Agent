    "domain": "insurance"
  },
  {
    "id": "insurance:special_purpose_real_estate_investment_company_permit",
    "desc": "投資大陸地區特定目的不動產投資事業應申請經濟部許可",
    "expr": [
      "EQ",
      "special_purpose_real_estate_investment_company_permit",
