        ],
        [
          "EQ",
          "capital_or_investment_stage_analysis_submitted",
          true
        ],
        [
          "EQ",
          "responsible_person_list_submitted",
          true
        ],
        [
          "EQ",
          "existing_investments_and_operation_status_submitted",
          true
        ],
        [
          "EQ",
          "legal_use_and_benefit_proof_submitted",
          true
        ],
        [
          "EQ",
          "loan_approval_and_decision_documents_submitted",
          true
        ],
        [
          "EQ",
          "other_documents_required_by_authority_submitted",
          true
        ]
      ]
    ],
