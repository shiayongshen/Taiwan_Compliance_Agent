[
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "不動產投資總額限制及自用不動產限制",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "EQ",
          "real_estate_investment_in_use_and_income",
          true
        ],
        [
          "LE",
          "real_estate_investment_total_excluding_self_use",
          [
            "MUL",
            "capital_fund",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_total",
          "owner_equity_total"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_valuation_required",
    "desc": "不動產取得及處分須經合法鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_valuation_required",
      [
        "EQ",
        "real_estate_valuation_by_legal_institution",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:social_housing_exemption",
    "desc": "依住宅法興辦社會住宅且僅供租賃者，不受即時利用並有收益限制",
    "expr": [
      "EQ",
      "social_housing_exemption",
      [
        "EQ",
        "social_housing_only_for_rent",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_conditions",
    "desc": "國外及大陸地區不動產投資條件限制",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_conditions",
      [
        "AND",
        [
          "EQ",
          "foreign_real_estate_legal_use_and_benefit",
          true
        ],
        [
          "GE",
          "latest_capital_to_risk_capital_ratio",
          "legal_standard"
        ],
        [
          "OR",
          [
            "AND",
            [
              "NOT",
              [
                "EQ",
                "major_penalty_in_last_two_years",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "major_internal_control_violation_in_last_two_years",
                true
              ]
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "violation_corrected_and_approved",
              true
            ]
          ]
        ],
        [
          "OR",
          [
            "EQ",
            "board_has_risk_management_committee",
            true
          ],
          [
            "EQ",
            "company_has_risk_management_department_and_officer",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_limit",
    "desc": "國外及大陸地區不動產投資總額限制依資本比率分級",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_limit_level",
      [
        "CASE",
        [
          "GE",
          "latest_capital_to_risk_capital_ratio",
          1.5
        ],
        3,
        [
          "GE",
          "latest_capital_to_risk_capital_ratio",
          1.25
        ],
        2,
        true,
        1,
        0.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_limit_amount",
    "desc": "國外及大陸地區不動產投資總額限制數值",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_limit_amount",
      [
        "CASE",
        [
          "EQ",
          "foreign_real_estate_investment_limit_level",
          3
        ],
        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "capital_fund",
              3.0
            ]
          ],
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "owner_equity_total",
              40.0
            ]
          ]
        ],
        [
          "EQ",
          "foreign_real_estate_investment_limit_level",
          2
        ],
        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "capital_fund",
              2.5
            ]
          ],
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "owner_equity_total",
              40.0
            ]
          ]
        ],
        [
          "EQ",
          "foreign_real_estate_investment_limit_level",
          1
        ],
        [
          "AND",
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "capital_fund",
              1.0
            ]
          ],
          [
            "LE",
            "foreign_real_estate_investment_total",
            [
              "MUL",
              "owner_equity_total",
              10.0
            ]
          ]
        ],
        false
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_legal_use_criteria",
    "desc": "國外不動產合法利用認定標準（出租率≥60%且符合當地經濟環境投資報酬率）",
    "expr": [
      "EQ",
      "foreign_real_estate_legal_use_criteria",
      [
        "AND",
        [
          "GE",
          "foreign_real_estate_rental_rate",
          60.0
        ],
        [
          "EQ",
          "foreign_real_estate_meets_local_economic_return",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_approval_conditions",
    "desc": "投資特定目的不動產投資事業或信託方式取得國外不動產董事會同意及備查條件",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_approval_conditions",
      [
        "AND",
        [
          "EQ",
          "internal_operation_rules_established_and_approved",
          true
        ],
        [
          "GE",
          "latest_two_periods_capital_to_risk_capital_ratio",
          1.25
        ],
        [
          "EQ",
          "board_has_risk_management_committee",
          true
        ],
        [
          "EQ",
          "company_has_risk_management_department_and_officer",
          true
        ],
        [
          "GE",
          "average_rental_rate_of_invested_properties",
          80.0
        ],
        [
          "EQ",
          "investment_meets_local_economic_return",
          true
        ],
        [
          "EQ",
          "has_other_properties_in_same_country_or_region",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_real_estate_investment_report_penalty",
    "desc": "未依規定提報董事會或提報資料虛偽不實視為違反投資規範",
    "expr": [
      "EQ",
      "foreign_real_estate_investment_report_penalty",
      [
        "NOT",
        [
          "EQ",
          "foreign_real_estate_investment_approval_conditions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_to_special_purpose_real_estate_investment_company_conditions",
    "desc": "貸款方式取得國外不動產貸款條件及董事會同意",
    "expr": [
      "EQ",
      "loan_to_special_purpose_real_estate_investment_company_conditions",
      [
        "AND",
        [
          "EQ",
          "board_approval_2_3_attendance",
          true
        ],
        [
          "EQ",
          "board_approval_3_4_votes",
          true
        ],
        [
          "LE",
          "loan_interest_rate",
          "local_similar_loan_interest_rate"
        ],
        [
          "EQ",
          "loan_conditions_meet_local_law",
          true
        ],
        [
          "EQ",
          "loan_funds_used_for_real_estate_investment",
          true
        ],
        [
          "LE",
          "loan_balance_to_special_purpose_company",
          [
            "MUL",
            "owner_equity_total",
            10.0
          ]
        ],
        [
          "LE",
          "total_loan_balance_including_related_parties",
          [
            "MUL",
            "owner_equity_total",
            150.0
          ]
        ],
        [
          "LE",
          "total_loan_balance_to_related_enterprises",
          [
            "MUL",
            "owner_equity_total",
            40.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:special_purpose_real_estate_investment_company_business_scope",
    "desc": "特定目的不動產投資事業業務範圍及借貸限制",
    "expr": [
      "EQ",
      "special_purpose_real_estate_investment_company_business_scope",
      [
        "AND",
        [
          "EQ",
          "business_scope_limited_to_real_estate_and_related_rights",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "borrowing_outside_loan_in_item_1",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "acting_as_guarantor_or_providing_collateral",
            true
          ]
        ],
        [
          "EQ",
          "funds_used_for_business_costs_or_deposits",
          true
        ],
        [
          "EQ",
          "income_repatriated_after_audit",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
