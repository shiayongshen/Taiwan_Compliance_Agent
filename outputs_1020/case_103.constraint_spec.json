        [
          "EQ",
          "investment_in_mainland_china",
          true
        ],
        [
          "EQ",
          "permit_applied_to_ministry_of_economy",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:special_purpose_real_estate_investment_company_exemption",
    "desc": "特定目的不動產投資事業不適用分支機構設立遷移及香港澳門分支機構子公司許可規定",
    "expr": [
      "EQ",
      "special_purpose_real_estate_investment_company_exemption",
