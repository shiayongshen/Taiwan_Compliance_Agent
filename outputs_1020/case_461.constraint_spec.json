[
  {
    "id": "insurance:capital_level_severe_insufficiency",
    "desc": "資本等級嚴重不足判定",
    "expr": [
      "EQ",
      "capital_level_severe_insufficiency",
      [
        "OR",
        [
          "LT",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "net_worth",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_significant_insufficiency",
    "desc": "資本等級顯著不足判定",
    "expr": [
      "EQ",
      "capital_level_significant_insufficiency",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          150.0
        ],
        [
          "GE",
          "net_worth_ratio",
          0.0
        ],
        [
          "LT",
          "net_worth_ratio",
          2.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_insufficient",
    "desc": "資本等級不足判定",
    "expr": [
      "EQ",
      "capital_level_insufficient",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          150.0
        ],
        [
          "LT",
          "capital_adequacy_ratio",
          200.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_adequate",
    "desc": "資本等級適足判定",
    "expr": [
      "EQ",
      "capital_level_adequate",
      [
        "GE",
        "capital_adequacy_ratio",
        200.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_4_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_4_measures_executed",
      [
        "EQ",
        "level_4_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_3_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_3_measures_executed",
      [
        "EQ",
        "level_3_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_2_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:severe_insufficiency_and_no_measures",
    "desc": "嚴重不足且未完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "severe_insufficiency_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_level_4_measures_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:significant_insufficiency_and_no_measures",
    "desc": "顯著不足且未完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "significant_insufficiency_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          3
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_level_3_measures_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insufficient_and_no_measures",
    "desc": "不足且未完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "insufficient_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          2
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "improvement_plan_submitted",
              true
            ],
            [
              "EQ",
              "improvement_plan_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_or_business_deterioration",
    "desc": "財務或業務狀況顯著惡化且不能支付債務或履行契約責任或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "financial_or_business_deterioration",
      [
        "AND",
        [
          "EQ",
          "deterioration_report_submitted",
          true
        ],
        [
          "EQ",
          "deterioration_report_approved",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "accelerated_deterioration",
            true
          ],
          [
            "EQ",
            "counseling_not_improved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervision_or_takeover_or_shutdown_order",
    "desc": "主管機關依資本嚴重不足或財務業務惡化情況，為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervision_or_takeover_or_shutdown_order",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_4_measures_executed",
              true
            ]
          ],
          [
            "LE",
            "days_after_deadline",
            90
          ]
        ],
        [
          "EQ",
          "financial_or_business_deterioration",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:restriction_on_business_or_fund_usage",
    "desc": "限制營業或資金運用範圍",
    "expr": [
      "EQ",
      "restriction_on_business_or_fund_usage",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:stop_or_limit_insurance_products",
    "desc": "停售保險商品或限制保險商品開辦",
    "expr": [
      "EQ",
      "stop_or_limit_insurance_products",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:order_capital_increase",
    "desc": "令其增資",
    "expr": [
      "EQ",
      "order_capital_increase",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:remove_manager_or_staff",
    "desc": "解除經理人或職員職務",
    "expr": [
      "EQ",
      "remove_manager_or_staff",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:revoke_statutory_meeting_resolution",
    "desc": "撤銷法定會議決議",
    "expr": [
      "EQ",
      "revoke_statutory_meeting_resolution",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:remove_director_or_supervisor",
    "desc": "解除董（理）事、監察人（監事）職務",
    "expr": [
      "EQ",
      "remove_director_or_supervisor",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:other_necessary_measures",
    "desc": "其他必要之處置",
    "expr": [
      "EQ",
      "other_necessary_measures",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:director_supervisor_removal_registration_cancelled",
    "desc": "解除董（理）事、監察人（監事）職務時，主管機關通知公司登記主管機關廢止其登記",
    "expr": [
      "EQ",
      "director_supervisor_removal_registration_cancelled",
      [
        "IMPLIES",
        [
          "EQ",
          "remove_director_or_supervisor",
          true
        ],
        [
          "EQ",
          "registration_cancelled",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervision_restrictions",
    "desc": "監管處分期間保險業不得超過限額支付款項或處分財產、締結契約或重大義務承諾及其他重大影響財務事項",
    "expr": [
      "EQ",
      "supervision_restrictions",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "supervision_consent_payment_exceed_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervision_consent_contract_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervision_consent_other_major_financial",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisor_execute_inspection",
    "desc": "監管人執行監管職務時，準用檢查規定",
    "expr": [
      "EQ",
      "supervisor_execute_inspection",
      [
        "EQ",
        "inspection_rules_applied",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:funds_deposit_limit_exceeded",
    "desc": "存款於每一金融機構金額超過資金百分之十且未經主管機關核准",
    "expr": [
      "EQ",
      "funds_deposit_limit_exceeded",
      [
        "AND",
        [
          "GT",
          "deposit_amount_per_financial_institution",
          [
            "MUL",
            "total_funds",
            0.1
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "deposit_limit_approved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_in_insurance_related_business",
    "desc": "投資保險相關事業符合主管機關認定",
    "expr": [
      "EQ",
      "investment_in_insurance_related_business",
      [
        "EQ",
        "insurance_related_business_approved",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_derivative_trading_compliance",
    "desc": "從事衍生性商品交易符合主管機關規定",
    "expr": [
      "EQ",
      "investment_derivative_trading_compliance",
      [
        "EQ",
        "derivative_trading_compliance",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_accounting_bookkeeping_compliance",
    "desc": "投資型保險業務專設帳簿管理保存及運用符合主管機關規定",
    "expr": [
      "EQ",
      "investment_accounting_bookkeeping_compliance",
      [
        "EQ",
        "special_accounting_compliance",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:full_discretionary_investment_requires_approval",
    "desc": "保險契約委任全權決定運用標的且投資於有價證券須申請兼營全權委託投資業務",
    "expr": [
      "EQ",
      "full_discretionary_investment_requires_approval",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "full_discretionary_investment",
            true
          ],
          [
            "EQ",
            "investment_in_securities",
            true
          ]
        ],
        [
          "EQ",
          "full_discretionary_investment_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "taiwan_cross_strait_violation_penalty",
    "desc": "違反臺灣地區與大陸地區人民關係條例第81條規定之處罰",
    "expr": [
      "EQ",
      "taiwan_cross_strait_violation_penalty",
      [
        "OR",
        [
          "EQ",
          "violate_article_36_1_or_2",
          true
        ],
        [
          "EQ",
          "violate_financial_institution_restriction_order",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "taiwan_cross_strait"
  },
  {
    "id": "taiwan_cross_strait_violation_fine_and_imprisonment",
    "desc": "違反規定處以罰鍰及刑罰",
    "expr": [
      "EQ",
      "violation_fine_and_imprisonment",
      [
        "OR",
        [
          "EQ",
          "violate_article_36_1_or_2",
          true
        ],
        [
          "EQ",
          "violate_financial_institution_restriction_order",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "taiwan_cross_strait"
  },
  {
    "id": "taiwan_cross_strait_financial_institution_permitted_business",
    "desc": "臺灣地區金融保險證券期貨機構經財政部許可與大陸地區人民或機構有業務往來",
    "expr": [
      "EQ",
      "financial_institution_permitted_business",
      [
        "EQ",
        "permit_by_finance_ministry",
        true
      ]
    ],
    "weight": 1,
    "domain": "taiwan_cross_strait"
  },
  {
    "id": "taiwan_cross_strait_branch_establishment_reported",
    "desc": "臺灣地區金融保險證券期貨機構在大陸地區設立分支機構已報經財政部許可",
    "expr": [
      "EQ",
      "branch_establishment_reported",
      [
        "EQ",
        "report_to_finance_ministry",
        true
      ]
    ],
    "weight": 1,
    "domain": "taiwan_cross_strait"
  },
  {
    "id": "taiwan_cross_strait_business_restriction_approved",
    "desc": "財政部報請行政院核定限制或禁止業務直接往來",
    "expr": [
      "EQ",
      "business_restriction_approved",
      [
        "EQ",
        "restriction_approved_by_cabinet",
        true
      ]
    ],
    "weight": 1,
    "domain": "taiwan_cross_strait"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "NOT",
        "penalty"
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反資本嚴重不足未完成增資或改善計畫、財務業務惡化未改善、違反監管限制或違反臺灣地區與大陸地區人民關係條例規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_4_measures_executed",
              true
            ]
          ]
        ],
        [
          "EQ",
          "financial_or_business_deterioration",
          true
        ],
        [
          "EQ",
          "supervision_restrictions",
          true
        ],
        [
          "EQ",
          "taiwan_cross_strait_violation_penalty",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]