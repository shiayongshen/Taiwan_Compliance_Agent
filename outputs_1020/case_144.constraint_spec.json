  {
    "id": "insurance:violation_of_management_rules",
    "desc": "違反保險法第163條第4項管理規則財務或業務管理規定、163條第7項規定、165條第1項或163條第5項準用規定",
    "expr": [
      "EQ",
      "violation_of_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_or_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_article_163_paragraph_7",
          true
        ],
        [
          "EQ",
          "violate_article_165_paragraph_1_or_163_paragraph_5",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:correction_order_issued",
    "desc": "違反管理規則者已限期改正",
    "expr": [
      "EQ",
      "correction_order_issued",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_imposed",
    "desc": "違反管理規則者處以罰鍰",
    "expr": [
      "EQ",
      "penalty_imposed",
      [
        "AND",
        [
          "EQ",
          "violation_of_management_rules",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "correction_order_issued",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:serious_violation",
    "desc": "情節重大者",
    "expr": [
      "EQ",
      "serious_violation",
      true
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:license_revoked",
    "desc": "情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "license_revoked",
      [
        "AND",
        [
          "EQ",
          "violation_of_management_rules",
          true
        ],
        [
          "EQ",
          "serious_violation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反管理規則且未限期改正，或情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_of_management_rules",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "correction_order_issued",
              true
            ]
          ]
        ],
        [
          "EQ",
          "license_revoked",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]