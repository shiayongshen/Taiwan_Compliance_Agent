[
  {
    "id": "insurance:license_required",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可並領有執業證照",
    "expr": [
      "EQ",
      "license_required",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "EQ",
          "license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:guarantee_deposit_and_insurance_required",
    "desc": "須繳存保證金並投保相關保險",
    "expr": [
      "EQ",
      "guarantee_and_insurance_ok",
      [
        "AND",
        [
          "EQ",
          "guarantee_deposit_paid",
          true
        ],
        [
          "EQ",
          "related_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_insurance_type",
    "desc": "相關保險類型依身份區分",
    "expr": [
      "EQ",
      "related_insurance_type_ok",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "is_agent",
            true
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              1
            ],
            [
              "EQ",
              "insurance_type",
              2
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_notary",
            true
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:business_allowed",
    "desc": "領有執業證照且繳存保證金並投保相關保險後，始得經營或執行業務",
    "expr": [
      "EQ",
      "business_allowed",
      [
        "AND",
        [
          "EQ",
          "license_required",
          true
        ],
        [
          "EQ",
          "guarantee_and_insurance_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_to_operate",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務",
    "expr": [
      "EQ",
      "bank_permission_ok",
      [
        "AND",
        [
          "EQ",
          "bank_approved_by_authority",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_as_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_as_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_ok",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_report_and_fee_disclosure",
    "desc": "保險經紀人洽訂契約前應主動提供書面分析報告並明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_ok",
      [
        "AND",
        [
          "EQ",
          "broker_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:compliance_all",
    "desc": "保險代理人、經紀人、公證人合規條件",
    "expr": [
      "EQ",
      "compliance_all",
      [
        "AND",
        [
          "EQ",
          "business_allowed",
          true
        ],
        [
          "EQ",
          "related_insurance_type_ok",
          true
        ],
        [
          "EQ",
          "broker_duty_ok",
          true
        ],
        [
          "EQ",
          "broker_report_and_fee_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:illegal_operation",
    "desc": "未領有執業證照而經營或執行保險代理人、經紀人、公證人業務",
    "expr": [
      "EQ",
      "illegal_operation",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "license_held",
            true
          ]
        ],
        [
          "EQ",
          "operating_as_agent_broker_notary",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:criminal_violation",
    "desc": "非本法保險業代理、經紀或招攬保險業務者",
    "expr": [
      "EQ",
      "criminal_violation",
      [
        "EQ",
        "not_authorized_insurance_business",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反未經許可經營、未領執業證照經營或非本法保險業代理經紀招攬業務",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "criminal_violation",
          true
        ],
        [
          "EQ",
          "illegal_operation",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "license_required",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]