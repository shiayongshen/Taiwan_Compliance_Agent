[
  {
    "id": "insurance:internal_control_compliance",
    "desc": "建立且確實執行內部控制、稽核制度、招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "audit_system_established",
          true
        ],
        [
          "EQ",
          "audit_system_executed",
          true
        ],
        [
          "EQ",
          "solicitation_handling_system_established",
          true
        ],
        [
          "EQ",
          "solicitation_handling_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:management_rule_compliance",
    "desc": "遵守財務或業務管理相關管理規則及相關規定",
    "expr": [
      "EQ",
      "management_rule_compliance",
      [
        "AND",
        [
          "EQ",
          "financial_management_rule_complied",
          true
        ],
        [
          "EQ",
          "business_management_rule_complied",
          true
        ],
        [
          "EQ",
          "article_165_1_complied",
          true
        ],
        [
          "EQ",
          "article_163_5_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "finance_consumer:violation_advertising",
    "desc": "違反廣告、業務招攬、營業促銷活動方式或內容規定",
    "expr": [
      "EQ",
      "violation_advertising",
      [
        "EQ",
        "violate_advertising_rule",
        true
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "finance_consumer:violation_consumer_info",
    "desc": "違反未充分瞭解金融消費者資料及適合度規定",
    "expr": [
      "EQ",
      "violation_consumer_info",
      [
        "OR",
        [
          "EQ",
          "violate_consumer_info_rule",
          true
        ],
        [
          "EQ",
          "violate_suitability_consideration_rule",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "finance_consumer:violation_disclosure",
    "desc": "違反未充分說明金融商品、服務、契約重要內容或揭露風險規定",
    "expr": [
      "EQ",
      "violation_disclosure",
      [
        "OR",
        [
          "EQ",
          "violate_disclosure_rule",
          true
        ],
        [
          "EQ",
          "violate_disclosure_method_rule",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "finance_consumer:violation_compensation_system",
    "desc": "違反酬金制度訂定或執行規定",
    "expr": [
      "EQ",
      "violation_compensation_system",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "compensation_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "compensation_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "finance_consumer:violation_formal_condition",
    "desc": "協助金融服務業未符合形式條件者",
    "expr": [
      "EQ",
      "violation_formal_condition",
      [
        "EQ",
        "assist_violate_formal_condition",
        true
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "finance_consumer:serious_violation",
    "desc": "金融服務業違反規定且情節重大",
    "expr": [
      "EQ",
      "serious_violation",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "violation_advertising",
            true
          ],
          [
            "EQ",
            "violation_consumer_info",
            true
          ],
          [
            "EQ",
            "violation_disclosure",
            true
          ],
          [
            "EQ",
            "violation_compensation_system",
            true
          ],
          [
            "EQ",
            "violation_formal_condition",
            true
          ]
        ],
        [
          "EQ",
          "violation_serious",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer"
  },
  {
    "id": "insurance:internal_control_established_and_approved",
    "desc": "內部控制、稽核制度與招攬處理制度及程序經董（理）事會通過",
    "expr": [
      "EQ",
      "internal_control_approved",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "audit_system_established",
          true
        ],
        [
          "EQ",
          "solicitation_handling_system_established",
          true
        ],
        [
          "EQ",
          "board_of_directors_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_audit_committee_approval",
    "desc": "設置審計委員會者，內部控制、稽核制度與招攬處理制度及程序經審計委員會同意",
    "expr": [
      "EQ",
      "internal_control_audit_committee_approved",
      [
        "IMPLIES",
        [
          "EQ",
          "audit_committee_established",
          true
        ],
        [
          "AND",
          [
            "GE",
            "audit_committee_approval_ratio",
            0.5
          ],
          [
            "EQ",
            "board_of_directors_resolution",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_established_timing",
    "desc": "公開發行公司或營業收入達2億者，次年內建立內部控制、稽核制度與招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_established_timing",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "is_public_company",
            true
          ],
          [
            "GE",
            "annual_revenue",
            200000000.0
          ]
        ],
        [
          "EQ",
          "internal_control_established_within_next_year",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_report_filing_compliance",
    "desc": "代理人離職及任用報備符合規定",
