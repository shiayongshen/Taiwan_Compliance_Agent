[
  {
    "id": "fhc:confidentiality_obligation",
    "desc": "金融控股公司及其子公司應保守客戶個人資料、往來交易資料及其他相關資料秘密",
    "expr": [
      "EQ",
      "confidentiality_obligation",
      [
        "EQ",
        "confidentiality_maintained",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:confidentiality_measures_disclosed",
    "desc": "主管機關已令金融控股公司及其子公司訂定書面保密措施並揭露重要事項",
    "expr": [
      "EQ",
      "confidentiality_measures_disclosed",
      [
        "EQ",
        "confidentiality_measures_set_and_disclosed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_1",
    "desc": "違反第六條第一項規定，未申請設立金融控股公司",
    "expr": [
      "EQ",
      "violation_1",
      [
        "EQ",
        "establishment_application_submitted",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_2",
    "desc": "違反第十六條第三項規定，未經主管機關核准而持有股份",
    "expr": [
      "EQ",
      "violation_2",
      [
        "EQ",
        "shareholding_approved_by_authority",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_3",
    "desc": "違反第十六條第一項、第二項或第九項規定未向主管機關申報，或違反同條第七項但書規定增加持股",
    "expr": [
      "EQ",
      "violation_3",
      [
        "OR",
        [
          "EQ",
          "reporting_to_authority_done",
          false
        ],
        [
          "EQ",
          "shareholding_increased_illegally",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_4",
    "desc": "違反第十六條第十項規定，未依主管機關所定期限處分",
    "expr": [
      "EQ",
      "violation_4",
      [
        "EQ",
        "disposition_within_deadline",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_5",
    "desc": "違反主管機關依第十六條第五項所定辦法中有關申報或公告之規定",
    "expr": [
      "EQ",
      "violation_5",
      [
        "EQ",
        "reporting_or_announcement_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_6",
    "desc": "違反第十六條第六項規定，為質權之設定",
    "expr": [
      "EQ",
      "violation_6",
      [
        "EQ",
        "pledge_setting_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_7",
    "desc": "違反第十八條第一項規定，未經許可為合併、概括讓與或概括承受",
    "expr": [
      "EQ",
      "violation_7",
      [
        "EQ",
        "merger_or_transfer_permitted",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_8",
    "desc": "違反第三十八條規定，持有金融控股公司之股份",
    "expr": [
      "EQ",
      "violation_8",
      [
        "EQ",
        "shareholding_compliant_38",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_9",
    "desc": "違反第三十九條第一項所定短期資金運用項目；或違反同條第二項規定，未經核准投資不動產或投資非自用不動產",
    "expr": [
      "EQ",
      "violation_9",
      [
        "OR",
        [
          "EQ",
          "short_term_fund_usage_compliant",
          false
        ],
        [
          "EQ",
          "real_estate_investment_approved",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_10",
    "desc": "違反主管機關依第三十九條第三項所定辦法中有關發行條件或期限之規定",
    "expr": [
      "EQ",
      "violation_10",
      [
        "EQ",
        "issuance_conditions_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_11",
    "desc": "違反主管機關依第四十條或第四十一條所定之比率或所為之處置或限制",
    "expr": [
      "EQ",
      "violation_11",
      [
        "EQ",
        "ratio_or_disposition_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_12",
    "desc": "違反第四十二條第一項規定，未保守秘密",
    "expr": [
      "EQ",
      "violation_12",
      [
        "NOT",
        [
          "EQ",
          "confidentiality_obligation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_13",
    "desc": "違反第四十三條第一項、第二項或第四項規定；或違反主管機關依同條第三項所定辦法中有關可從事之業務範圍、資訊交互運用、共用設備、場所或人員管理之規定",
    "expr": [
      "EQ",
      "violation_13",
      [
        "EQ",
        "fhc_43_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_14",
    "desc": "違反第四十五條第一項交易條件之限制或董事會之決議方法；或違反同條第四項所定之金額比率",
    "expr": [
      "EQ",
      "violation_14",
      [
        "EQ",
        "fhc_45_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_15",
    "desc": "違反第四十六條第一項規定，未向主管機關申報或揭露",
    "expr": [
      "EQ",
      "violation_15",
      [
        "EQ",
        "fhc_46_reporting_compliant",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_16",
    "desc": "違反第五十一條規定，未建立內部控制或稽核制度，或未確實執行",
    "expr": [
      "EQ",
      "violation_16",
      [
        "OR",
        [
          "EQ",
          "internal_control_established",
          false
        ],
        [
          "EQ",
          "internal_audit_established",
          false
        ],
        [
          "EQ",
          "internal_control_executed",
          false
        ],
        [
          "EQ",
          "internal_audit_executed",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_17",
    "desc": "違反第五十三條第一項或第二項規定；或未於主管機關依同條第三項所定期限內補足資本",
    "expr": [
      "EQ",
      "violation_17",
      [
        "OR",
        [
          "EQ",
          "fhc_53_compliant",
          false
        ],
        [
          "EQ",
          "capital_replenished_within_deadline",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_18",
    "desc": "違反主管機關依第五十五條第一項所為之命令",
    "expr": [
      "EQ",
      "violation_18",
      [
        "EQ",
        "fhc_55_order_complied",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_19",
    "desc": "違反第五十六條第一項規定，未盡協助義務；或違反主管機關依同條第二項所為之命令",
    "expr": [
      "EQ",
      "violation_19",
      [
        "OR",
        [
          "EQ",
          "assistance_obligation_fulfilled",
          false
        ],
        [
          "EQ",
          "fhc_56_order_complied",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
