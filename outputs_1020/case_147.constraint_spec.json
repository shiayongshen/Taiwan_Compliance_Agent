    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關法條規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "agent_broker_officer_violation",
          true
        ],
        [
          "EQ",
          "penalty_167_2",
          true
        ],
        [
          "EQ",
          "penalty_167_3",
          true
        ],
        [
          "EQ",
          "penalty_30_1",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
