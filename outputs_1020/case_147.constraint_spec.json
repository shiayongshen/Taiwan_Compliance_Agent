        [
          "EQ",
          "violation_30_1_3",
          true
        ],
        [
          "EQ",
          "violation_30_1_4",
          true
        ],
        [
          "EQ",
          "violation_30_1_5",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "finance_consumer_protection"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
