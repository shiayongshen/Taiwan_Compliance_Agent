[
  {
    "id": "insurance:agent_broker_officer_violation",
    "desc": "保險代理人、經紀人、公證人違反法令或有礙健全經營",
    "expr": [
      "EQ",
      "agent_broker_officer_violation",
      [
        "EQ",
        "violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_measures",
    "desc": "主管機關可採取之處分措施",
    "expr": [
      "EQ",
      "penalty_measures",
      [
        "CASE",
        [
          "EQ",
          "restriction_of_business_scope",
          true
        ],
        1,
        [
          "EQ",
          "dismissal_of_manager_or_staff",
          true
        ],
        2,
        [
          "EQ",
          "dismissal_or_suspension_of_director_or_supervisor",
          true
        ],
        3,
        [
          "EQ",
          "other_necessary_measures",
          true
        ],
        4,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_167_2",
    "desc": "違反保險法第163條相關財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_167_2",
      [
        "OR",
        [
          "EQ",
          "violate_financial_or_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_163_7",
          true
        ],
        [
          "EQ",
          "violate_165_1",
          true
        ],
        [
          "EQ",
          "violate_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_167_2",
    "desc": "違反第167-2條應限期改正或處罰",
    "expr": [
      "EQ",
      "penalty_167_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "correction_made_167_2",
            true
          ]
        ],
        [
          "EQ",
          "fine_imposed_167_2",
          true
        ],
        [
          "EQ",
          "license_revoked",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_167_3",
    "desc": "違反保險法第165條第三項或第163條第五項準用規定，未建立或未確實執行內部控制等制度",
    "expr": [
      "EQ",
      "violation_167_3",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_handling_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_167_3",
    "desc": "違反第167-3條應限期改正或處罰",
    "expr": [
      "EQ",
      "penalty_167_3",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "correction_made_167_3",
            true
          ]
        ],
        [
          "EQ",
          "fine_imposed_167_3",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
