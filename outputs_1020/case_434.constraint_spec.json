[
  {
    "id": "securities:investment_decision_recorded",
    "desc": "證券投資信託事業投資決定依據分析作成並有合理基礎，交付執行時作成紀錄，並按月檢討",
    "expr": [
      "EQ",
      "investment_decision_recorded",
      [
        "AND",
        [
          "EQ",
          "investment_decision_based_on_analysis",
          true
        ],
        [
          "EQ",
          "investment_decision_has_reasonable_basis",
          true
        ],
        [
          "EQ",
          "execution_recorded",
          true
        ],
        [
          "EQ",
          "monthly_review_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_established_and_executed",
    "desc": "證券投資信託事業內部控制制度訂定並確實執行，控制作業留存紀錄並保存一定期限",
    "expr": [
      "EQ",
      "internal_control_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_documented",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "control_operation_recorded",
          true
        ],
        [
          "GE",
          "control_record_retention_period_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_qualification_compliance",
    "desc": "證券投資信託事業及顧問事業人員資格條件、行為規範、訓練、登記期限及程序符合主管機關規定",
    "expr": [
      "EQ",
      "personnel_qualification_compliance",
      [
        "EQ",
        "personnel_qualification_meets_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_penalties",
    "desc": "主管機關對違反法令者得依情節輕重處分",
    "expr": [
      "EQ",
      "violation_penalties_applicable",
      [
        "EQ",
        "violation_of_law_or_order",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_misconduct_affects_operations",
    "desc": "證券投資信託事業及顧問事業人員違反法令行為足以影響業務正常執行",
    "expr": [
      "EQ",
      "personnel_misconduct_affects_operations",
      [
        "EQ",
        "personnel_violation_affects_operations",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:serious_violations_fines_and_orders",
    "desc": "證券投資信託事業或顧問事業違反特定條文規定，處罰鍰並責令限期改善，屆期不改善加重處罰",
    "expr": [
      "EQ",
      "serious_violations_fines_and_orders",
      [
        "AND",
        [
          "EQ",
          "violation_of_specified_provisions",
          true
        ],
        [
          "EQ",
          "fine_imposed",
          true
        ],
        [
          "EQ",
          "improvement_ordered",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:minor_violations_fines_and_orders",
    "desc": "證券投資信託事業、顧問事業、基金保管機構違反申報、帳簿保存等規定，處罰鍰並責令限期改善，屆期不改善加重處罰",
    "expr": [
      "EQ",
      "minor_violations_fines_and_orders",
      [
        "AND",
        [
          "EQ",
          "violation_of_reporting_or_recording_rules",
          true
        ],
        [
          "EQ",
          "fine_imposed",
          true
        ],
        [
          "EQ",
          "improvement_ordered",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_duty_of_care_and_prohibited_behaviors",
    "desc": "證券投資信託事業負責人及業務人員應以善良管理人注意義務執行業務，且不得有列舉之不當行為",
    "expr": [
      "EQ",
      "personnel_duty_of_care_and_prohibited_behaviors",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_and_loyalty_observed",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "disclosure_of_confidential_info",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "self_dealing_or_related_party_trading",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fraudulent_or_misleading_behavior",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "failure_to_return_commissions_to_fund",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "providing_undue_benefits_for_promotion",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "selling_proxy_votes_for_money",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "manipulating_security_prices",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_account_transfers",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_public_recommendations",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "using_non_professional_agents_or_unreasonable_commissions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_agent_trading",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_acts_harming_clients_or_business",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_confidentiality",
    "desc": "證券投資信託事業人員對受益人或客戶資料應保守秘密",
    "expr": [
      "EQ",
      "personnel_confidentiality",
      [
        "EQ",
        "confidentiality_observed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_organization_and_execution",
    "desc": "各服務事業內部控制制度訂定明確組織結構、呈報體系及權責，並確實執行及隨時檢討",
    "expr": [
      "EQ",
      "internal_control_organization_and_execution",
      [
        "AND",
        [
          "EQ",
          "internal_control_organization_documented",
          true
        ],
        [
          "EQ",
          "internal_control_execution_confirmed",
          true
        ],
        [
          "EQ",
          "internal_control_periodic_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_audit_responsibility_and_reporting",
    "desc": "內部稽核人員發現重大弊端應揭露並建議懲處，相關人員應負失職責任",
    "expr": [
      "EQ",
      "internal_audit_responsibility_and_reporting",
      [
        "AND",
        [
          "EQ",
          "major_deficiency_or_misconduct_disclosed",
          true
        ],
        [
          "EQ",
          "recommendation_for_disciplinary_action_made",
          true
        ],
        [
          "EQ",
          "responsible_persons_held_accountable",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一法定要求時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "investment_decision_recorded",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_qualification_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_duty_of_care_and_prohibited_behaviors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_confidentiality",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_organization_and_execution",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_audit_responsibility_and_reporting",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "serious_violations_fines_and_orders",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "minor_violations_fines_and_orders",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]