[
  {
    "id": "insurance:capital_level_severe_insufficient",
    "desc": "資本等級為嚴重不足",
    "expr": [
      "EQ",
      "capital_level_severe_insufficient",
      [
        "OR",
        [
          "LT",
          "capital_adequacy_ratio",
          50.0
        ],
        [
          "LT",
          "net_worth",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_significant_deterioration",
    "desc": "財務或業務狀況顯著惡化且不能支付債務或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "capital_level_significant_deterioration",
      [
        "OR",
        [
          "EQ",
          "financial_or_business_deteriorated",
          true
        ],
        [
          "EQ",
          "unable_to_pay_debt",
          true
        ],
        [
          "EQ",
          "unable_to_fulfill_contract",
          true
        ],
        [
          "EQ",
          "risk_to_insured_rights",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_submitted_and_approved",
    "desc": "提出財務或業務改善計畫並經主管機關核定",
    "expr": [
      "EQ",
      "improvement_plan_submitted_and_approved",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_accelerated_deterioration",
    "desc": "損益、淨值呈現加速惡化且經輔導仍未改善",
    "expr": [
      "EQ",
      "improvement_plan_accelerated_deterioration",
      [
        "AND",
        [
          "EQ",
          "profit_loss_accelerated_deterioration",
          true
        ],
        [
          "EQ",
          "net_worth_accelerated_deterioration",
          true
        ],
        [
          "EQ",
          "improvement_plan_not_improved_after_guidance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_applicable",
    "desc": "主管機關得為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervisory_measures_applicable",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level_severe_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_increase_or_improvement_plan_completed",
              true
            ]
          ],
          [
            "LE",
            "days_after_deadline",
            90
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level_significant_deterioration",
            true
          ],
          [
            "EQ",
            "improvement_plan_submitted_and_approved",
            true
          ],
          [
            "EQ",
            "improvement_plan_accelerated_deterioration",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_restrictions",
    "desc": "保險業監管處分限制行為",
    "expr": [
      "EQ",
      "supervisory_restrictions",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "supervisory_consent_payment_exceed_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisory_consent_contract_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisory_consent_other_major_financial_matters",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established_and_executed",
    "desc": "建立並執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_established_and_executed",
    "desc": "建立並執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "money_laundering:internal_control_and_audit_established",
    "desc": "金融機構及指定非金融事業建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "money_laundering_internal_control_established",
      [
        "EQ",
        "money_laundering_internal_control_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "money_laundering"
  },
  {
    "id": "money_laundering:internal_control_and_audit_executed",
    "desc": "金融機構及指定非金融事業執行洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "money_laundering_internal_control_executed",
      [
        "EQ",
        "money_laundering_internal_control_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "money_laundering"
  },
  {
    "id": "money_laundering:improvement_order_issued_and_completed",
    "desc": "違反洗錢防制規定被限期改善且已完成改善",
    "expr": [
      "EQ",
      "money_laundering_improvement_completed",
      [
        "AND",
        [
          "EQ",
          "money_laundering_improvement_ordered",
          true
        ],
        [
          "EQ",
          "money_laundering_improvement_completed_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "money_laundering"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反保險法及洗錢防制法相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level_severe_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_increase_or_improvement_plan_completed",
              true
            ]
          ],
          [
            "GT",
            "days_after_deadline",
            90
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level_significant_deterioration",
            true
          ],
          [
            "EQ",
            "improvement_plan_submitted_and_approved",
            true
          ],
          [
            "EQ",
            "improvement_plan_accelerated_deterioration",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "money_laundering_improvement_ordered",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "money_laundering_improvement_completed_flag",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]