[
  {
    "id": "financial_consumer:understanding_and_suitability",
    "desc": "金融服務業充分瞭解金融消費者相關資料並確保適合度",
    "expr": [
      "EQ",
      "understanding_and_suitability",
      [
        "AND",
        [
          "EQ",
          "consumer_data_fully_understood",
          true
        ],
        [
          "EQ",
          "product_service_suitable",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:bank_securities_consumer_data_complete",
    "desc": "銀行及證券期貨業充分瞭解金融消費者相關資料且資料經確認",
    "expr": [
      "EQ",
      "bank_securities_consumer_data_complete",
      [
        "AND",
        [
          "EQ",
          "consumer_identity_confirmed",
          true
        ],
        [
          "EQ",
          "consumer_financial_background_confirmed",
          true
        ],
        [
          "EQ",
          "consumer_income_and_funds_confirmed",
          true
        ],
        [
          "EQ",
          "consumer_risk_preference_confirmed",
          true
        ],
        [
          "EQ",
          "consumer_investment_experience_confirmed",
          true
        ],
        [
          "EQ",
          "consumer_contract_purpose_confirmed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:bank_securities_investment_ability_evaluated",
    "desc": "銀行及證券期貨業綜合考量資料評估金融消費者投資能力",
    "expr": [
      "EQ",
      "bank_securities_investment_ability_evaluated",
      [
        "AND",
        [
          "EQ",
          "consumer_funds_operation_assessed",
          true
        ],
        [
          "EQ",
          "consumer_professional_ability_assessed",
          true
        ],
        [
          "EQ",
          "consumer_investment_attributes_assessed",
          true
        ],
        [
          "EQ",
          "consumer_risk_understanding_assessed",
          true
        ],
        [
          "EQ",
          "consumer_risk_tolerance_assessed",
          true
        ],
        [
          "EQ",
          "service_suitability_assessed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:insurance_suitability_considered",
    "desc": "保險業提供投資型保險商品前考量適合度事項",
    "expr": [
      "EQ",
      "insurance_suitability_considered",
      [
        "AND",
        [
          "EQ",
          "consumer_understands_premium_usage",
          true
        ],
        [
          "EQ",
          "insurance_amount_and_premium_match_needs",
          true
        ],
        [
          "EQ",
          "consumer_investment_attributes_and_risk_tolerance_assessed",
          true
        ],
        [
          "EQ",
          "consumer_understands_investment_risks",
          true
        ],
        [
          "EQ",
          "transaction_control_mechanism_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:bank_product_review_group_established",
    "desc": "銀行業設立商品審查小組並進行投資型金融商品上架前審查",
    "expr": [
      "EQ",
      "bank_product_review_group_established",
      [
        "AND",
        [
          "EQ",
          "product_review_group_established",
          true
        ],
        [
          "EQ",
          "investment_product_pre_listing_review_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:bank_securities_risk_level_classification_done",
    "desc": "銀行及證券期貨業完成金融消費者風險承受等級及商品風險等級分類",
    "expr": [
      "EQ",
      "risk_level_classification_done",
      [
        "AND",
        [
          "EQ",
          "consumer_risk_tolerance_level_classified",
          true
        ],
        [
          "EQ",
          "product_service_risk_level_classified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "insurance:agent_broker_license_and_insurance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可、繳存保證金並投保相關保險",
    "expr": [
      "EQ",
      "agent_broker_license_and_insurance",
      [
        "AND",
        [
          "EQ",
          "license_obtained",
          true
        ],
        [
          "EQ",
          "guarantee_deposit_paid",
          true
        ],
        [
          "EQ",
          "related_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fiduciary",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fiduciary",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_fulfilled",
          true
        ],
        [
          "EQ",
          "fiduciary_duty_fulfilled",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_report_and_disclose_fee",
    "desc": "保險經紀人於指定範圍內提供書面分析報告並明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_written_report_and_fee_disclosed",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "EQ",
          "fee_disclosure_made",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融消費者保護法第9條及相關辦法規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "understanding_and_suitability",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_securities_consumer_data_complete",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_securities_investment_ability_evaluated",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_suitability_considered",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_product_review_group_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "risk_level_classification_done",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_broker_license_and_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fiduciary",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_written_report_and_fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]