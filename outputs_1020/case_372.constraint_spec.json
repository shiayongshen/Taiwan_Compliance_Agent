[
  {
    "id": "bank:investment_limit_stock_and_equity",
    "desc": "商業銀行投資於集中交易市場與店頭市場股票等原始取得成本總餘額不得超過核算基數30%",
    "expr": [
      "EQ",
      "investment_limit_stock_and_equity",
      [
        "LE",
        "cost_stock_and_equity",
        [
          "MUL",
          "capital_base",
          0.3
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:investment_limit_otc_stock_and_equity",
    "desc": "商業銀行投資於店頭市場股票及相關權證等原始取得成本總餘額不得超過核算基數5%",
    "expr": [
      "EQ",
      "investment_limit_otc_stock_and_equity",
      [
        "LE",
        "cost_otc_stock_and_equity",
        [
          "MUL",
          "capital_base",
          0.05
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:investment_limit_unrated_short_term_and_bonds",
    "desc": "商業銀行投資於無信用評等或信用評等未達標準短期票券及債券等原始取得成本總餘額不得超過核算基數10%",
    "expr": [
      "EQ",
      "investment_limit_unrated_short_term_and_bonds",
      [
        "LE",
        "cost_unrated_short_term_and_bonds",
        [
          "MUL",
          "capital_base",
          0.1
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:investment_limit_total_excluding_government",
    "desc": "銀行投資於第二點第一項各種有價證券總餘額（除政府公債等）不得超過存款總餘額及金融債券發售額和的25%",
    "expr": [
      "EQ",
      "investment_limit_total_excluding_government",
      [
        "LE",
        "total_investment_excluding_government",
        [
          "MUL",
          [
            "ADD",
            "total_deposits",
            "financial_bond_issuance"
          ],
          0.25
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:investment_limit_stock_per_company",
    "desc": "商業銀行投資於每一公司股票及相關權證股份總額不得超過該公司已發行股份總數5%",
    "expr": [
      "EQ",
      "investment_limit_stock_per_company",
      [
        "LE",
        "investment_per_company_stock",
        [
          "MUL",
          "company_total_shares",
          0.05
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:capital_base_calculation",
    "desc": "核算基數為上會計年度決算後淨值扣除特定項目後餘額，年度中現金增資計入，現金股利扣除",
    "expr": [
      "EQ",
      "capital_base",
      [
        "SUB",
        "net_worth_last_year",
        [
          "ADD",
          "cost_long_term_bank_shares",
          "cost_other_enterprise_investments"
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:deposit_total_includes",
    "desc": "存款總餘額包括活期、定期、支票、中華郵政轉存款及外幣存款",
    "expr": [
      "EQ",
      "total_deposits",
      [
        "ADD",
        "demand_deposits",
        "time_deposits",
        "checking_deposits",
        "postal_savings_transfers",
        "foreign_currency_deposits"
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:exclusion_of_sell_back_short_term_bonds",
    "desc": "附賣回條件買入短期票券及債券餘額不計入限額，附買回條件賣出則計入",
    "expr": [
      "EQ",
      "sell_back_short_term_bonds_exclusion_ok",
      [
        "AND",
        [
          "EQ",
          "buy_back_short_term_bonds_balance_excluded",
          true
        ],
        [
          "EQ",
          "sell_back_short_term_bonds_balance_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反投資有價證券種類及限額規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_and_equity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_otc_stock_and_equity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_unrated_short_term_and_bonds",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_total_excluding_government",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_per_company",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sell_back_short_term_bonds_exclusion_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]