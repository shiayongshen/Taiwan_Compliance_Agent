[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures_established",
          true
        ],
        [
          "EQ",
          "training_held",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_designated_matters_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_compliance",
    "desc": "洗錢防制內部控制制度建立且確實執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:reporting_timing_ok",
    "desc": "金融機構於交易完成後五個營業日內申報達一定金額以上通貨交易",
    "expr": [
      "EQ",
      "reporting_timing_ok",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "reporting_media_submitted",
            true
          ],
          [
            "LE",
            "reporting_days_after_transaction",
            5
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "reporting_media_submitted",
            false
          ],
          [
            "EQ",
            "reporting_written_submitted",
            true
          ],
          [
            "EQ",
            "reporting_written_approved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:transaction_amount_threshold",
    "desc": "通貨交易達一定金額以上（新台幣五十萬元含等值外幣）",
    "expr": [
      "EQ",
      "transaction_amount_threshold",
      [
        "GE",
        "transaction_amount_ntd",
        500000.0
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:currency_transaction_defined",
    "desc": "通貨交易定義符合現金收付或換鈔交易",
    "expr": [
      "EQ",
      "currency_transaction_defined",
      [
        "OR",
        [
          "EQ",
          "transaction_is_cash_receipt",
          true
        ],
        [
          "EQ",
          "transaction_is_cash_payment",
          true
        ],
        [
          "EQ",
          "transaction_is_currency_exchange",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:financial_institution_defined",
    "desc": "金融機構定義符合洗錢防制法第5條規定",
    "expr": [
      "EQ",
      "financial_institution_defined",
      [
        "OR",
        [
          "EQ",
          "institution_is_bank",
          true
        ],
        [
          "EQ",
          "institution_is_trust_investment_company",
          true
        ],
        [
          "EQ",
          "institution_is_credit_cooperative",
          true
        ],
        [
          "EQ",
          "institution_is_agricultural_credit_department",
          true
        ],
        [
          "EQ",
          "institution_is_fisheries_credit_department",
          true
        ],
        [
          "EQ",
          "institution_is_national_agricultural_bank",
          true
        ],
        [
          "EQ",
          "institution_is_postal_financial_institution",
          true
        ],
        [
          "EQ",
          "institution_is_bill_finance_company",
          true
        ],
        [
          "EQ",
          "institution_is_credit_card_company",
          true
        ],
        [
          "EQ",
          "institution_is_insurance_company",
          true
        ],
        [
          "EQ",
          "institution_is_securities_firm",
          true
        ],
        [
          "EQ",
          "institution_is_securities_investment_trust",
          true
        ],
        [
          "EQ",
          "institution_is_securities_finance_company",
          true
        ],
        [
          "EQ",
          "institution_is_securities_investment_advisor",
          true
        ],
        [
          "EQ",
          "institution_is_securities_central_depository",
          true
        ],
        [
          "EQ",
          "institution_is_futures_broker",
          true
        ],
        [
          "EQ",
          "institution_is_trust_industry",
          true
        ],
        [
          "EQ",
          "institution_is_other_designated_financial_institution",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:designated_non_financial_business_defined",
    "desc": "指定之非金融事業或人員定義符合洗錢防制法第5條規定",
    "expr": [
      "EQ",
      "designated_non_financial_business_defined",
      [
        "OR",
        [
          "EQ",
          "business_is_jewelry_industry",
          true
        ],
        [
          "EQ",
          "business_is_real_estate_agent_related",
          true
        ],
        [
          "EQ",
          "business_is_lawyer_notary_accountant_related",
          true
        ],
        [
          "EQ",
          "business_is_trust_and_company_service_provider",
          true
        ],
        [
          "EQ",
          "business_is_third_party_payment_service",
          true
        ],
        [
          "EQ",
          "business_is_other_designated_non_financial",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_violation",
    "desc": "違反洗錢防制法第7條未建立制度或未依規定執行",
    "expr": [
      "EQ",
      "internal_control_violation",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "implementation_rules_complied",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:refuse_or_obstruct_inspection",
    "desc": "規避、拒絕或妨礙現地或非現地查核",
    "expr": [
      "EQ",
      "refuse_or_obstruct_inspection",
      [
        "EQ",
        "inspection_obstructed",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反未建立或未依規定執行洗錢防制制度，或規避拒絕妨礙查核時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "internal_control_violation",
          true
        ],
        [
          "EQ",
          "refuse_or_obstruct_inspection",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]