  {
    "id": "securities:penalty_178_1_mild_exemption",
    "desc": "違反178-1條情節輕微且已改善免罰",
    "expr": [
      "EQ",
      "penalty_178_1_mild_exemption",
      [
        "AND",
        [
          "EQ",
          "penalty_178_1_violation",
          true
        ],
        [
          "OR",
          [
