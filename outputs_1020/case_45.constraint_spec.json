[
  {
    "id": "securities:violation_of_law",
    "desc": "證券商董事、監察人及受僱人違反證券交易法或相關法令，影響業務正常執行",
    "expr": [
      "EQ",
      "violation_of_law",
      [
        "EQ",
        "violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:authority_order_stop_or_dismiss",
    "desc": "主管機關命令停止一年以下業務或解除職務",
    "expr": [
      "EQ",
      "authority_order_stop_or_dismiss",
      [
        "OR",
        [
          "EQ",
          "order_stop_business_within_1_year",
          true
        ],
        [
          "EQ",
          "order_dismiss_officer",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:authority_impose_penalty_66",
    "desc": "主管機關依第66條視情節輕重對證券商處分",
    "expr": [
      "EQ",
      "authority_impose_penalty_66",
      [
        "EQ",
        "penalty_66_imposed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:non_compliance_found",
    "desc": "主管機關調查發現證券商有不符合規定事項",
    "expr": [
      "EQ",
      "non_compliance_found",
      [
        "EQ",
        "non_compliance_detected",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:authority_order_correction_or_improvement",
    "desc": "主管機關命令糾正或限期改善",
    "expr": [
      "EQ",
      "authority_order_correction_or_improvement",
      [
        "OR",
        [
          "EQ",
          "order_correction",
          true
        ],
        [
          "EQ",
          "order_improvement_deadline",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_and_penalty_measures",
