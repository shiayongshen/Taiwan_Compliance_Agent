  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反證券交易法相關規定或內部控制制度未建立或未執行，或負責人及業務人員有禁止行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "violation_of_law",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_behaviors",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "penalty_178_1_violation",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "penalty_178_1_mild_exemption",
              true
            ]
