[
  {
    "id": "insurance:agent_license_required",
    "desc": "保險代理人須經主管機關許可並領有執業證照",
    "expr": [
      "EQ",
      "agent_license_required",
      [
        "AND",
        [
          "EQ",
          "agent_permit_granted",
          true
        ],
        [
          "EQ",
          "agent_license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_bond_and_insurance_required",
    "desc": "保險代理人須繳存保證金並投保責任保險",
    "expr": [
      "EQ",
      "agent_bond_and_insurance_required",
      [
        "AND",
        [
          "EQ",
          "agent_bond_deposited",
          true
        ],
        [
          "EQ",
          "agent_liability_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_operate_allowed",
    "desc": "保險代理人得經營或執行業務",
    "expr": [
      "EQ",
      "agent_operate_allowed",
      [
        "AND",
        [
          "EQ",
          "agent_license_required",
          true
        ],
        [
          "EQ",
          "agent_bond_and_insurance_required",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_license_required",
    "desc": "保險經紀人須經主管機關許可並領有執業證照",
    "expr": [
      "EQ",
      "broker_license_required",
      [
        "AND",
        [
          "EQ",
          "broker_permit_granted",
          true
        ],
        [
          "EQ",
          "broker_license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_bond_and_insurance_required",
    "desc": "保險經紀人須繳存保證金並投保責任保險及保證保險",
    "expr": [
      "EQ",
      "broker_bond_and_insurance_required",
      [
        "AND",
        [
          "EQ",
          "broker_bond_deposited",
          true
        ],
        [
          "EQ",
          "broker_liability_insurance_purchased",
          true
        ],
        [
          "EQ",
          "broker_guarantee_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_operate_allowed",
    "desc": "保險經紀人得經營或執行業務",
    "expr": [
      "EQ",
      "broker_operate_allowed",
      [
        "AND",
        [
          "EQ",
          "broker_license_required",
          true
        ],
        [
          "EQ",
          "broker_bond_and_insurance_required",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:notary_license_required",
    "desc": "保險公證人須經主管機關許可並領有執業證照",
    "expr": [
      "EQ",
      "notary_license_required",
      [
        "AND",
        [
          "EQ",
          "notary_permit_granted",
          true
        ],
        [
          "EQ",
          "notary_license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:notary_bond_and_insurance_required",
    "desc": "保險公證人須繳存保證金並投保責任保險",
    "expr": [
      "EQ",
      "notary_bond_and_insurance_required",
      [
        "AND",
        [
          "EQ",
          "notary_bond_deposited",
          true
        ],
        [
          "EQ",
          "notary_liability_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:notary_operate_allowed",
    "desc": "保險公證人得經營或執行業務",
    "expr": [
      "EQ",
      "notary_operate_allowed",
      [
        "AND",
        [
          "EQ",
          "notary_license_required",
          true
        ],
        [
          "EQ",
          "notary_bond_and_insurance_required",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permit_to_operate_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務",
    "expr": [
      "EQ",
      "bank_permit_to_operate_agent_or_broker",
      [
        "EQ",
        "bank_permit_granted",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_apply_agent_broker_rules",
    "desc": "銀行兼營保險代理人或保險經紀人業務時，應分別準用相關規定",
    "expr": [
      "EQ",
      "bank_apply_agent_broker_rules",
      [
        "AND",
        [
          "EQ",
          "bank_operate_as_agent",
          true
        ],
        [
          "EQ",
          "agent_operate_allowed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_apply_broker_rules",
    "desc": "銀行兼營保險經紀人業務時，應分別準用相關規定",
    "expr": [
      "EQ",
      "bank_apply_broker_rules",
      [
        "AND",
        [
          "EQ",
          "bank_operate_as_broker",
          true
        ],
        [
          "EQ",
          "broker_operate_allowed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_exercise_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_report_before_contract",
    "desc": "保險經紀人於洽訂保險契約前應主動提供書面分析報告",
    "expr": [
      "EQ",
      "broker_provide_written_report_before_contract",
      [
        "EQ",
        "broker_written_report_provided",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_disclose_fee_standard",
    "desc": "保險經紀人向要保人或被保險人收取報酬時，應明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_disclose_fee_standard",
      [
        "IMPLIES",
        [
          "EQ",
          "broker_fee_charged",
          true
        ],
        [
          "EQ",
          "broker_fee_standard_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定許可、繳存保證金、投保相關保險或未領執業證照者處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_operate_allowed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_operate_allowed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "notary_operate_allowed",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "bank_permit_to_operate_agent_or_broker",
            true
          ],
          [
            "NOT",
            [
              "OR",
              [
                "EQ",
                "bank_apply_agent_broker_rules",
                true
              ],
              [
                "EQ",
                "bank_apply_broker_rules",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]