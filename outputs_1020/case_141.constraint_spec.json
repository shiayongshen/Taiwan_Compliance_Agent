  },
  {
    "id": "insurance:agent_capital_adjustment_due_to_transfer",
    "desc": "代理人公司股權或資本總額移轉累計達50%以上且非繼承，須於股權交割日或出資轉讓日次日起6個月內完成資本額調整",
    "expr": [
      "EQ",
      "agent_capital_adjustment_due_to_transfer",
      [
        "AND",
        [
          "GE",
          "agent_transfer_ratio",
          50
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_transfer_due_to_inheritance",
            true
          ]
        ],
        [
          "LE",
          "days_since_transfer",
          180
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_capital_adjustment_required_final",
    "desc": "代理人公司需完成資本額調整（含執照持有者期限內調整及股權移轉調整）",
    "expr": [
      "EQ",
      "agent_capital_adjustment_required_final",
      [
        "OR",
        [
          "EQ",
          "agent_capital_adjustment_required",
          true
        ],
        [
          "EQ",
          "agent_capital_adjustment_due_to_transfer",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
