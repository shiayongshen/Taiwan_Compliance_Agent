[
  {
    "id": "fhc:shareholding_over_10_percent_declaration_at_conversion",
    "desc": "金融機構轉換為金融控股公司時，同一人或同一關係人持股超過10%應申報",
    "expr": [
      "EQ",
      "shareholding_over_10_percent_declaration_at_conversion",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent_at_conversion",
          10.0
        ],
        [
          "EQ",
          "declaration_made_at_conversion",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_5_percent_declaration_after_establishment",
    "desc": "金融控股公司設立後，同一人或同一關係人持股超過5%應10日內申報",
    "expr": [
      "EQ",
      "shareholding_over_5_percent_declaration_after_establishment",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent_after_establishment",
          5.0
        ],
        [
          "LE",
          "days_since_shareholding_over_5_percent",
          10
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_accumulated_change_over_1_percent_declaration",
    "desc": "持股超過5%後累積增減逾1%應申報",
    "expr": [
      "EQ",
      "shareholding_accumulated_change_over_1_percent_declaration",
      [
        "IMPLIES",
        [
          "AND",
          [
            "GT",
            "shareholding_percent_after_establishment",
            5.0
          ],
          [
            "GT",
            "accumulated_shareholding_change_percent",
            1.0
          ]
        ],
        [
          "EQ",
          "declaration_made_for_accumulated_change",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_thresholds_prior_approval",
    "desc": "持股超過10%、25%、50%應事先申請核准",
    "expr": [
      "EQ",
      "shareholding_over_thresholds_prior_approval",
      [
        "OR",
        [
          "IMPLIES",
          [
            "GT",
            "shareholding_percent",
            50.0
          ],
          [
            "EQ",
            "prior_approval_50_percent",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "AND",
            [
              "LE",
              25.0,
              "shareholding_percent"
            ],
            [
              "LE",
              "shareholding_percent",
              50.0
            ]
          ],
          [
            "EQ",
            "prior_approval_25_percent",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "AND",
            [
              "LE",
              10.0,
              "shareholding_percent"
            ],
            [
              "LT",
              "shareholding_percent",
              25.0
            ]
          ],
          [
            "EQ",
            "prior_approval_10_percent",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_trust_inclusion",
    "desc": "第三人以信託等方式持股應併入同一關係人範圍",
    "expr": [
      "EQ",
      "shareholding_trust_inclusion",
      [
        "EQ",
        "trust_and_agreement_included_in_related_person",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_over_10_percent_pledge_restriction",
    "desc": "持股超過10%不得設定質權予子公司，例外於轉換前原質權存續期限內",
    "expr": [
      "EQ",
      "shareholding_over_10_percent_pledge_restriction",
      [
        "IMPLIES",
        [
          "GT",
          "shareholding_percent",
          10.0
        ],
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "pledge_to_subsidiary",
              true
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "pledge_to_subsidiary",
              true
            ],
            [
              "EQ",
              "pledge_acquired_before_conversion",
              true
            ],
            [
              "LE",
              "original_pledge_expiry_days",
              0
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_qualification_noncompliance_no_increase",
    "desc": "不符適格條件者得繼續持有但不得增加持股",
    "expr": [
      "EQ",
      "shareholding_qualification_noncompliance_no_increase",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "qualification_conditions_met",
            true
          ]
        ],
        [
          "LE",
          "shareholding_increase_percent",
          0.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:approval_deemed_after_15_business_days",
    "desc": "主管機關15營業日內未反對視為核准",
    "expr": [
      "EQ",
      "approval_deemed_after_15_business_days",
      [
        "IMPLIES",
        [
          "GE",
          "business_days_since_application",
          15
        ],
        [
          "EQ",
          "approval_opposed",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:pre_2008_5_to_10_percent_declaration",
    "desc": "2008年修正前持股5%至10%者應於6個月內申報",
    "expr": [
      "EQ",
      "pre_2008_5_to_10_percent_declaration",
      [
        "IMPLIES",
        [
          "AND",
          [
            "GE",
            "shareholding_percent_before_2008",
            5.0
          ],
          [
            "LE",
            "shareholding_percent_before_2008",
            10.0
          ]
        ],
        [
          "LE",
          "days_since_2008_revision",
          180
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_declaration_compliance",
    "desc": "依第二項、第九項規定申報且依第三項規定核准持股",
    "expr": [
      "EQ",
      "shareholding_declaration_compliance",
      [
        "AND",
        [
          "EQ",
          "declaration_made_after_establishment",
          true
        ],
        [
          "EQ",
          "declaration_made_pre_2008",
          true
        ],
        [
          "EQ",
          "prior_approval_obtained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_pledge_compliance",
    "desc": "未違反持股質權設定限制",
    "expr": [
      "EQ",
      "shareholding_pledge_compliance",
      [
        "NOT",
        [
          "EQ",
          "illegal_pledge_set",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_disposal_compliance",
    "desc": "違規持股超過部分已依主管機關限期處分",
    "expr": [
      "EQ",
      "shareholding_disposal_compliance",
      [
        "EQ",
        "illegal_shareholding_disposed_within_deadline",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反申請核准、申報、持股質權限制或限期處分規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "prior_approval_obtained",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "declaration_made_after_establishment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "declaration_made_pre_2008",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_pledge_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_disposal_compliance",
            true
          ]
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "qualification_conditions_met",
              true
            ]
          ],
          [
            "GT",
            "shareholding_increase_percent",
            0.0
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]