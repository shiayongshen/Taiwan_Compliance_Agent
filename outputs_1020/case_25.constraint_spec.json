[
  {
    "id": "fhc:violation_occurred",
    "desc": "金融控股公司有違反法令、章程或有礙健全經營之虞",
    "expr": [
      "EQ",
      "violation_occurred",
      [
        "EQ",
        "fhc_violation_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_measures",
    "desc": "主管機關可採取之處分措施",
    "expr": [
      "EQ",
      "penalty_measures",
      [
        "CASE",
        [
          "EQ",
          "violation_occurred",
          true
        ],
        1,
        true,
        0,
        0.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:director_supervisor_dismissal_notified",
    "desc": "依第四款解除董事、監察人職務時，主管機關已通知經濟部廢止其登記",
    "expr": [
      "EQ",
      "director_supervisor_dismissal_notified",
      [
        "AND",
        [
          "EQ",
          "dismiss_director_supervisor",
          true
        ],
        [
          "EQ",
          "notification_to_economic_ministry",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:license_revoked",
    "desc": "依第六款廢止許可",
    "expr": [
      "EQ",
      "license_revoked",
      [
        "EQ",
        "license_revocation_ordered",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:disposition_completed_within_deadline",
    "desc": "於期限內完成處分銀行、保險公司或證券商持有股份及董事人數不符規定",
    "expr": [
      "EQ",
      "disposition_completed_within_deadline",
      [
        "AND",
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "EQ",
          "disposition_completed",
          true
        ],
        [
          "EQ",
          "shares_and_directors_not_meet_requirements",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:disposition_not_completed_within_deadline",
    "desc": "未於期限內完成處分，應進行解散及清算",
    "expr": [
      "EQ",
      "disposition_not_completed_within_deadline",
      [
        "AND",
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "disposition_completed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:dissolution_and_liquidation_ordered",
    "desc": "應令進行解散及清算",
    "expr": [
      "EQ",
      "dissolution_and_liquidation_ordered",
      [
        "EQ",
        "disposition_not_completed_within_deadline",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令且未於期限內完成處分或未執行必要處置時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "license_revoked",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "disposition_completed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "OR",
              [
                "EQ",
                "dismiss_director_supervisor",
                true
              ],
              [
                "EQ",
                "license_revoked",
                true
              ],
              [
                "EQ",
                "other_penalty_measures_taken",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]