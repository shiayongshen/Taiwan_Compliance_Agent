[
  {
    "id": "insurance:violate_148_1_2",
    "desc": "違反保險法第148條之一第一項或第二項規定",
    "expr": [
      "EQ",
      "violate_148_1_2",
      [
        "EQ",
        "violate_148_1_1_or_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_1",
    "desc": "違反保險法第148條之二第一項規定，未提供說明文件或說明文件不實",
    "expr": [
      "EQ",
      "violate_148_2_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "explanation_document_provided",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "explanation_document_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "explanation_document_truthful",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_2",
    "desc": "違反保險法第148條之二第二項規定，未依限報告或公開說明，或內容不實",
    "expr": [
      "EQ",
      "violate_148_2_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "report_to_authority_on_time",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "public_explanation_provided",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "report_content_truthful",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_1",
    "desc": "違反保險法第148條之三第一項規定，未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "violate_148_3_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_2",
    "desc": "違反保險法第148條之三第二項規定，未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "violate_148_3_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_ok",
    "desc": "建立且執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "建立且執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_processing_compliance",
    "desc": "核保處理制度及程序符合招攬及核保理賠辦法第7條規定",
    "expr": [
      "EQ",
      "underwriting_processing_compliance",
      [
        "AND",
        [
          "EQ",
          "underwriting_staff_qualified",
          true
        ],
        [
          "EQ",
          "underwriting_process_documented",
          true
        ],
        [
          "EQ",
          "underwriting_risk_assessment_done",
          true
        ],
        [
          "EQ",
          "underwriting_fair_treatment",
          true
        ],
        [
          "EQ",
          "underwriting_signature_verified",
          true
        ],
        [
          "EQ",
          "underwriting_financial_source_checked",
          true
        ],
        [
          "EQ",
          "underwriting_documents_retained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_exceptions_applied",
    "desc": "財務核保機制、生調體檢標準及部分作業程序得不適用於特定保險商品",
    "expr": [
      "EQ",
      "underwriting_exceptions_applied",
      [
        "OR",
        [
          "EQ",
          "product_type_property_insurance",
          true
        ],
        [
          "EQ",
          "product_type_micro_insurance",
          true
        ],
        [
          "EQ",
          "product_type_other_special",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_reported_to_authority",
    "desc": "依規定報主管機關備查",
    "expr": [
      "EQ",
      "underwriting_reported_to_authority",
      [
        "AND",
        [
          "EQ",
          "financial_underwriting_mechanism_reported",
          true
        ],
        [
          "EQ",
          "investor_risk_assessment_reported",
          true
        ],
        [
          "EQ",
          "operational_procedures_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_notification_mechanism_defined",
    "desc": "保險通報機制定義及執行",
    "expr": [
      "EQ",
      "insurance_notification_mechanism_defined",
      [
        "AND",
        [
          "EQ",
          "notification_data_reported",
          true
        ],
        [
          "EQ",
          "underwriting_query_system_used",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:uninsured_personal_data_retention_compliant",
    "desc": "未承保件個人資料保存程序符合規定",
    "expr": [
      "EQ",
      "uninsured_personal_data_retention_compliant",
      [
        "AND",
        [
          "LE",
          "uninsured_data_retention_period_years",
          5.0
        ],
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "longer_retention_law_applied",
              true
            ]
          ],
          [
            "AND",
            [
              "EQ",
              "dispute_processing_continued",
              true
            ],
            [
              "LE",
              "dispute_processing_extension_years",
              1.0
            ]
          ]
        ],
        [
          "EQ",
          "personal_data_protection_law_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:business_execution_compliance",
    "desc": "確實執行招攬、核保及理賠處理制度及程序",
    "expr": [
      "EQ",
      "business_execution_compliance",
      [
        "EQ",
        "business_execution_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reinsurance_risk_spread_compliance",
    "desc": "再保險分出分入及其他危險分散機制符合規定",
    "expr": [
      "EQ",
      "reinsurance_risk_spread_compliance",
      [
        "EQ",
        "reinsurance_mechanism_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_approval_compliance",
    "desc": "國外投資管理符合核准及相關規定",
    "expr": [
      "EQ",
      "foreign_investment_approval_compliance",
      [
        "AND",
        [
          "EQ",
          "foreign_investment_approved",
          true
        ],
        [
          "EQ",
          "foreign_investment_funds_compliant",
          true
        ],
        [
          "EQ",
          "foreign_investment_documents_submitted",
          true
        ],
        [
          "EQ",
          "foreign_investment_internal_control_ok",
          true
        ],
        [
          "EQ",
          "foreign_investment_risk_management_ok",
          true
        ],
        [
          "EQ",
          "foreign_investment_financial_report_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_adjustment_plan_compliance",
    "desc": "國外投資調整計畫訂定及報送符合規定",
    "expr": [
      "EQ",
      "foreign_investment_adjustment_plan_compliance",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_funds_compliant",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "adjustment_plan_set_within_one_month",
            true
          ],
          [
            "EQ",
            "adjustment_plan_approved_by_board",
            true
          ],
          [
            "EQ",
            "adjustment_plan_reported_to_authority",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_approval_revoked",
    "desc": "國外投資額度核准被廢止",
    "expr": [
      "EQ",
      "foreign_investment_approval_revoked",
      [
        "AND",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "foreign_investment_adjustment_plan_compliance",
              true
            ]
          ],
          [
            "GT",
            "foreign_investment_adjustment_plan_violation_count",
            1
          ]
        ],
        [
          "EQ",
          "foreign_investment_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violate_148_1_2",
          true
        ],
        [
          "EQ",
          "violate_148_2_1",
          true
        ],
        [
          "EQ",
          "violate_148_2_2",
          true
        ],
        [
          "EQ",
          "violate_148_3_1",
          true
        ],
        [
          "EQ",
          "violate_148_3_2",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "underwriting_processing_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "underwriting_reported_to_authority",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_notification_mechanism_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "uninsured_personal_data_retention_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "business_execution_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "reinsurance_risk_spread_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_approval_compliance",
            true
          ]
        ],
        [
          "EQ",
          "foreign_investment_approval_revoked",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]