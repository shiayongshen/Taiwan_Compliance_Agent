[
  {
    "id": "insurance:violate_148_1_2",
    "desc": "違反保險法第148條之一第一項或第二項規定",
    "expr": [
      "EQ",
      "violate_148_1_2",
      [
        "EQ",
        "violate_148_1_1_or_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_1",
    "desc": "違反保險法第148條之二第一項規定：未提供說明文件供查閱、或說明文件未依規定記載、或說明文件記載不實",
    "expr": [
      "EQ",
      "violate_148_2_1",
      [
        "OR",
        [
          "EQ",
          "not_provide_explanation_doc",
          true
        ],
        [
          "EQ",
          "explanation_doc_not_according_to_rule",
          true
        ],
        [
          "EQ",
          "explanation_doc_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_2",
    "desc": "違反保險法第148條之二第二項規定：未依限向主管機關報告或主動公開說明，或報告或公開說明內容不實",
    "expr": [
      "EQ",
      "violate_148_2_2",
      [
        "OR",
        [
          "EQ",
          "not_report_to_authority_in_time",
          true
        ],
        [
          "EQ",
          "not_public_explanation",
          true
        ],
        [
          "EQ",
          "report_or_explanation_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_1",
    "desc": "違反保險法第148條之三第一項規定：未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "violate_148_3_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_2",
    "desc": "違反保險法第148條之三第二項規定：未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "violate_148_3_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_ok",
    "desc": "建立且執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "建立且執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_consumer_info_complete",
    "desc": "保險業充分瞭解金融消費者相關資料",
    "expr": [
      "EQ",
      "financial_consumer_info_complete",
      [
        "AND",
        [
          "EQ",
          "consumer_basic_info_complete",
          true
        ],
        [
          "EQ",
          "consumer_relationship_info_complete",
          true
        ],
        [
          "EQ",
          "consumer_other_required_info_complete",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_consumer_understanding",
    "desc": "保險業充分瞭解金融消費者投保條件及審查原則",
    "expr": [
      "EQ",
      "financial_consumer_understanding",
      [
        "AND",
        [
          "EQ",
          "consumer_insurance_conditions_set",
          true
        ],
        [
          "EQ",
          "consumer_underwriting_review_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_consumer_suitability_checked",
    "desc": "保險業對金融消費者保險商品適合度事項已考量",
    "expr": [
      "EQ",
      "financial_consumer_suitability_checked",
      [
        "AND",
        [
          "EQ",
          "consumer_understands_premium_usage",
          true
        ],
        [
          "EQ",
          "consumer_insurance_type_amount_fee_match_need",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "consumer_purchases_foreign_currency_non_investment_insurance",
            true
          ],
          [
            "EQ",
            "consumer_understands_exchange_rate_risk",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:sales_and_underwriting_compliance",
    "desc": "保險業招攬及核保理賠制度及程序確實執行",
    "expr": [
      "EQ",
      "sales_and_underwriting_compliance",
      [
        "AND",
        [
          "EQ",
          "sales_systems_established",
          true
        ],
        [
          "EQ",
          "underwriting_systems_established",
          true
        ],
        [
          "EQ",
          "claims_systems_established",
          true
        ],
        [
          "EQ",
          "sales_systems_executed",
          true
        ],
        [
          "EQ",
          "underwriting_systems_executed",
          true
        ],
        [
          "EQ",
          "claims_systems_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:sales_and_underwriting_personnel_compliance",
    "desc": "招攬、核保及理賠人員依規定執行業務",
    "expr": [
      "EQ",
      "sales_and_underwriting_personnel_compliance",
      [
        "EQ",
        "personnel_perform_as_required",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violate_148_1_2",
          true
        ],
        [
          "EQ",
          "violate_148_2_1",
          true
        ],
        [
          "EQ",
          "violate_148_2_2",
          true
        ],
        [
          "EQ",
          "violate_148_3_1",
          true
        ],
        [
          "EQ",
          "violate_148_3_2",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "financial_consumer_info_complete",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "financial_consumer_understanding",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "financial_consumer_suitability_checked",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sales_and_underwriting_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sales_and_underwriting_personnel_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]