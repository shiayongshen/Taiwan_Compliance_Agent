  },
  {
    "id": "bank:internal_audit_staff_adjusted_if_violation",
    "desc": "違反資格規定者於二個月內改善，逾期未改善應調整職務",
    "expr": [
      "EQ",
      "internal_audit_staff_adjusted_if_violation",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "internal_audit_staff_compliance",
            true
          ]
        ],
        [
          "EQ",
          "internal_audit_staff_adjusted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
