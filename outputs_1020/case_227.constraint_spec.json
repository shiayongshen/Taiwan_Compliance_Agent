        [
          "EQ",
          "internal_handling_ok",
          true
        ],
        [
          "EQ",
          "internal_operation_ok",
          true
        ],
        [
          "EQ",
          "internal_derivative_operation_ok",
          true
        ],
        [
          "EQ",
          "internal_audit_unit_effective",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立或未確實執行內部控制、內部處理、內部作業制度或未符合內部稽核人員資格規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_derivative_operation_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_audit_unit_effective",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_audit_staff_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
