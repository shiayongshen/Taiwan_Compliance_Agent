[
  {
    "id": "insurance:internal_control_compliance",
    "desc": "保險代理人公司或經紀人公司建立並確實執行內部控制、稽核制度及招攬處理制度",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "audit_system_established",
          true
        ],
        [
          "EQ",
          "audit_system_executed",
          true
        ],
        [
          "EQ",
          "solicitation_handling_established",
          true
        ],
        [
          "EQ",
          "solicitation_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_license_only",
    "desc": "兼有保險代理人、經紀人、公證人資格者僅得擇一申領執業證照",
    "expr": [
      "EQ",
      "single_license_only",
      [
        "OR",
        [
          "EQ",
          "only_agent_license",
          true
        ],
        [
          "EQ",
          "only_broker_license",
          true
        ],
        [
          "EQ",
          "only_notary_license",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:fixed_office_and_accounting",
    "desc": "保險代理人、經紀人、公證人應有固定業務處所並專設帳簿記載業務收支",
    "expr": [
      "EQ",
      "fixed_office_and_accounting",
      [
        "AND",
        [
          "EQ",
          "has_fixed_office",
          true
        ],
        [
          "EQ",
          "has_dedicated_accounting",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:solicitation_handling_minimum_requirements",
    "desc": "招攬處理制度及程序至少包括11項規定（第7條）",
    "expr": [
      "EQ",
      "solicitation_handling_minimum_requirements",
      [
        "AND",
        [
          "EQ",
          "qualification_and_scope_defined",
          true
        ],
        [
          "EQ",
          "compensation_and_risk_management",
          true
        ],
        [
          "EQ",
          "premium_collection_management",
          true
        ],
        [
          "EQ",
          "product_information_disclosure",
          true
        ],
        [
          "EQ",
          "advertisement_and_promotion_management",
          true
        ],
        [
          "EQ",
          "customer_needs_assessment",
          true
        ],
        [
          "EQ",
          "report_filing_and_verification",
          true
        ],
        [
          "EQ",
          "pre_submission_check",
          true
        ],
        [
          "EQ",
          "document_control_and_storage",
          true
        ],
        [
          "EQ",
          "customer_complaints_handling",
          true
        ],
        [
          "EQ",
          "other_regulatory_requirements",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：未建立或未確實執行內部控制、稽核制度或招攬處理制度，或兼有多重資格未擇一申領執業證照，或未有固定業務處所及專設帳簿時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "single_license_only",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fixed_office_and_accounting",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_handling_minimum_requirements",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]