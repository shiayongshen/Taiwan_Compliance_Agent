[
  {
    "id": "insurance:over_insurance_prohibited",
    "desc": "保險金額不得超額承保",
    "expr": [
      "EQ",
      "over_insurance_prohibited",
      [
        "LE",
        "insured_amount",
        "market_value"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:actuary_assigned",
    "desc": "保險業聘用精算人員並指派簽證精算人員",
    "expr": [
      "EQ",
      "actuary_assigned",
      [
        "AND",
        [
          "EQ",
          "actuary_employed",
          true
        ],
        [
          "EQ",
          "signing_actuary_assigned",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:external_actuary_reviewed",
    "desc": "保險業聘請外部複核精算人員並執行複核",
    "expr": [
      "EQ",
      "external_actuary_reviewed",
      [
        "AND",
        [
          "EQ",
          "external_actuary_hired",
          true
        ],
        [
          "EQ",
          "external_actuary_review_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:board_approval_for_actuary",
    "desc": "董（理）事會同意簽證精算人員指派及外部複核精算人員聘請",
    "expr": [
      "EQ",
      "board_approval_for_actuary",
      [
        "AND",
        [
          "EQ",
          "board_approved_signing_actuary",
          true
        ],
        [
          "EQ",
          "board_approved_external_actuary",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:actuary_reports_fair_and_true",
    "desc": "簽證精算人員及外部複核精算人員報告不得有虛偽、隱匿、遺漏或錯誤",
    "expr": [
      "EQ",
      "actuary_reports_fair_and_true",
      [
        "AND",
        [
          "EQ",
          "signing_actuary_report_true",
          true
        ],
        [
          "EQ",
          "external_actuary_review_report_true",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_established_and_executed",
    "desc": "保險業建立並執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_established_and_executed",
    "desc": "保險業建立並執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reinsurance_compliance",
    "desc": "保險業辦理再保險分出、分入及其他危險分散機制符合主管機關規定",
    "expr": [
      "EQ",
      "reinsurance_compliance",
      [
        "EQ",
        "reinsurance_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_product_review_compliance",
    "desc": "保險業銷售保險商品前依規定程序辦理審查",
    "expr": [
      "EQ",
      "insurance_product_review_compliance",
      [
        "AND",
        [
          "EQ",
          "product_reviewed_per_guidelines",
          true
        ],
        [
          "EQ",
          "product_documents_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_and_business_disclosure_compliance",
    "desc": "保險業依規定編製說明文件並於重大訊息發生時報告及公開說明",
    "expr": [
      "EQ",
      "financial_and_business_disclosure_compliance",
      [
        "AND",
        [
          "EQ",
          "financial_business_documents_prepared",
          true
        ],
        [
          "EQ",
          "major_information_reported_and_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反超額承保、精算人員聘用、簽證報告、內部控制、內部處理、再保險規定、保險商品審查或財務業務說明文件規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "over_insurance_prohibited",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "actuary_assigned",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "external_actuary_reviewed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_approval_for_actuary",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "actuary_reports_fair_and_true",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "reinsurance_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_product_review_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "financial_and_business_disclosure_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]