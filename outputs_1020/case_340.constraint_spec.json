    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本等級為嚴重不足且未依主管機關規定期限完成增資、改善計畫或合併時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
