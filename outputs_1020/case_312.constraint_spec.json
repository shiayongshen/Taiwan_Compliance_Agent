  {
    "id": "insurance:capital_adequacy_ratio",
    "desc": "資本適足率計算",
    "expr": [
      "EQ",
      "capital_adequacy_ratio",
      [
        "MUL",
        [
          "DIV",
          "own_capital",
          "risk_capital"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio",
    "desc": "淨值比率計算",
    "expr": [
      "EQ",
      "net_worth_ratio",
      [
        "MUL",
        [
          "DIV",
          "owner_equity",
          "total_assets_excluding_investment_type_insurance"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本適足等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth_ratio",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反簽證精算人員聘用、外部複核聘用、董事會同意報備、報告公正真實、內部控制及稽核制度、內部處理制度或銷售前程序規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "insurance:act144_actuarial_staff_assigned",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:act144_external_review_hired",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:act144_board_approval_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:act144_reports_fair_and_true",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:internal_control_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:internal_handling_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance:sales_preparation_procedures_complied",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]