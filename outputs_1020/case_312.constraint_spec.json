  },
  {
    "id": "insurance:product_may_be_rejected_or_stopped",
    "desc": "保險商品有重大不符規定或錯誤等情形，主管機關得退回或停止銷售",
    "expr": [
      "EQ",
      "insurance:product_may_be_rejected_or_stopped",
      [
        "OR",
        [
          "EQ",
          "product_content_serious_violation",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "signed_by_authorized_person",
            true
          ]
        ],
        [
          "EQ",
          "product_content_major_error_or_omission",
          true
        ],
        [
          "EQ",
          "submitted_documents_false",
          true
        ],
        [
          "EQ",
          "authorized_person_false_or_major_error_statement",
          true
        ],
        [
          "EQ",
          "sold_without_required_procedures",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "submission_method_compliant",
            true
          ]
        ],
        [
          "EQ",
          "required_documents_missing_or_not_corrected_in_time",
          true
        ],
        [
          "EQ",
          "serious_violation_of_specified_articles",
          true
        ],
        [
          "EQ",
          "correction_not_completed_within_65_working_days",
          true
        ],
        [
          "EQ",
          "correction_not_completed_within_35_working_days",
          true
        ],
        [
          "EQ",
          "cumulative_rejection_times_three_or_more",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:product_minor_violation_may_require_change_and_stop",
