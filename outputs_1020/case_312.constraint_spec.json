          "EQ",
          "signing_actuarial_staff_approved_by_board",
          true
        ],
        [
          "EQ",
          "external_review_actuarial_staff_approved_by_board",
          true
        ],
        [
          "EQ",
          "reported_to_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
