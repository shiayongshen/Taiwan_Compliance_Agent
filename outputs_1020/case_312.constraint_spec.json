[
  {
    "id": "insurance:act144_actuarial_staff_assigned",
    "desc": "保險業聘用精算人員並指派簽證精算人員",
    "expr": [
      "EQ",
      "insurance:act144_actuarial_staff_assigned",
      [
        "AND",
        [
          "EQ",
          "actuarial_staff_hired",
          true
        ],
        [
          "EQ",
          "signing_actuarial_staff_assigned",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act144_external_review_hired",
    "desc": "保險業聘請外部複核精算人員",
    "expr": [
      "EQ",
      "insurance:act144_external_review_hired",
      [
        "EQ",
        "external_review_actuarial_staff_hired",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act144_board_approval_reported",
    "desc": "簽證精算人員指派及外部複核精算人員聘請經董（理）事會同意並報主管機關備查",
    "expr": [
      "EQ",
      "insurance:act144_board_approval_reported",
      [
        "AND",
