            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "annual_audit_plan_executed_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_findings_improvements_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_self_assessed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_statement_made",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_deficiencies_corrected",
            true
          ]
        ],
        [
