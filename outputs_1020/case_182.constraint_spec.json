      "EQ",
      "internal_control_violation",
      [
        "NOT",
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_of_finance_business_management",
    "desc": "違反財務、業務或管理規定",
    "expr": [
      "EQ",
      "violation_of_finance_business_management",
      [
        "EQ",
        "violation_finance_business_management",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_fine_applicable",
    "desc": "違反第178-1條規定應處罰鍰",
    "expr": [
      "EQ",
      "penalty_fine_applicable",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "violation_of_law_or_order",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "books_reports_submitted",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "inspection_cooperated",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "documents_produced_reported",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "internal_control_executed",
              true
            ]
          ],
          [
            "EQ",
            "violation_of_finance_business_management",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_fine_exemption",
