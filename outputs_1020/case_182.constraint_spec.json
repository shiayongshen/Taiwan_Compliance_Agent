  },
  {
    "id": "securities:securities_acquisition_accountant_opinion",
    "desc": "交易金額達實收資本額20%或新臺幣3億元以上者，事前洽請會計師表示意見",
    "expr": [
      "EQ",
      "securities_acquisition_accountant_opinion",
      [
        "IMPLIES",
        [
          "OR",
          [
            "GE",
            "transaction_amount",
            [
              "MUL",
              "paid_in_capital",
              0.2
            ]
          ],
          [
            "GE",
            "transaction_amount",
            300000000.0
          ]
        ],
        [
          "EQ",
          "accountant_opinion_obtained_before_transaction",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
