[
  {
    "id": "securities:violation_affecting_business",
    "desc": "董事、監察人及受僱人有違法行為足以影響證券業務正常執行",
    "expr": [
      "EQ",
      "violation_affecting_business",
      [
        "EQ",
        "board_or_supervisor_or_employee_violation",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_imposeable",
