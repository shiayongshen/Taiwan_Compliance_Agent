[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=資本適足, 2=資本不足, 3=資本顯著不足, 4=資本嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              "capital_adequacy_ratio",
              150.0
            ],
            [
              "LT",
              "capital_adequacy_ratio",
              200.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              "net_worth_ratio",
              3.0
            ],
            [
              "GE",
              "net_worth_ratio",
              2.0
            ]
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            200.0
          ],
          [
            "OR",
            [
              "GE",
              "net_worth_ratio",
              3.0
            ],
            [
              "GE",
              "net_worth_ratio_prev",
              3.0
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_lowest_rule",
    "desc": "資本等級以較低等級為準",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "LT",
          "capital_adequacy_ratio",
          50.0
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_net_worth",
    "desc": "淨值比率資本等級判定",
    "expr": [
      "EQ",
      "capital_level_net_worth",
      [
        "CASE",
        [
          "LT",
          "net_worth",
          0.0
        ],
        4,
        [
          "AND",
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "net_worth_ratio",
            2.0
          ],
          [
            "LT",
            "net_worth_ratio",
            3.0
          ]
        ],
        [
          "GE",
          "net_worth_ratio",
          3.0
        ],
        2,
        0,
        0.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_final",
    "desc": "資本等級以資本適足率與淨值比率較低等級為準",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "LT",
          "capital_level",
          "capital_level_net_worth"
        ],
        "capital_level",
        [
          "LE",
          "capital_level",
          "capital_level_net_worth"
        ],
        "capital_level",
        "capital_level_net_worth"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severely_insufficient_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_severely_insufficient_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "EQ",
          "capital_severely_insufficient_measures_executed_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significantly_insufficient_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_significantly_insufficient_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          3
        ],
        [
          "EQ",
          "capital_significantly_insufficient_measures_executed_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_insufficient_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          2
        ],
        [
          "AND",
          [
            "EQ",
            "improvement_plan_submitted",
            true
          ],
          [
            "EQ",
            "improvement_plan_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:severe_insufficient_and_no_measures",
    "desc": "資本嚴重不足且未依規定完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "severe_insufficient_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_severely_insufficient_measures_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:significant_insufficient_and_no_measures",
    "desc": "資本顯著不足且未執行對應措施",
    "expr": [
      "EQ",
      "significant_insufficient_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          3
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_significantly_insufficient_measures_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insufficient_and_no_measures",
    "desc": "資本不足且未執行對應措施",
    "expr": [
      "EQ",
      "insufficient_and_no_measures",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          2
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_insufficient_measures_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本不足等級達一定程度且未執行對應措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "severe_insufficient_and_no_measures",
          true
        ],
        [
          "EQ",
          "significant_insufficient_and_no_measures",
          true
        ],
        [
          "EQ",
          "insufficient_and_no_measures",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:refuse_inspection_penalty",
    "desc": "拒絕檢查或拒絕開啟金庫或其他庫房",
    "expr": [
      "EQ",
      "refuse_inspection_penalty",
      [
        "EQ",
        "refuse_inspection",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:conceal_or_destroy_documents_penalty",
    "desc": "隱匿或毀損帳冊文件",
    "expr": [
      "EQ",
      "conceal_or_destroy_documents_penalty",
      [
        "EQ",
        "conceal_or_destroy_documents",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:no_response_or_false_response_penalty",
    "desc": "無故不答復或答復不實",
    "expr": [
      "EQ",
      "no_response_or_false_response_penalty",
      [
        "EQ",
        "no_response_or_false_response",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:late_or_false_report_penalty",
    "desc": "逾期提報或提報不實、不全或未繳查核費用",
    "expr": [
      "EQ",
      "late_or_false_report_penalty",
      [
        "EQ",
        "late_or_false_report",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_financial_institution_penalty",
    "desc": "關係企業或金融機構怠於提供資料",
    "expr": [
      "EQ",
      "related_financial_institution_penalty",
      [
        "EQ",
        "related_financial_institution_fail_provide",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_conditions_inspection",
    "desc": "處罰條件：違反檢查相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "refuse_inspection_penalty",
          true
        ],
        [
          "EQ",
          "conceal_or_destroy_documents_penalty",
          true
        ],
        [
          "EQ",
          "no_response_or_false_response_penalty",
          true
        ],
        [
          "EQ",
          "late_or_false_report_penalty",
          true
        ],
        [
          "EQ",
          "related_financial_institution_penalty",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
