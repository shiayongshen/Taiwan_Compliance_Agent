[
  {
    "id": "fhc:non_credit_transaction_condition_met",
    "desc": "授信以外之交易條件符合",
    "expr": [
      "EQ",
      "non_credit_transaction_condition_met",
      [
        "OR",
        [
          "EQ",
          "transaction_invest_securities",
          true
        ],
        [
          "EQ",
          "transaction_purchase_real_estate_or_assets",
          true
        ],
        [
          "EQ",
          "transaction_sell_securities_real_estate_or_assets",
          true
        ],
        [
          "EQ",
          "transaction_contract_payment_or_service",
          true
        ],
        [
          "EQ",
          "transaction_agent_broker_commission_service",
          true
        ],
        [
          "EQ",
          "transaction_third_party_related",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_party_transaction_subject",
    "desc": "交易對象為金融控股公司或子公司之負責人、大股東、關係企業、子公司及其負責人",
    "expr": [
      "EQ",
      "related_party_transaction_subject",
      [
        "OR",
        [
          "EQ",
          "is_fhc_and_responsible_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "is_fhc_responsible_or_major_shareholder_sole_proprietor_or_partner_or_enterprise_representative",
          true
        ],
        [
          "EQ",
          "is_fhc_related_enterprise_and_responsible_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "is_fhc_bank_insurance_securities_subsidiary_or_responsible",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:transaction_condition_not_better_than_others",
    "desc": "授信以外交易條件不得優於其他同類對象",
    "expr": [
      "EQ",
      "transaction_condition_not_better_than_others",
      [
        "EQ",
        "transaction_condition_better_than_others",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:board_resolution_valid",
    "desc": "公司三分之二以上董事出席及出席董事四分之三以上決議通過",
    "expr": [
      "EQ",
      "board_resolution_valid",
      [
        "AND",
        [
          "GE",
          "board_attendance_ratio",
          0.6666666667
        ],
        [
          "GE",
          "board_approval_ratio",
          0.75
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_compliance",
    "desc": "授信以外交易符合條件限制",
    "expr": [
      "EQ",
      "non_credit_transaction_compliance",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "non_credit_transaction_condition_met",
            true
          ],
          [
            "EQ",
            "related_party_transaction_subject",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "transaction_condition_not_better_than_others",
            true
          ],
          [
            "EQ",
            "board_resolution_valid",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_single_related_party_limit_ok",
    "desc": "銀行子公司與單一關係人交易金額不超過淨值10%",
    "expr": [
      "EQ",
      "bank_subsidiary_single_related_party_limit_ok",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "single_related_party_transaction_amount",
            "bank_subsidiary_net_worth"
          ],
          100.0
        ],
        10.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_all_related_party_limit_ok",
    "desc": "銀行子公司與所有利害關係人交易總額不超過淨值20%",
    "expr": [
      "EQ",
      "bank_subsidiary_all_related_party_limit_ok",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "all_related_party_transaction_amount",
            "bank_subsidiary_net_worth"
          ],
          100.0
        ],
        20.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_transaction_compliance",
    "desc": "銀行子公司與利害關係人交易金額符合限制",
    "expr": [
      "EQ",
      "bank_subsidiary_transaction_compliance",
      [
        "AND",
        [
          "EQ",
          "bank_subsidiary_single_related_party_limit_ok",
          true
        ],
        [
          "EQ",
          "bank_subsidiary_all_related_party_limit_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:fhc_non_credit_transaction_overall_compliance",
    "desc": "金融控股公司及子公司授信以外交易符合所有規定",
    "expr": [
      "EQ",
      "fhc_non_credit_transaction_overall_compliance",
      [
        "AND",
        [
          "EQ",
          "non_credit_transaction_compliance",
          true
        ],
        [
          "EQ",
          "bank_subsidiary_transaction_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_45_1_or_4",
    "desc": "違反第45條第1項交易條件限制或董事會決議方法",
    "expr": [
      "EQ",
      "violation_45_1_or_4",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "transaction_condition_not_better_than_others",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_resolution_valid",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反第45條第1項交易條件限制或董事會決議方法，或違反銀行子公司交易金額限制",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_45_1_or_4",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_subsidiary_transaction_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]