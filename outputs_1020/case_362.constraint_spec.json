[
  {
    "id": "bank:internal_control_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_executed",
    "desc": "內部控制及稽核制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_established",
    "desc": "建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_executed",
    "desc": "內部處理制度及程序確實執行",
    "expr": [
      "EQ",
      "internal_handling_executed",
      [
        "EQ",
        "internal_handling_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_established",
    "desc": "建立內部作業制度及程序",
    "expr": [
      "EQ",
      "internal_operation_established",
      [
        "EQ",
        "internal_operation_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_executed",
    "desc": "內部作業制度及程序確實執行",
    "expr": [
      "EQ",
      "internal_operation_executed",
      [
        "EQ",
        "internal_operation_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_qualified",
    "desc": "衍生性金融商品業務人員具備專業資格",
    "expr": [
      "EQ",
      "derivative_business_qualified",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_license_held",
          true
        ],
        [
          "GE",
          "derivative_internship_years",
          1
        ],
        [
          "GE",
          "derivative_experience_months",
          6
        ],
        [
          "EQ",
          "structured_product_qualification_passed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_permit",
    "desc": "外匯業務經本行許可或完成備查",
    "expr": [
      "EQ",
      "foreign_exchange_permit",
      [
        "OR",
        [
          "EQ",
          "foreign_exchange_permit_granted",
          true
        ],
        [
          "EQ",
          "foreign_exchange_filing_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定建立或執行內部控制、內部處理、內部作業制度或未具備衍生性金融商品業務人員資格，或未取得外匯業務許可時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "internal_control_established",
              true
            ],
            [
              "EQ",
              "internal_control_executed",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "internal_handling_established",
              true
            ],
            [
              "EQ",
              "internal_handling_executed",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "internal_operation_established",
              true
            ],
            [
              "EQ",
              "internal_operation_executed",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "derivative_business_qualified",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_exchange_permit",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]