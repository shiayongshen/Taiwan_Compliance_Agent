[
  {
    "id": "int_finance:investment_prohibited_stock",
    "desc": "國際金融業務分行不得投資股票",
    "expr": [
      "EQ",
      "investment_prohibited_stock",
      [
        "EQ",
        "invest_stock",
        false
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:investment_prohibited_related_securities",
    "desc": "國際金融業務分行不得投資於所屬銀行負責人擔任董事、監察人或經理人之公司所發行、承兌或保證之有價證券",
    "expr": [
      "EQ",
      "investment_prohibited_related_securities",
      [
        "EQ",
        "invest_related_person_securities",
        false
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:investment_limit_total",
    "desc": "國際金融業務分行投資有價證券與所屬銀行投資有價證券金額合計不得超過金管會對總行規定之限額",
    "expr": [
      "EQ",
      "investment_limit_total",
      [
        "LE",
        [
          "ADD",
          "branch_invest_amount",
          "head_office_invest_amount"
        ],
        "investment_limit"
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:investment_approval_required",
    "desc": "國際金融業務分行投資有價證券須經董（理）事會或總行授權同意並向金管會申請核准，且依核准內容辦理",
    "expr": [
      "EQ",
      "investment_approval_required",
      [
        "AND",
        [
          "EQ",
          "board_approval_obtained",
          true
        ],
        [
          "EQ",
          "approval_document_submitted",
          true
        ],
        [
          "EQ",
          "investment_within_approved_scope",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:credit_and_transaction_limit_compliance",
    "desc": "遵守同一人或同一關係人授信及其他交易限制",
    "expr": [
      "EQ",
      "credit_and_transaction_limit_compliance",
      [
        "EQ",
        "credit_transaction_limit_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:inspection_cooperation",
    "desc": "配合主管機關或委託機構檢查，不隱匿、毀損文件，不規避、妨礙、拒絕檢查",
    "expr": [
      "EQ",
      "inspection_cooperation",
      [
        "EQ",
        "inspection_cooperated",
        true
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "int_finance:foreign_currency_securities_investment_limit",
    "desc": "遵守主管機關對資金運用中投資外幣有價證券種類及限額規定",
    "expr": [
      "EQ",
      "foreign_currency_securities_investment_limit",
      [
        "EQ",
        "foreign_currency_securities_limit_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "int_finance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反授信及交易限制、檢查規定或外幣有價證券投資限額規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "credit_and_transaction_limit_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "inspection_cooperation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_currency_securities_investment_limit",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]