[
  {
    "id": "insurance:violate_148_1_1_or_2",
    "desc": "違反保險法第148條之一第一項或第二項規定",
    "expr": [
      "EQ",
      "violate_148_1_1_or_2",
      [
        "EQ",
        "violate_148_1_1_or_2_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_1",
    "desc": "違反保險法第148條之二第一項規定：未提供說明文件、文件未依規定記載或記載不實",
    "expr": [
      "EQ",
      "violate_148_2_1",
      [
        "OR",
        [
          "EQ",
          "not_provide_explanation_doc",
          true
        ],
        [
          "EQ",
          "explanation_doc_not_according_to_rule",
          true
        ],
        [
          "EQ",
          "explanation_doc_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_2_2",
    "desc": "違反保險法第148條之二第二項規定：未依限報告或公開說明，或報告內容不實",
    "expr": [
      "EQ",
      "violate_148_2_2",
      [
        "OR",
        [
          "EQ",
          "not_report_to_authority_in_time",
          true
        ],
        [
          "EQ",
          "not_public_explanation",
          true
        ],
        [
          "EQ",
          "report_or_explanation_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_1",
    "desc": "違反保險法第148條之三第一項規定：未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "violate_148_3_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_148_3_2",
    "desc": "違反保險法第148條之三第二項規定：未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "violate_148_3_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_ok",
    "desc": "已建立且執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "audit_system_established",
          true
        ],
        [
          "EQ",
          "audit_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "已建立且執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_category_first_non_restrictive",
    "desc": "第一類非限制性資本範圍合計",
    "expr": [
      "EQ",
      "capital_first_non_restrictive",
      [
        "ADD",
        "common_stock",
        "capital_surplus",
        "retained_earnings",
        "other_comprehensive_income",
        "adjustments_per_reporting_manual"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_category_first_restrictive",
    "desc": "第一類限制性資本範圍合計",
    "expr": [
      "EQ",
      "capital_first_restrictive",
      [
        "ADD",
        "non_cumulative_no_interest_preferred_stock",
        "non_cumulative_no_interest_subordinated_bonds",
        "adjustments_per_reporting_manual"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_category_second",
    "desc": "第二類資本範圍合計",
    "expr": [
      "EQ",
      "capital_second",
      [
        "ADD",
        "cumulative_or_interest_preferred_stock",
        "cumulative_or_interest_subordinated_bonds",
        "subordinated_bonds_over_10_years",
        "convertible_subordinated_bonds_5_to_10_years",
        "special_reserves_and_surplus_per_ifrs",
        "investment_property_fair_value_adjustments",
        "adjustments_per_reporting_manual"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violate_148_1_1_or_2",
          true
        ],
        [
          "EQ",
          "violate_148_2_1",
          true
        ],
        [
          "EQ",
          "violate_148_2_2",
          true
        ],
        [
          "EQ",
          "violate_148_3_1",
          true
        ],
        [
          "EQ",
          "violate_148_3_2",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]