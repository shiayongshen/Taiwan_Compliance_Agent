[
  {
    "id": "financial_consumer:understanding_and_suitability",
    "desc": "金融服務業充分瞭解金融消費者相關資料且確保適合度",
    "expr": [
      "EQ",
      "understanding_and_suitability",
      [
        "AND",
        [
          "EQ",
          "financial_consumer_data_fully_understood",
          true
        ],
        [
          "EQ",
          "financial_product_service_suitable",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "insurance:agent_broker_license_and_insurance",
    "desc": "保險代理人、經紀人、公證人已取得許可、繳存保證金並投保相關保險",
    "expr": [
      "EQ",
      "agent_broker_license_and_insurance",
      [
        "AND",
        [
          "EQ",
          "license_obtained",
          true
        ],
        [
          "EQ",
          "guarantee_deposit_paid",
          true
        ],
        [
          "EQ",
          "related_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fiduciary",
    "desc": "保險經紀人履行善良管理人注意義務及忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fiduciary",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_performed",
          true
        ],
        [
          "EQ",
          "fiduciary_duty_performed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_written_report_and_fee_disclosure",
    "desc": "保險經紀人提供書面分析報告並明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_written_report_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "EQ",
          "fee_disclosure_made",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_internal_control_compliance",
    "desc": "保險業核保制度符合管理規則要求",
    "expr": [
      "EQ",
      "underwriting_internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "underwriting_personnel_qualified",
          true
        ],
        [
          "EQ",
          "underwriting_suitability_evaluated_and_signed",
          true
        ],
        [
          "EQ",
          "no_retroactive_policy_effect",
          true
        ],
        [
          "EQ",
          "signatures_and_evidence_verified",
          true
        ],
        [
          "EQ",
          "financial_underwriting_and_reporting_implemented",
          true
        ],
        [
          "EQ",
          "fund_source_assessed",
          true
        ],
        [
          "EQ",
          "other_protection_measures_implemented",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "financial_consumer:excluded_professional_investors",
    "desc": "金融消費者不包括專業投資機構及符合一定財力或專業能力者",
    "expr": [
      "EQ",
      "excluded_professional_investors",
      [
        "OR",
        [
          "EQ",
          "is_professional_investor",
          true
        ],
        [
          "EQ",
          "meets_financial_or_professional_criteria",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:is_financial_consumer",
    "desc": "是否為金融消費者",
    "expr": [
      "EQ",
      "is_financial_consumer",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "excluded_professional_investors",
            true
          ]
        ],
        [
          "EQ",
          "assisted_to_create_formal_appearance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "financial_consumer:bank_and_securities_understanding",
    "desc": "銀行及證券期貨業於訂立契約前充分瞭解金融消費者相關資料",
    "expr": [
      "EQ",
      "bank_and_securities_understanding",
      [
        "AND",
        [
          "EQ",
          "consumer_identity_and_financial_background_collected",
          true
        ],
        [
          "EQ",
          "consumer_risk_preference_and_investment_experience_collected",
          true
        ],
        [
          "EQ",
          "consumer_investment_ability_evaluated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "financial_consumer"
  },
  {
    "id": "insurance:consumer_basic_data_collected",
    "desc": "保險業提供保險契約前充分瞭解金融消費者基本資料",
    "expr": [
      "EQ",
      "consumer_basic_data_collected",
      [
        "AND",
        [
          "EQ",
          "applicant_and_insured_basic_data_collected",
          true
        ],
        [
          "EQ",
          "relationship_between_applicant_insured_beneficiary_collected",
          true
        ],
        [
          "EQ",
          "other_regulatory_basic_data_collected",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融消費者保護法第30-1條第2款未充分瞭解金融消費者資料及確保適合度",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "understanding_and_suitability",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_broker_license_and_insurance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fiduciary",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_written_report_and_fee_disclosure",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "underwriting_internal_control_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]