[
  {
    "id": "insurance:same_person_definition",
    "desc": "同一人定義為同一自然人或同一法人",
    "expr": [
      "EQ",
      "same_person",
      [
        "OR",
        [
          "EQ",
          "person_type",
          1
        ],
        [
          "EQ",
          "person_type",
          2
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:same_related_person_definition",
    "desc": "同一關係人範圍包含本人、配偶、二親等以內血親及以本人或配偶為負責人之事業",
    "expr": [
      "EQ",
      "same_related_person",
      [
        "OR",
        [
          "EQ",
          "is_self",
          true
        ],
        [
          "EQ",
          "is_spouse",
          true
        ],
        [
          "LE",
          "blood_relation_degree",
          2
        ],
        [
          "EQ",
          "is_business_responsible_by_self_or_spouse",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:same_related_enterprise_definition",
    "desc": "同一關係企業範圍依公司法相關條文規定",
    "expr": [
      "EQ",
      "same_related_enterprise",
      [
        "EQ",
        "company_law_related_enterprise",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_and_other_transaction_limit_applicable",
    "desc": "主管機關得對保險業就同一人、同一關係人或同一關係企業之放款或其他交易予以限制",
    "expr": [
      "EQ",
      "loan_and_other_transaction_limit",
      [
        "OR",
        [
          "EQ",
          "loan_limit_imposed",
          true
        ],
        [
          "EQ",
          "other_transaction_limit_imposed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_person_and_transaction_limit",
    "desc": "主管機關得對保險業與利害關係人從事放款以外之其他交易予以限制",
    "expr": [
      "EQ",
      "related_person_other_transaction_limit",
      [
        "AND",
        [
          "EQ",
          "related_person_defined",
          true
        ],
        [
          "EQ",
          "other_transaction_limit_imposed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_business_scope_rules",
    "desc": "違反第一百三十八條相關業務範圍規定",
    "expr": [
      "EQ",
      "violation_business_scope",
      [
        "EQ",
        "violate_article_138_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_reserve_rules",
    "desc": "違反第一百三十八條之二及第一百三十八條之三有關賠償準備金提存額度及方式規定",
    "expr": [
      "EQ",
      "violation_reserve_rules",
      [
        "EQ",
        "violate_article_138_2_and_138_3_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_article_143",
    "desc": "違反第一百四十三條規定",
    "expr": [
      "EQ",
      "violation_article_143",
      [
        "EQ",
        "violate_article_143",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_article_143_5_and_143_6_measures",
    "desc": "違反第一百四十三條之五或主管機關依第一百四十三條之六規定所為措施",
    "expr": [
      "EQ",
      "violation_article_143_5_6",
      [
        "EQ",
        "violate_article_143_5_or_143_6_measures",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_fund_management_rules",
    "desc": "違反第一百四十六條相關資金運用規定",
    "expr": [
      "EQ",
      "violation_fund_management",
      [
        "EQ",
        "violate_article_146_fund_management",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_without_sufficient_collateral",
    "desc": "依第一百四十六條之三或第一百四十六條之八規定放款無十足擔保或條件優於其他同類放款對象",
    "expr": [
      "EQ",
      "loan_without_sufficient_collateral",
      [
        "EQ",
        "loan_no_sufficient_collateral_or_better_terms",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_without_board_approval",
    "desc": "擔保放款達主管機關規定金額以上，未經董事會三分之二以上董事出席及四分之三以上同意",
    "expr": [
      "EQ",
      "loan_guarantee_without_board_approval",
      [
        "EQ",
        "loan_guarantee_no_board_approval",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_loan_and_transaction_limits",
    "desc": "違反第一百四十六條之七有關放款或其他交易限額及決議程序規定",
    "expr": [
      "EQ",
      "violation_loan_transaction_limits",
      [
        "EQ",
        "violate_article_146_7_loan_transaction_limits",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:reserve_calculation_and_recording",
    "desc": "保險業於營業年度屆滿時計算應提存準備金並記載於特設帳簿",
    "expr": [
      "EQ",
      "reserve_calculated_and_recorded",
      [
        "AND",
        [
          "EQ",
          "reserve_calculated",
          true
        ],
        [
          "EQ",
          "reserve_recorded_in_special_ledger",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "保險業建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "保險業建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_system_and_procedure_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_of_internal_control_and_handling",
    "desc": "違反第一百四十八條之一及相關規定未建立或未執行內部控制、稽核及處理制度",
    "expr": [
      "EQ",
      "violation_internal_control_and_handling",
      [
        "OR",
        [
          "EQ",
          "violate_internal_control_or_audit",
          true
        ],
        [
          "EQ",
          "violate_internal_handling_system",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_limit",
    "desc": "保險業國外投資總額不得超過資金45%，特定項目不計入限額",
    "expr": [
      "EQ",
      "foreign_investment_limit_ok",
      [
        "LE",
        "foreign_investment_amount",
        [
          "MUL",
          "total_funds",
          0.45
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_exclusions",
    "desc": "特定投資金額不計入國外投資限額",
    "expr": [
      "EQ",
      "foreign_investment_exclusions_ok",
      [
        "AND",
        [
          "EQ",
          "approved_non_investment_foreign_currency_insurance_amount_excluded",
          true
        ],
        [
          "EQ",
          "approved_foreign_currency_securities_investment_excluded",
          true
        ],
        [
          "EQ",
          "approved_foreign_insurance_related_investment_excluded",
          true
        ],
        [
          "EQ",
          "other_approved_exclusions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholding_exclusion",
    "desc": "計算同一人或同一關係人持有股份時排除特定情形所持股份",
    "expr": [
      "EQ",
      "shareholding_exclusion_applied",
      [
        "AND",
        [
          "EQ",
          "underwriting_shares_excluded",
          true
        ],
        [
          "EQ",
          "financial_institution_shares_excluded",
          true
        ],
        [
          "EQ",
          "inheritance_shares_excluded",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一保險法相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_business_scope",
          true
        ],
        [
          "EQ",
          "violation_reserve_rules",
          true
        ],
        [
          "EQ",
          "violation_article_143",
          true
        ],
        [
          "EQ",
          "violation_article_143_5_6",
          true
        ],
        [
          "EQ",
          "violation_fund_management",
          true
        ],
        [
          "EQ",
          "loan_without_sufficient_collateral",
          true
        ],
        [
          "EQ",
          "loan_guarantee_without_board_approval",
          true
        ],
        [
          "EQ",
          "violation_loan_transaction_limits",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "reserve_calculated_and_recorded",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ],
        [
          "EQ",
          "violation_internal_control_and_handling",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_limit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "foreign_investment_exclusions_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholding_exclusion_applied",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]