[
  {
    "id": "aml:internal_control_established",
    "desc": "已建立洗錢防制內部控制與稽核制度，包含六項規定",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures_established",
          true
        ],
        [
          "EQ",
          "training_held_regularly",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_designated_matters_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "已確實執行洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_implementation_confirmed",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:account_monitoring_policy_established",
    "desc": "已建立帳戶或交易監控政策與程序，符合風險基礎方法及資訊系統輔助要求",
    "expr": [
      "EQ",
      "account_monitoring_policy_established",
      [
        "AND",
        [
          "EQ",
          "customer_data_integrated",
          true
        ],
        [
          "EQ",
          "internal_control_for_data_access_established",
          true
        ],
        [
          "EQ",
          "risk_based_monitoring_policy_established",
          true
        ],
        [
          "EQ",
          "monitoring_policy_reviewed_and_updated",
          true
        ],
        [
          "EQ",
          "monitoring_policy_documented_completely",
          true
        ],
        [
          "EQ",
          "monitoring_patterns_included",
          true
        ],
        [
          "EQ",
          "electronic_payment_monitoring_included",
          true
        ],
        [
          "EQ",
          "monitoring_records_kept",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:compliance_ok",
    "desc": "洗錢防制制度建立且執行，帳戶交易監控政策建立且符合規定",
    "expr": [
      "EQ",
      "compliance_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "account_monitoring_policy_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "aml:penalty_conditions",
    "desc": "處罰條件：未建立或未執行洗錢防制內部控制與稽核制度，或未建立符合規定之帳戶交易監控政策時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "account_monitoring_policy_established",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]