[
  {
    "id": "fhc:violation_occurred",
    "desc": "金融控股公司有違反法令、章程或有礙健全經營之虞",
    "expr": [
      "EQ",
      "violation_occurred",
      [
        "EQ",
        "fhc_violation_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_measures_authorized",
    "desc": "主管機關得依情節輕重採取處分措施",
    "expr": [
      "EQ",
      "penalty_measures_authorized",
      [
        "AND",
        [
          "EQ",
          "violation_occurred",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "correction_order_issued",
            true
          ],
          [
            "EQ",
            "improvement_order_issued",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "resolution_revoked",
              true
            ],
            [
              "EQ",
              "subsidiary_business_suspended",
              true
            ],
            [
              "EQ",
              "manager_or_staff_dismissed",
              true
            ],
            [
              "EQ",
              "director_or_supervisor_dismissed_or_suspended",
              true
            ],
            [
              "EQ",
              "subsidiary_shares_disposed",
              true
            ],
            [
              "EQ",
              "license_revoked",
              true
            ],
            [
              "EQ",
              "other_measures_taken",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:director_supervisor_dismissal_notification",
    "desc": "依第四款解除董事、監察人職務時，主管機關通知經濟部廢止登記",
    "expr": [
      "EQ",
      "director_supervisor_dismissal_notification",
      [
        "IMPLIES",
        [
          "EQ",
          "director_or_supervisor_dismissed_or_suspended",
          true
        ],
        [
          "EQ",
          "economic_ministry_notified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:license_revocation_requirements_met",
    "desc": "依第六款廢止許可時，金融控股公司於期限內完成股份及董事人數處分且停止使用名稱及變更登記",
    "expr": [
      "EQ",
      "license_revocation_requirements_met",
      [
        "AND",
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "EQ",
          "shares_disposed_within_deadline",
          true
        ],
        [
          "EQ",
          "directors_reduced_within_deadline",
          true
        ],
        [
          "EQ",
          "name_usage_stopped",
          true
        ],
        [
          "EQ",
          "company_registration_changed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:license_revocation_noncompliance",
    "desc": "未於期限內完成股份及董事人數處分者，應進行解散及清算",
    "expr": [
      "EQ",
      "license_revocation_noncompliance",
      [
        "AND",
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "license_revocation_requirements_met",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令且未依規定完成改善或處分者處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "penalty_measures_authorized",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "license_revoked",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "license_revocation_requirements_met",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]