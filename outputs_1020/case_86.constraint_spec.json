[
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_minimum_amount"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_covered",
    "desc": "相關保險依身份分類投保",
    "expr": [
      "EQ",
      "relevant_insurance_covered",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "liability_insurance_covered",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker",
            true
          ],
          [
            "EQ",
            "liability_insurance_covered",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_covered",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_written_report_and_fee_disclosure",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_written_report_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_resume_dissolve_reporting",
    "desc": "經紀人公司停業、復業、解散應依規定申請核准並辦理登記",
    "expr": [
      "EQ",
      "broker_company_stop_resume_dissolve_reporting",
      [
        "AND",
        [
          "EQ",
          "application_submitted",
          true
        ],
        [
          "EQ",
          "board_or_shareholders_resolution_attached",
          true
        ],
        [
          "EQ",
          "approval_obtained",
          true
        ],
        [
          "EQ",
          "registration_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_period_limit_and_extension",
    "desc": "經紀人公司停業期間以一年為限，得申請一次展延，應於屆滿前十五日提出",
    "expr": [
      "EQ",
      "broker_company_stop_period_limit_and_extension",
      [
        "AND",
        [
          "LE",
          "stop_period_months",
          12
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "extension_requested",
            true
          ],
          [
            "EQ",
            "extension_approved",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "extension_requested",
            true
          ],
          [
            "LE",
            "extension_request_days_before_expiry",
            15
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_revoke_license_if_no_resume_and_no_broker",
    "desc": "經紀人公司停業屆滿未申請復業且未依規定任用經紀人者，廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "broker_company_revoke_license_if_no_resume_and_no_broker",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "stop_period_expired",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "resume_application_submitted",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_appointed_according_to_rule7",
              true
            ]
          ]
        ],
        [
          "EQ",
          "license_revoked",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_cancel_broker_license_on_stop_or_dissolve",
    "desc": "經紀人公司停業或解散應繳銷所任用經紀人執業證照",
    "expr": [
      "EQ",
      "broker_company_cancel_broker_license_on_stop_or_dissolve",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "company_stop_applied",
            true
          ],
          [
            "EQ",
            "company_dissolve_applied",
            true
          ]
        ],
        [
          "EQ",
          "broker_license_cancelled",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_cancel_broker_license_on_license_revocation",
    "desc": "經主管機關註銷經紀人公司執業證照，未辦理繳銷所任用經紀人執業證照者，應於三十日內委由經紀人公會辦理註銷登記",
    "expr": [
      "EQ",
      "broker_company_cancel_broker_license_on_license_revocation",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "company_license_revoked",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "broker_license_cancelled",
              true
            ]
          ]
        ],
        [
          "EQ",
          "broker_registration_cancelled_by_association_within_30_days",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_reinsurance_stop_reporting",
    "desc": "同時經營保險經紀及再保險經紀業務之經紀人公司停止其中一業務，應於一個月內報主管機關備查",
    "expr": [
      "EQ",
      "broker_company_stop_reinsurance_stop_reporting",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "insurance_brokerage_stopped",
            true
          ],
          [
            "EQ",
            "reinsurance_brokerage_stopped",
            true
          ]
        ],
        [
          "EQ",
          "report_to_authority_within_1_month",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:accounting_and_reporting_compliance",
    "desc": "個人執業經紀人、經紀人公司及銀行應專設帳簿並於指定期間彙報主管機關",
    "expr": [
      "EQ",
      "accounting_and_reporting_compliance",
      [
        "AND",
        [
          "EQ",
          "special_account_books_maintained",
          true
        ],
        [
          "GE",
          "reporting_date",
          "reporting_start_date"
        ],
        [
          "LE",
          "reporting_date",
          "reporting_end_date"
        ],
        [
          "EQ",
          "annual_financial_reports_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:authority_inspection_and_reporting_compliance",
