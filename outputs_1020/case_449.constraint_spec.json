[
  {
    "id": "fhc:non_credit_transaction_condition_met",
    "desc": "授信以外之交易條件符合",
    "expr": [
      "EQ",
      "non_credit_transaction_condition_met",
      [
        "OR",
        [
          "EQ",
          "transaction_invest_security",
          true
        ],
        [
          "EQ",
          "transaction_purchase_asset",
          true
        ],
        [
          "EQ",
          "transaction_sell_security_or_asset",
          true
        ],
        [
          "EQ",
          "transaction_contract_payment_or_service",
          true
        ],
        [
          "EQ",
          "transaction_agent_or_broker_service",
          true
        ],
        [
          "EQ",
          "transaction_related_third_party",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:related_party_transaction_subject",
    "desc": "交易對象為金融控股公司或其子公司負責人、大股東、關係企業、銀行子公司、保險子公司、證券子公司及其負責人",
    "expr": [
      "EQ",
      "related_party_transaction_subject",
      [
        "OR",
        [
          "EQ",
          "is_fhc_and_responsible_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "is_fhc_responsible_or_major_shareholder_business_or_enterprise",
          true
        ],
        [
          "EQ",
          "is_fhc_related_enterprise_and_responsible_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "is_fhc_bank_insurance_securities_subsidiary_or_responsible",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:transaction_condition_not_better_than_others",
    "desc": "授信以外交易條件不得優於其他同類對象",
    "expr": [
      "EQ",
      "transaction_condition_not_better_than_others",
      [
        "EQ",
        "transaction_condition_better_than_others",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:board_approval_met",
    "desc": "公司三分之二以上董事出席及出席董事四分之三以上決議",
    "expr": [
      "EQ",
      "board_approval_met",
      [
        "AND",
        [
          "GE",
          "board_attendance_ratio",
          0.6666666667
        ],
        [
          "GE",
          "board_approval_ratio",
          0.75
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_compliance",
    "desc": "授信以外交易符合條件且經董事會決議",
    "expr": [
      "EQ",
      "non_credit_transaction_compliance",
      [
        "AND",
        [
          "EQ",
          "non_credit_transaction_condition_met",
          true
        ],
        [
          "EQ",
          "related_party_transaction_subject",
          true
        ],
        [
          "EQ",
          "transaction_condition_not_better_than_others",
          true
        ],
        [
          "EQ",
          "board_approval_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_single_related_party_limit_ok",
    "desc": "銀行子公司與單一關係人交易金額不超過淨值10%",
    "expr": [
      "EQ",
      "bank_subsidiary_single_related_party_limit_ok",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "bank_subsidiary_single_related_party_transaction_amount",
            "bank_subsidiary_net_worth"
          ],
          100.0
        ],
        10.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_all_related_party_limit_ok",
    "desc": "銀行子公司與所有利害關係人交易總額不超過淨值20%",
    "expr": [
      "EQ",
      "bank_subsidiary_all_related_party_limit_ok",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "bank_subsidiary_all_related_party_transaction_amount",
            "bank_subsidiary_net_worth"
          ],
          100.0
        ],
        20.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_transaction_compliance",
    "desc": "銀行子公司交易金額符合單一及全部利害關係人限制",
    "expr": [
      "EQ",
      "bank_subsidiary_transaction_compliance",
      [
        "AND",
        [
          "EQ",
          "bank_subsidiary_single_related_party_limit_ok",
          true
        ],
        [
          "EQ",
          "bank_subsidiary_all_related_party_limit_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:fhc_transaction_compliance",
    "desc": "金融控股公司及子公司授信以外交易合規",
    "expr": [
      "EQ",
      "fhc_transaction_compliance",
      [
        "AND",
        [
          "EQ",
          "non_credit_transaction_compliance",
          true
        ],
        [
          "EQ",
          "bank_subsidiary_transaction_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_45_1_or_4",
    "desc": "違反第45條第一項交易條件限制或董事會決議方法",
    "expr": [
      "EQ",
      "violation_45_1_or_4",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "transaction_condition_not_better_than_others",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_approval_met",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_45_4_ratio",
    "desc": "違反第45條第四項金額比率限制",
    "expr": [
      "EQ",
      "violation_45_4_ratio",
      [
        "OR",
        [
          "NOT",
