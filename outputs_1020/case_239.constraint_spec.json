[
  {
    "id": "fhc:disciplinary_measures",
    "desc": "金融控股公司違反法令或章程時可採取之處分措施",
    "expr": [
      "EQ",
      "disciplinary_measures",
      [
        "CASE",
        [
          "EQ",
          "violation",
          true
        ],
        1,
        [
          "NOT",
          [
            "EQ",
            "violation",
            true
          ]
        ],
        0,
        0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:notify_economic_ministry_on_director_removal",
    "desc": "解除董事、監察人職務時通知經濟部廢止登記",
    "expr": [
      "EQ",
      "notify_economic_ministry_on_director_removal",
      [
        "EQ",
        "director_or_supervisor_removed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:dispose_shares_and_dissolve_if_not_completed",
    "desc": "廢止許可時限期處分股份，未完成則解散清算",
    "expr": [
      "EQ",
      "dispose_shares_and_dissolve_if_not_completed",
      [
        "IMPLIES",
        [
          "EQ",
          "license_revoked",
          true
        ],
        [
          "AND",
          [
            "LE",
            "disposition_deadline",
            "current_date"
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "shares_disposed",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "compliance_with_article_4_1",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_communication_established",
    "desc": "建立法令規章諮詢溝通管道",
    "expr": [
      "EQ",
      "internal_control_communication_established",
      [
        "EQ",
        "consultation_channel_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_report_includes_analysis",
    "desc": "法令遵循單位提報董事會報告包含缺失分析及改善建議",
    "expr": [
      "EQ",
      "internal_control_report_includes_analysis",
      [
        "AND",
        [
          "EQ",
          "report_includes_deficiency_analysis",
          true
        ],
        [
          "EQ",
          "report_includes_improvement_suggestions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:compliance_unit_mandatory_tasks",
    "desc": "法令遵循單位應辦理事項",
    "expr": [
      "EQ",
      "compliance_unit_mandatory_tasks",
      [
        "AND",
        [
          "EQ",
          "clear_communication_system_established",
          true
        ],
        [
          "EQ",
          "regulations_updated_timely",
          true
        ],
        [
          "EQ",
          "legal_opinion_signed_before_new_business",
          true
        ],
        [
          "EQ",
          "compliance_evaluation_and_supervision",
          true
        ],
        [
          "EQ",
          "staff_training_provided",
          true
        ],
        [
          "EQ",
          "supervision_of_internal_regulations_implementation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_audit_exemption",
    "desc": "內部稽核單位自行評估法令遵循不適用部分規定",
    "expr": [
      "EQ",
      "internal_audit_exemption",
      [
        "EQ",
        "internal_audit_unit_self_evaluation",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:foreign_branch_compliance_supervision",
    "desc": "國外營業單位法令遵循督導事項",
    "expr": [
      "EQ",
      "foreign_branch_compliance_supervision",
      [
        "AND",
        [
          "EQ",
          "foreign_regulations_collected",
          true
        ],
        [
          "EQ",
          "foreign_compliance_self_evaluation_implemented",
          true
        ],
        [
          "EQ",
          "foreign_compliance_supervisor_qualified",
          true
        ],
        [
          "EQ",
          "foreign_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "high_risk_business_external_verification",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:semiannual_self_evaluation",
    "desc": "法令遵循自行評估每半年至少辦理一次",
    "expr": [
      "EQ",
      "semiannual_self_evaluation",
      [
        "AND",
        [
          "GE",
          [
            "SUB",
            "current_date",
            "last_self_evaluation_date"
          ],
          180
        ],
        [
          "EQ",
          "self_evaluation_report_submitted",
          true
        ],
        [
          "EQ",
          "unit_supervisor_designated_person",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:self_evaluation_records_retained",
    "desc": "自行評估工作底稿及資料保存至少五年",
    "expr": [
      "EQ",
      "self_evaluation_records_retained",
      [
        "GE",
        [
          "SUB",
          "current_date",
          "record_creation_date"
        ],
        1825
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
