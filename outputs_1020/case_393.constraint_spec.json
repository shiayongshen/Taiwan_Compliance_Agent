[
  {
    "id": "insurance:license_required",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可",
    "expr": [
      "EQ",
      "license_required",
      [
        "AND",
        [
          "EQ",
          "agent_license_granted",
          true
        ],
        [
          "EQ",
          "broker_license_granted",
          true
        ],
        [
          "EQ",
          "notary_license_granted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:deposit_guarantee_and_insurance_required",
    "desc": "須繳存保證金並投保相關保險",
    "expr": [
      "EQ",
      "deposit_and_insurance_ok",
      [
        "AND",
        [
          "EQ",
          "deposit_paid",
          true
        ],
        [
          "EQ",
          "insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_type_required",
    "desc": "相關保險種類依身份不同而定",
    "expr": [
      "EQ",
      "insurance_type_ok",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "is_agent",
            true
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "is_notary",
            true
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              1
            ],
            [
              "EQ",
              "insurance_type",
              2
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:license_and_deposit_and_insurance_ok",
    "desc": "領有執業證照且繳存保證金並投保相關保險後，始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_deposit_and_insurance_ok",
      [
        "AND",
        [
          "EQ",
          "license_required",
          true
        ],
        [
          "EQ",
          "deposit_and_insurance_ok",
          true
        ],
        [
          "EQ",
          "insurance_type_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_for_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務",
    "expr": [
      "EQ",
      "bank_permission_ok",
      [
        "AND",
        [
          "EQ",
          "bank_permission_granted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_as_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_as_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_apply_agent_broker_rules",
    "desc": "銀行兼營保險代理人或經紀人業務時，應分別準用相關規定",
    "expr": [
      "EQ",
      "bank_apply_agent_broker_rules",
      [
        "AND",
        [
          "EQ",
          "bank_permission_ok",
          true
        ],
        [
          "EQ",
          "agent_rules_applied",
          true
        ],
        [
          "EQ",
          "broker_rules_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_ok",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂契約前應主動提供書面分析報告並明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_ok",
      [
        "AND",
        [
          "EQ",
          "broker_provide_written_report",
          true
        ],
        [
          "EQ",
          "broker_disclose_fee_standard",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未經主管機關許可、未繳存保證金、未投保相關保險、未領執業證照或保險經紀人未履行義務時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "deposit_and_insurance_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_type_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "license_and_deposit_and_insurance_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_report_and_fee_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]