[
  {
    "id": "insurance:other_transaction_limit_government_exclusion",
    "desc": "交易對象為政府機關、公立學校、公營事業者時，交易總餘額不計入限額",
    "expr": [
      "EQ",
      "other_transaction_limit_government_exclusion",
      [
        "EQ",
        "transaction_counterparty_is_government",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_transaction_limit_percentage",
    "desc": "單一交易金額不得超過業主權益之35%",
    "expr": [
      "EQ",
      "single_transaction_limit_percentage",
      [
        "LE",
        "single_transaction_amount",
        [
          "MUL",
          "policyholder_equity",
          0.35
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:total_transaction_limit_percentage",
    "desc": "交易總餘額不得超過業主權益之70%",
    "expr": [
      "EQ",
      "total_transaction_limit_percentage",
      [
        "LE",
        "total_transaction_amount",
        [
          "MUL",
          "policyholder_equity",
          0.7
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_transaction_limit_fixed_limit",
    "desc": "單一交易金額未達新臺幣1億元者，得以新臺幣1億元為最高限額",
    "expr": [
      "EQ",
      "single_transaction_limit_fixed_limit",
      [
        "OR",
        [
          "LE",
          "single_transaction_amount",
          100000000.0
        ],
        [
          "GE",
          "single_transaction_amount",
          100000000.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:total_transaction_limit_fixed_limit",
    "desc": "交易總餘額不得逾新臺幣2億元",
    "expr": [
      "EQ",
      "total_transaction_limit_fixed_limit",
      [
        "LE",
        "total_transaction_amount",
        200000000.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_transaction_limit_government",
    "desc": "政府機關、公立學校、公營事業者單一交易金額不得超過業主權益",
    "expr": [
      "EQ",
      "single_transaction_limit_government",
      [
        "IMPLIES",
        [
          "EQ",
          "transaction_counterparty_is_government",
          true
        ],
        [
          "LE",
          "single_transaction_amount",
          "policyholder_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_transaction_limit_2billion",
    "desc": "依前款計算之單一交易金額未達新臺幣2億元者，得以新臺幣2億元為最高限額",
    "expr": [
      "EQ",
      "single_transaction_limit_2billion",
      [
        "OR",
        [
          "LE",
          "single_transaction_amount",
          200000000.0
        ],
        [
          "GE",
          "single_transaction_amount",
          200000000.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:other_transaction_limit_pre_announcement",
    "desc": "本辦法發布前之其他交易案件，交易總餘額逾限額者不得再增加交易",
    "expr": [
      "EQ",
      "other_transaction_limit_pre_announcement",
      [
        "IMPLIES",
        [
          "EQ",
          "transaction_before_announcement",
          true
        ],
        [
          "LE",
          "total_transaction_amount",
          "previous_limit_amount"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:non_related_party_real_estate_single_limit_capital_ratio_met",
    "desc": "自有資本與風險資本比率達法定標準，單一交易金額不得超過資金1.5%",
    "expr": [
      "EQ",
      "non_related_party_real_estate_single_limit_capital_ratio_met",
      [
        "IMPLIES",
        [
          "GE",
          "capital_to_risk_capital_ratio",
          "statutory_standard"
        ],
        [
          "LE",
          "single_transaction_amount",
          [
            "MUL",
            "funds",
            0.015
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:non_related_party_real_estate_total_limit_capital_ratio_met",
