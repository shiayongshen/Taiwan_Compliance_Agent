    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:non_related_party_real_estate_single_limit_capital_ratio_not_met_equity_positive",
    "desc": "自有資本與風險資本比率未達法定標準且業主權益正數，經核准後單一交易金額不得超過資金1%",
    "expr": [
      "EQ",
      "non_related_party_real_estate_single_limit_capital_ratio_not_met_equity_positive",
      [
        "AND",
        [
          "LT",
          "capital_to_risk_capital_ratio",
          "statutory_standard"
        ],
        [
          "GT",
          "policyholder_equity",
          0.0
        ],
        [
          "EQ",
          "capital_increase_plan_approved",
          true
        ],
        [
          "LE",
          "single_transaction_amount",
          [
            "MUL",
            "funds",
            0.01
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:non_related_party_real_estate_total_limit_capital_ratio_not_met_equity_positive",
