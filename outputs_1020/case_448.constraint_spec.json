    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_increase_plan_violation_penalty",
    "desc": "未依計畫確實辦理增資者，主管機關得廢止核准或為其他處置",
    "expr": [
      "EQ",
      "capital_increase_plan_violation_penalty",
      [
        "AND",
        [
          "EQ",
          "capital_increase_plan_approved",
          true
        ],
        [
          "EQ",
          "capital_increase_plan_violation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
