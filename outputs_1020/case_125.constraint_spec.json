[
  {
    "id": "insurance:internal_control_established",
    "desc": "保險業已建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_executed",
    "desc": "保險業已執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_established",
    "desc": "保險業已建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_executed",
    "desc": "保險業已執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_executed",
      [
        "EQ",
        "internal_handling_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_compliance",
    "desc": "保險業內部控制及稽核制度建立且執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_compliance",
    "desc": "保險業內部處理制度及程序建立且執行",
    "expr": [
      "EQ",
      "internal_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_handling_compliance",
    "desc": "保險業內部控制及稽核制度與內部處理制度均合規",
    "expr": [
      "EQ",
      "internal_control_and_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_compliance",
          true
        ],
        [
          "EQ",
          "internal_handling_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_and_transaction_limit_compliance",
    "desc": "保險業對同一人、同一關係人或同一關係企業之放款或其他交易符合主管機關限制規定",
    "expr": [
      "EQ",
      "loan_and_transaction_limit_compliance",
      [
        "EQ",
        "loan_and_transaction_limit_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_transaction_compliance",
    "desc": "保險業與利害關係人從事放款以外之其他交易符合主管機關限制規定",
    "expr": [
      "EQ",
      "related_party_transaction_compliance",
      [
        "EQ",
        "related_party_transaction_limit_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:report_and_document_compliance",
    "desc": "保險業依規定據實編製說明文件並於重大訊息發生時依規定報告及公開說明",
    "expr": [
      "EQ",
      "report_and_document_compliance",
      [
        "AND",
        [
          "EQ",
          "financial_and_business_document_provided",
          true
        ],
        [
          "EQ",
          "major_information_reported_and_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:inspection_cooperation_compliance",
    "desc": "保險業配合主管機關檢查，未拒絕檢查、未隱匿毀損帳冊文件、未不實答復、未逾期提報或未逾期繳納查核費用",
    "expr": [
      "EQ",
      "inspection_cooperation_compliance",
      [
        "AND",
        [
          "EQ",
          "not_refuse_inspection",
          true
        ],
        [
          "EQ",
          "not_hide_or_destroy_documents",
          true
        ],
        [
          "EQ",
          "truthful_and_timely_response",
          true
        ],
        [
          "EQ",
          "timely_report_and_fee_payment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_financial_institution_cooperation_compliance",
    "desc": "保險業之關係企業或其他金融機構配合主管機關檢查，未怠於提供財務報告、帳冊、文件或相關交易資料",
    "expr": [
      "EQ",
      "related_financial_institution_cooperation_compliance",
      [
        "EQ",
        "related_financial_institution_cooperated",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_violation",
    "desc": "違反內部控制及稽核制度建立或執行規定",
    "expr": [
      "EQ",
      "internal_control_violation",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_violation",
    "desc": "違反內部處理制度及程序建立或執行規定",
    "expr": [
      "EQ",
      "internal_handling_violation",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:inspection_violation",
    "desc": "違反主管機關檢查配合義務，包括拒絕檢查、隱匿毀損帳冊文件、不實答復、逾期提報或逾期繳納查核費用",
    "expr": [
      "EQ",
      "inspection_violation",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "not_refuse_inspection",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "not_hide_or_destroy_documents",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "truthful_and_timely_response",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "timely_report_and_fee_payment",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_financial_institution_violation",
    "desc": "保險業之關係企業或其他金融機構怠於提供財務報告、帳冊、文件或相關交易資料",
    "expr": [
      "EQ",
      "related_financial_institution_violation",
      [
        "NOT",
        [
          "EQ",
          "related_financial_institution_cooperated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反內部控制或內部處理制度建立或執行，或違反檢查配合義務，或關係企業怠於提供資料時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "internal_control_violation",
          true
        ],
        [
          "EQ",
          "internal_handling_violation",
          true
        ],
        [
          "EQ",
          "inspection_violation",
          true
        ],
        [
          "EQ",
          "related_financial_institution_violation",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]