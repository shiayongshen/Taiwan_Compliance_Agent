  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反相關法令、章程或規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violate_business_scope_regulations",
          true
        ],
        [
          "EQ",
          "violate_reserve_requirements",
          true
        ],
        [
          "EQ",
          "violate_article_143",
          true
        ],
        [
          "EQ",
          "violate_article_143_5_or_143_6_measures",
          true
        ],
        [
          "EQ",
          "violate_fund_management_regulations",
          true
        ],
        [
          "EQ",
          "loan_without_sufficient_collateral_or_better_terms",
          true
        ],
        [
          "EQ",
          "loan_guarantee_exceed_board_approval",
          true
        ],
        [
