            "EQ",
            "investment_decision_recorded",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fiduciary_business_operated_according_to_rules",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
