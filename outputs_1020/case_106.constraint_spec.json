      "EQ",
      "investment_decision_recorded",
      [
        "AND",
        [
          "EQ",
          "investment_decision_based_on_analysis",
          true
        ],
        [
          "EQ",
          "investment_decision_recorded_true",
          true
        ],
        [
          "EQ",
          "monthly_review_done",
          true
        ],
        [
          "EQ",
          "analysis_has_reasonable_basis",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_established_and_executed",
    "desc": "內部控制制度訂定於制度且確實執行，控制作業留存紀錄並保存期限",
    "expr": [
      "EQ",
      "internal_control_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_system_documented",
          true
        ],
        [
          "EQ",
          "internal_control_system_executed",
          true
        ],
        [
          "EQ",
          "control_operations_recorded",
          true
        ],
        [
          "EQ",
          "control_records_retained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:fiduciary_business_operated_according_to_rules",
    "desc": "全權委託投資業務依業務操作規定辦理",
    "expr": [
      "EQ",
      "fiduciary_business_operated_according_to_rules",
      [
        "EQ",
        "fiduciary_business_follow_operating_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:investment_decision_follow_article_17",
    "desc": "全權委託投資資產投資決定準用第17條規定",
    "expr": [
      "EQ",
      "investment_decision_follow_article_17",
      [
        "EQ",
        "investment_decision_follow_internal_control_17",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:investment_diversification_compliance",
    "desc": "委託投資資產分散投資且符合主管機關定之分散比率",
    "expr": [
      "EQ",
      "investment_diversification_compliance",
      [
        "AND",
        [
          "EQ",
          "investment_diversified",
          true
        ],
        [
          "EQ",
          "diversification_ratio_compliant",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors_violated",
    "desc": "有違反第59條禁止行為",
    "expr": [
      "EQ",
      "prohibited_behaviors_violated",
      [
        "OR",
        [
          "EQ",
          "use_of_insider_info_for_self_or_others",
          true
        ],
        [
          "EQ",
          "damaging_client_interests_trading",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "profit_loss_sharing_agreement",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "performance_fee_exception",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "self_or_other_fund_opposite_trading",
            true
          ],
          [
            "NOT",
            [
              "AND",
              [
                "EQ",
                "trading_through_central_market",
                true
              ],
              [
                "NOT",
                [
                  "EQ",
                  "intentional_opposite_trading",
                  true
                ]
              ]
            ]
          ]
        ],
        [
          "EQ",
          "use_client_account_for_self_or_others",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "full_trust_contract_subdelegated_or_transferred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "regulatory_exception",
              true
            ]
          ]
        ],
        [
          "EQ",
          "transfer_completed_orders_without_justification",
          true
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "investment_decision_follow_analysis_report",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "reasonable_explanation_provided",
              true
            ]
          ]
        ],
        [
          "EQ",
          "other_behaviors_affecting_business_or_client",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors_violated_by_personnel",
    "desc": "負責人、業務人員及受僱人不得為第19條第1項、第59條或法令契約禁止行為",
    "expr": [
      "EQ",
      "prohibited_behaviors_violated_by_personnel",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "personnel_no_violation_article_19_1",
            true
          ],
          [
            "EQ",
            "personnel_no_violation_article_59",
            true
          ],
          [
            "EQ",
            "personnel_no_violation_law_contract",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
