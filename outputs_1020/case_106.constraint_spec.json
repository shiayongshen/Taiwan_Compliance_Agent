  {
    "id": "securities:penalty_conditions",
    "desc": "處罰條件：違反善良管理人義務、保密義務、投資決策紀錄、內部控制制度、全權委託投資業務規定、禁止行為、內部控制缺失、資訊設備管理、防範利益衝突、投資分散限制、外國有價證券業務規定、業務終止規定等任一規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "good_faith_duty",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "confidentiality_obligation",
            true
          ]
        ],
        [
          "NOT",
