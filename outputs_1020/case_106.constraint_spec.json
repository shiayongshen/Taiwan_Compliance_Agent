  {
    "id": "securities:investment_diversification_limits_compliance",
    "desc": "全權委託投資帳戶投資股票、公司債、金融債券及認購權證符合百分比限制",
    "expr": [
      "EQ",
      "investment_diversification_limits_compliance",
      [
        "AND",
        [
          "LE",
          "investment_amount_per_company_stock_bond_warrant",
          [
            "MUL",
            [
              "DIV",
              "fiduciary_account_net_asset_value",
              1.0
            ],
            20.0
          ]
        ],
        [
          "LE",
          "investment_amount_per_company_bond",
          [
            "MUL",
            [
              "DIV",
              "fiduciary_account_net_asset_value",
              1.0
            ],
            10.0
          ]
        ],
        [
          "LE",
          "investment_amount_per_trustee_raised_securities",
          [
            "MUL",
            [
              "DIV",
              "fiduciary_account_net_asset_value",
              1.0
            ],
            20.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
