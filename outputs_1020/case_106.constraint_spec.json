[
  {
    "id": "securities:good_faith_duty",
    "desc": "證券投資信託及顧問事業等應以善良管理人注意義務及忠實義務誠實信用原則執行業務",
    "expr": [
      "EQ",
      "good_faith_duty",
      [
        "AND",
        [
          "EQ",
          "duty_of_care",
          true
        ],
        [
          "EQ",
          "duty_of_loyalty",
          true
        ],
        [
          "EQ",
          "good_faith_principle",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_obligation",
    "desc": "對受益人或客戶資料應保守秘密",
    "expr": [
      "EQ",
      "confidentiality_obligation",
      [
        "AND",
        [
          "EQ",
          "personal_data_protection",
          true
        ],
        [
          "EQ",
          "transaction_data_protection",
          true
        ],
        [
          "EQ",
          "other_related_data_protection",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:investment_decision_recorded",
