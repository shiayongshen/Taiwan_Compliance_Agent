[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures",
          true
        ],
        [
          "EQ",
          "training_held",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_required_matters_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "trust:contract_disclosure_compliant",
    "desc": "信託契約載明營運範圍、受益權轉讓限制及風險揭露並告知委託人",
    "expr": [
      "EQ",
      "contract_disclosure_compliant",
      [
        "AND",
        [
          "EQ",
          "operation_scope_disclosed",
          true
        ],
        [
          "EQ",
          "beneficiary_transfer_limit_disclosed",
          true
        ],
        [
          "EQ",
          "risk_disclosure_done",
          true
        ],
        [
          "EQ",
          "client_notified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:compliance_with_regulations",
    "desc": "遵守信託業法及主管機關命令",
    "expr": [
      "EQ",
      "compliance_with_regulations",
      [
        "EQ",
        "law_and_orders_complied",
        true
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "bank:regulatory_compliance",
    "desc": "銀行遵守法令、章程及健全經營規定",
    "expr": [
      "EQ",
      "regulatory_compliance",
      [
        "EQ",
        "law_and_regulations_complied",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:supervisory_measures",
    "desc": "主管機關對銀行違規採取處分措施",
    "expr": [
      "EQ",
      "supervisory_measures",
      [
        "OR",
        [
          "EQ",
          "resolution_revoked",
          true
        ],
        [
          "EQ",
          "partial_business_suspended",
          true
        ],
        [
          "EQ",
          "investment_restricted",
          true
        ],
        [
          "EQ",
          "asset_disposal_ordered",
          true
        ],
        [
          "EQ",
          "branch_closure_ordered",
          true
        ],
        [
          "EQ",
          "manager_duty_suspended",
          true
        ],
        [
          "EQ",
          "director_supervisor_removed",
          true
        ],
        [
          "EQ",
          "reserve_fund_mandated",
          true
        ],
        [
          "EQ",
          "other_measures_taken",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反洗錢防制法第7條建立或執行制度規定，或信託業法違規，或銀行法違規時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "compliance_with_regulations",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "regulatory_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]