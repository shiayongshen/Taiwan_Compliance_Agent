      "EQ",
      "penalty_investment_restriction",
      [
        "EQ",
        "penalty_investment_restriction_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:penalty_asset_disposal_restriction",
