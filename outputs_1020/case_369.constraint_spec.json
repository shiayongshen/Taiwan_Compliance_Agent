    "expr": [
      "EQ",
      "penalty_manager_staff_dismissal_or_suspension",
      [
        "EQ",
        "penalty_manager_staff_dismissal_or_suspension_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
