    "desc": "其他必要之處置",
    "expr": [
      "EQ",
      "other_necessary_measures_ordered",
      [
        "EQ",
        "other_necessary_measures_ordered_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:business_guidance_needed",
    "desc": "為改善銀行營運缺失有業務輔導之必要",
    "expr": [
      "EQ",
      "business_guidance_needed",
      [
        "EQ",
        "business_guidance_needed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：銀行違反法令、章程或有礙健全經營且主管機關依規定處分時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "AND",
        [
          "EQ",
          "violation_occurred",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "penalty_revocation_resolution",
            true
          ],
          [
            "EQ",
            "penalty_suspend_partial_business",
            true
          ],
          [
            "EQ",
            "penalty_investment_restriction",
            true
          ],
          [
            "EQ",
            "penalty_asset_disposal_restriction",
            true
          ],
          [
            "EQ",
            "penalty_branch_closure_order",
            true
          ],
          [
            "EQ",
            "penalty_manager_staff_dismissal_or_suspension",
            true
          ],
          [
            "EQ",
            "penalty_director_supervisor_dismissal_or_suspension",
            true
          ],
          [
            "EQ",
            "reserve_fund_ordered",
            true
          ],
          [
            "EQ",
            "other_necessary_measures_ordered",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]