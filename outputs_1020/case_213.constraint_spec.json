[
  {
    "id": "securities:annual_report_submitted",
    "desc": "每會計年度終了後三個月內公告並申報經董事長、經理人及會計主管簽名或蓋章，經會計師查核簽證、董事會通過及監察人承認之年度財務報告",
    "expr": [
      "EQ",
      "annual_report_submitted",
      [
        "AND",
        [
          "LE",
          "annual_report_submission_days",
          90
        ],
        [
          "EQ",
          "annual_report_signed_by_ceo_manager_accountant",
          true
        ],
        [
          "EQ",
          "annual_report_audited_by_accountant",
          true
        ],
        [
          "EQ",
          "annual_report_approved_by_board",
          true
        ],
        [
          "EQ",
          "annual_report_approved_by_supervisors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:quarterly_report_submitted",
    "desc": "每會計年度第一季、第二季及第三季終了後四十五日內公告並申報經董事長、經理人及會計主管簽名或蓋章，經會計師核閱及提報董事會之財務報告",
    "expr": [
      "EQ",
      "quarterly_report_submitted",
      [
        "AND",
        [
          "LE",
          "quarterly_report_submission_days",
          45
        ],
        [
          "EQ",
          "quarterly_report_signed_by_ceo_manager_accountant",
          true
        ],
        [
          "EQ",
          "quarterly_report_reviewed_by_accountant",
          true
        ],
        [
          "EQ",
          "quarterly_report_reported_to_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:monthly_operation_report_submitted",
    "desc": "每月十日以前公告並申報上月份營運情形",
    "expr": [
      "EQ",
      "monthly_operation_report_submitted",
      [
        "AND",
        [
          "LE",
          "monthly_operation_report_submission_day",
          10
        ],
        [
          "EQ",
          "monthly_operation_report_for_previous_month",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:special_circumstances_approved",
    "desc": "主管機關另定特殊情形適用範圍、公告、申報期限及其他應遵行事項",
    "expr": [
      "EQ",
      "special_circumstances_approved",
      [
        "EQ",
        "special_circumstances_applied",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:discrepant_annual_report_reported",
    "desc": "股東常會承認之年度財務報告與公告申報之年度財務報告不一致，於事實發生日起二日內公告並申報",
    "expr": [
      "EQ",
      "discrepant_annual_report_reported",
      [
        "AND",
        [
          "EQ",
          "annual_report_discrepant",
          true
        ],
        [
          "LE",
          "discrepant_report_days_since_occurrence",
          2
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:material_event_reported",
    "desc": "發生對股東權益或證券價格有重大影響事項，於事實發生日起二日內公告並申報",
    "expr": [
      "EQ",
      "material_event_reported",
      [
        "AND",
        [
          "EQ",
          "material_event_occurred",
          true
        ],
        [
          "LE",
          "material_event_report_days_since_occurrence",
          2
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:annual_meeting_held",
    "desc": "股票已上市或於證券商營業處所買賣之公司股東常會，於每會計年度終了後六個月內召開",
    "expr": [
      "EQ",
      "annual_meeting_held",
      [
        "LE",
        "annual_meeting_days_since_fiscal_year_end",
        180
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:board_failed_to_call_annual_meeting",
    "desc": "股票已上市或於證券商營業處所買賣之公司董事及監察人任期屆滿之年，董事會未依規定召開股東常會改選董事、監察人",
    "expr": [
      "EQ",
      "board_failed_to_call_annual_meeting",
      [
        "AND",
        [
          "EQ",
          "board_term_expired",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "annual_meeting_held",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:board_and_supervisors_dismissed",
    "desc": "董事會未召開股東常會改選，主管機關限期召開屆期仍不召開者，全體董事及監察人當然解任",
    "expr": [
      "EQ",
      "board_and_supervisors_dismissed",
      [
        "AND",
        [
          "EQ",
          "board_failed_to_call_annual_meeting",
          true
        ],
        [
          "EQ",
          "regulator_called_meeting_expired",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:reorganization_period_board_supervisor_powers",
    "desc": "公司重整期間董事會及監察人職權由重整人及重整監督人行使",
    "expr": [
      "EQ",
      "reorganization_period_board_supervisor_powers",
      [
        "EQ",
        "company_in_reorganization_period",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:annual_report_prepared_and_distributed",
    "desc": "公司應編製年報，於股東常會分送股東",
    "expr": [
      "EQ",
      "annual_report_prepared_and_distributed",
      [
        "EQ",
        "annual_report_prepared_and_distributed_to_shareholders",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:report_copies_sent",
    "desc": "公告申報事項及年報抄本送證券交易所或主管機關指定機構供公眾閱覽",
    "expr": [
      "EQ",
      "report_copies_sent",
      [
        "OR",
        [
          "EQ",
          "report_copies_sent_to_exchange",
          true
        ],
        [
          "EQ",
          "report_copies_sent_to_designated_agency",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_178",
    "desc": "違反證券交易法第178條規定之行為",
    "expr": [
      "EQ",
      "violation_178",
      [
        "OR",
        [
          "EQ",
          "violate_article_22_2_1_or_2",
          true
        ],
        [
          "EQ",
          "violate_article_26_1_or_165_1_applied_22_2_1_or_2",
          true
        ],
        [
          "EQ",
          "fail_to_submit_or_obstruct_inspection",
          true
        ],
        [
          "EQ",
          "fail_to_prepare_or_report_documents",
          true
        ],
        [
          "EQ",
          "violate_article_14_4_or_165_1_applied_14_4",
          true
        ],
        [
          "EQ",
          "violate_article_14_6_or_165_1_applied_14_6",
          true
        ],
        [
          "EQ",
          "violate_article_25_1_or_165_1_applied_25_1",
          true
        ],
        [
          "EQ",
          "violate_director_supervisor_shareholding_rules",
          true
        ],
        [
          "EQ",
          "violate_article_26_3_or_165_1_applied_26_3",
          true
        ],
        [
          "EQ",
          "violate_article_28_2_or_165_1_applied_28_2",
          true
        ],
        [
          "EQ",
          "violate_article_36_1_or_165_1_applied_36_1",
          true
        ],
        [
          "EQ",
          "violate_article_43_2_or_43_3_or_43_5_or_165_1_or_165_2_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_179",
    "desc": "法人及外國公司違反本法規定，依本章各條規定處罰其負責人",
    "expr": [
      "EQ",
      "violation_179",
      [
        "AND",
        [
          "EQ",
          "legal_entity_violated",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "excluded_by_articles_177_and_178",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:special_circumstances_extension_annual_report",
    "desc": "未上市、未上櫃國內外國公司因作業時間不及，得延長公告申報年度財務報告至四個月內，免公告申報第一季及第三季合併財務報告",
    "expr": [
      "EQ",
      "special_circumstances_extension_annual_report",
      [
        "AND",
        [
          "EQ",
          "not_listed_or_taipei_over_the_counter",
          true
        ],
        [
          "LE",
          "annual_report_submission_days",
          120
        ],
        [
          "EQ",
          "exempt_first_and_third_quarter_reports",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:second_listing_company_report_rules",
    "desc": "第二上市公司依註冊地或上市地國法令公告申報年度及期中合併財務報告，免公告申報每月營運情形，年度合併財務報告不得逾會計年度終了後六個月",
    "expr": [
      "EQ",
      "second_listing_company_report_rules",
      [
        "AND",
        [
          "EQ",
          "second_listing_company",
          true
        ],
        [
          "EQ",
          "comply_registered_or_listed_country_laws",
          true
        ],
        [
          "EQ",
          "exempt_monthly_operation_report",
          true
        ],
        [
          "LE",
          "annual_report_submission_days",
          180
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:first_listing_second_quarter_report_rules",
    "desc": "自中華民國110會計年度起，第一上市公司第二季財務報告應經會計師查核簽證、董事會通過及監察人承認，公告申報不得逾第二季終了後二個月",
    "expr": [
      "EQ",
      "first_listing_second_quarter_report_rules",
      [
        "AND",
        [
          "GE",
          "accounting_year",
          110
        ],
        [
          "EQ",
          "first_listing_company",
          true
        ],
        [
          "LE",
          "second_quarter_report_submission_days",
          60
        ],
        [
          "EQ",
          "second_quarter_report_audited_by_accountant",
          true
        ],
        [
          "EQ",
          "second_quarter_report_approved_by_board",
          true
        ],
        [
          "EQ",
          "second_quarter_report_approved_by_supervisors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:large_capital_annual_report_deadline",
    "desc": "自111會計年度起，實收資本額達新臺幣100億元以上上市公司公告申報年度財務報告不得逾會計年度終了後75日",
    "expr": [
      "EQ",
      "large_capital_annual_report_deadline",
      [
        "AND",
        [
          "GE",
          "accounting_year",
          111
        ],
        [
          "GE",
          "paid_in_capital_ntd",
          10000000000
        ],
        [
          "LE",
          "annual_report_submission_days",
          75
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:monthly_operation_report_items_defined",
    "desc": "公告並申報之營運情形包括合併營業收入額、為他人背書及保證之金額及主管機關所定事項",
    "expr": [
      "EQ",
      "monthly_operation_report_items_defined",
      [
        "AND",
        [
          "EQ",
          "include_consolidated_revenue",
          true
        ],
        [
          "EQ",
          "include_endorsement_and_guarantee_amount",
          true
        ],
        [
          "EQ",
          "include_other_regulator_defined_items",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反公告申報及相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "annual_report_submitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "quarterly_report_submitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "monthly_operation_report_submitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "discrepant_annual_report_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "material_event_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "annual_meeting_held",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_failed_to_call_annual_meeting",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_and_supervisors_dismissed",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_178",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_179",
            false
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]