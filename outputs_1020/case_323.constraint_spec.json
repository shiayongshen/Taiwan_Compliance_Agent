[
  {
    "id": "insurance:act_144_actuarial_staff_assigned",
    "desc": "保險業聘用精算人員並指派簽證精算人員",
    "expr": [
      "EQ",
      "act_144_actuarial_staff_assigned",
      [
        "AND",
        [
          "EQ",
          "actuarial_staff_hired",
          true
        ],
        [
          "EQ",
          "signing_actuary_assigned",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_144_external_review_actuary_hired",
    "desc": "保險業聘請外部複核精算人員",
    "expr": [
      "EQ",
      "act_144_external_review_actuary_hired",
      [
        "EQ",
        "external_review_actuary_hired",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_144_board_approval_obtained",
    "desc": "簽證精算人員指派及外部複核精算人員聘請經董（理）事會同意",
    "expr": [
      "EQ",
      "act_144_board_approval_obtained",
      [
        "AND",
        [
          "EQ",
          "signing_actuary_board_approved",
          true
        ],
        [
          "EQ",
          "external_review_actuary_board_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_144_reports_fair_and_true",
    "desc": "簽證報告及複核報告內容公正且無虛偽隱匿遺漏錯誤",
    "expr": [
      "EQ",
      "act_144_reports_fair_and_true",
      [
        "AND",
        [
          "EQ",
          "signing_actuary_report_fair_and_true",
          true
        ],
        [
          "EQ",
          "external_review_report_fair_and_true",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_148_3_internal_control_established",
    "desc": "保險業建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "act_148_3_internal_control_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_148_3_internal_handling_established",
    "desc": "保險業建立內部處理制度及程序",
    "expr": [
      "EQ",
      "act_148_3_internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_171_1_violate_internal_control",
    "desc": "違反第148-3條第一項規定，未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "act_171_1_violate_internal_control",
      [
        "NOT",
        [
          "EQ",
          "act_148_3_internal_control_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:act_171_1_violate_internal_handling",
    "desc": "違反第148-3條第二項規定，未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "act_171_1_violate_internal_handling",
      [
        "NOT",
        [
          "EQ",
          "act_148_3_internal_handling_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:product_sales_precheck_responsibilities",
    "desc": "保險商品銷售前各職務負責檢視項目完成",
    "expr": [
      "EQ",
      "product_sales_precheck_responsibilities",
      [
        "AND",
        [
          "EQ",
          "gm_or_authorized_manager_reviewed",
          true
        ],
        [
          "EQ",
          "underwriting_staff_reviewed",
          true
        ],
        [
          "EQ",
          "claims_staff_reviewed",
          true
        ],
        [
          "EQ",
          "actuarial_staff_reviewed",
          true
        ],
        [
          "EQ",
          "policy_service_staff_reviewed",
          true
        ],
        [
          "EQ",
          "legal_staff_reviewed",
          true
        ],
        [
          "EQ",
          "investment_staff_reviewed",
          true
        ],
        [
          "EQ",
          "risk_management_staff_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
