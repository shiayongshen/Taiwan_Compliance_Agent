        [
          "EQ",
          "underwriting_process_defined",
          true
        ],
        [
          "EQ",
          "insurance_needs_assessed",
          true
        ],
        [
          "EQ",
          "insurance_amount_and_premium_assessed",
          true
        ],
        [
          "EQ",
          "senior_customer_appropriateness_assessed",
          true
        ],
        [
          "EQ",
          "premium_source_assessed",
          true
        ],
        [
          "EQ",
          "applicant_and_insured_identity_confirmed",
          true
        ],
        [
          "EQ",
          "beneficiary_confirmation_procedure",
          true
        ],
        [
          "EQ",
          "contract_change_and_signature_procedure",
          true
        ],
        [
          "EQ",
          "personal_data_preservation_procedure",
          true
        ],
        [
          "EQ",
          "risk_and_premium_based_on_actuarial_data",
          true
        ],
        [
          "EQ",
          "no_unqualified_underwriting",
          true
        ],
        [
          "EQ",
          "no_unassessed_appropriateness",
          true
        ],
        [
          "EQ",
          "no_backdated_policy",
          true
        ],
        [
          "EQ",
          "proper_signature_and_evidence_reviewed",
          true
        ],
        [
          "EQ",
          "proper_financial_underwriting_and_reporting",
          true
        ],
        [
          "EQ",
          "no_damaging_behavior_to_insured",
          true
        ],
        [
          "EQ",
          "other_regulatory_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internet_only_insurance_restrictions",
    "desc": "純網路保險公司不得有保險業務員及相關限制",
    "expr": [
      "EQ",
      "internet_only_insurance_restrictions",
      [
        "AND",
        [
          "EQ",
          "no_insurance_agents",
          true
        ],
        [
          "EQ",
          "no_brokers",
          true
        ],
        [
          "EQ",
          "internal_sales_procedure_defined",
          true
        ],
        [
          "EQ",
          "basic_customer_data_collected",
          true
        ],
        [
          "EQ",
          "customer_eligibility_assessed",
          true
        ],
        [
          "EQ",
          "insurance_purpose_and_needs_assessed",
          true
        ],
        [
          "EQ",
          "premium_source_assessed",
          true
        ],
        [
          "EQ",
          "senior_customer_ability_assessed",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "mispricing_or_improper_discount",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "false_or_misleading_promotion",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "induce_contract_termination_or_loan_payment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "induce_violation_of_disclosure",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "no_appropriateness_confirmation_for_seniors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_damaging_behavior_to_customers",
            true
          ]
        ],
        [
          "EQ",
          "recording_and_review_of_sales_process",
          true
        ],
        [
          "EQ",
          "recording_and_review_includes_required_items",
          true
        ],
        [
          "EQ",
          "recording_and_review_retention_period_met",
          true
        ],
        [
          "EQ",
          "post_sale_customer_contact_and_recording",
          true
        ],
        [
          "EQ",
          "post_sale_record_retention_period_met",
          true
        ],
        [
          "EQ",
          "other_regulatory_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法定規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "act_144_actuarial_staff_assigned",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_144_external_review_actuary_hired",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_144_board_approval_obtained",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_144_reports_fair_and_true",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_148_3_internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "act_148_3_internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "underwriting_procedure_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internet_only_insurance_restrictions",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]