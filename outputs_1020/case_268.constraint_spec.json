[
  {
    "id": "fhc:internal_control_established",
    "desc": "金融控股公司已建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_executed",
    "desc": "金融控股公司已確實執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_compliance",
    "desc": "金融控股公司內部控制制度建立且確實執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_components_compliant",
    "desc": "內部控制制度包含五大組成要素且符合規定",
    "expr": [
      "EQ",
      "internal_control_components_compliant",
      [
        "AND",
        [
          "EQ",
          "control_environment_compliant",
          true
        ],
        [
          "EQ",
          "risk_assessment_compliant",
          true
        ],
        [
          "EQ",
          "control_activities_compliant",
          true
        ],
        [
          "EQ",
          "information_communication_compliant",
          true
        ],
        [
          "EQ",
          "monitoring_activities_compliant",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_audit_duties_compliant",
    "desc": "內部稽核單位履行規劃、督導及稽核計畫等職責",
    "expr": [
      "EQ",
      "internal_audit_duties_compliant",
      [
        "AND",
        [
          "EQ",
          "audit_organization_planned",
          true
        ],
        [
          "EQ",
          "audit_supervision_done",
          true
        ],
        [
          "EQ",
          "annual_audit_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_scope_compliant",
    "desc": "內部控制制度涵蓋所有營運活動並訂定適當政策及程序",
    "expr": [
      "EQ",
      "internal_control_scope_compliant",
      [
        "AND",
        [
          "EQ",
          "organization_rules_defined",
          true
        ],
        [
          "EQ",
          "business_regulations_defined",
          true
        ],
        [
          "EQ",
          "subsidiary_management_defined",
          true
        ],
        [
          "EQ",
          "banking_business_regulations_defined",
          true
        ],
        [
          "EQ",
          "credit_union_business_regulations_defined",
          true
        ],
        [
          "EQ",
          "securities_business_regulations_defined",
          true
        ],
        [
          "EQ",
          "trust_business_manual_defined",
          true
        ],
        [
          "EQ",
          "salary_committee_management_included",
          true
        ],
        [
          "EQ",
          "audit_committee_management_included",
          true
        ],
        [
          "EQ",
          "subsidiary_control_defined",
          true
        ],
        [
          "EQ",
          "group_aml_ctf_plan_established",
          true
        ],
        [
          "EQ",
          "policy_revision_mechanism_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:legal_compliance_violations",
    "desc": "違反金融控股公司法第60條各項規定",
    "expr": [
      "EQ",
      "legal_compliance_violations",
      [
        "OR",
        [
          "EQ",
          "violate_article_6_1",
          true
        ],
        [
          "EQ",
          "violate_article_16_3",
          true
        ],
        [
          "EQ",
          "violate_article_16_1_2_9",
          true
        ],
        [
          "EQ",
          "violate_article_16_7_exception",
          true
        ],
        [
          "EQ",
          "violate_article_16_10",
          true
        ],
        [
          "EQ",
          "violate_article_16_5_reporting",
          true
        ],
        [
          "EQ",
          "violate_article_16_6_pledge",
          true
        ],
        [
          "EQ",
          "violate_article_18_1",
          true
        ],
        [
          "EQ",
          "violate_article_38",
          true
        ],
        [
          "EQ",
          "violate_article_39_1",
          true
        ],
        [
          "EQ",
          "violate_article_39_2",
          true
        ],
        [
          "EQ",
          "violate_article_39_3",
          true
        ],
        [
          "EQ",
          "violate_article_40_41_ratio_disposal",
          true
        ],
        [
          "EQ",
          "violate_article_42_1_confidentiality",
          true
        ],
        [
          "EQ",
          "violate_article_43_1_2_4",
          true
        ],
        [
          "EQ",
          "violate_article_43_3_scope_management",
          true
        ],
        [
          "EQ",
          "violate_article_45_1_4",
          true
        ],
        [
          "EQ",
          "violate_article_46_1_reporting",
          true
        ],
        [
          "EQ",
          "violate_article_51_internal_control",
          true
        ],
        [
          "EQ",
          "violate_article_53_1_2_capital",
          true
        ],
        [
          "EQ",
          "violate_article_53_3_capital_replenish",
          true
        ],
        [
          "EQ",
          "violate_article_55_1_order",
          true
        ],
        [
          "EQ",
          "violate_article_56_1_assistance",
          true
        ],
        [
          "EQ",
          "violate_article_56_2_order",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融控股公司法第60條任一規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "legal_compliance_violations",
            false
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]