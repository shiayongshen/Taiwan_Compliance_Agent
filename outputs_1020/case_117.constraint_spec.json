[
  {
    "id": "insurance:related_party_definition",
    "desc": "同一人、同一關係人及同一關係企業定義",
    "expr": [
      "EQ",
      "related_party_definition",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "same_natural_person",
            true
          ],
          [
            "EQ",
            "same_legal_person",
            true
          ]
        ],
        [
          "OR",
          [
            "EQ",
            "related_person_self",
            true
          ],
          [
            "EQ",
            "related_person_spouse",
            true
          ],
          [
            "LE",
            "related_person_blood_degree",
            2
          ],
          [
            "EQ",
            "related_person_responsible_enterprise",
            true
          ]
        ],
        [
          "EQ",
          "related_enterprise_company_law_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_equity_exchange",
    "desc": "禁止保險業與被投資公司或第三人以信託、委任或其他契約約定股權交換或利益輸送",
    "expr": [
      "EQ",
      "prohibited_equity_exchange",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "equity_exchange_agreement",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "benefit_transfer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "damage_to_policyholder",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholder_meeting_vote_documented",
    "desc": "股東會表決權評估分析及董事會提報",
    "expr": [
      "EQ",
      "shareholder_meeting_vote_documented",
      [
        "AND",
        [
          "EQ",
          "vote_evaluation_prepared",
          true
        ],
        [
          "EQ",
          "vote_record_reported_to_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_proxy_requester",
    "desc": "保險業及其從屬公司不得擔任被投資公司委託書徵求人",
    "expr": [
      "EQ",
      "prohibited_proxy_requester",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "proxy_requester_self",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "proxy_requester_agent",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "CAR",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "CAR",
            50.0
          ],
          [
            "LT",
            "CAR",
            150.0
          ],
          [
            "GE",
            "NWR",
            0.0
          ],
          [
            "LT",
            "NWR",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "CAR",
            150.0
          ],
          [
            "LT",
            "CAR",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "CAR",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_4_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_4_measures_executed",
      [
        "EQ",
        "capital_level_4_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_3_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_3_measures_executed",
      [
        "EQ",
        "capital_level_3_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_2_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervision_penalty_conditions",
    "desc": "主管機關對資本嚴重不足且未完成增資或改善計畫者，得為接管等處分",
    "expr": [
      "EQ",
      "supervision_penalty_conditions",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_or_responsible_person_completed_capital_increase_or_improvement",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_condition_significantly_deteriorated",
            true
          ],
          [
            "EQ",
            "unable_to_pay_debt_or_fulfill_contract",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_approved",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_condition_significantly_deteriorated",
            true
          ],
          [
            "EQ",
            "unable_to_pay_debt_or_fulfill_contract",
            true
          ],
          [
            "EQ",
            "loss_or_net_worth_accelerated_deterioration",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_business_scope_penalty",
    "desc": "違反業務範圍規定處罰",
    "expr": [
      "EQ",
      "violation_business_scope_penalty",
      [
        "EQ",
        "violate_business_scope_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_reserve_penalty",
    "desc": "違反賠償準備金提存額度及方式規定處罰",
    "expr": [
      "EQ",
      "violation_reserve_penalty",
      [
        "EQ",
        "violate_reserve_provision_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_article_143_penalty",
    "desc": "違反第一百四十三條規定處罰",
    "expr": [
      "EQ",
      "violation_article_143_penalty",
      [
        "EQ",
        "violate_article_143",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_article_143_5_6_penalty",
    "desc": "違反第一百四十三條之五或主管機關依第一百四十三條之六措施處罰",
    "expr": [
      "EQ",
      "violation_article_143_5_6_penalty",
      [
        "EQ",
        "violate_article_143_5_or_143_6_measures",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_fund_use_penalty",
    "desc": "違反資金運用相關規定處罰或解除負責人職務",
    "expr": [
      "EQ",
      "violation_fund_use_penalty",
      [
        "EQ",
        "violate_fund_use_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_without_sufficient_collateral_penalty",
    "desc": "放款無十足擔保或條件優於其他同類放款對象者處刑罰",
    "expr": [
      "EQ",
      "loan_without_sufficient_collateral_penalty",
      [
        "EQ",
        "loan_without_sufficient_collateral_or_better_condition",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_exceed_board_approval_penalty",
    "desc": "擔保放款未經董事會三分之二出席及四分之三同意或違反放款限額規定處罰",
    "expr": [
      "EQ",
      "loan_exceed_board_approval_penalty",
      [
        "EQ",
        "loan_exceed_board_approval_or_limit",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_loan_or_other_transaction_limit_penalty",
    "desc": "違反放款或其他交易限額及決議程序規定處罰",
    "expr": [
      "EQ",
      "violation_loan_or_other_transaction_limit_penalty",
      [
        "EQ",
        "violate_loan_or_other_transaction_limit_or_resolution",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_scope_definition",
    "desc": "利害關係人範圍定義",
    "expr": [
      "EQ",
      "related_party_scope_definition",
      [
        "OR",
        [
          "EQ",
          "related_party_responsible_person_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "related_party_responsible_person_or_major_shareholder_enterprise",
          true
        ],
        [
          "EQ",
          "related_party_related_enterprise_and_responsible_person_or_major_shareholder",
          true
        ],
        [
          "EQ",
          "related_party_subsidiary_and_responsible_person",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:responsible_person_definition",
    "desc": "負責人範圍定義",
    "expr": [
      "EQ",
      "responsible_person_definition",
      [
        "OR",
        [
          "EQ",
          "responsible_person_director",
          true
        ],
        [
          "EQ",
          "responsible_person_supervisor",
          true
        ],
        [
          "EQ",
          "responsible_person_general_manager",
          true
        ],
        [
          "EQ",
          "responsible_person_deputy_general_manager",
          true
        ],
        [
          "EQ",
          "responsible_person_assistant_manager",
          true
        ],
        [
          "EQ",
          "responsible_person_manager",
          true
        ],
        [
          "EQ",
          "responsible_person_equivalent_position",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:major_shareholder_definition",
    "desc": "大股東定義",
    "expr": [
      "EQ",
      "major_shareholder_definition",
      [
        "OR",
        [
          "GE",
          "shareholding_percentage",
          10
        ],
        [
          "AND",
          [
            "EQ",
            "shareholder_is_natural_person",
            true
          ],
          [
            "EQ",
            "include_spouse_and_minor_children",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反資本等級措施或違反相關法令規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_4_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_3_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_2_measures_executed",
              true
            ]
          ]
        ],
        [
          "EQ",
          "violation_business_scope_penalty",
          true
        ],
        [
          "EQ",
          "violation_reserve_penalty",
          true
        ],
        [
          "EQ",
          "violation_article_143_penalty",
          true
        ],
        [
          "EQ",
          "violation_article_143_5_6_penalty",
          true
        ],
        [
          "EQ",
          "violation_fund_use_penalty",
          true
        ],
        [
          "EQ",
          "loan_without_sufficient_collateral_penalty",
          true
        ],
        [
          "EQ",
          "loan_exceed_board_approval_penalty",
          true
        ],
        [
          "EQ",
          "violation_loan_or_other_transaction_limit_penalty",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]