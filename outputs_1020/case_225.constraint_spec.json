            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "assistance_obligation_compliant",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
