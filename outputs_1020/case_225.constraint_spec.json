[
  {
    "id": "fhc:related_person_definition",
    "desc": "同一人及同一關係人定義",
    "expr": [
      "EQ",
      "related_person_definition",
      [
        "AND",
        [
          "EQ",
          "same_person_is_natural_or_legal",
          true
        ],
        [
          "EQ",
          "related_person_includes_spouse_and_second_degree_blood_relative",
          true
        ],
        [
          "EQ",
          "related_person_includes_enterprise_with_responsible_person",
          true
        ],
        [
          "EQ",
          "related_person_includes_enterprise_with_over_one_third_shares",
          true
        ],
        [
          "EQ",
          "related_person_includes_enterprise_with_chairman_or_majority_directors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_definition",
    "desc": "子公司定義",
    "expr": [
      "EQ",
      "subsidiary_definition",
      [
        "AND",
        [
          "EQ",
          "bank_subsidiary_controlled",
          true
        ],
        [
          "EQ",
          "insurance_subsidiary_controlled",
          true
        ],
        [
          "EQ",
          "securities_subsidiary_controlled",
          true
        ],
        [
          "EQ",
          "other_subsidiary_controlled_over_50_percent",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:transaction_scope",
    "desc": "交易行為範圍",
    "expr": [
      "EQ",
      "transaction_scope",
      [
        "AND",
        [
          "EQ",
          "credit_transactions_included",
          true
        ],
        [
          "EQ",
          "short_term_note_guarantee_or_endorsement_included",
          true
        ],
        [
          "EQ",
          "repurchase_agreement_included",
          true
        ],
        [
          "EQ",
          "investment_in_issuer_securities_included",
          true
        ],
        [
          "EQ",
          "derivative_financial_products_included",
          true
        ],
        [
          "EQ",
          "other_transactions_as_regulated_included",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:reporting_and_disclosure_requirement",
    "desc": "交易行為達一定金額或比率時申報及揭露義務",
    "expr": [
      "EQ",
      "reporting_and_disclosure_requirement",
      [
        "AND",
        [
          "GE",
          "transaction_amount_or_ratio",
          "threshold_amount_or_ratio"
        ],
        [
          "LE",
          "reporting_days_after_quarter_end",
          30
        ],
        [
          "EQ",
          "report_to_authority",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "disclosure_by_announcement",
            true
          ],
          [
            "EQ",
            "disclosure_by_internet",
            true
          ],
          [
            "EQ",
            "disclosure_by_authority_designated_method",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_article_60_15",
    "desc": "違反第46條申報或揭露規定",
    "expr": [
      "EQ",
      "violation_article_60_15",
      [
        "NOT",
        [
          "EQ",
          "reporting_and_disclosure_requirement",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_article_60_any",
    "desc": "違反金融控股公司法第60條任一規定",
    "expr": [
      "EQ",
      "violation_article_60_any",
      [
        "OR",
        [
          "NOT",
