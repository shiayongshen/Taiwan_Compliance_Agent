[
  {
    "id": "bank:inspection_authority",
    "desc": "中央主管機關得隨時派員或委託機構檢查銀行業務財務及相關事項，並要求限期提報資料",
    "expr": [
      "EQ",
      "bank:inspection_authority",
      [
        "OR",
        [
          "EQ",
          "central_authority_dispatch",
          true
        ],
        [
          "EQ",
          "central_authority_delegate",
          true
        ],
        [
          "EQ",
          "local_authority_dispatch",
          true
        ],
        [
          "EQ",
          "bank_report_submitted_on_time",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:specialist_audit_assigned",
    "desc": "中央主管機關得指定專業人員查核並向中央主管機關提出報告，費用由銀行負擔",
    "expr": [
      "EQ",
      "bank:specialist_audit_assigned",
      [
        "AND",
        [
          "EQ",
          "specialist_assigned",
          true
        ],
        [
          "EQ",
          "specialist_report_submitted",
          true
        ],
        [
          "EQ",
          "audit_fee_paid",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_established",
    "desc": "銀行建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "bank:internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_established",
    "desc": "銀行建立內部處理制度及程序",
    "expr": [
      "EQ",
      "bank:internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_established",
    "desc": "銀行建立內部作業制度及程序",
    "expr": [
      "EQ",
      "bank:internal_operation_established",
      [
        "EQ",
        "internal_operation_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_executed",
    "desc": "銀行內部控制及稽核制度確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_system_executed",
          true
        ],
        [
          "EQ",
          "internal_control_system_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_executed",
    "desc": "銀行內部處理制度及程序確實執行",
    "expr": [
      "EQ",
      "bank:internal_handling_executed",
      [
        "AND",
        [
          "EQ",
          "internal_handling_system_executed",
          true
        ],
        [
          "EQ",
          "internal_handling_system_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_executed",
    "desc": "銀行內部作業制度及程序確實執行",
    "expr": [
      "EQ",
      "bank:internal_operation_executed",
      [
        "AND",
        [
          "EQ",
          "internal_operation_system_executed",
          true
        ],
        [
          "EQ",
          "internal_operation_system_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_refuse_inspect",
    "desc": "拒絕檢查或拒絕開啟金庫或其他庫房",
    "expr": [
      "EQ",
      "bank:inspection_violation_refuse_inspect",
      [
        "EQ",
        "refuse_inspection",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_hide_destroy",
    "desc": "隱匿或毀損有關業務或財務狀況之帳冊文件",
    "expr": [
      "EQ",
      "bank:inspection_violation_hide_destroy",
      [
        "EQ",
        "hide_or_destroy_documents",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_no_answer",
    "desc": "對檢查人員詢問無正當理由不為答復或答復不實",
    "expr": [
      "EQ",
      "bank:inspection_violation_no_answer",
      [
        "EQ",
        "no_answer_or_false_answer",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_late_or_false_report",
    "desc": "逾期提報財務報告、財產目錄或其他有關資料及報告，或提報不實、不全或未繳納查核費用",
    "expr": [
      "EQ",
      "bank:inspection_violation_late_or_false_report",
      [
        "OR",
        [
          "EQ",
          "late_report",
          true
        ],
        [
          "EQ",
          "false_or_incomplete_report",
          true
        ],
        [
          "EQ",
          "audit_fee_not_paid",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_any",
    "desc": "違反檢查規定任一情事",
    "expr": [
      "EQ",
      "bank:inspection_violation_any",
      [
        "OR",
        [
          "EQ",
          "bank:inspection_violation_refuse_inspect",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_hide_destroy",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_no_answer",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_late_or_false_report",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_control",
    "desc": "未依規定建立或執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "bank:violation_internal_control",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank:internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_handling",
    "desc": "未依規定建立或執行內部處理制度及程序",
    "expr": [
      "EQ",
      "bank:violation_internal_handling",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank:internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_operation",
    "desc": "未依規定建立或執行內部作業制度及程序",
    "expr": [
      "EQ",
      "bank:violation_internal_operation",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_operation_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank:internal_operation_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_systems_any",
    "desc": "未依規定建立或執行內部控制、處理或作業制度任一違反",
    "expr": [
      "EQ",
      "bank:violation_internal_systems_any",
      [
        "OR",
        [
          "EQ",
          "bank:violation_internal_control",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_handling",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_operation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_any",
    "desc": "銀行違反檢查規定或內部制度規定任一違反",
    "expr": [
      "EQ",
      "bank:violation_any",
      [
        "OR",
        [
          "EQ",
          "bank:inspection_violation_any",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_systems_any",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_policy_established",
    "desc": "金融機構訂定使用雲端服務政策及原則，採取適當風險管控措施",
    "expr": [
      "EQ",
      "bank:cloud_service_policy_established",
      [
        "EQ",
        "cloud_service_policy_defined",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_risk_control",
    "desc": "金融機構採取適當風險管控措施並注意委託雲端服務業者分散",
    "expr": [
      "EQ",
      "bank:cloud_service_risk_control",
      [
        "EQ",
        "cloud_service_risk_control_measures_taken",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_supervision",
    "desc": "金融機構對雲端服務業者負有最終監督義務並具專業技術及資源",
    "expr": [
      "EQ",
      "bank:cloud_service_supervision",
      [
        "EQ",
        "cloud_service_supervision_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_third_party_audit",
    "desc": "金融機構委託或聯合委託第三人查核雲端服務業者並符合規定",
    "expr": [
      "EQ",
      "bank:cloud_service_third_party_audit",
      [
        "AND",
        [
          "EQ",
          "third_party_audit_engaged",
          true
        ],
        [
          "EQ",
          "audit_scope_covered",
          true
        ],
        [
          "EQ",
          "third_party_qualification_confirmed",
          true
        ],
        [
          "EQ",
          "audit_report_appropriate",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_protection",
    "desc": "金融機構對客戶資料採行加密或代碼化等有效保護措施及加密金鑰管理",
    "expr": [
      "EQ",
      "bank:cloud_service_data_protection",
      [
        "AND",
        [
          "EQ",
          "customer_data_encrypted",
          true
        ],
        [
          "EQ",
          "encryption_key_management_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_ownership_and_access",
    "desc": "金融機構保有資料所有權，雲端服務業者不得存取客戶資料或超範圍利用",
    "expr": [
      "EQ",
      "bank:cloud_service_data_ownership_and_access",
      [
        "AND",
        [
          "EQ",
          "data_ownership_retained",
          true
        ],
        [
          "EQ",
          "cloud_service_access_restricted",
          true
        ],
        [
          "EQ",
          "cloud_service_no_out_of_scope_use",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_location_compliance",
    "desc": "金融機構指定資料處理及儲存地權利，境外資料保護法規不低於我國要求，重要資料原則留存我國",
    "expr": [
      "EQ",
      "bank:cloud_service_data_location_compliance",
      [
        "AND",
        [
          "EQ",
          "data_location_rights_held",
          true
        ],
        [
          "EQ",
          "foreign_data_protection_compliance",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "important_data_stored_domestically",
            true
          ],
          [
            "EQ",
            "foreign_storage_approved_by_authority",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反檢查規定或未建立或執行內部控制、處理、作業制度任一違反時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "bank:inspection_violation_any",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_systems_any",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]