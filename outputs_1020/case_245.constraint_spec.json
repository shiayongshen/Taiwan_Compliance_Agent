[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures",
          true
        ],
        [
          "EQ",
          "training_held",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_designated_matters_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_procedure_ok",
    "desc": "完成確認客戶身分程序並留存資料",
    "expr": [
      "EQ",
      "customer_identification_procedure_ok",
      [
        "AND",
        [
          "EQ",
          "customer_identification_procedure_performed",
          true
        ],
        [
          "EQ",
          "customer_identification_data_retained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_risk_based",
    "desc": "確認客戶身分程序以風險為基礎並包含實質受益人審查",
    "expr": [
      "EQ",
      "customer_identification_risk_based",
      [
        "AND",
        [
          "EQ",
          "customer_identification_risk_based_method",
          true
        ],
        [
          "EQ",
          "beneficial_owner_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:identification_data_retention_period_ok",
    "desc": "確認客戶身分資料保存期限符合規定",
    "expr": [
      "EQ",
      "identification_data_retention_period_ok",
      [
        "OR",
        [
          "GE",
          "customer_identification_data_retention_years",
          5.0
        ],
        [
          "GE",
          "temporary_transaction_data_retention_years",
          5.0
        ],
        [
          "GE",
          "legal_longer_retention_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_customer_due_diligence_ok",
    "desc": "對重要政治性職務客戶及其關係人執行加強客戶審查程序",
    "expr": [
      "EQ",
      "enhanced_customer_due_diligence_ok",
      [
        "AND",
        [
          "EQ",
          "enhanced_due_diligence_performed",
          true
        ],
        [
          "EQ",
          "enhanced_due_diligence_risk_based",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立或未執行洗錢防制內部控制制度，或未完成確認客戶身分程序、資料保存、加強審查等規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "customer_identification_procedure_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "customer_identification_risk_based",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "identification_data_retention_period_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "enhanced_customer_due_diligence_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]