[
  {
    "id": "insurance:actuarial_officer_assigned",
    "desc": "保險業聘用精算人員並指派簽證精算人員",
    "expr": [
      "EQ",
      "actuarial_officer_assigned",
      [
        "AND",
        [
          "EQ",
          "actuarial_staff_hired",
          true
        ],
        [
          "EQ",
          "signing_actuarial_officer_assigned",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:external_review_actuary_hired",
    "desc": "保險業聘請外部複核精算人員",
    "expr": [
      "EQ",
      "external_review_actuary_hired",
      [
        "EQ",
        "external_review_actuary_hired_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:board_approval_obtained",
    "desc": "簽證精算人員指派及外部複核精算人員聘請經董（理）事會同意",
    "expr": [
      "EQ",
      "board_approval_obtained",
      [
        "AND",
        [
          "EQ",
          "signing_actuarial_officer_approved_by_board",
          true
        ],
        [
          "EQ",
          "external_review_actuary_approved_by_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:actuarial_reports_fair_and_true",
    "desc": "簽證精算人員及外部複核精算人員報告內容公正且無虛偽隱匿遺漏錯誤",
    "expr": [
      "EQ",
      "actuarial_reports_fair_and_true",
      [
        "AND",
        [
          "EQ",
          "signing_actuarial_report_fair_and_true",
          true
        ],
        [
          "EQ",
          "external_review_report_fair_and_true",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_established_and_executed",
    "desc": "保險業建立並執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_established_and_executed",
    "desc": "保險業建立並執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_established_and_executed",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反精算人員指派、外部複核聘請、董事會同意、報告公正性、內部控制及內部處理制度規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "actuarial_officer_assigned",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "external_review_actuary_hired",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "board_approval_obtained",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "actuarial_reports_fair_and_true",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established_and_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established_and_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]