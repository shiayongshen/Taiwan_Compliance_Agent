[
  {
    "id": "insurance:agent_broker_not_permitted",
    "desc": "保險代理人、經紀人、公證人未經主管機關許可、未繳存保證金或未投保相關保險",
    "expr": [
      "EQ",
      "agent_broker_not_permitted",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "permit_granted",
            true
          ],
          [
            "EQ",
            "deposit_paid",
            true
          ],
          [
            "EQ",
            "insurance_policy_purchased",
            true
          ],
          [
            "EQ",
            "license_held",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_policy_type_correct",
    "desc": "保險代理人、公證人投保責任保險，保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_policy_type_correct",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "role_agent_or_notary",
            true
          ],
          [
            "EQ",
            "policy_type_responsibility",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "role_broker",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "policy_type_responsibility",
              true
            ],
            [
              "EQ",
              "policy_type_guarantee",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permit_and_separate_compliance",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permit_and_separate_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "bank_permit_granted",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "agent_business_compliance",
            true
          ],
          [
            "EQ",
            "broker_business_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_must_provide_written_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_financial_or_business_management",
      [
        "EQ",
        "violate_financial_or_business_management",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_broker_duties",
    "desc": "違反保險法第163條第七項規定",
    "expr": [
      "EQ",
      "violation_broker_duties",
      [
        "EQ",
        "violate_broker_duties",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_article_165_1_or_163_5_applied",
    "desc": "違反保險法第165條第一項或第163條第五項準用規定",
    "expr": [
      "EQ",
      "violation_article_165_1_or_163_5_applied",
      [
        "EQ",
        "violate_article_165_1_or_163_5_applied",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "violation_financial_or_business_management",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_broker_duties",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_article_165_1_or_163_5_applied",
            true
          ]
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反財務或業務管理規定、違反經紀人義務或違反相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_financial_or_business_management",
          true
        ],
        [
          "EQ",
          "violation_broker_duties",
          true
        ],
        [
          "EQ",
          "violation_article_165_1_or_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]