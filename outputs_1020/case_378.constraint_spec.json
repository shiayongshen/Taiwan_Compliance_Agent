[
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            [
              "MUL",
              "required_ratio",
              0.25
            ]
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            [
              "MUL",
              "required_ratio",
              0.25
            ]
          ],
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            "required_ratio"
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            "required_ratio"
          ],
          [
            "GE",
            "net_worth_ratio",
            "required_net_worth_ratio"
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_ratio_ok",
    "desc": "自有資本與風險資本比率及淨值比率均不低於一定比率",
    "expr": [
      "EQ",
      "capital_ratio_ok",
      [
        "AND",
        [
          "GE",
          [
            "DIV",
            "own_capital",
            "risk_capital"
          ],
          "required_ratio"
        ],
        [
          "GE",
          "net_worth_ratio",
          "required_net_worth_ratio"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_report_compliance",
    "desc": "依規定申報資本等級相關資訊",
    "expr": [
      "EQ",
      "capital_report_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "annual_report_submitted",
            true
          ],
          [
            "LE",
            "annual_report_submission_months",
            3
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "semiannual_report_submitted",
            true
          ],
          [
            "LE",
            "semiannual_report_submission_months",
            2
          ]
        ],
        [
          "EQ",
          "under_supervision",
          false
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本比率不足或未依規定申報時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "capital_ratio_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_report_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]