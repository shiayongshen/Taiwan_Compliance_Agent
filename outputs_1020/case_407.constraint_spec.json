[
  {
    "id": "bank:inspection_authority",
    "desc": "中央主管機關得隨時派員或委託機構檢查銀行業務財務及相關事項，並可要求限期提報資料",
    "expr": [
      "EQ",
      "bank:inspection_authority",
      [
        "OR",
        [
          "EQ",
          "central_authority_dispatch",
          true
        ],
        [
          "EQ",
          "central_authority_delegate",
          true
        ],
        [
          "EQ",
          "local_authority_dispatch",
          true
        ],
        [
          "EQ",
          "bank_report_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:specialist_audit_assigned",
    "desc": "中央主管機關得指定專門職業及技術人員查核並提出報告，費用由銀行負擔",
    "expr": [
      "EQ",
      "bank:specialist_audit_assigned",
      [
        "AND",
        [
          "EQ",
          "specialist_assigned",
          true
        ],
        [
          "EQ",
          "specialist_report_submitted",
          true
        ],
        [
          "EQ",
          "audit_fee_paid",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_established",
    "desc": "銀行建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "bank:internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_established",
    "desc": "銀行建立內部處理制度及程序",
    "expr": [
      "EQ",
      "bank:internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_established",
    "desc": "銀行建立內部作業制度及程序",
    "expr": [
      "EQ",
      "bank:internal_operation_established",
      [
        "EQ",
        "internal_operation_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_refuse_check",
    "desc": "拒絕檢查或拒絕開啟金庫或其他庫房",
    "expr": [
      "EQ",
      "bank:inspection_violation_refuse_check",
      [
        "EQ",
        "refuse_inspection",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_hide_or_destroy",
    "desc": "隱匿或毀損有關業務或財務狀況之帳冊文件",
    "expr": [
      "EQ",
      "bank:inspection_violation_hide_or_destroy",
      [
        "EQ",
        "hide_or_destroy_documents",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_no_answer_or_false",
    "desc": "對檢查人員詢問無正當理由不為答復或答復不實",
    "expr": [
      "EQ",
      "bank:inspection_violation_no_answer_or_false",
      [
        "EQ",
        "no_answer_or_false_reply",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:inspection_violation_late_or_false_report",
    "desc": "逾期提報財務報告、財產目錄或其他有關資料及報告，或提報不實、不全或未繳納查核費用",
    "expr": [
      "EQ",
      "bank:inspection_violation_late_or_false_report",
      [
        "OR",
        [
          "EQ",
          "late_report",
          true
        ],
        [
          "EQ",
          "false_or_incomplete_report",
          true
        ],
        [
          "EQ",
          "audit_fee_unpaid",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_refuse_or_hide_or_no_answer_or_report",
    "desc": "違反檢查規定任一情事",
    "expr": [
      "EQ",
      "bank:violation_refuse_or_hide_or_no_answer_or_report",
      [
        "OR",
        [
          "EQ",
          "bank:inspection_violation_refuse_check",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_hide_or_destroy",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_no_answer_or_false",
          true
        ],
        [
          "EQ",
          "bank:inspection_violation_late_or_false_report",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_control_not_established_or_not_executed",
    "desc": "未依規定建立或確實執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "bank:violation_internal_control_not_established_or_not_executed",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_handling_not_established_or_not_executed",
    "desc": "未依規定建立或確實執行內部處理制度及程序",
    "expr": [
      "EQ",
      "bank:violation_internal_handling_not_established_or_not_executed",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_handling_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_internal_operation_not_established_or_not_executed",
    "desc": "未依規定建立或確實執行內部作業制度及程序",
    "expr": [
      "EQ",
      "bank:violation_internal_operation_not_established_or_not_executed",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "bank:internal_operation_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_compliance",
    "desc": "內部控制及稽核制度建立且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "bank:internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_compliance",
    "desc": "內部處理制度及程序建立且確實執行",
    "expr": [
      "EQ",
      "bank:internal_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "bank:internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_compliance",
    "desc": "內部作業制度及程序建立且確實執行",
    "expr": [
      "EQ",
      "bank:internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "bank:internal_operation_established",
          true
        ],
        [
          "EQ",
          "internal_operation_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_and_handling_and_operation_compliance",
    "desc": "內部控制、處理及作業制度均建立且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_handling_and_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "bank:internal_control_compliance",
          true
        ],
        [
          "EQ",
          "bank:internal_handling_compliance",
          true
        ],
        [
          "EQ",
          "bank:internal_operation_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policies_comprehensive",
    "desc": "內部控制制度涵蓋所有營運活動並訂定適當政策及作業程序",
    "expr": [
      "EQ",
      "bank:internal_control_policies_comprehensive",
      [
        "AND",
        [
          "EQ",
          "organization_rules_defined",
          true
        ],
        [
          "EQ",
          "business_regulations_defined",
          true
        ],
        [
          "EQ",
          "financial_report_management_defined",
          true
        ],
        [
          "EQ",
          "general_admin_defined",
          true
        ],
        [
          "EQ",
          "external_info_disclosure_defined",
          true
        ],
        [
          "EQ",
          "financial_inspection_report_management_defined",
          true
        ],
        [
          "EQ",
          "financial_consumer_protection_defined",
          true
        ],
        [
          "EQ",
          "major_incident_handling_defined",
          true
        ],
        [
          "EQ",
          "anti_money_laundering_defined",
          true
        ],
        [
          "EQ",
          "other_business_regulations_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_policy_compliance",
    "desc": "金融機構訂定使用雲端服務政策及風險管控措施",
    "expr": [
      "EQ",
      "bank:cloud_service_policy_compliance",
      [
        "AND",
        [
          "EQ",
          "cloud_service_policy_defined",
          true
        ],
        [
          "EQ",
          "risk_control_measures_implemented",
          true
        ],
        [
          "EQ",
          "cloud_service_provider_diversified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_supervision_compliance",
    "desc": "金融機構對雲端服務業者具有最終監督義務並具專業技術及資源",
    "expr": [
      "EQ",
      "bank:cloud_service_supervision_compliance",
      [
        "AND",
        [
          "EQ",
          "final_supervision_responsibility",
          true
        ],
        [
          "EQ",
          "professional_technical_resources",
          true
        ],
        [
          "EQ",
          "third_party_assistance_commissioned",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_independent_audit_compliance",
    "desc": "金融機構委託或聯合委託獨立第三人查核雲端服務業者並符合規定",
    "expr": [
      "EQ",
      "bank:cloud_service_independent_audit_compliance",
      [
        "AND",
        [
          "EQ",
          "independent_audit_commissioned",
          true
        ],
        [
          "EQ",
          "audit_scope_covered",
          true
        ],
        [
          "EQ",
          "third_party_qualification_assessed",
          true
        ],
        [
          "EQ",
          "audit_report_appropriate",
          true
        ],
        [
          "EQ",
          "audit_report_meets_standards",
          true
        ],
        [
          "EQ",
          "audit_report_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_protection_compliance",
    "desc": "金融機構對雲端服務業者傳輸及儲存客戶資料採有效保護措施",
    "expr": [
      "EQ",
      "bank:cloud_service_data_protection_compliance",
      [
        "AND",
        [
          "EQ",
          "customer_data_encrypted_or_tokenized",
          true
        ],
        [
          "EQ",
          "encryption_key_management_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_ownership_compliance",
    "desc": "金融機構保有資料所有權並限制雲端服務業者存取及利用權限",
    "expr": [
      "EQ",
      "bank:cloud_service_data_ownership_compliance",
      [
        "AND",
        [
          "EQ",
          "data_ownership_retained",
          true
        ],
        [
          "EQ",
          "cloud_service_provider_access_limited",
          true
        ],
        [
          "EQ",
          "cloud_service_provider_use_restricted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cloud_service_data_storage_compliance",
    "desc": "金融機構對委託雲端服務業者資料及儲存地符合規定",
    "expr": [
      "EQ",
      "bank:cloud_service_data_storage_compliance",
      [
        "AND",
        [
          "EQ",
          "data_storage_location_rights_held",
          true
        ],
        [
          "EQ",
          "foreign_data_protection_law_not_lower_than_domestic",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "customer_important_data_stored_domestically",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "foreign_storage_approved_by_authority",
              true
            ],
            [
              "EQ",
              "customer_important_data_backup_in_domestic",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反檢查規定或未建立或未確實執行內部控制、處理、作業制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "bank:violation_refuse_or_hide_or_no_answer_or_report",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_control_not_established_or_not_executed",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_handling_not_established_or_not_executed",
          true
        ],
        [
          "EQ",
          "bank:violation_internal_operation_not_established_or_not_executed",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]