[
  {
    "id": "insurance:violate_article_148_1_2",
    "desc": "違反保險法第148條之一第一項或第二項規定",
    "expr": [
      "EQ",
      "violate_article_148_1_2",
      [
        "EQ",
        "violate_148_1_1_or_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_article_148_2_1",
    "desc": "違反保險法第148條之二第一項規定，未提供說明文件或說明文件不實",
    "expr": [
      "EQ",
      "violate_article_148_2_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "explanation_document_provided",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "explanation_document_compliant",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "explanation_document_truthful",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_article_148_2_2",
    "desc": "違反保險法第148條之二第二項規定，未依限報告或公開說明，或內容不實",
    "expr": [
      "EQ",
      "violate_article_148_2_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "report_submitted_on_time",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "public_explanation_made",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "report_content_truthful",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_article_148_3_1",
    "desc": "違反保險法第148條之三第一項規定，未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "violate_article_148_3_1",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_article_148_3_2",
    "desc": "違反保險法第148條之三第二項規定，未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "violate_article_148_3_2",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violate_article_148_1_2",
          true
        ],
        [
          "EQ",
          "violate_article_148_2_1",
          true
        ],
        [
          "EQ",
          "violate_article_148_2_2",
          true
        ],
        [
          "EQ",
          "violate_article_148_3_1",
          true
        ],
        [
          "EQ",
          "violate_article_148_3_2",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]