[
  {
    "id": "epayment:company_type_restriction",
    "desc": "電子支付機構必須為股份有限公司，除經主管機關許可兼營者外，應專營第四條第一項及第二項各款業務",
    "expr": [
      "EQ",
      "company_type_restriction",
      [
        "OR",
        [
          "EQ",
          "company_type_corporation",
          true
        ],
        [
          "EQ",
          "allowed_to_concurrent_business",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "epayment"
  },
  {
    "id": "epayment:contract_terms_compliance",
    "desc": "專營電子支付機構訂定業務定型化契約條款內容須符合主管機關公告範本及不得低於範本內容",
    "expr": [
      "EQ",
      "contract_terms_compliance",
      [
        "EQ",
        "contract_terms_meet_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "epayment"
  },
  {
    "id": "epayment:annual_report_submission",
    "desc": "專營電子支付機構應於會計年度終了四個月內編製營業報告書及財務報告，並於董事會通過翌日起15日內申報公告",
    "expr": [
      "EQ",
      "annual_report_submission",
      [
        "AND",
        [
          "EQ",
          "annual_report_prepared",
          true
        ],
        [
          "EQ",
          "financial_report_audited",
          true
        ],
        [
          "EQ",
          "board_approval_passed",
          true
        ],
        [
          "LE",
          "days_since_board_approval",
          15
        ],
        [
          "LE",
          "months_since_fiscal_year_end",
          4
        ]
      ]
    ],
    "weight": 1,
    "domain": "epayment"
  },
  {
