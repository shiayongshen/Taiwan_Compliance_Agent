  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反公司型態限制、契約條款規定或未依時申報公告營業及財務報告時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "company_type_restriction",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contract_terms_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "annual_report_submission",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]