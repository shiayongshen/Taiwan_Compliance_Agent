[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度且包含六項必要內容",
    "expr": [
      "EQ",
      "aml:internal_control_established",
      [
        "AND",
        [
          "EQ",
          "aml:control_procedure_established",
          true
        ],
        [
          "EQ",
          "aml:training_held",
          true
        ],
        [
          "EQ",
          "aml:dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "aml:risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "aml:audit_procedure_established",
          true
        ],
        [
          "EQ",
          "aml:other_designated_matters_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "aml:internal_control_executed",
      [
        "AND",
        [
          "EQ",
          "aml:internal_control_implementation_confirmed",
          true
        ],
        [
          "EQ",
          "aml:internal_control_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_procedure_ok",
    "desc": "完成確認客戶身分程序並留存資料",
    "expr": [
      "EQ",
      "aml:customer_identification_procedure_ok",
      [
        "AND",
        [
          "EQ",
          "aml:customer_identification_procedure_performed",
          true
        ],
        [
          "EQ",
          "aml:customer_identification_data_retained",
          true
        ],
        [
          "EQ",
          "aml:customer_identification_data_retention_period_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_risk_based",
    "desc": "確認客戶身分程序以風險為基礎並包含實質受益人審查",
    "expr": [
      "EQ",
      "aml:customer_identification_risk_based",
      [
        "AND",
        [
          "EQ",
          "aml:customer_identification_risk_based_performed",
          true
        ],
        [
          "EQ",
          "aml:beneficial_owner_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_data_retention_period_ok",
    "desc": "確認客戶身分資料保存期限符合規定",
    "expr": [
      "EQ",
      "aml:customer_identification_data_retention_period_ok",
      [
        "OR",
        [
          "GE",
          "aml:customer_identification_data_retention_years",
          5.0
        ],
        [
          "GE",
          "aml:temporary_transaction_data_retention_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_customer_due_diligence_ok",
    "desc": "對重要政治性職務客戶及其關係人執行加強客戶審查程序",
    "expr": [
      "EQ",
      "aml:enhanced_customer_due_diligence_ok",
      [
        "AND",
        [
          "EQ",
          "aml:enhanced_customer_due_diligence_performed",
          true
        ],
        [
          "EQ",
          "aml:customer_identification_risk_based",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:transaction_reported",
    "desc": "對達一定金額之通貨交易向法務部調查局申報",
    "expr": [
      "EQ",
      "aml:transaction_reported",
      [
        "AND",
        [
          "EQ",
          "aml:transaction_report_made",
          true
        ],
        [
          "EQ",
          "aml:internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:suspicious_transaction_reported",
    "desc": "對疑似犯罪交易向法務部調查局申報",
    "expr": [
      "EQ",
      "aml:suspicious_transaction_reported",
      [
        "AND",
        [
          "EQ",
          "aml:suspicious_transaction_report_made",
          true
        ],
        [
          "EQ",
          "aml:internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "aml:penalty_conditions",
    "desc": "處罰條件：違反洗錢防制內部控制制度建立或執行、確認客戶身分程序、資料保存、加強審查、交易申報等規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "AND",
            [
              "EQ",
              "aml:internal_control_established",
              true
            ],
            [
              "EQ",
              "aml:internal_control_executed",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:customer_identification_procedure_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:customer_identification_risk_based",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:customer_identification_data_retention_period_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:enhanced_customer_due_diligence_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:transaction_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:suspicious_transaction_reported",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]