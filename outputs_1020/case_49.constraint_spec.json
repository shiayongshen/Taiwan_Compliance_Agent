[
  {
    "id": "insurance:agent_license_and_guarantee",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_license_and_guarantee",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_minimum_amount"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type",
    "desc": "相關保險類型依保險代理人、公證人為責任保險，保險經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_covered",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              1
            ],
            [
              "EQ",
              "insurance_type",
              2
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:guarantee_minimum_amount_defined",
    "desc": "主管機關定最低保證金及投保相關保險金額及實施方式",
    "expr": [
      "EQ",
      "guarantee_minimum_amount_defined",
      [
        "EQ",
        "guarantee_minimum_amount",
        "guarantee_minimum_amount_defined_by_authority"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:management_rules_defined",
    "desc": "主管機關定保險代理人、經紀人、公證人資格取得、申請許可條件、程序、文件、董事監察人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則",
    "expr": [
      "EQ",
      "management_rules_defined",
      [
        "EQ",
        "management_rules_set_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_engage_agent_or_broker",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_engage_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_permit_granted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_engage_agent",
            true
          ],
          [
            "EQ",
            "bank_engage_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務洽訂保險契約或提供服務，並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_due_care",
          true
        ],
        [
          "EQ",
          "broker_fulfill_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前，於主管機關指定範圍內，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_written_report_and_fee_disclosed",
      [
        "AND",
        [
          "EQ",
          "written_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_rules",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定、同條第七項規定，或違反第165條第一項或第163條第五項準用規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rule",
          true
        ],
        [
          "EQ",
          "violate_business_management_rule",
          true
        ],
        [
          "EQ",
          "violate_article_165_1",
          true
        ],
        [
          "EQ",
          "violate_article_163_5",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_report_status",
    "desc": "經紀人公司停業、復業、解散等情事應報主管機關核准並辦理登記",
    "expr": [
      "EQ",
      "broker_company_status_reported",
      [
        "OR",
        [
          "EQ",
          "stop_business_reported",
          true
        ],
        [
          "EQ",
          "resume_business_reported",
          true
        ],
        [
          "EQ",
          "dissolution_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_stop_business_limit_and_extension",
    "desc": "經紀人公司停業期間以一年為限，得申請一次展延，應於屆滿前十五日提出",
    "expr": [
      "EQ",
      "broker_company_stop_business_within_limit",
      [
        "AND",
        [
          "LE",
          "stop_business_duration_days",
          365
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "extension_applied",
            true
          ],
          [
            "EQ",
            "extension_count",
            1
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "extension_applied",
            true
          ],
          [
            "LE",
            "extension_application_days_before_expiry",
            15
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_reappoint_broker_after_resume",
    "desc": "經紀人公司停業屆滿未申請復業並依規定任用經紀人者，主管機關廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "broker_company_reappoint_broker_after_resume",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "resume_business_applied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_reappointed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_cancel_certificates_on_stop_or_dissolution",
    "desc": "經紀人公司申請停業或解散，應繳銷所任用經紀人及公司執業證照",
    "expr": [
      "EQ",
      "broker_company_cancel_certificates",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "stop_business_applied",
            true
          ],
          [
            "EQ",
            "dissolution_applied",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker_certificates_cancelled",
            true
          ],
          [
            "EQ",
            "company_certificate_cancelled",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_cancel_certificate_within_30_days_after_company_stop_or_dissolution",
    "desc": "經紀人公司停業、解散或主管機關註銷公司執業證照後30日內，受任用經紀人應委由公會辦理註銷登記",
    "expr": [
      "EQ",
      "broker_cancel_certificate_within_30_days",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "company_stop_business",
            true
          ],
          [
            "EQ",
            "company_dissolution",
            true
          ],
          [
            "EQ",
            "company_license_revoked",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker_certificate_cancellation_reported",
            true
          ],
          [
            "LE",
            "broker_certificate_cancellation_days",
            30
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_report_stop_reinsurance_or_insurance_business",
    "desc": "同時經營保險經紀及再保險經紀業務之經紀人公司停止其中一業務，應於一個月內報主管機關備查",
    "expr": [
      "EQ",
      "broker_company_report_stop_business_within_one_month",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "insurance_brokerage_stopped",
            true
          ],
          [
            "EQ",
            "reinsurance_brokerage_stopped",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "board_resolution_reported",
            true
          ],
          [
            "LE",
            "report_days_after_stop",
            30
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_keep_books_and_report_financials_annually",
    "desc": "個人執業經紀人、經紀人公司及銀行應專設帳簿，記載業務收支，並於每年4/1至5/31期間彙報主管機關財務報表及其他指定事項",
    "expr": [
      "EQ",
      "broker_annual_financial_report_submitted",
      [
        "AND",
        [
          "EQ",
          "books_kept",
          true
        ],
        [
          "EQ",
          "financial_report_submitted",
          true
        ],
        [
          "GE",
          "report_submission_date",
          401
        ],
        [
          "LE",
          "report_submission_date",
          531
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:authority_may_inspect_and_request_reports",
    "desc": "主管機關得隨時派員檢查或令限期內報告營業狀況",
    "expr": [
      "EQ",
      "authority_inspection_and_report_request",
      [
        "OR",
        [
          "EQ",
          "inspection_conducted",
          true
        ],
        [
          "EQ",
          "report_request_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_improve_and_report_on_inspection_findings",
    "desc": "個人執業經紀人、經紀人公司及銀行應確實辦理改善檢查意見並持續追蹤覆查，於期限內函送主管機關",
    "expr": [
      "EQ",
      "broker_improvement_and_reporting_done",
      [
        "AND",
        [
          "EQ",
          "inspection_findings_improved",
          true
        ],
        [
          "EQ",
          "follow_up_tracking_done",
          true
        ],
        [
          "EQ",
          "report_submitted_to_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_conducts",
    "desc": "個人執業經紀人、經紀人公司、銀行及受任用經紀人不得有列舉之不當行為",
    "expr": [
      "EQ",
      "prohibited_conducts_absent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "false_report_on_license_application",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contract_with_unapproved_insurer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "conceal_important_contract_info",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "coerce_or_induce_unfair_contract",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "misleading_promotion_or_recruitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "induce_policyholder_to_cancel_or_loan",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "misappropriate_insurance_funds",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "use_license_for_others",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "criminal_conviction_for_fraud_or_breach",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "operate_outside_license_scope",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "charge_unapproved_fees_or_commissions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "illegal_insurance_payments",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "spread_false_information",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "authorize_others_to_operate",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "transfer_documents_to_unaffiliated_agents",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "employ_unqualified_insurance_agents",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fail_to_cancel_license_within_deadline",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_stop_or_resume_or_dissolution",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fail_to_reappoint_broker_after_resignation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fail_to_report_to_broker_association",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_advertisement",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "pay_commission_to_non_actual_agents",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fail_to_confirm_suitability_for_elderly",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sell_unapproved_foreign_policy_discount_products",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "false_or_incomplete_financial_reports",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "hold_positions_in_insurance_or_association",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "induce_contract_termination_or_loan",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fail_to_fill_out_recruitment_report_truthfully",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_violations_of_rules_or_laws",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_acts_damaging_insurance_image",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、繳存保證金、投保相關保險、執業證照、管理規則、停業復業規定、帳簿報告義務、改善義務或有不當行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_license_and_guarantee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "management_rules_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_financial_or_business_management_rules",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_company_status_reported",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_company_stop_business_within_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_company_reappoint_broker_after_resume",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_company_cancel_certificates",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_cancel_certificate_within_30_days",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_company_report_stop_business_within_one_month",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_annual_financial_report_submitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_improvement_and_reporting_done",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_conducts_absent",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]