          ],
          [
            "GT",
            "insurance_company_shareholding_ratio",
            10.0
          ]
        ],
        [
          "EQ",
          "shareholding_info_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:fixed_business_place_and_special_books",
    "desc": "保險代理人、經紀人、公證人應有固定業務處所，並專設帳簿記載業務收支",
    "expr": [
      "EQ",
      "fixed_place_and_special_books_compliance",
      [
