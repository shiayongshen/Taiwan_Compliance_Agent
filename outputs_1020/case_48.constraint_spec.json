[
  {
    "id": "insurance:license_and_insurance_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可、繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_insurance_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_subscribed",
          true
        ],
        [
          "EQ",
          "license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_compliance",
    "desc": "相關保險類型依身份區分：保險代理人、公證人為責任保險；保險經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_subscribed",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "liability_insurance_subscribed",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker",
            true
          ],
          [
            "EQ",
            "liability_insurance_subscribed",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_subscribed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit_and_insurance_amount",
    "desc": "繳存保證金及投保相關保險之最低金額及實施方式由主管機關依經營業務範圍及規模定之",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit",
      "guarantee_deposit_amount"
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:qualification_and_management_rules_compliance",
    "desc": "資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則由主管機關定之",
    "expr": [
      "EQ",
      "qualification_and_management_rules_compliance",
      [
        "EQ",
        "compliance_with_authority_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_for_agent_or_broker",
    "desc": "銀行經主管機關許可得擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permission_and_compliance",
      [
        "AND",
        [
          "EQ",
          "bank_approved",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ],
        [
          "EQ",
          "compliance_with_agent_broker_regulations",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fiduciary",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fiduciary",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_exercise_fiduciary_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_analysis_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前，於主管機關指定範圍內，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_written_analysis_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_analysis_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_rules",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定、163條第七項規定，或違反165條第一項或163條第五項準用規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_163_4_financial_or_business_management",
          true
        ],
        [
          "EQ",
          "violate_163_7",
          true
        ],
        [
          "EQ",
          "violate_165_1",
          true
        ],
        [
          "EQ",
          "violate_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_report_for_stop_resume_dissolve",
    "desc": "經紀人公司停業、復業、解散應報主管機關核准並辦理登記，停業期間一年為限，未依規定復業者廢止許可並註銷執照",
    "expr": [
      "EQ",
      "broker_company_stop_resume_dissolve_compliance",
      [
        "AND",
        [
          "EQ",
          "report_stop_resume_dissolve_to_authority",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "stop_period_exceeded_one_year",
            true
          ],
          [
            "EQ",
            "approval_for_extension_obtained",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "AND",
            [
              "EQ",
              "stop_period_expired",
              true
            ],
            [
              "NOT",
              [
                "EQ",
                "resume_applied",
                true
              ]
            ]
          ],
          [
            "EQ",
            "license_revoked",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_must_cancel_licenses_on_stop_or_dissolve",
    "desc": "經紀人公司停業或解散應繳銷所任用經紀人及公司執業證照，未繳銷者經紀人應於30日內辦理註銷登記",
    "expr": [
      "EQ",
      "broker_company_license_cancellation_compliance",
      [
        "AND",
        [
          "EQ",
          "cancel_broker_licenses_on_stop_or_dissolve",
          true
        ],
        [
          "IMPLIES",
          [
            "NOT",
            [
              "EQ",
              "licenses_cancelled",
              true
            ]
          ],
          [
            "EQ",
            "brokers_must_cancel_registration_within_30_days",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_report_stop_reinsurance_within_one_month",
    "desc": "同時經營保險經紀及再保險經紀業務之經紀人公司停止其中一業務，應於一個月內報主管機關備查",
    "expr": [
      "EQ",
      "broker_company_report_stop_reinsurance_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "stop_insurance_or_reinsurance_business",
          true
        ],
        [
          "EQ",
          "report_to_authority_within_one_month",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:individual_and_company_must_keep_books_and_report_financials",
    "desc": "個人執業經紀人、經紀人公司及銀行應專設帳簿記載業務收支，並於每年4/1至5/31期間彙報主管機關財務報表及指定事項",
    "expr": [
      "EQ",
      "bookkeeping_and_reporting_compliance",
      [
        "AND",
        [
          "EQ",
          "special_books_kept",
          true
        ],
        [
          "EQ",
          "annual_financial_report_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:authority_inspection_and_followup",
    "desc": "主管機關得隨時檢查並令限期報告，經紀人公司及銀行應確實改善並持續追蹤覆查，並提報董事會及監察人",
    "expr": [
      "EQ",
      "authority_inspection_and_followup_compliance",
      [
        "AND",
        [
          "EQ",
          "authority_inspection_conducted",
          true
        ],
        [
          "EQ",
          "improvement_followed_up",
          true
        ],
        [
          "EQ",
          "improvement_reported_to_board_and_supervisors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
