      "broker_client_understanding_and_written_analysis",
      [
        "AND",
        [
          "EQ",
          "client_basic_info_understood",
          true
        ],
        [
          "EQ",
          "client_needs_and_risk_assessed",
          true
        ],
        [
          "EQ",
          "written_analysis_provided",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_disclose_shareholding_info_before_contract",
    "desc": "經紀人公司或銀行持有保險公司表決權股份超過10%或反向持股，經紀人洽訂契約前應揭露該資訊",
    "expr": [
      "EQ",
      "broker_shareholding_disclosure",
      [
        "IMPLIES",
        [
          "OR",
          [
            "GT",
            "broker_company_shareholding_ratio",
