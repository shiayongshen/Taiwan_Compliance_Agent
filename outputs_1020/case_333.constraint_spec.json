[
  {
    "id": "bank:internal_control_compliance",
    "desc": "建立內部控制及稽核制度且確實執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_handling_compliance",
    "desc": "建立內部處理制度及程序且確實執行",
    "expr": [
      "EQ",
      "internal_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_operation_compliance",
    "desc": "建立內部作業制度及程序且確實執行",
    "expr": [
      "EQ",
      "internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_operation_established",
          true
        ],
        [
          "EQ",
          "internal_operation_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:credit_limit_ratio",
    "desc": "授信業務比率（百分比）",
    "expr": [
      "EQ",
      "credit_limit_ratio",
      [
        "MUL",
        [
          "DIV",
          [
            "SUB",
            [
              "ADD",
              "credit_to_third_country_entities",
              "credit_to_non_mainland_entities"
            ],
            "short_term_trade_financing_and_syndicated_loans"
          ],
          "net_assets_last_year"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:credit_limit_ratio_adjusted",
    "desc": "授信業務比率調整後（最高50%）",
    "expr": [
      "EQ",
      "credit_limit_ratio_adjusted",
      [
        "CASE",
        [
          "AND",
          [
            "LT",
            "avg_nonperforming_loan_ratio",
            1.5
          ],
          [
            "GT",
            "avg_allowance_coverage_ratio",
            80.0
          ],
          [
            "GT",
            "capital_to_risk_assets_ratio",
            10.0
          ],
          [
            "GT",
            "credit_limit_ratio",
            20.0
          ]
        ],
        50.0,
        30.0
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:annual_report_compliance",
    "desc": "每年一月及七月底前函報授信比率及相關指標",
    "expr": [
      "EQ",
      "annual_report_compliance",
      [
        "EQ",
        "report_submitted_on_time",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_management_policy_compliance",
    "desc": "訂定風險管理政策與程序且經董事會通過",
    "expr": [
      "EQ",
      "risk_management_policy_compliance",
      [
        "AND",
        [
          "EQ",
          "risk_management_policy_established",
          true
        ],
        [
          "EQ",
          "risk_management_policy_approved_by_board",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_compliance",
    "desc": "銀行業風險控管機制符合規定原則",
    "expr": [
      "EQ",
      "risk_control_mechanism_compliance",
      [
        "AND",
        [
          "EQ",
          "capital_adequacy_monitored",
          true
        ],
        [
          "EQ",
          "liquidity_management_mechanism_established",
          true
        ],
        [
          "EQ",
          "asset_allocation_considered_risks",
          true
        ],
        [
          "EQ",
          "asset_quality_and_loss_provisioning_established",
          true
        ],
        [
          "EQ",
          "information_security_and_emergency_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定建立或執行內部控制、內部處理、內部作業制度或未符其他法定要求時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "annual_report_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "risk_management_policy_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "risk_control_mechanism_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]