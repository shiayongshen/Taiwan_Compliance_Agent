[
  {
    "id": "securities:prohibited_trading_during_fund_holding",
    "desc": "負責人及關係人於基金持有期間不得從事該公司股票及具股權性質衍生商品交易",
    "expr": [
      "EQ",
      "prohibited_trading_during_fund_holding",
      [
        "IMPLIES",
        [
          "EQ",
          "fund_holding_stock_or_equity_derivative",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "person_or_related_party_trading_stock_or_equity_derivative",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:trading_declaration_required",
    "desc": "負責人及關係人從事公司股票及具股權性質衍生商品交易應申報",
    "expr": [
      "EQ",
      "trading_declaration_required",
      [
        "IMPLIES",
        [
          "EQ",
          "person_or_related_party_trading_stock_or_equity_derivative",
          true
        ],
        [
          "EQ",
          "trading_reported_to_fund_company",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:related_person_definition",
    "desc": "關係人定義符合主管機關規定",
    "expr": [
      "EQ",
      "related_person_definition_compliant",
      [
        "EQ",
        "related_person_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:duty_of_care_and_loyalty",
    "desc": "負責人及業務人員應以善良管理人注意義務及忠實義務執行業務",
    "expr": [
      "EQ",
      "duty_of_care_and_loyalty",
      [
        "EQ",
        "duty_of_care_and_loyalty_performed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors",
    "desc": "負責人及業務人員不得有法令禁止之不當行為",
    "expr": [
      "EQ",
      "prohibited_behaviors_absent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "insider_trading_or_leakage",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "self_dealing_or_conflict_of_interest",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fraud_or_misrepresentation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "failure_to_return_commission_or_benefits_to_fund",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "providing_or_receiving_undue_benefits",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "selling_voting_rights_for_benefits",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "market_manipulation_or_harm_to_investors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_account_transfer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_public_recommendation_or_forecast",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_commission_or_client_recruitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_agent_trading",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_acts_harming_investors_or_company",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_obligation",
    "desc": "負責人及業務人員應保守受益人及客戶資料秘密",
    "expr": [
      "EQ",
      "confidentiality_obligation_met",
      [
        "EQ",
        "confidentiality_maintained",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "securities:penalty_conditions",
    "desc": "處罰條件：違反禁止交易、申報義務、善良管理義務或保密義務時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "prohibited_trading_during_fund_holding",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "trading_declaration_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "duty_of_care_and_loyalty",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_behaviors_absent",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "confidentiality_obligation_met",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]