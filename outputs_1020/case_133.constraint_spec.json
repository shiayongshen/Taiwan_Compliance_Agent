[
  {
    "id": "insurance_agent:violation_penalty",
    "desc": "保險代理人、經紀人、公證人違反法令或有礙健全經營時主管機關可處分",
    "expr": [
      "EQ",
      "violation_penalty",
      [
        "OR",
        [
          "EQ",
          "violate_law",
          true
        ],
        [
          "EQ",
          "impede_sound_operation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:penalty_measures",
    "desc": "主管機關可採取限制經營範圍、解除職務、停止職務或其他處置",
    "expr": [
      "EQ",
      "penalty_measures",
      [
        "OR",
        [
          "EQ",
          "restrict_business_scope",
          true
        ],
        [
          "EQ",
          "dismiss_manager_or_staff",
          true
        ],
        [
          "EQ",
          "dismiss_or_suspend_director_or_supervisor",
          true
        ],
        [
          "EQ",
          "other_necessary_measures",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:notify_deregistration",
    "desc": "解除董事或監察人職務時通知主管機關註銷登記",
    "expr": [
      "EQ",
      "notify_deregistration",
      [
        "IMPLIES",
        [
          "EQ",
          "dismiss_or_suspend_director_or_supervisor",
          true
        ],
        [
          "EQ",
          "notify_registration_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance:violate_financial_or_business_management",
    "desc": "違反財務或業務管理規定",
    "expr": [
      "EQ",
      "violate_financial_or_business_management",
      [
        "OR",
        [
          "EQ",
          "violate_article_163_4",
          true
        ],
        [
          "EQ",
          "violate_article_163_7",
          true
        ],
        [
          "EQ",
          "violate_article_165_1",
          true
        ],
        [
          "EQ",
          "violate_article_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_167_2",
    "desc": "違反第167-2條規定應限期改正或處罰，情節重大者廢止許可並註銷執照",
    "expr": [
      "EQ",
      "penalty_167_2",
      [
        "OR",
        [
          "EQ",
          "corrected_within_deadline",
          false
        ],
        [
          "EQ",
          "penalty_fine_imposed",
          true
        ],
        [
          "EQ",
          "license_revoked",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violate_internal_control_or_audit",
    "desc": "違反內部控制、稽核制度或招攬處理制度或程序",
    "expr": [
      "EQ",
      "violate_internal_control_or_audit",
      [
        "OR",
        [
          "EQ",
          "not_establish_internal_control",
          true
        ],
        [
          "EQ",
          "not_execute_internal_control",
          true
        ],
        [
          "EQ",
          "not_establish_audit_system",
          true
        ],
        [
          "EQ",
          "not_execute_audit_system",
          true
        ],
        [
          "EQ",
          "not_establish_solicitation_system",
          true
        ],
        [
          "EQ",
          "not_execute_solicitation_system",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_167_3",
    "desc": "違反第167-3條規定應限期改正或處罰",
    "expr": [
      "EQ",
      "penalty_167_3",
      [
        "OR",
        [
          "EQ",
          "corrected_within_deadline_167_3",
          false
        ],
        [
          "EQ",
          "penalty_fine_imposed_167_3",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance_agent:internal_control_compliance",
    "desc": "保險代理人公司、保險經紀人公司、銀行內部控制制度符合規定",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_defined_by_business_nature_and_scale",
          true
        ],
        [
          "EQ",
          "internal_control_reviewed_and_revised",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "audit_committee_established",
            true
          ],
          [
            "EQ",
            "internal_control_includes_audit_committee_management",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:solicitation_system_compliance",
    "desc": "招攬處理制度及程序符合規定",
    "expr": [
      "EQ",
      "solicitation_system_compliance",
      [
        "AND",
        [
          "EQ",
          "include_qualification_and_insurance_type",
          true
        ],
        [
          "EQ",
          "include_compensation_and_risk_assessment",
          true
        ],
        [
          "EQ",
          "include_premium_collection_and_management",
          true
        ],
        [
          "EQ",
          "include_product_information_disclosure",
          true
        ],
        [
          "EQ",
          "include_advertisement_and_promotion_management",
          true
        ],
        [
          "EQ",
          "include_customer_need_assessment",
          true
        ],
        [
          "EQ",
          "include_report_filling_and_verification",
          true
        ],
        [
          "EQ",
          "include_pre_submission_check",
          true
        ],
        [
          "EQ",
          "include_document_control_and_storage",
          true
        ],
        [
          "EQ",
          "include_customer_complaints_handling",
          true
        ],
        [
          "EQ",
          "include_other_designated_matters",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:solicitation_system_exemption_property_insurance",
    "desc": "招攬財產保險時不適用第七款規定",
    "expr": [
      "EQ",
      "solicitation_system_exemption_property_insurance",
      [
        "IMPLIES",
        [
          "EQ",
          "property_insurance_solicited",
          true
        ],
        [
          "EQ",
          "exclude_clause_7",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_broker:prohibited_acts",
    "desc": "個人執業經紀人、經紀人公司、銀行及受任用經紀人不得有禁止行為",
    "expr": [
      "EQ",
      "prohibited_acts",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "false_report_on_license_application",
            true
          ],
          [
            "EQ",
            "contract_with_unregistered_insurer",
            true
          ],
          [
            "EQ",
            "conceal_important_contract_info",
            true
          ],
          [
            "EQ",
            "coerce_or_induce_contract",
            true
          ],
          [
            "EQ",
            "misleading_advertisement",
            true
          ],
          [
            "EQ",
            "induce_policy_cancellation_or_loan",
            true
          ],
          [
            "EQ",
            "embezzle_insurance_funds",
            true
          ],
          [
            "EQ",
            "license_used_by_others",
            true
          ],
          [
            "EQ",
            "criminal_conviction_for_fraud_or_forgery",
            true
          ],
          [
            "EQ",
            "operate_outside_license_scope",
            true
          ],
          [
            "EQ",
            "charge_illegal_fees_or_commissions",
            true
          ],
          [
            "EQ",
            "illegal_insurance_payments",
            true
          ],
          [
            "EQ",
            "spread_false_information",
            true
          ],
          [
            "EQ",
            "authorize_others_to_operate",
            true
          ],
          [
            "EQ",
            "transfer_documents_to_unauthorized_person",
            true
          ],
          [
            "EQ",
            "employ_unqualified_personnel",
            true
          ],
          [
            "EQ",
            "fail_to_cancel_license_in_time",
            true
          ],
          [
            "EQ",
            "unauthorized_suspend_or_terminate_business",
            true
          ],
          [
            "EQ",
            "fail_to_reappoint_agents_after_resignation",
            true
          ],
          [
            "EQ",
            "fail_to_report_to_association",
            true
          ],
          [
            "EQ",
            "unauthorized_use_of_advertisement",
            true
          ],
          [
            "EQ",
            "pay_commission_to_non_actual_agents",
            true
          ],
          [
            "EQ",
            "fail_to_confirm_suitability_for_elderly",
            true
          ],
          [
            "EQ",
            "sell_unapproved_foreign_products",
            true
          ],
          [
            "EQ",
            "false_or_incomplete_report",
            true
          ],
          [
            "EQ",
            "hold_positions_in_insurance_and_association",
            true
          ],
          [
            "EQ",
            "induce_contract_termination_or_loan",
            true
          ],
          [
            "EQ",
            "fail_to_fill_solicitation_report",
            true
          ],
          [
            "EQ",
            "other_violations_of_rules_or_laws",
            true
          ],
          [
            "EQ",
            "damage_insurance_image",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:duty_of_care_and_loyalty",
    "desc": "個人執業經紀人、經紀人公司及銀行應盡善良管理人注意及忠實義務",
    "expr": [
      "EQ",
      "duty_of_care_and_loyalty",
      [
        "AND",
        [
          "EQ",
          "exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "exercise_duty_of_loyalty",
          true
        ],
        [
          "EQ",
          "maintain_insured_interest",
          true
        ],
        [
          "EQ",
          "explain_and_disclose_insurance_info",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:document_retention",
    "desc": "個人執業經紀人、經紀人公司及銀行應留存文件備查",
    "expr": [
      "EQ",
      "document_retention",
      true
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:contact_info_for_e_policy",
    "desc": "電子保單應取得要保人及被保險人聯絡方式並提供保險人",
    "expr": [
      "EQ",
      "contact_info_for_e_policy",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance_policy_is_electronic",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "insured_phone_provided",
            true
          ],
          [
            "EQ",
            "insured_email_provided",
            true
          ],
          [
            "EQ",
            "other_approved_contact_provided",
            true
          ],
          [
            "EQ",
            "contact_provided_to_insurer",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:internal_operation_regulation",
    "desc": "經紀人公司及銀行應訂定並執行內部作業規範，保障高齡消費者權益",
    "expr": [
      "EQ",
      "internal_operation_regulation",
      [
        "AND",
        [
          "EQ",
          "internal_operation_regulation_established",
          true
        ],
        [
          "EQ",
          "internal_operation_regulation_executed",
          true
        ],
        [
          "EQ",
          "include_protection_for_elderly",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:pre_contract_duty",
    "desc": "經紀人洽訂契約前應充分瞭解客戶資料並提供書面分析報告及報酬標準",
    "expr": [
      "EQ",
      "pre_contract_duty",
      [
        "AND",
        [
          "EQ",
          "understand_client_basic_info",
          true
        ],
        [
          "EQ",
          "provide_written_analysis_report",
          true
        ],
        [
          "EQ",
          "disclose_fee_standard_before_receiving_fee",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:shareholding_disclosure",
    "desc": "經紀人持股超過10%應於洽訂契約前揭露資訊",
    "expr": [
      "EQ",
      "shareholding_disclosure",
      [
        "IMPLIES",
        [
          "OR",
          [
            "GT",
            "broker_shareholding_in_insurer",
            10
          ],
          [
            "GT",
            "insurer_shareholding_in_broker",
            10
          ]
        ],
        [
          "EQ",
          "disclose_shareholding_info_before_contract",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令或規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "violation_penalty",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "penalty_measures",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "penalty_167_2",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "penalty_167_3",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_system_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_acts",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "duty_of_care_and_loyalty",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "document_retention",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contact_info_for_e_policy",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_regulation",
            true
          ]
        ],
        [
          "NOT",
          [
