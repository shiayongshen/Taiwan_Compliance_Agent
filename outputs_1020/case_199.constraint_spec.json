[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=資本適足, 2=資本不足, 3=資本顯著不足, 4=資本嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_lower_priority",
    "desc": "資本等級以較低等級為準（若同時符合多等級）",
    "expr": [
      "EQ",
      "capital_level_lower_priority",
      [
        "CASE",
        [
          "EQ",
          "capital_level",
          4
        ],
        4,
        [
          "EQ",
          "capital_level",
          3
        ],
        3,
        [
          "EQ",
          "capital_level",
          2
        ],
        2,
        [
          "EQ",
          "capital_level",
          1
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_severely_insufficient",
    "desc": "資本嚴重不足等級判定",
    "expr": [
      "EQ",
      "capital_severely_insufficient",
      [
        "EQ",
        "capital_level",
        4
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_significantly_insufficient",
    "desc": "資本顯著不足等級判定",
    "expr": [
      "EQ",
      "capital_significantly_insufficient",
      [
        "EQ",
        "capital_level",
        3
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient",
    "desc": "資本不足等級判定",
    "expr": [
      "EQ",
      "capital_insufficient",
      [
        "EQ",
        "capital_level",
        2
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_adequate",
    "desc": "資本適足等級判定",
    "expr": [
      "EQ",
      "capital_adequate",
      [
        "EQ",
        "capital_level",
        1
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_completed",
    "desc": "增資、財務或業務改善計畫或合併已於主管機關規定期限內完成",
    "expr": [
      "EQ",
      "improvement_plan_completed",
      [
        "EQ",
        "improvement_plan_submitted",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_overdue",
    "desc": "資本嚴重不足且未於期限完成增資、財務或業務改善計畫或合併",
    "expr": [
      "EQ",
      "improvement_plan_overdue",
      [
        "AND",
        [
          "EQ",
          "capital_severely_insufficient",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "improvement_plan_completed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_or_business_deterioration",
    "desc": "財務或業務狀況顯著惡化，不能支付債務或無法履行契約責任或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "financial_or_business_deterioration",
      [
        "EQ",
        "financial_business_deterioration_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_approved",
    "desc": "主管機關核定財務或業務改善計畫",
    "expr": [
      "EQ",
      "improvement_plan_approved",
      [
        "EQ",
        "improvement_plan_approved_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:accelerated_deterioration_or_no_improvement",
    "desc": "損益、淨值加速惡化或經輔導仍未改善",
    "expr": [
      "EQ",
      "accelerated_deterioration_or_no_improvement",
      [
        "EQ",
        "accelerated_deterioration_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:regulatory_action_required",
    "desc": "應為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "regulatory_action_required",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "improvement_plan_overdue",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_deterioration",
            true
          ],
          [
            "EQ",
            "improvement_plan_approved",
            true
          ],
          [
            "EQ",
            "accelerated_deterioration_or_no_improvement",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervision_restriction_compliance",
    "desc": "保險業未違反主管機關限制營業或資金運用範圍等規定",
    "expr": [
      "EQ",
      "supervision_restriction_compliance",
      [
        "AND",
        [
          "EQ",
          "business_scope_restricted",
          false
        ],
        [
          "EQ",
          "capital_usage_restricted",
          false
        ],
        [
          "EQ",
          "insurance_product_sales_restricted",
          false
        ],
        [
          "EQ",
          "capital_increase_ordered",
          false
        ],
        [
          "EQ",
          "manager_or_staff_dismissed",
          false
        ],
        [
          "EQ",
          "statutory_meeting_resolution_revoked",
          false
        ],
        [
          "EQ",
          "director_or_supervisor_dismissed_or_suspended",
          false
        ],
        [
          "EQ",
          "other_necessary_measures_taken",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_ok",
    "desc": "建立並執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "建立並執行內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_usage_limit_compliance",
    "desc": "保險業資金運用符合主管機關規定之限額及範圍",
    "expr": [
      "EQ",
      "capital_usage_limit_compliance",
      [
        "AND",
        [
          "LE",
          "deposit_per_financial_institution_ratio",
          10.0
        ],
        [
          "EQ",
          "deposit_limit_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_in_insurance_related_business_compliance",
    "desc": "投資保險相關事業符合主管機關規定",
    "expr": [
      "EQ",
      "investment_in_insurance_related_business_compliance",
      [
        "EQ",
        "investment_compliance_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:derivative_transaction_compliance",
    "desc": "從事衍生性商品交易符合主管機關規定",
    "expr": [
      "EQ",
      "derivative_transaction_compliance",
      [
        "EQ",
        "derivative_compliance_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:project_investment_approval_or_post_check",
    "desc": "專案運用及公共及社會福利事業投資申請核准或備供事後查核",
    "expr": [
      "EQ",
      "project_investment_approval_or_post_check",
      [
        "OR",
        [
          "EQ",
          "project_investment_approved",
          true
        ],
        [
          "EQ",
          "project_investment_post_check",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:public_welfare_investment_compliance",
    "desc": "公共及社會福利事業投資符合主管機關規定",
    "expr": [
      "EQ",
      "public_welfare_investment_compliance",
      [
        "AND",
        [
          "LE",
          "appointed_director_ratio",
          0.6666667
        ],
        [
          "GE",
          "appointed_director_ratio",
          0.0
        ],
        [
          "EQ",
          "independent_director_exists",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_staff_appointed_as_manager",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反資本嚴重不足未完成改善計畫、財務或業務惡化未改善、未建立或執行內部控制及稽核制度、未建立或執行內部處理制度或程序、資金運用違反限額或規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_severely_insufficient",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_completed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_deterioration",
            true
          ],
          [
            "EQ",
            "improvement_plan_approved",
            true
          ],
          [
            "EQ",
            "accelerated_deterioration_or_no_improvement",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "capital_usage_limit_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]