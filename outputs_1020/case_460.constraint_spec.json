[
  {
    "id": "insurance:business_start_permit",
    "desc": "保險業非經主管機關許可、依法設立登記、繳存保證金及領得營業執照後，始得開始營業",
    "expr": [
      "EQ",
      "business_start_permit",
      [
        "AND",
        [
          "EQ",
          "permit_obtained",
          true
        ],
        [
          "EQ",
          "registered_according_law",
          true
        ],
        [
          "EQ",
          "deposit_guarantee",
          true
        ],
        [
          "EQ",
          "business_license_obtained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "保險業不動產投資總額除自用不動產外不得超過資金30%，自用不動產不得超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "capital_fund",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_use_and_income",
    "desc": "保險業投資不動產須即時利用並有收益，住宅法興辦社會住宅且僅供租賃者除外",
    "expr": [
      "EQ",
      "real_estate_use_and_income",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "real_estate_invested",
            true
          ],
          [
            "EQ",
            "real_estate_in_use",
            true
          ],
          [
            "EQ",
            "real_estate_has_income",
            true
          ]
        ],
        [
          "EQ",
          "social_housing_rental_only",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_types_limit",
    "desc": "保險業辦理放款限銀行或主管機關認可信用保證機構保證、以動產不動產擔保、有價證券質押、人壽保險單質押",
    "expr": [
      "EQ",
      "loan_types_limit",
      [
        "OR",
        [
          "EQ",
          "loan_guaranteed_by_bank_or_authority",
          true
        ],
        [
          "EQ",
          "loan_secured_by_movable_or_immovable",
          true
        ],
        [
          "EQ",
          "loan_secured_by_approved_securities",
          true
        ],
        [
          "EQ",
          "loan_secured_by_life_insurance_policy",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_loan_amount_limit",
    "desc": "每一單位放款金額不得超過資金5%",
    "expr": [
      "EQ",
      "single_loan_amount_limit",
      [
        "LE",
        "single_loan_amount",
        [
          "MUL",
          "capital_fund",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:total_loan_amount_limit",
    "desc": "放款總額不得超過資金35%",
    "expr": [
      "EQ",
      "total_loan_amount_limit",
      [
        "LE",
        "total_loan_amount",
        [
          "MUL",
          "capital_fund",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_conditions",
    "desc": "對負責人、職員、主要股東或利害關係人擔保放款應有十足擔保且條件不得優於其他同類放款，達一定金額須董事會同意",
    "expr": [
      "EQ",
      "related_party_loan_conditions",
      [
        "AND",
        [
          "EQ",
          "full_collateral_for_related_party_loan",
          true
        ],
        [
          "EQ",
          "loan_conditions_not_better_than_others",
          true
        ],
        [
          "IMPLIES",
          [
            "GE",
            "related_party_loan_amount",
            "authority_threshold"
          ],
          [
            "AND",
            [
              "GE",
              "board_attendance",
              [
                "MUL",
                "board_total",
                0.6667
              ]
            ],
            [
              "GE",
              "board_approval",
              [
                "MUL",
                "board_attendance",
                0.75
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:combined_investment_limit",
    "desc": "有價證券投資與以該公司發行有價證券為質之放款合併計算不得超過資金10%及該公司業主權益10%",
    "expr": [
      "EQ",
      "combined_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "ADD",
            "investment_in_securities",
            "loan_secured_by_issuer_securities"
          ],
          [
            "MUL",
            "capital_fund",
            10.0
          ]
        ],
        [
          "LE",
          [
            "ADD",
            "investment_in_securities",
            "loan_secured_by_issuer_securities"
          ],
          [
            "MUL",
            "issuer_owner_equity",
            10.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "保險業應建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "保險業應建立資產品質評估、準備金提存、逾期放款、催收款清理、呆帳轉銷及保單招攬核保理賠之內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_system_and_procedures_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：未依規定取得許可、未依法設立登記、未繳存保證金、未領得營業執照、超過不動產投資限制、放款超限、未建立內部控制或內部處理制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "business_start_permit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_use_and_income",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "loan_types_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "single_loan_amount_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "total_loan_amount_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "related_party_loan_conditions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "combined_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]