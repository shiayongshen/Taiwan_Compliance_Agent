      [
        "EQ",
        "regulations_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_178_1",
    "desc": "違反第22-2條第一項、第二項、第26-1條或第165-1條準用第22-2條第一項、第二項規定",
    "expr": [
      "EQ",
      "violation_178_1",
      [
        "EQ",
        "violate_22_2_1_or_2_or_26_1_or_165_1_applied_22_2_1_or_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_178_2",
    "desc": "違反第14條第三項、第14條之一第一項、第三項、第14條之二第一項、第三項、第6項、第14條之三、第14條之五第一項至第三項、第21條之一第五項、第25條第一項、第二項、第四項、第31條第一項、第36條第五項、第七項、第41條、第43條之一第一項、第43條之四第一項、第43條之六第五項至第七項、第165條之一或第165條之二準用相關規定",
    "expr": [
      "EQ",
      "violation_178_2",
      [
        "EQ",
        "violate_specified_articles_14_14_1_14_2_etc",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_178_3",
    "desc": "發行人、公開收購人或其關係人、證券商委託人未依主管機關命令提出帳簿、表冊、文件或其他資料，或規避、妨礙、拒絕檢查",
    "expr": [
      "EQ",
      "violation_178_3",
      [
        "EQ",
        "fail_to_submit_or_obstruct_inspection",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_178_4",
    "desc": "發行人、公開收購人未依規定製作、申報、公告、備置或保存帳簿、表冊、傳票、財務報告或其他有關業務文件",
    "expr": [
      "EQ",
      "violation_178_4",
      [
