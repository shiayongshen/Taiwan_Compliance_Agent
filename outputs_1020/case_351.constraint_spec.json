  },
  {
    "id": "securities:derivative_transaction_risk_management_measures_compliance",
    "desc": "公開發行公司從事衍生性商品交易採行風險管理措施",
    "expr": [
      "EQ",
      "derivative_transaction_risk_management_measures_compliance",
      [
        "AND",
        [
