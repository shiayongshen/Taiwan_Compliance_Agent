  {
    "id": "securities:foreign_company_violation_178_3_or_4",
    "desc": "外國公司為發行人時，違反第178條第三款或第四款規定",
    "expr": [
      "EQ",
      "foreign_company_violation_178_3_or_4",
      [
        "AND",
        [
          "EQ",
          "is_foreign_company_issuer",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "violation_178_3",
            true
          ],
          [
            "EQ",
            "violation_178_4",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_exemption_for_minor_cases",
