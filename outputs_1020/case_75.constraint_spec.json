      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反保險法第171-1條任一規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "penalty_171_1",
          true
        ],
        [
          "EQ",
          "penalty_171_2",
          true
        ],
        [
          "EQ",
          "penalty_171_3",
          true
        ],
        [
          "EQ",
          "penalty_171_4",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
