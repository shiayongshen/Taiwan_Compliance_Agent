[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_4_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "level_4_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "AND",
          [
            "EQ",
            "capital_increase_completed",
            true
          ],
          [
            "EQ",
            "financial_improvement_plan_completed",
            true
          ],
          [
            "EQ",
            "business_improvement_plan_completed",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "merged",
              true
            ],
            [
              "EQ",
              "merged",
              false
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_3_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "level_3_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          3
        ],
        [
          "AND",
          [
            "EQ",
            "improvement_plan_submitted",
            true
          ],
          [
            "EQ",
            "improvement_plan_approved",
            true
          ],
          [
            "EQ",
            "improvement_plan_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_2_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          2
        ],
        [
          "OR",
          [
            "AND",
            [
              "EQ",
              "improvement_plan_submitted",
              true
            ],
            [
              "EQ",
              "improvement_plan_executed",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level",
              2
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：資本嚴重不足且未完成增資或改善計畫，或資本顯著不足且未完成改善計畫，或資本不足且未完成改善計畫時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "level_4_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "level_3_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "level_2_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:internal_control_ok",
    "desc": "建立內部控制及稽核制度且確實執行",
    "expr": [
      "EQ",
      "internal_control_ok",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_ok",
    "desc": "建立內部處理制度及程序且確實執行",
    "expr": [
      "EQ",
      "internal_handling_ok",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_internal_control_handling",
    "desc": "處罰條件：未建立或未執行內部控制或內部處理制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "aml:internal_control_established",
    "desc": "洗錢防制法規定建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "aml_internal_control_established",
      [
        "EQ",
        "aml_internal_control_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制法規定執行洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "aml_internal_control_executed",
      [
        "EQ",
        "aml_internal_control_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:penalty_conditions",
    "desc": "處罰條件：未建立或未執行洗錢防制內部控制與稽核制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "aml_internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml_internal_control_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "aml:customer_id_procedure_ok",
    "desc": "已依洗錢防制法執行確認客戶身分程序並留存資料",
    "expr": [
      "EQ",
      "customer_id_procedure_ok",
      [
        "AND",
        [
          "EQ",
          "customer_id_procedure_performed",
          true
        ],
        [
          "GE",
          "customer_id_data_retention_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:penalty_customer_id_procedure",
    "desc": "處罰條件：未依規定執行確認客戶身分程序或未留存資料時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "EQ",
          "customer_id_procedure_ok",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "aml:transaction_record_retention_ok",
    "desc": "已留存必要交易紀錄且保存期限符合規定",
    "expr": [
      "EQ",
      "transaction_record_retention_ok",
      [
        "AND",
        [
          "EQ",
          "transaction_record_retained",
          true
        ],
        [
          "GE",
          "transaction_record_retention_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:penalty_transaction_record_retention",
    "desc": "處罰條件：未留存必要交易紀錄或保存期限不足時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "EQ",
          "transaction_record_retention_ok",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]