[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度且包含六項規定",
    "expr": [
      "EQ",
      "aml:internal_control_established",
      [
        "AND",
        [
          "EQ",
          "aml:control_procedure_established",
          true
        ],
        [
          "EQ",
          "aml:training_held_regularly",
          true
        ],
        [
          "EQ",
          "aml:dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "aml:risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "aml:audit_procedure_established",
          true
        ],
        [
          "EQ",
          "aml:other_designated_matters_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_executed",
    "desc": "洗錢防制內部控制制度確實執行",
    "expr": [
      "EQ",
      "aml:internal_control_executed",
      [
        "EQ",
        "aml:internal_control_implementation",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_compliance",
    "desc": "洗錢防制內部控制制度建立且確實執行",
    "expr": [
      "EQ",
      "aml:internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "aml:internal_control_established",
          true
        ],
        [
          "EQ",
          "aml:internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_procedure_established",
    "desc": "建立確認客戶身分程序且包含風險基礎及實質受益人審查",
    "expr": [
      "EQ",
      "aml:customer_identification_procedure_established",
      [
        "AND",
        [
          "EQ",
          "aml:customer_identification_procedure",
          true
        ],
        [
          "EQ",
          "aml:risk_based_approach_applied",
          true
        ],
        [
          "EQ",
          "aml:beneficial_owner_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_data_retained",
    "desc": "確認客戶身分程序所得資料保存期限符合規定",
    "expr": [
      "EQ",
      "aml:customer_identification_data_retained",
      [
        "AND",
        [
          "GE",
          "aml:customer_data_retention_years",
          5.0
        ],
        [
          "GE",
          "aml:temporary_transaction_data_retention_years",
          5.0
        ],
        [
          "GE",
          "aml:longer_legal_retention_years",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:enhanced_customer_due_diligence_applied",
    "desc": "對重要政治性職務客戶及其家庭成員及密切關係人執行加強客戶審查程序",
    "expr": [
      "EQ",
      "aml:enhanced_customer_due_diligence_applied",
      [
        "EQ",
        "aml:enhanced_due_diligence_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:customer_identification_compliance",
    "desc": "確認客戶身分程序建立、資料保存及加強審查均符合規定",
    "expr": [
      "EQ",
      "aml:customer_identification_compliance",
      [
        "AND",
        [
          "EQ",
          "aml:customer_identification_procedure_established",
          true
        ],
        [
          "EQ",
          "aml:customer_identification_data_retained",
          true
        ],
        [
          "EQ",
          "aml:enhanced_customer_due_diligence_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:report_currency_transaction_timely",
    "desc": "金融機構於交易完成後五個營業日內以媒體申報方式申報達一定金額以上通貨交易",
    "expr": [
      "EQ",
      "aml:report_currency_transaction_timely",
      [
        "OR",
        [
          "EQ",
          "aml:media_report_submitted",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "aml:media_report_not_possible",
            true
          ],
          [
            "EQ",
            "aml:written_report_approved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:suspicious_transaction_report_required",
    "desc": "符合疑似洗錢交易條件應申報疑似洗錢交易",
    "expr": [
      "EQ",
      "aml:suspicious_transaction_report_required",
      [
        "OR",
        [
          "AND",
          [
            "GE",
            "aml:same_account_daily_cash_deposit_withdrawal_amount",
            500000.0
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_customer_income",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_business_nature",
                true
              ]
            ]
          ]
        ],
        [
          "AND",
          [
            "GE",
            "aml:same_customer_multiple_cash_transactions_amount",
            500000.0
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_customer_income",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_business_nature",
                true
              ]
            ]
          ]
        ],
        [
          "AND",
          [
            "GE",
            "aml:same_customer_multiple_cash_remittances_amount",
            500000.0
          ],
          [
            "NOT",
            [
              "EQ",
              "aml:reasonable_purpose_explained",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "aml:transaction_from_high_risk_country",
            true
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_customer_income",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "aml:transaction_matches_business_nature",
                true
              ]
            ]
          ]
        ],
        [
          "OR",
          [
            "EQ",
            "aml:transaction_beneficial_owner_is_terrorist",
            true
          ],
          [
            "EQ",
            "aml:transaction_party_is_terrorist",
            true
          ],
          [
            "EQ",
            "aml:transaction_funds_suspected_terrorism_related",
            true
          ]
        ],
        [
          "EQ",
          "aml:transaction_identified_as_suspicious_by_internal_procedure",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:currency_transaction_definition",
    "desc": "通貨交易定義為單筆現金收付或換鈔交易",
    "expr": [
      "EQ",
      "aml:currency_transaction_definition",
      [
        "EQ",
        "aml:currency_transaction",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反洗錢防制內部控制制度建立或執行規定，或違反確認客戶身分程序及資料保存規定，或未依規定申報通貨交易及疑似洗錢交易時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "aml:internal_control_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:customer_identification_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:report_currency_transaction_timely",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "aml:suspicious_transaction_report_required",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]