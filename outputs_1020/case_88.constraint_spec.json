            "hold_positions_in_insurance_or_association",
            true
          ],
          [
            "EQ",
            "induce_clients_to_terminate_contracts_or_loan",
            true
          ],
          [
            "EQ",
            "fail_to_fill_recruitment_report_truthfully",
            true
          ],
          [
            "EQ",
            "other_violations_of_rules_or_laws",
            true
          ],
          [
            "EQ",
