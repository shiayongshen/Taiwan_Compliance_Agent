      "broker_company_and_bank_must_establish_internal_procedures",
      [
        "EQ",
        "internal_procedures_established_and_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_understand_client_and_provide_written_report_before_contract",
    "desc": "經紀人洽訂保險契約前應充分了解要保人及被保險人基本資料、需求及風險屬性，並依主管機關規定主動提供書面分析報告，收費前應明確告知收費標準",
    "expr": [
      "EQ",
      "broker_must_understand_client_and_provide_written_report_before_contract",
