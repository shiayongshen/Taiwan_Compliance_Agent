        [
          "EQ",
          "exercise_fidelity",
          true
        ],
        [
          "EQ",
          "maintain_documentation",
          true
        ],
        [
          "EQ",
          "provide_sufficient_explanation_and_disclosure",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_obtain_contact_info_for_e_policy",
    "desc": "保險人以電子保單出單時，經紀人應取得要保人及被保險人聯絡方式並提供保險人",
    "expr": [
      "EQ",
      "broker_must_obtain_contact_info_for_e_policy",
      [
        "IMPLIES",
        [
          "EQ",
          "insurance_policy_is_electronic",
          true
        ],
        [
          "AND",
          [
            "OR",
            [
              "EQ",
              "applicant_mobile_phone",
              true
            ],
            [
              "EQ",
              "applicant_email",
              true
            ],
            [
              "EQ",
              "applicant_other_contact",
              true
            ]
          ],
          [
            "OR",
            [
              "EQ",
              "insured_mobile_phone",
              true
            ],
            [
              "EQ",
              "insured_email",
              true
            ],
            [
              "EQ",
              "insured_other_contact",
              true
            ]
          ],
          [
            "EQ",
            "provide_contact_info_to_insurer",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_and_bank_must_establish_internal_procedures",
    "desc": "經紀人公司及銀行應依法令及主管機關規定訂定內部作業規範並落實執行，包含保障65歲以上高齡消費者權益",
    "expr": [
