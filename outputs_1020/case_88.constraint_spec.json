          [
            "EQ",
            "disclose_shareholding_info",
            true
          ]
        ],
        [
          "AND",
          [
            "GE",
            "insurance_company_shareholding_ratio",
            10
          ],
          [
            "EQ",
            "disclose_shareholding_info",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
