[
  {
    "id": "insurance:agent_broker_not_permitted_without_license_and_guarantee",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_broker_not_permitted_without_license_and_guarantee",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_minimum_amount"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "has_practice_certificate",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_covered",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_covered",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "is_agent",
            true
          ],
          [
            "EQ",
            "is_notary",
            true
          ],
          [
            "EQ",
            "has_liability_insurance",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "EQ",
            "has_liability_insurance",
            true
          ],
          [
            "EQ",
            "has_guarantee_insurance",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:guarantee_minimum_amount_set_by_authority",
    "desc": "保證金最低金額及實施方式由主管機關依經營業務範圍及規模定之",
    "expr": [
      "EQ",
      "guarantee_minimum_amount_set_by_authority",
      [
        "EQ",
        "guarantee_minimum_amount_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:qualification_and_management_rules_defined",
    "desc": "資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他管理規則由主管機關定之",
    "expr": [
      "EQ",
      "qualification_and_management_rules_defined",
      [
        "EQ",
        "management_rules_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_license_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_exercise_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_analysis_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前，於主管機關指定範圍內，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_must_provide_written_analysis_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "broker_provide_written_analysis_report",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_charge_fee",
            true
          ],
          [
            "EQ",
            "broker_disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_or_broker_rules",
    "desc": "違反保險法第163條第4項管理規則中財務或業務管理規定、第163條第7項規定，或第165條第1項及第163條第5項準用規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_or_broker_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rules",
          true
        ],
        [
          "EQ",
          "violate_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_broker_duty_rules",
          true
        ],
        [
          "EQ",
          "violate_article_165_1",
          true
        ],
        [
          "EQ",
          "violate_article_163_5",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_capital_requirements",
    "desc": "經紀人公司最低實收資本額依申請業務類型及修正時間規定",
    "expr": [
      "EQ",
      "broker_company_capital_requirements",
      [
        "CASE",
        [
          "AND",
          [
            "LT",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            1
          ]
        ],
        5000000,
        [
          "AND",
          [
            "LT",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            2
          ]
        ],
        10000000,
        [
          "AND",
          [
            "LT",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            3
          ]
        ],
        10000000,
        [
          "AND",
          [
            "GE",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            1
          ]
        ],
        20000000,
        [
          "AND",
          [
            "GE",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            2
          ]
        ],
        20000000,
        [
          "AND",
          [
            "GE",
            "application_date",
            20170303
          ],
          [
            "EQ",
            "business_type",
            3
          ]
        ],
        30000000,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_capital_adjustment_required",
    "desc": "已領有執業證照之經紀人公司於股權或資本總額移轉累計達50%以上時，應於交割日次日起6個月內完成資本額調整（繼承除外）",
    "expr": [
      "EQ",
      "broker_company_capital_adjustment_required",
      [
        "IMPLIES",
        [
          "AND",
          [
            "GE",
            "equity_or_capital_transfer_ratio",
            50
          ],
          [
            "NOT",
            [
              "EQ",
              "transfer_due_to_inheritance",
              true
            ]
          ]
        ],
        [
          "LE",
          "capital_adjustment_days_after_transfer",
          180
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_company_capital_paid_in_cash",
    "desc": "經紀人公司發起人及股東出資以現金為限",
    "expr": [
      "EQ",
      "broker_company_capital_paid_in_cash",
      [
        "EQ",
        "capital_paid_in_cash",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
