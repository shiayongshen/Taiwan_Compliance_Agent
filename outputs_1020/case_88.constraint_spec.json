        [
          "EQ",
          "provide_written_analysis_report",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "charge_fee",
            true
          ],
          [
            "EQ",
            "disclose_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_disclose_shareholding_info_before_contract",
    "desc": "經紀人公司或銀行持有單一保險公司表決權股份超過10%或反之，洽訂保險契約前應向要保人揭露",
    "expr": [
      "EQ",
      "broker_must_disclose_shareholding_info_before_contract",
      [
        "OR",
        [
          "AND",
          [
            "GE",
            "broker_company_shareholding_ratio",
            10
