[
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_purchased",
          true
        ],
        [
          "EQ",
          "license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_compliance",
    "desc": "保險代理人、公證人須投保責任保險；保險經紀人須投保責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_or_notary",
            true
          ],
          [
            "EQ",
            "liability_insurance_purchased",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "broker",
            true
          ],
          [
            "EQ",
            "liability_insurance_purchased",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_purchased",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:minimum_guarantee_deposit_defined",
    "desc": "主管機關定最低保證金及實施方式，考量經營業務範圍及規模",
    "expr": [
      "EQ",
      "minimum_guarantee_deposit_defined",
      [
        "EQ",
        "authority_defined_minimum_guarantee_deposit",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:management_rules_defined",
    "desc": "主管機關定保險代理人、經紀人、公證人資格取得、申請許可條件、程序及其他管理規則",
    "expr": [
      "EQ",
      "management_rules_defined",
      [
        "EQ",
        "authority_defined_management_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permission_for_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permission_for_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_authority_permission",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_as_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_as_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務洽訂保險契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fidelity_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosure_made",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_penalties",
    "desc": "違反法令或有礙健全經營時，主管機關得糾正、限期改善或處分",
    "expr": [
      "EQ",
      "violation_penalties",
      [
        "OR",
        [
          "EQ",
          "corrective_order_issued",
          true
        ],
        [
          "EQ",
          "improvement_order_issued",
          true
        ],
        [
          "EQ",
          "business_scope_restriction",
          true
        ],
        [
          "EQ",
          "manager_or_staff_dismissed",
          true
        ],
        [
          "EQ",
          "director_or_supervisor_dismissed_or_suspended",
          true
        ],
        [
          "EQ",
          "other_necessary_measures_taken",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:director_supervisor_dismissal_notification",
    "desc": "依規定解除董事或監察人職務時，主管機關通知公司登記主管機關註銷登記",
    "expr": [
      "EQ",
      "director_supervisor_dismissal_notification",
      [
        "IMPLIES",
        [
          "EQ",
          "director_or_supervisor_dismissed",
          true
        ],
        [
          "EQ",
          "dismissal_notification_sent",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_for_violation_of_management_rules",
    "desc": "違反管理規則財務或業務管理規定、或相關規定者，應限期改正或處罰，情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "penalty_for_violation_of_management_rules",
      [
        "OR",
        [
          "EQ",
          "ordered_to_correct",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "penalty_fine_imposed",
            true
          ],
          [
            "GE",
            "penalty_fine_amount",
            100000.0
          ],
          [
            "LE",
            "penalty_fine_amount",
            3000000.0
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "license_revoked",
            true
          ],
          [
            "EQ",
            "license_canceled",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_prohibited_acts",
    "desc": "保險經紀人及相關人員不得有規則第49條列舉之不當行為",
    "expr": [
      "EQ",
      "broker_prohibited_acts",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "false_report_on_license_application",
            true
          ],
          [
            "EQ",
            "contract_with_unapproved_insurer",
            true
          ],
          [
            "EQ",
            "conceal_important_contract_info",
            true
          ],
          [
            "EQ",
            "coerce_or_induce_contract",
            true
          ],
          [
            "EQ",
            "misleading_promotion_or_recruitment",
            true
          ],
          [
            "EQ",
            "induce_policyholder_to_cancel_or_loan",
            true
          ],
          [
            "EQ",
            "misappropriate_insurance_funds",
            true
          ],
          [
            "EQ",
            "license_used_by_others",
            true
          ],
          [
            "EQ",
            "convicted_of_fraud_or_forgery",
            true
          ],
          [
            "EQ",
            "operate_outside_license_scope",
            true
          ],
          [
            "EQ",
            "charge_illegal_fees_or_commissions",
            true
          ],
          [
            "EQ",
            "illegal_insurance_payments",
            true
          ],
          [
            "EQ",
            "spread_false_information",
            true
          ],
          [
            "EQ",
            "authorize_others_to_operate",
            true
          ],
          [
            "EQ",
            "transfer_application_documents_improperly",
            true
          ],
          [
            "EQ",
            "employ_unqualified_recruiters",
            true
          ],
          [
            "EQ",
            "fail_to_cancel_license_in_time",
            true
          ],
          [
            "EQ",
            "unauthorized_suspend_or_terminate_business",
            true
          ],
          [
            "EQ",
            "fail_to_appoint_replacement_broker",
            true
          ],
          [
            "EQ",
            "fail_to_report_to_broker_association",
            true
          ],
          [
            "EQ",
            "unauthorized_use_of_advertisement",
            true
          ],
          [
            "EQ",
            "pay_commission_to_non_recruiters",
            true
          ],
          [
            "EQ",
            "fail_to_confirm_suitability_for_seniors",
            true
          ],
          [
            "EQ",
            "sell_unapproved_foreign_policies",
            true
          ],
          [
            "EQ",
            "false_or_incomplete_report",
            true
          ],
          [
            "EQ",
            "hold_conflicting_positions",
            true
          ],
          [
            "EQ",
            "induce_contract_termination_or_loan",
            true
          ],
          [
            "EQ",
            "fail_to_fill_recruitment_report_truthfully",
            true
          ],
          [
            "EQ",
            "other_violations_of_rules_or_laws",
            true
          ],
          [
            "EQ",
            "damage_insurance_image",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未經主管機關許可、未繳存保證金、未投保相關保險、未領執業證照、或有違反管理規則及不當行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_and_guarantee_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "relevant_insurance_type_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "management_rules_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fidelity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_report_and_fee_disclosure",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_penalties",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "penalty_for_violation_of_management_rules",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_prohibited_acts",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]