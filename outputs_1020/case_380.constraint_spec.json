[
  {
    "id": "insurance:agent_license_and_insurance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "agent_license_and_insurance",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_deposit_minimum"
        ],
        [
          "EQ",
          "relevant_insurance_purchased",
          true
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type",
    "desc": "相關保險種類依代理人、經紀人、公證人身份不同而定",
    "expr": [
      "EQ",
      "relevant_insurance_type_ok",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "relevant_insurance_type",
            1
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "OR",
            [
              "EQ",
              "relevant_insurance_type",
              1
            ],
            [
              "EQ",
              "relevant_insurance_type",
              2
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "relevant_insurance_type",
            1
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:guarantee_deposit_minimum_set",
    "desc": "保證金最低金額及實施方式由主管機關依業務範圍及規模定之",
    "expr": [
      "EQ",
      "guarantee_deposit_minimum_set",
      [
        "EQ",
        "guarantee_deposit_minimum_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_management_rules_set",
    "desc": "代理人資格取得、申請許可條件、程序、文件等管理規則由主管機關定之",
    "expr": [
      "EQ",
      "agent_management_rules_set",
      [
        "EQ",
        "management_rules_defined_by_authority",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行得經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_permission_granted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercise_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_fulfill_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人洽訂契約前應主動提供書面分析報告，收取報酬者應明確告知收費標準",
    "expr": [
      "EQ",
      "broker_report_and_fee_disclosed",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_qualification_and_employment",
    "desc": "代理人具資格且無禁止情事，得以個人名義或受代理人公司或銀行任用取得執業證照後執行業務",
    "expr": [
      "EQ",
      "agent_qualification_and_employment",
      [
        "AND",
        [
          "EQ",
          "agent_qualification_met",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_prohibited_condition",
            true
          ]
        ],
        [
          "EQ",
          "practice_certificate_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_and_bank_must_employ_minimum_agents",
    "desc": "代理人公司及銀行應任用代理人至少一人，並視業務規模及品質適當調整",
    "expr": [
      "EQ",
      "agent_company_and_bank_employment_ok",
      [
        "AND",
        [
          "GE",
          "agents_employed",
          1
        ],
        [
          "EQ",
          "employment_adjusted_appropriately",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_registration_after_permit",
    "desc": "依規定辦理許可登記後，應依法向公司登記主管機關辦理登記",
    "expr": [
      "EQ",
      "agent_registration_after_permit",
      [
        "AND",
        [
          "EQ",
          "permit_registration_done",
          true
        ],
        [
          "EQ",
          "company_registration_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_no_multiple_employment",
    "desc": "個人執業代理人及受代理人公司或銀行任用代理人不得同時受任於其他代理人公司、保險經紀人公司、公證人公司或銀行",
    "expr": [
      "EQ",
      "agent_no_multiple_employment",
      [
        "NOT",
        [
          "EQ",
          "agent_employed_multiple_places",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_contract_must_include_required_items",
    "desc": "保險代理合約內容至少應包括主管機關規定之各項目",
    "expr": [
      "EQ",
      "agent_contract_content_ok",
      [
        "EQ",
        "contract_includes_required_items",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management_rules",
    "desc": "違反管理規則中財務或業務管理規定、保險經紀人義務或相關準用規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rules",
          true
        ],
        [
          "EQ",
          "violate_business_management_rules",
          true
        ],
        [
          "EQ",
          "violate_broker_duties",
          true
        ],
        [
          "EQ",
          "violate_related_provisions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反財務或業務管理規定、保險經紀人義務或相關準用規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "EQ",
        "violation_financial_or_business_management_rules",
        true
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]