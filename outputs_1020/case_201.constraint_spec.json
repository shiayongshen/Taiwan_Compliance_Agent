[
  {
    "id": "insurance:capital_level",
    "desc": "保險業資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "capital_adequacy_ratio",
                100.0
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  100.0
                ],
                100.0
              ],
              50.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  100.0
                ],
                100.0
              ],
              150.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev1",
                  100.0
                ],
                100.0
              ],
              3.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev2",
                  100.0
                ],
                100.0
              ],
              3.0
            ],
            [
              "OR",
              [
                "GE",
                [
                  "MUL",
                  [
                    "DIV",
                    "net_worth_ratio_prev1",
                    100.0
                  ],
                  100.0
                ],
                2.0
              ],
              [
                "GE",
                [
                  "MUL",
                  [
                    "DIV",
                    "net_worth_ratio_prev2",
                    100.0
                  ],
                  100.0
                ],
                2.0
              ]
            ]
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  100.0
                ],
                100.0
              ],
              150.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  100.0
                ],
                100.0
              ],
              200.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev1",
                  100.0
                ],
                100.0
              ],
              2.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev2",
                  100.0
                ],
                100.0
              ],
              2.0
            ],
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev1",
                  100.0
                ],
                100.0
              ],
              0.0
            ]
          ]
        ],
        2,
        [
          "GE",
          [
            "MUL",
            [
              "DIV",
              "capital_adequacy_ratio",
              100.0
            ],
            100.0
          ],
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:serious_insufficient_and_no_improvement",
    "desc": "資本嚴重不足且未依主管機關規定期限完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "serious_insufficient_and_no_improvement",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "NOT",
          [
            "OR",
            [
              "EQ",
              "capital_increase_completed",
              true
            ],
            [
              "EQ",
              "financial_improvement_plan_completed",
              true
            ],
            [
              "EQ",
              "business_improvement_plan_completed",
              true
            ],
            [
              "EQ",
              "merger_completed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:financial_or_business_deterioration",
    "desc": "財務或業務狀況顯著惡化且不能支付債務或履行契約責任或有損及被保險人權益之虞",
    "expr": [
      "EQ",
      "financial_or_business_deterioration",
      [
        "OR",
        [
          "EQ",
          "financial_or_business_deterioration_flag",
          true
        ],
        [
          "EQ",
          "unable_to_pay_debt",
          true
        ],
        [
          "EQ",
          "unable_to_fulfill_contract",
          true
        ],
        [
          "EQ",
          "risk_to_insured_interest",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_required_and_approved",
    "desc": "主管機關已核定財務或業務改善計畫",
    "expr": [
      "EQ",
      "improvement_plan_approved",
      [
        "EQ",
        "improvement_plan_submitted_and_approved",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:accelerated_deterioration_and_no_improvement",
    "desc": "損益、淨值加速惡化且經輔導仍未改善",
    "expr": [
      "EQ",
      "accelerated_deterioration_and_no_improvement",
      [
        "AND",
        [
          "EQ",
          "accelerated_deterioration",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "improvement_plan_effective",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_applicable",
    "desc": "應依情節輕重為監管、接管、勒令停業清理或命令解散之處分",
    "expr": [
      "EQ",
      "supervisory_measures_applicable",
      [
        "OR",
        [
          "EQ",
          "serious_insufficient_and_no_improvement",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "financial_or_business_deterioration",
            true
          ],
          [
            "EQ",
            "improvement_plan_approved",
            true
          ],
          [
            "EQ",
            "accelerated_deterioration_and_no_improvement",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_148_1_violation",
    "desc": "違反第一百四十八條之一第一項或第二項規定",
    "expr": [
      "EQ",
      "penalty_148_1_violation",
      [
        "EQ",
        "violate_148_1",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_148_2_1_violation",
    "desc": "違反第一百四十八條之二第一項規定，未提供或提供不實說明文件",
    "expr": [
      "EQ",
      "penalty_148_2_1_violation",
      [
        "EQ",
        "violate_148_2_1",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_148_2_2_violation",
    "desc": "違反第一百四十八條之二第二項規定，未依限報告或公開說明或內容不實",
    "expr": [
      "EQ",
      "penalty_148_2_2_violation",
      [
        "EQ",
        "violate_148_2_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_148_3_1_violation",
    "desc": "違反第一百四十八條之三第一項規定，未建立或未執行內部控制或稽核制度",
    "expr": [
      "EQ",
      "penalty_148_3_1_violation",
      [
        "EQ",
        "violate_148_3_1",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_148_3_2_violation",
    "desc": "違反第一百四十八條之三第二項規定，未建立或未執行內部處理制度或程序",
    "expr": [
      "EQ",
      "penalty_148_3_2_violation",
      [
        "EQ",
        "violate_148_3_2",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "penalty_148_1_violation",
          true
        ],
        [
          "EQ",
          "penalty_148_2_1_violation",
          true
        ],
        [
          "EQ",
          "penalty_148_2_2_violation",
          true
        ],
        [
          "EQ",
          "penalty_148_3_1_violation",
          true
        ],
        [
          "EQ",
          "penalty_148_3_2_violation",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]