    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_contract_must_include_required_items",
    "desc": "保險代理合約內容應包括主管機關規定之各項必要事項",
    "expr": [
      "EQ",
      "agent_contract_must_include_required_items",
      [
        "AND",
        [
          "EQ",
          "contract_party_names_included",
          true
        ],
        [
          "EQ",
          "contract_period_included",
          true
        ],
        [
          "EQ",
          "contract_authority_scope_included",
          true
        ],
        [
          "EQ",
          "commission_payment_standard_included",
          true
        ],
        [
          "EQ",
          "commission_payment_method_included",
          true
        ],
        [
          "EQ",
          "legal_compliance_clause_included",
          true
