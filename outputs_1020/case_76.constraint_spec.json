  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險投保、管理規則、善良管理義務、禁止行為或合約規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "agent_broker_license_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_policy_type_correct",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_broker_qualification_conditions",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_permitted_to_operate_agent_or_broker",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fidelity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_must_provide_written_analysis_report",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_duty_of_care_and_information_disclosure",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_must_obtain_contact_info_for_e_policy",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_company_and_bank_internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_prohibited_behaviors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "agent_contract_must_include_required_items",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
