[
  {
    "id": "insurance:agent_broker_license_required",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可並繳存保證金及投保相關保險",
    "expr": [
      "EQ",
      "agent_broker_license_required",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "deposit_guarantee",
          "minimum_guarantee_amount"
        ],
        [
          "EQ",
          "insurance_policy_subscribed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_policy_type_correct",
    "desc": "保險代理人、公證人投保責任保險；保險經紀人投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_policy_type_correct",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_policy_responsibility",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance_policy_guarantee",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "EQ",
            "insurance_policy_responsibility",
            true
          ],
          [
            "EQ",
            "insurance_policy_guarantee",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_policy_responsibility",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance_policy_guarantee",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_broker_qualification_conditions",
    "desc": "保險代理人、經紀人、公證人資格取得、申請許可及管理規則遵守",
    "expr": [
      "EQ",
      "agent_broker_qualification_conditions",
      [
        "AND",
        [
          "EQ",
          "qualification_conditions_met",
          true
        ],
        [
          "EQ",
          "application_procedure_followed",
          true
        ],
        [
          "EQ",
          "required_documents_submitted",
          true
        ],
        [
          "EQ",
          "board_and_manager_qualifications_met",
          true
        ],
        [
          "EQ",
          "dismissal_reasons_complied",
          true
        ],
        [
          "EQ",
          "branch_establishment_conditions_met",
          true
        ],
        [
          "EQ",
          "financial_and_business_management_compliant",
          true
        ],
        [
          "EQ",
          "education_and_training_completed",
          true
        ],
        [
          "EQ",
          "license_revocation_procedures_followed",
          true
        ],
        [
          "EQ",
          "other_compliance_matters_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:bank_permitted_to_operate_agent_or_broker",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "bank_permitted_to_operate_agent_or_broker",
      [
        "AND",
        [
          "EQ",
          "bank_license_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_broker",
            true
          ]
        ],
        [
          "EQ",
          "agent_broker_regulations_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務及忠實義務為被保險人洽訂保險契約或提供服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_observed",
          true
        ],
        [
          "EQ",
          "duty_of_fidelity_observed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_must_provide_written_analysis_report",
    "desc": "保險經紀人於洽訂保險契約前應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_must_provide_written_analysis_report",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "broker_receives_compensation",
            true
          ],
          [
            "EQ",
            "compensation_standard_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management",
    "desc": "違反財務或業務管理規定應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management",
          true
        ],
        [
          "EQ",
          "violate_business_management",
          true
        ],
        [
          "EQ",
          "violate_related_regulations",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_duty_of_care_and_information_disclosure",
    "desc": "代理人應盡善良管理人注意義務，向要保人說明保險商品主要內容與重要權利義務，並留存相關文件",
    "expr": [
      "EQ",
      "agent_duty_of_care_and_information_disclosure",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_observed",
          true
        ],
        [
          "EQ",
          "main_content_disclosed",
          true
        ],
        [
          "EQ",
          "important_rights_obligations_disclosed",
          true
        ],
        [
          "EQ",
          "documents_retained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_must_obtain_contact_info_for_e_policy",
    "desc": "電子保單出單時應取得要保人及被保險人聯絡方式並提供保險人",
    "expr": [
      "EQ",
      "agent_must_obtain_contact_info_for_e_policy",
      [
        "AND",
        [
          "EQ",
          "policy_issued_electronically",
          true
        ],
        [
          "EQ",
          "contact_info_obtained",
          true
        ],
        [
          "EQ",
          "contact_info_provided_to_insurer",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_company_and_bank_internal_operation_compliance",
    "desc": "代理人公司及銀行應訂定並落實內部作業規範，確保遵循相關法令及高齡消費者保障規定",
    "expr": [
      "EQ",
      "agent_company_and_bank_internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_operation_regulations_established",
          true
        ],
        [
          "EQ",
          "internal_operation_regulations_executed",
          true
        ],
        [
          "EQ",
          "compliance_with_laws_and_regulations",
          true
        ],
        [
          "EQ",
          "compliance_with_elderly_consumer_protection",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_prohibited_behaviors",
