[
  {
    "id": "insurance_agent:license_and_insurance_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_insurance_compliance",
      [
        "AND",
        [
          "EQ",
          "license_permitted",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "guarantee_deposit_minimum"
        ],
        [
          "EQ",
          "relevant_insurance_covered",
          true
        ],
        [
          "EQ",
          "practice_license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:relevant_insurance_type_compliance",
    "desc": "相關保險類型依身份區分：保險代理人、公證人為責任保險；保險經紀人為責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "agent_type",
            1
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            2
          ],
          [
            "OR",
            [
              "EQ",
              "insurance_type",
              1
            ],
            [
              "EQ",
              "insurance_type",
              2
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "agent_type",
            3
          ],
          [
            "EQ",
            "insurance_type",
            1
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:minimum_guarantee_and_insurance_amount_set_by_authority",
    "desc": "主管機關依經營業務範圍及規模定最低繳存保證金及投保相關保險金額",
    "expr": [
      "EQ",
      "minimum_guarantee_and_insurance_amount_set_by_authority",
      [
        "EQ",
        "minimum_guarantee_and_insurance_amount_set",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "insurance_agent:management_rules_compliance",
    "desc": "保險代理人、經紀人、公證人之資格取得、申請許可條件、程序、文件、董事監察人經理人資格、解任事由、分支機構條件、財務業務管理、教育訓練、廢止許可及其他應遵行事項依主管機關管理規則",
    "expr": [
      "EQ",
      "management_rules_compliance",
      [
        "EQ",
        "management_rules_complied",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance_agent"
  },
  {
    "id": "bank:insurance_agent_or_broker_permitted",
    "desc": "銀行經主管機關許可擇一兼營保險代理人或保險經紀人業務，並分別準用相關規定",
    "expr": [
      "EQ",
      "insurance_agent_or_broker_permitted",
      [
        "AND",
        [
          "EQ",
          "bank_permitted",
          true
        ],
        [
          "OR",
          [
            "EQ",
            "bank_operate_as_agent",
            true
          ],
          [
            "EQ",
            "bank_operate_as_broker",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "insurance_broker:duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人注意義務洽訂保險契約或提供服務，並負忠實義務",
    "expr": [
      "EQ",
      "duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "duty_of_care",
          true
        ],
        [
          "EQ",
          "duty_of_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:provide_written_analysis_report_and_disclose_fee",
    "desc": "保險經紀人洽訂保險契約前，於主管機關指定範圍內，主動提供書面分析報告，收取報酬者明確告知報酬標準",
    "expr": [
      "EQ",
      "provide_written_analysis_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:violation_financial_or_business_management_rules",
    "desc": "違反保險法第163條第四項管理規則中財務或業務管理規定、同條第七項規定，或違反第165條第一項或第163條第五項準用規定者，應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rule",
          true
        ],
        [
          "EQ",
          "violate_business_management_rule",
          true
        ],
        [
          "EQ",
          "violate_165_1_rule",
          true
        ],
        [
          "EQ",
          "violate_163_5_rule",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker_company:report_and_registration_compliance",
    "desc": "經紀人公司停業、復業、解散應依規定申請核准並辦理登記，停業期間一年內，正當理由得申請展延一次，未申請復業並任用經紀人者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "report_and_registration_compliance",
      [
        "AND",
        [
          "EQ",
          "report_to_authority",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "stop_business",
            true
          ],
          [
            "OR",
            [
              "LE",
              "stop_business_duration",
              365
            ],
            [
              "AND",
              [
                "EQ",
                "extension_requested",
                true
              ],
              [
                "LE",
                "extension_count",
                1
              ]
            ]
          ]
        ],
        [
          "IMPLIES",
          [
            "AND",
            [
              "EQ",
              "stop_business",
              true
            ],
            [
              "GT",
              "stop_business_duration",
              365
            ]
          ],
          [
            "EQ",
            "reopen_application_submitted",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "NOT",
            [
              "EQ",
              "reopen_application_submitted",
              true
            ]
          ],
          [
            "EQ",
            "license_revoked",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker_company"
  },
  {
    "id": "insurance_broker_company:license_cancellation_and_certificate_return",
    "desc": "經紀人公司申請停業應繳銷經紀人執業證照，申請解散應繳銷經紀人及公司執業證照，未繳銷者經紀人應於30日內委由公會辦理註銷登記",
    "expr": [
      "EQ",
      "license_cancellation_and_certificate_return",
      [
        "AND",
        [
          "IMPLIES",
          [
            "EQ",
            "stop_business_application_submitted",
            true
          ],
          [
            "EQ",
            "broker_license_returned",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "dissolution_application_submitted",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "broker_license_returned",
              true
            ],
            [
              "EQ",
              "company_license_returned",
              true
            ]
          ]
        ],
        [
          "IMPLIES",
          [
            "OR",
            [
              "EQ",
              "stop_business_not_returned",
              true
            ],
            [
              "EQ",
              "dissolution_not_returned",
              true
            ],
            [
              "EQ",
              "license_revoked",
              true
            ]
          ],
          [
            "EQ",
            "broker_cancellation_registered_within_30_days",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker_company"
  },
  {
    "id": "insurance_broker_company:business_operation_change_report",
    "desc": "同時經營保險經紀及再保險經紀業務之公司停止其中一業務，應於一個月內檢具董事會或股東會議事錄報主管機關備查",
    "expr": [
      "EQ",
      "business_operation_change_report",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "stop_insurance_brokerage",
            true
          ],
          [
            "EQ",
            "stop_reinsurance_brokerage",
            true
          ]
        ],
        [
          "EQ",
          "board_resolution_reported_within_1_month",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker_company"
  },
  {
    "id": "insurance_broker:insurance_fee_collection_compliance",
    "desc": "個人執業經紀人、經紀人公司及銀行受要保人委託代收轉付保險費應直接總額解繳保險業，非本人被保險人及受益人名義票據須有聲明書",
    "expr": [
      "EQ",
      "insurance_fee_collection_compliance",
      [
        "AND",
        [
          "EQ",
          "insurance_fee_total_remitted",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "insurance_fee_payer_not_related",
            true
          ],
          [
            "EQ",
            "payer_declaration_provided",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:accounting_and_reporting_compliance",
    "desc": "個人執業經紀人、經紀人公司及銀行應專設帳簿記載業務收支，並於每年4/1至5/31彙報主管機關，主管機關得隨時檢查並要求限期報告，應確實辦理改善並持續追蹤覆查",
    "expr": [
      "EQ",
      "accounting_and_reporting_compliance",
      [
        "AND",
        [
          "EQ",
          "special_account_book_kept",
          true
        ],
        [
          "EQ",
          "annual_report_submitted",
          true
        ],
        [
          "EQ",
          "authority_inspection_complied",
          true
        ],
        [
          "EQ",
          "improvement_measures_implemented",
          true
        ],
        [
          "EQ",
          "improvement_followup_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "insurance_broker:prohibited_acts_compliance",
    "desc": "個人執業經紀人、經紀人公司、銀行及受任用經紀人不得有申領證照不實、洽訂未核准保險、隱匿重要事項、不當強迫或索取利益、不實宣傳、不當慫恿退保、挪用保險費、證照供他人使用、刑事宣告、超範圍經營、不當收費、不法保險給付、擾亂金融秩序、授權他人經營、未經同意轉報要保文件、聘用無資格人員、未依期限繳銷證照、擅自停業或解散、未依規定任用經紀人、未報備、未經同意使用廣告、佣酬支付不當、未確認適合度、銷售未許可商品、報表不實、其他違規及損保險形象行為",
    "expr": [
      "EQ",
      "prohibited_acts_compliance",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "act_false_license_application",
            true
          ],
          [
            "EQ",
            "act_contract_with_unapproved_insurer",
            true
          ],
          [
            "EQ",
            "act_hide_important_contract_info",
            true
          ],
          [
            "EQ",
            "act_force_or_induce_unfairly",
            true
          ],
          [
            "EQ",
            "act_false_advertisement",
            true
          ],
          [
            "EQ",
            "act_induce_policy_surrender_or_loan",
            true
          ],
          [
            "EQ",
            "act_misappropriate_insurance_funds",
            true
          ],
          [
            "EQ",
            "act_unauthorized_use_of_license",
            true
          ],
          [
            "EQ",
            "act_criminal_conviction",
            true
          ],
          [
            "EQ",
            "act_out_of_scope_business",
            true
          ],
          [
            "EQ",
            "act_illegal_fee_collection",
            true
          ],
          [
            "EQ",
            "act_illegal_insurance_payment",
            true
          ],
          [
            "EQ",
            "act_disturb_financial_order",
            true
          ],
          [
            "EQ",
            "act_authorize_others_to_operate",
            true
          ],
          [
            "EQ",
            "act_transfer_application_documents_without_consent",
            true
          ],
          [
            "EQ",
            "act_employ_unqualified_personnel",
            true
          ],
          [
            "EQ",
            "act_fail_to_cancel_license_in_time",
            true
          ],
          [
            "EQ",
            "act_unauthorized_suspension_or_dissolution",
            true
          ],
          [
            "EQ",
            "act_fail_to_appoint_broker_according_to_regulation",
            true
          ],
          [
            "EQ",
            "act_fail_to_report_to_broker_association",
            true
          ],
          [
            "EQ",
            "act_use_advertisement_without_consent",
            true
          ],
          [
            "EQ",
            "act_improper_commission_payment",
            true
          ],
          [
            "EQ",
            "act_fail_to_confirm_suitability",
            true
          ],
          [
            "EQ",
            "act_sell_unapproved_foreign_policy_discount_benefit",
            true
          ],
          [
            "EQ",
            "act_false_or_incomplete_report",
            true
          ],
          [
            "EQ",
            "act_other_violations",
            true
          ],
          [
            "EQ",
            "act_damage_insurance_image",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance_broker"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "AND",
        [
          "EQ",
          "license_and_insurance_compliance",
          true
        ],
        [
          "EQ",
          "relevant_insurance_type_compliance",
          true
        ],
        [
          "EQ",
          "minimum_guarantee_and_insurance_amount_set_by_authority",
          true
        ],
        [
          "EQ",
          "management_rules_compliance",
          true
        ],
        [
          "EQ",
          "insurance_agent_or_broker_permitted",
          true
        ],
        [
          "EQ",
          "duty_of_care_and_fidelity",
          true
        ],
        [
          "EQ",
          "provide_written_analysis_report_and_disclose_fee",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_financial_or_business_management_rules",
            true
          ]
        ],
        [
          "EQ",
          "report_and_registration_compliance",
          true
        ],
        [
          "EQ",
          "license_cancellation_and_certificate_return",
          true
        ],
        [
          "EQ",
          "business_operation_change_report",
          true
        ],
        [
          "EQ",
          "insurance_fee_collection_compliance",
          true
        ],
        [
          "EQ",
          "accounting_and_reporting_compliance",
          true
        ],
        [
          "EQ",
          "prohibited_acts_compliance",
          true
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險投保、執業證照、管理規則、財務或業務管理規定，或有禁止行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_and_insurance_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "relevant_insurance_type_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "minimum_guarantee_and_insurance_amount_set_by_authority",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "management_rules_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_agent_or_broker_permitted",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "duty_of_care_and_fidelity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "provide_written_analysis_report_and_disclose_fee",
            true
          ]
        ],
        [
          "EQ",
          "violation_financial_or_business_management_rules",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "report_and_registration_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "license_cancellation_and_certificate_return",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "business_operation_change_report",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "insurance_fee_collection_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "accounting_and_reporting_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_acts_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
