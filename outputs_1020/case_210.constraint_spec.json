[
  {
    "id": "bank:permission_required_for_money_market_or_credit_card",
    "desc": "經營貨幣市場業務或信用卡業務須經中央主管機關許可",
    "expr": [
      "EQ",
      "permission_required_for_money_market_or_credit_card",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "engage_money_market_business",
            true
          ],
          [
            "EQ",
            "engage_credit_card_business",
            true
          ]
        ],
        [
          "EQ",
          "central_authority_permission_granted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cash_card_and_credit_card_interest_rate_limit",
    "desc": "現金卡利率及信用卡循環信用利率不得超過年利率15%",
    "expr": [
      "EQ",
      "cash_card_and_credit_card_interest_rate_limit",
      [
        "AND",
        [
          "LE",
          "cash_card_interest_rate_annual_percent",
          15.0
        ],
        [
          "LE",
          "credit_card_revolving_credit_interest_rate_annual_percent",
          15.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "credit_card:disclosure_requirements",
    "desc": "發卡機構應以書面或電子文件告知申請人規定事項",
    "expr": [
      "EQ",
      "disclosure_requirements",
      [
        "AND",
        [
          "EQ",
          "disclosed_annual_fee",
          true
        ],
        [
          "EQ",
          "disclosed_fees_and_charges",
          true
        ],
        [
          "EQ",
          "disclosed_revolving_credit_rate_and_interest",
          true
        ],
        [
          "EQ",
          "disclosed_default_penalty_calculation",
          true
        ],
        [
          "EQ",
          "disclosed_usage_and_loss_handling",
          true
        ],
        [
          "EQ",
          "disclosed_cardholder_rights_and_obligations",
          true
        ],
        [
          "EQ",
          "disclosed_dispute_handling_procedures",
          true
        ],
        [
          "EQ",
          "disclosed_benefits_and_conditions",
          true
        ],
        [
          "EQ",
          "disclosed_other_regulatory_matters",
          true
        ],
        [
          "EQ",
          "disclosure_plain_and_prominent",
          true
        ],
        [
          "EQ",
          "contract_specifies_adjustment_frequency_for_fee_and_benefits",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:interest_calculation_rules",
    "desc": "信用卡循環信用計息方式符合規定",
    "expr": [
      "EQ",
      "interest_calculation_rules",
      [
        "AND",
        [
          "EQ",
          "no_compound_interest",
          true
        ],
        [
          "EQ",
          "interest_start_date_not_before_actual_disbursement",
          true
        ],
        [
          "EQ",
          "comply_with_standard_contract_provisions",
          true
        ],
        [
          "EQ",
          "fees_not_included_in_revolving_principal",
          true
        ],
        [
          "EQ",
          "current_consumption_not_included_in_current_principal",
          true
        ],
        [
          "EQ",
          "principal_of_interest_included_accounts_comply_with_regulations",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:default_penalty_collection_method_compliance",
    "desc": "違約金收取方式符合主管機關規定",
    "expr": [
      "EQ",
      "default_penalty_collection_method_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "default_penalty_charged",
          true
        ],
        [
          "EQ",
          "default_penalty_collection_method_complies",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反銀行法及信用卡業務管理辦法相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "OR",
            [
              "EQ",
              "engage_money_market_business",
              true
            ],
            [
              "EQ",
              "engage_credit_card_business",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "central_authority_permission_granted",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "LE",
            "cash_card_interest_rate_annual_percent",
            15.0
          ]
        ],
        [
          "NOT",
          [
            "LE",
            "credit_card_revolving_credit_interest_rate_annual_percent",
            15.0
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "disclosure_requirements",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "interest_calculation_rules",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "default_penalty_charged",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "default_penalty_collection_method_complies",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]