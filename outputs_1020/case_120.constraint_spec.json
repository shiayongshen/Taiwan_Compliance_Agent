          true
        ],
        [
          "EQ",
          "not_proactively_public_explanation",
          true
        ],
        [
          "EQ",
          "report_or_public_explanation_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
