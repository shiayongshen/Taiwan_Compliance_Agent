          true
        ],
        [
          "EQ",
          "explanation_documents_not_according_to_regulations",
          true
        ],
        [
          "EQ",
          "explanation_documents_false",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_148_2_2",
