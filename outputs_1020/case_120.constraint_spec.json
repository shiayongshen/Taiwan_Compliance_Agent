  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反相關條文規定或資本不足且未執行對應措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_148_1_2",
          true
        ],
        [
          "EQ",
          "violation_148_2_1",
          true
        ],
        [
          "EQ",
          "violation_148_2_2",
          true
        ],
        [
          "EQ",
          "violation_148_3_1",
          true
        ],
        [
          "EQ",
          "violation_148_3_2",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_severely_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_significantly_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_insufficient_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
