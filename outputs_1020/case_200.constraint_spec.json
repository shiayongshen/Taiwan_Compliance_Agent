  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反相關法令規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_148_1_2",
          true
        ],
        [
          "EQ",
          "violation_148_2_1",
          true
        ],
        [
          "EQ",
          "violation_148_2_2",
          true
        ],
        [
          "EQ",
          "violation_148_3_1",
          true
        ],
        [
          "EQ",
          "violation_148_3_2",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level_final",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "improvement_plan_completed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
