  },
  {
    "id": "bank:high_net_worth_investor_criteria_met",
    "desc": "符合高淨值投資法人資格條件",
    "expr": [
      "EQ",
      "high_net_worth_investor_criteria_met",
      [
        "AND",
        [
          "GE",
          "latest_financial_report_net_assets",
          20000000000.0
        ],
        [
          "EQ",
          "has_investment_unit_with_qualified_personnel",
          true
        ],
        [
          "OR",
          [
            "GE",
            "unit_head_financial_experience_years",
            3
          ],
          [
            "GE",
            "unit_head_financial_investment_experience_years",
            4
          ],
          [
            "EQ",
            "unit_head_other_qualified_experience",
            true
          ]
        ],
        [
          "GE",
          "latest_financial_report_securities_or_derivative_investment",
          1000000000.0
        ],
        [
          "EQ",
          "internal_control_has_appropriate_investment_procedure_and_risk_management",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_corporate_criteria_met",
    "desc": "法人專業客戶資格條件符合",
    "expr": [
      "EQ",
      "professional_customer_corporate_criteria_met",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "is_corporate",
            true
          ],
          [
            "EQ",
            "meets_conditions_for_professional_customer",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_subsidiary_100_percent_owned",
            true
          ],
          [
            "EQ",
            "parent_meets_conditions_for_professional_customer",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_foreign_corporate_branch",
            true
          ],
          [
            "EQ",
            "meets_conditions_for_professional_customer",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_corporate_conditions_met",
    "desc": "法人專業客戶條件符合",
    "expr": [
      "EQ",
      "professional_customer_corporate_conditions_met",
      [
        "AND",
        [
          "GE",
          "latest_financial_report_total_assets",
          100000000.0
        ],
        [
          "EQ",
          "authorized_trading_person_has_financial_expertise",
          true
        ],
        [
          "EQ",
          "customer_understands_liability_exemption_and_signed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_individual_conditions_met",
    "desc": "自然人專業客戶條件符合",
    "expr": [
      "EQ",
      "professional_customer_individual_conditions_met",
      [
        "AND",
        [
          "OR",
          [
            "GE",
            "financial_proof_amount",
            30000000.0
          ],
          [
            "AND",
            [
              "GE",
              "single_transaction_amount",
              3000000.0
            ],
            [
              "GE",
              "total_assets_in_bank",
              15000000.0
            ],
            [
              "GE",
              "total_financial_assets",
              30000000.0
            ]
          ]
        ],
        [
          "EQ",
          "has_financial_expertise_and_experience",
          true
        ],
        [
          "EQ",
          "understands_liability_exemption_and_signed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_trust_conditions_met",
    "desc": "信託業委託人符合專業客戶條件",
    "expr": [
      "EQ",
      "professional_customer_trust_conditions_met",
      [
        "EQ",
        "trust_principal_meets_professional_customer_conditions",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_annual_review_done",
    "desc": "每年辦理一次覆審檢視專業客戶資格",
    "expr": [
      "EQ",
      "professional_customer_annual_review_done",
      [
        "OR",
        [
          "EQ",
          "customer_is_listed_company",
          true
        ],
        [
          "EQ",
          "annual_review_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:professional_customer_knowledge_assessment_reported",
    "desc": "非專業機構投資人之專業客戶金融商品專業知識評估納入瞭解客戶程序並報董(理)事會通過",
    "expr": [
      "EQ",
      "professional_customer_knowledge_assessment_reported",
      [
        "AND",
        [
          "EQ",
          "knowledge_assessment_included_in_customer_understanding_procedure",
          true
        ],
        [
          "EQ",
          "reported_to_board_of_directors",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未依規定建立或執行內部控制、內部處理、內部作業制度及程序時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_operation_ok",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
