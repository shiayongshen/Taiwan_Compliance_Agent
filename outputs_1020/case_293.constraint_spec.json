  {
    "id": "bank:derivative_product_suitability_established",
    "desc": "建立衍生性金融商品適合度制度",
    "expr": [
      "EQ",
      "derivative_product_suitability_established",
      [
        "EQ",
        "derivative_product_suitability_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_product_suitability_content_ok",
    "desc": "衍生性金融商品適合度制度內容符合規定",
    "expr": [
      "EQ",
      "derivative_product_suitability_content_ok",
      [
        "AND",
        [
          "EQ",
          "derivative_product_attribute_assessed",
          true
        ],
        [
          "EQ",
          "customer_understanding_procedure_established",
          true
        ],
        [
          "EQ",
          "customer_attribute_assessed",
          true
        ],
        [
          "EQ",
          "customer_and_product_grading_basis_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_product_customer_reviewed",
    "desc": "客戶屬性評估及分級結果覆核且每年檢視並確認",
    "expr": [
      "EQ",
      "derivative_product_customer_reviewed",
      [
        "AND",
        [
          "EQ",
          "customer_attribute_reviewed_by_appropriate_unit",
          true
        ],
        [
          "EQ",
          "customer_attribute_reviewed_at_least_annually",
          true
        ],
        [
          "EQ",
          "customer_confirmation_obtained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_product_customer_review_updated",
    "desc": "客戶屬性評估及分級結果修正時須確認",
    "expr": [
      "EQ",
      "derivative_product_customer_review_updated",
      [
        "EQ",
        "customer_confirmation_obtained_on_update",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_product_not_exceed_suitability",
    "desc": "不得向一般客戶提供超過其適合等級之衍生性金融商品交易服務",
    "expr": [
      "EQ",
      "derivative_product_not_exceed_suitability",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "customer_is_general",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "customer_is_general",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "transaction_is_non_structured_and_hedging_purpose",
              true
            ],
            [
              "LE",
              "product_level",
              "customer_suitability_level"
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_qualification_ok",
    "desc": "內部稽核人員資格條件符合規定",
    "expr": [
      "EQ",
      "internal_audit_staff_qualification_ok",
      [
        "AND",
        [
          "OR",
          [
            "GE",
            "internal_audit_staff_financial_inspection_experience_years",
            2
          ],
          [
            "AND",
            [
              "EQ",
              "internal_audit_staff_college_graduate",
              true
            ],
            [
              "OR",
              [
                "EQ",
                "internal_audit_staff_pass_high_exam",
                true
              ],
              [
                "EQ",
                "internal_audit_staff_pass_cia_exam",
                true
              ]
            ],
            [
              "GE",
              "internal_audit_staff_financial_experience_years",
              2
            ]
          ],
          [
            "GE",
            "internal_audit_staff_financial_experience_years",
            5
          ]
        ],
        [
          "LE",
          "internal_audit_staff_accountant_or_programmer_or_analyst_years",
          2
        ],
        [
          "EQ",
          "internal_audit_staff_training_months",
          true
        ],
        [
          "LE",
          "internal_audit_staff_accountant_or_programmer_or_analyst_ratio",
          0.3333333333
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_no_major_demerit",
    "desc": "內部稽核人員最近三年內無記過以上不良紀錄",
    "expr": [
      "EQ",
      "internal_audit_staff_no_major_demerit",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_audit_staff_major_demerit_record",
            true
          ]
        ],
        [
          "EQ",
          "internal_audit_staff_demerit_due_to_others_offset",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_leader_experience_ok",
    "desc": "內部稽核人員充任領隊資格符合規定",
    "expr": [
      "EQ",
      "internal_audit_staff_leader_experience_ok",
      [
        "OR",
        [
          "GE",
          "internal_audit_staff_leader_audit_or_inspection_experience_years",
          3
        ],
        [
          "AND",
          [
            "GE",
            "internal_audit_staff_leader_audit_experience_years",
            1
          ],
          [
            "GE",
            "internal_audit_staff_leader_financial_experience_years",
            5
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_qualification_compliance",
    "desc": "內部稽核人員資格條件符合且無不良紀錄且領隊資格符合",
    "expr": [
      "EQ",
      "internal_audit_staff_qualification_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_audit_staff_qualification_ok",
          true
        ],
        [
          "EQ",
          "internal_audit_staff_no_major_demerit",
          true
        ],
        [
          "EQ",
          "internal_audit_staff_leader_experience_ok",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_foreign_unit_qualification_ok",
    "desc": "國外營業單位內部稽核人員資格符合當地法令及主管機關要求",
    "expr": [
      "EQ",
      "internal_audit_staff_foreign_unit_qualification_ok",
      [
        "OR",
        [
          "EQ",
          "foreign_internal_audit_staff_meet_local_regulations",
          true
        ],
        [
          "AND",
          [
            "NOT",
            [
              "EQ",
              "foreign_internal_audit_staff_meet_local_regulations",
              true
            ]
          ],
          [
            "EQ",
            "board_approved_selection_method_used",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_audit_staff_duty_adjusted_if_violation",
    "desc": "內部稽核人員違反規定逾期未改善應立即調整職務",
    "expr": [
      "EQ",
      "internal_audit_staff_duty_adjusted_if_violation",
      [
        "IMPLIES",
        [
          "AND",
          [
            "EQ",
            "internal_audit_staff_violation_found",
            true
          ],
          [
            "GT",
            "violation_discovery_days",
            60
          ],
          [
            "NOT",
            [
              "EQ",
              "internal_audit_staff_duty_adjusted",
              true
            ]
          ]
        ],
        false
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
