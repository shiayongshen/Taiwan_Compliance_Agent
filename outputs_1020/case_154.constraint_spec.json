[
  {
    "id": "insurance:violation_management_rules",
    "desc": "違反第163條第4項管理規則中財務或業務管理規定、163條第7項規定，或違反165條第1項及163條第5項準用規定",
    "expr": [
      "EQ",
      "violation_management_rules",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rule",
          true
        ],
        [
          "EQ",
          "violate_business_management_rule",
          true
        ],
        [
          "EQ",
          "violate_article_163_7",
          true
        ],
        [
          "EQ",
          "violate_article_165_1",
          true
        ],
        [
          "EQ",
          "violate_article_163_5_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:correction_ordered",
    "desc": "違反管理規則者已限期改正",
    "expr": [
      "EQ",
      "correction_ordered",
      [
        "EQ",
        "correction_deadline_issued",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:fine_imposed",
    "desc": "違反管理規則者處以新臺幣十萬元以上三百萬元以下罰鍰",
    "expr": [
      "EQ",
      "fine_imposed",
      [
        "AND",
        [
          "GE",
          "fine_amount",
          100000
        ],
        [
          "LE",
          "fine_amount",
          300000
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:license_revoked",
    "desc": "情節重大者廢止許可並註銷執業證照",
    "expr": [
      "EQ",
      "license_revoked",
      [
        "EQ",
        "serious_violation",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
