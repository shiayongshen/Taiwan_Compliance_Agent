[
  {
    "id": "insurance:fixed_office_and_account_book",
    "desc": "保險代理人、經紀人、公證人應有固定業務處所並專設帳簿記載業務收支",
    "expr": [
      "EQ",
      "fixed_office_and_account_book",
      [
        "AND",
        [
          "EQ",
          "has_fixed_office",
          true
        ],
        [
          "EQ",
          "has_dedicated_account_book",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_license_only",
    "desc": "兼有保險代理人、經紀人、公證人資格者僅得擇一申領執業證照",
    "expr": [
      "EQ",
      "single_license_only",
      [
        "LE",
        [
          "ADD",
          [
            "IF",
            [
              "EQ",
              "has_agent_license",
              true
            ],
            1,
            0
          ],
          [
            "IF",
            [
              "EQ",
              "has_broker_license",
              true
            ],
            1,
            0
          ],
          [
            "IF",
            [
              "EQ",
              "has_notary_license",
              true
            ],
            1,
            0
          ]
        ],
        1
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_required",
    "desc": "公開發行或具一定規模之保險代理人公司、經紀人公司應建立內部控制、稽核制度與招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_required",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "is_publicly_listed",
            true
          ],
          [
            "EQ",
            "has_certain_scale",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "audit_system_established",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_executed",
    "desc": "公開發行或具一定規模之保險代理人公司、經紀人公司應確實執行內部控制、稽核制度與招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "is_publicly_listed",
            true
          ],
          [
            "EQ",
            "has_certain_scale",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "internal_control_implemented",
            true
          ],
          [
            "EQ",
            "audit_system_implemented",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_implemented",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_compliance",
    "desc": "公開發行或具一定規模之保險代理人公司、經紀人公司內部控制、稽核制度與招攬處理制度建立且執行合規",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "OR",
        [
          "NOT",
          [
            "OR",
            [
              "EQ",
              "is_publicly_listed",
              true
            ],
            [
              "EQ",
              "has_certain_scale",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "audit_system_established",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ],
          [
            "EQ",
            "internal_control_implemented",
            true
          ],
          [
            "EQ",
            "audit_system_implemented",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_implemented",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:license_and_insurance_compliance",
    "desc": "保險代理人、經紀人、公證人應經主管機關許可，繳存保證金並投保相關保險，領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_insurance_compliance",
      [
        "AND",
        [
          "EQ",
          "has_government_license",
          true
        ],
        [
          "EQ",
          "has_deposit_guarantee",
          true
        ],
        [
          "EQ",
          "has_relevant_insurance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_compliance",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂保險契約並負忠實義務",
    "expr": [
      "EQ",
      "broker_duty_compliance",
      [
        "AND",
        [
          "EQ",
          "exercised_due_diligence",
          true
        ],
        [
          "EQ",
          "fulfilled_fiduciary_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_report_compliance",
    "desc": "保險經紀人於主管機關指定範圍內應主動提供書面分析報告並明確告知報酬收取標準",
    "expr": [
      "EQ",
      "broker_report_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "within_government_specified_scope",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "provided_written_analysis_report",
            true
          ],
          [
            "EQ",
            "clearly_informed_fee_standard",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反內部控制、稽核制度、招攬處理制度建立或執行規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "OR",
            [
              "EQ",
              "is_publicly_listed",
              true
            ],
            [
              "EQ",
              "has_certain_scale",
              true
            ]
          ],
          [
            "OR",
            [
              "NOT",
              [
                "EQ",
                "internal_control_established",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "audit_system_established",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "solicitation_handling_system_established",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "internal_control_implemented",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "audit_system_implemented",
                true
              ]
            ],
            [
              "NOT",
              [
                "EQ",
                "solicitation_handling_system_implemented",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]