[
  {
    "id": "insurance:insurance_broker_definition",
    "desc": "保險經紀人定義：基於被保險人利益洽訂保險契約或提供服務並收取佣金或報酬",
    "expr": [
      "EQ",
      "insurance_broker_definition",
      [
        "AND",
        [
          "EQ",
          "based_on_insured_interest",
          true
        ],
        [
          "EQ",
          "conclude_insurance_contract_or_provide_service",
          true
        ],
        [
          "EQ",
          "receive_commission_or_fee",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可、繳存保證金、投保相關保險並領有執業證照",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_purchased",
          true
        ],
        [
          "EQ",
          "license_issued",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_broker_insurance_types",
    "desc": "保險經紀人須投保責任保險及保證保險",
    "expr": [
      "EQ",
      "insurance_broker_insurance_types",
      [
        "AND",
        [
          "EQ",
          "liability_insurance_purchased",
          true
        ],
        [
          "EQ",
          "guarantee_insurance_purchased",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_broker_duties",
    "desc": "保險經紀人應以善良管理人注意義務為被保險人洽訂契約並負忠實義務",
    "expr": [
      "EQ",
      "insurance_broker_duties",
      [
        "AND",
        [
          "EQ",
          "duty_of_care_exercised",
          true
        ],
        [
          "EQ",
          "faithful_duty_performed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_broker_report_and_fee_disclosure",
    "desc": "保險經紀人於主管機關指定範圍內應主動提供書面分析報告並明確告知報酬標準",
    "expr": [
      "EQ",
      "insurance_broker_report_and_fee_disclosure",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "EQ",
          "fee_disclosure_made",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_financial_or_business_management",
    "desc": "違反財務或業務管理規定應限期改正或處罰",
    "expr": [
      "EQ",
      "violation_financial_or_business_management",
      [
        "OR",
        [
          "EQ",
          "violate_financial_management_rules",
          true
        ],
        [
          "EQ",
          "violate_business_management_rules",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_violation_financial_or_business_management",
    "desc": "違反財務或業務管理規定且未限期改正時處罰",
    "expr": [
      "EQ",
      "penalty_violation_financial_or_business_management",
      [
        "AND",
        [
          "EQ",
          "violation_financial_or_business_management",
          true
        ],
        [
          "NOT",
