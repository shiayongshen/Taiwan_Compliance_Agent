[
  {
    "id": "insurance:internal_control_approved",
    "desc": "內部控制、稽核制度與招攬處理制度經董（理）事會通過",
    "expr": [
      "EQ",
      "internal_control_approved",
      [
        "EQ",
        "board_of_directors_approval",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_opposition_recorded",
    "desc": "董（理）事有保留或反對意見且已記錄於會議紀錄並送監察人或審計委員會",
    "expr": [
      "EQ",
      "internal_control_opposition_recorded",
      [
        "AND",
        [
          "EQ",
          "board_opposition_exists",
          true
        ],
        [
          "EQ",
          "opposition_recorded_in_minutes",
          true
        ],
        [
          "EQ",
          "opposition_sent_to_supervisors_or_audit_committee",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:audit_committee_approval",
    "desc": "審計委員會全體成員二分之一以上同意內部控制、稽核制度與招攬處理制度",
    "expr": [
      "EQ",
      "audit_committee_approval",
      [
        "GE",
        "audit_committee_approval_ratio",
        0.5
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:board_resolution_after_audit_committee",
    "desc": "董（理）事會決議通過內部控制、稽核制度與招攬處理制度",
    "expr": [
      "EQ",
      "board_resolution_after_audit_committee",
      [
        "EQ",
        "board_of_directors_approval_after_audit_committee",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:board_resolution_two_thirds_without_audit_committee",
    "desc": "未經審計委員會同意時，董（理）事會三分之二以上同意並記錄決議",
    "expr": [
      "EQ",
      "board_resolution_two_thirds_without_audit_committee",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "audit_committee_approval",
            true
          ]
        ],
        [
          "GE",
          "board_of_directors_two_thirds_approval_ratio",
          0.6666667
        ],
        [
          "EQ",
          "board_resolution_recorded",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_valid",
    "desc": "內部控制、稽核制度與招攬處理制度有效且合法",
    "expr": [
      "EQ",
      "internal_control_valid",
      [
        "OR",
        [
          "EQ",
          "internal_control_approved",
          true
        ],
        "internal_control_opposition_recorded",
        "board_resolution_two_thirds_without_audit_committee"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_167_2",
    "desc": "違反保險法第167-2條相關財務或業務管理規定",
    "expr": [
      "EQ",
      "violation_167_2",
      [
        "EQ",
        "violate_financial_or_business_management_rules",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:violation_167_3",
    "desc": "違反保險法第167-3條未建立或未確實執行內部控制、稽核制度、招攬處理制度或程序",
    "expr": [
      "EQ",
      "violation_167_3",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "audit_system_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_system_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "solicitation_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:agent_broker_violation",
    "desc": "保險代理人、經紀人、公證人違反法令或有礙健全經營",
    "expr": [
      "EQ",
      "agent_broker_violation",
      [
        "EQ",
        "violate_law_or_impair_sound_operation",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反相關法令或未依規定建立執行內部控制等制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "agent_broker_violation",
          true
        ],
        [
          "EQ",
          "violation_167_2",
          true
        ],
        [
          "EQ",
          "violation_167_3",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  }
]