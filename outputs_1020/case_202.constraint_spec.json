    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:responsible_person_multiple_positions_limited",
    "desc": "金融控股公司負責人兼任職務應確保有效執行且無利益衝突",
    "expr": [
      "EQ",
      "responsible_person_multiple_positions_limited",
      [
        "AND",
        [
          "EQ",
          "responsible_person_multiple_positions_effective_execution",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "responsible_person_conflict_of_interest",
            true
          ]
        ],
        [
          "EQ",
          "group_management_checks_and_balances_ensured",
          true
        ],
        [
          "EQ",
          "shareholder_rights_protected",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融控股公司法及相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "investment_scope_compliance"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "approved_investment_business"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "investment_without_approval_prohibited"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "shares_without_approval_no_voting_right"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "authority_must_order_disposal_of_illegal_investment"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "exceed_business_or_investment_scope_must_adjust"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "responsible_person_cannot_be_manager_of_venture_invested_company"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "subsidiary_capital_reduction_must_apply_approval"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "internal_control_established_and_effective"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "overall_strategy_and_risk_management_planned"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "board_responsible_for_internal_control"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "internal_control_policy_and_procedures_defined_and_reviewed"
            ],
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            [
              "VAR",
              "responsible_person_multiple_positions_limited"
            ],
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]