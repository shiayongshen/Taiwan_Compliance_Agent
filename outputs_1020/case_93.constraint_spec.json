[
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "不動產投資總額除自用不動產外不得超過資金30%，自用不動產不得超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "total_funds",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_immediate_use_and_income",
    "desc": "不動產投資以即時利用並有收益者為限，住宅法社會住宅租賃除外",
    "expr": [
      "EQ",
      "real_estate_immediate_use_and_income",
      [
        "OR",
        [
          "EQ",
          "social_housing_for_rent_only",
          true
        ],
        [
          "EQ",
          "real_estate_immediate_use_and_income_flag",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_valuation_required",
    "desc": "不動產取得及處分應經合法鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_valuation_required",
      [
        "EQ",
        "real_estate_valuation_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_investment_compliance",
    "desc": "不動產投資符合條件限制、即時利用並有收益認定基準及處理原則",
    "expr": [
      "EQ",
      "real_estate_investment_compliance",
      [
        "EQ",
        "real_estate_investment_internal_procedure_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_4_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_4_measures_executed",
      [
        "EQ",
        "capital_level_4_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_3_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_3_measures_executed",
      [
        "EQ",
        "capital_level_3_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level_2_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "capital_level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:supervisory_measures_applicable",
    "desc": "主管機關得對資本嚴重不足且未完成改善計畫者為接管、勒令停業清理或解散處分",
    "expr": [
      "EQ",
      "supervisory_measures_applicable",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_4_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_3_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_2_measures_executed",
              true
            ]
          ]
        ],
        [
          "EQ",
          "financial_or_business_condition_deteriorated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_actions_without_supervisor_consent",
    "desc": "監管處分期間未經監管人同意不得超限支付款項、締結契約或其他重大財務事項",
    "expr": [
      "EQ",
      "prohibited_actions_without_supervisor_consent",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_payment_exceed_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_contract_commitment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "supervisor_consent_other_major_financial",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_securities_limit_35_percent",
    "desc": "第三款及第四款投資總額不得超過資金35%",
    "expr": [
      "EQ",
      "investment_securities_limit_35_percent",
      [
        "LE",
        [
          "ADD",
          "investment_third_item",
          "investment_fourth_item"
        ],
        [
          "MUL",
          "total_funds",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_conditions_prohibited_roles",
    "desc": "投資不得以保險業或代表人擔任被投資公司董事、監察人、行使表決權、指派經理人等角色",
    "expr": [
      "EQ",
      "investment_conditions_prohibited_roles",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_director",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_supervisor",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_voting_rights",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_manager_appointment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_trust_supervisor",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investor_or_representative_agreement_participation",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_compliance_conditions",
    "desc": "投資符合主管機關定之條件、範圍、內容及規範",
    "expr": [
      "EQ",
      "investment_compliance_conditions",
      [
        "EQ",
        "investment_conditions_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_owner_equity_investment_limit",
    "desc": "自用不動產投資總額不得超過業主權益總額",
    "expr": [
      "EQ",
      "capital_owner_equity_investment_limit",
      [
        "LE",
        "self_use_real_estate_investment",
        "owner_equity"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反不動產投資限制、鑑價、即時利用及收益認定、投資條件限制或資本不足且未執行改善措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_immediate_use_and_income",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_valuation_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_securities_limit_35_percent",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_conditions_prohibited_roles",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_compliance_conditions",
            true
          ]
        ],
        [
          "AND",
          [
            "OR",
            [
              "EQ",
              "capital_level",
              4
            ],
            [
              "EQ",
              "capital_level",
              3
            ],
            [
              "EQ",
              "capital_level",
              2
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_4_measures_executed",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_3_measures_executed",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_level_2_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]