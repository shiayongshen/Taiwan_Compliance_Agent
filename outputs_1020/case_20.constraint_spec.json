[
  {
    "id": "securities:fiduciary_duty_compliance",
    "desc": "證券投資信託事業等應以善良管理人注意義務及忠實義務執行業務",
    "expr": [
      "EQ",
      "fiduciary_duty_compliance",
      [
        "AND",
        [
          "EQ",
          "duty_of_care",
          true
        ],
        [
          "EQ",
          "duty_of_loyalty",
          true
        ],
        [
          "EQ",
          "good_faith_principle",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_compliance",
    "desc": "應保守受益人或客戶個人資料及交易資料秘密",
    "expr": [
      "EQ",
      "confidentiality_compliance",
      [
        "OR",
        [
          "EQ",
          "other_law_or_authority_exemption",
          true
        ],
        [
          "EQ",
          "confidentiality_maintained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_qualification_compliance",
    "desc": "人員資格條件及行為規範符合主管機關規定",
    "expr": [
      "EQ",
      "personnel_qualification_compliance",
      [
        "EQ",
        "personnel_qualification_meets_requirements",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_trading_compliance",
    "desc": "負責人及關係人不得從事禁止之公司股票及股權性質衍生商品交易",
    "expr": [
      "EQ",
      "prohibited_trading_compliance",
      [
        "OR",
        [
          "EQ",
          "regulatory_exemption",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_trading_occurred",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:trading_declaration_compliance",
    "desc": "負責人及關係人應依規定申報公司股票及股權性質衍生商品交易",
    "expr": [
      "EQ",
      "trading_declaration_compliance",
      [
        "EQ",
        "required_trading_declared",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_established",
    "desc": "證券投資信託事業已建立內部控制制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_executed",
    "desc": "證券投資信託事業依法令及內部控制制度經營業務",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "business_operated_according_to_internal_control",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_change_approved",
    "desc": "內部控制制度訂定或變更經董事會同意並留存備查",
    "expr": [
      "EQ",
      "internal_control_change_approved",
      [
        "AND",
        [
          "EQ",
          "internal_control_change_reported",
          true
        ],
        [
          "EQ",
          "board_approval_obtained",
          true
        ],
        [
          "EQ",
          "record_kept",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:internal_control_change_complied",
    "desc": "依本會通知限期內變更內部控制制度",
    "expr": [
      "EQ",
      "internal_control_change_complied",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "regulator_change_notification",
            true
          ]
        ],
        [
          "EQ",
          "internal_control_changed_within_deadline",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personal_trading_restriction_compliance",
    "desc": "負責人及關係人遵守個人交易限制規定",
    "expr": [
      "EQ",
      "personal_trading_restriction_compliance",
      [
        "EQ",
        "personal_trading_restrictions_followed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personal_trading_declaration_compliance",
    "desc": "負責人及關係人依規定申報個人交易",
    "expr": [
      "EQ",
      "personal_trading_declaration_compliance",
      [
        "EQ",
        "personal_trading_declared",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors_compliance",
    "desc": "負責人及業務人員未有違反善良管理人注意義務及忠實義務之禁止行為",
    "expr": [
      "EQ",
      "prohibited_behaviors_compliance",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "insider_trading_or_leakage",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "self_dealing_or_conflict_of_interest",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fraudulent_behavior",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_fee_handling",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "providing_undue_benefits",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "proxy_vote_for_benefit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "market_manipulation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_account_transfer",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "improper_public_recommendation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unreasonable_commission_payment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_agent_trading",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "other_harmful_behaviors",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_personnel_compliance",
    "desc": "負責人及業務人員對受益人或客戶資料保守秘密",
    "expr": [
      "EQ",
      "confidentiality_personnel_compliance",
      [
        "OR",
        [
          "EQ",
          "other_law_or_authority_exemption",
          true
        ],
        [
          "EQ",
          "personnel_confidentiality_maintained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_penalty_applicable",
    "desc": "違反本法或主管機關命令規定者，主管機關得依情節輕重處分",
    "expr": [
      "EQ",
      "violation_penalty_applicable",
      [
        "EQ",
        "law_or_order_violated",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:serious_violation_penalty_applicable",
    "desc": "董事、監察人、經理人或受僱人違反法令足以影響業務正常執行者，得命令停止業務或解除職務",
    "expr": [
      "EQ",
      "serious_violation_penalty_applicable",
      [
        "EQ",
        "serious_violation_occurred",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:penalty_fine_violation",
    "desc": "違反特定條文規定者處罰鍰並限期改善",
    "expr": [
      "EQ",
      "penalty_fine_violation",
      [
        "OR",
        [
          "EQ",
          "violate_article_3_4",
          true
        ],
        [
          "EQ",
          "violate_article_4_4",
          true
        ],
        [
          "EQ",
          "violate_article_14_1",
          true
        ],
        [
          "EQ",
          "violate_article_18_1",
          true
        ],
        [
          "EQ",
          "violate_article_56_1",
          true
        ],
        [
          "EQ",
          "violate_article_16_4",
          true
        ],
        [
          "EQ",
          "violate_article_16_1",
          true
        ],
        [
          "EQ",
          "violate_article_19_1",
          true
        ],
        [
          "EQ",
          "violate_article_51_1",
          true
        ],
        [
          "EQ",
          "violate_article_59",
          true
        ],
        [
          "EQ",
          "violate_article_58_2",
          true
        ],
        [
          "EQ",
          "violate_article_63_1",
          true
        ],
        [
          "EQ",
          "violate_article_69",
          true
        ],
        [
          "EQ",
          "violate_article_70",
          true
        ],
        [
          "EQ",
          "violate_article_72_1",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反善良管理人義務、保密義務、內部控制、交易申報、禁止交易或主管機關規定者處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "fiduciary_duty_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "confidentiality_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_qualification_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_trading_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "trading_declaration_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_change_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_change_complied",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personal_trading_restriction_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personal_trading_declaration_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_behaviors_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "confidentiality_personnel_compliance",
            true
          ]
        ],
        [
          "EQ",
          "penalty_fine_violation",
          true
        ],
        [
          "EQ",
          "violation_penalty_applicable",
          true
        ],
        [
          "EQ",
          "serious_violation_penalty_applicable",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]