[
  {
    "id": "securities_investment_advisory:business_types_approved",
    "desc": "證券投資顧問事業經營業務種類應報請主管機關核准",
    "expr": [
      "EQ",
      "business_types_approved",
      [
        "AND",
        [
          "EQ",
          "business_type_securities_advisory",
          true
        ],
        [
          "EQ",
          "business_type_discretionary_investment",
          true
        ],
        [
          "EQ",
          "business_type_other_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:change_approval_required",
    "desc": "證券投資顧問事業變更事項應先報請本會核准",
    "expr": [
      "EQ",
      "change_approval_required",
      [
        "OR",
        [
          "EQ",
          "change_company_name",
          true
        ],
        [
          "EQ",
          "change_capital",
          true
        ],
        [
          "EQ",
          "change_business_items",
          true
        ],
        [
          "EQ",
          "change_office_location",
          true
        ],
        [
          "EQ",
          "transfer_major_business_or_assets",
          true
        ],
        [
          "EQ",
          "dissolution_or_merger",
          true
        ],
        [
          "EQ",
          "suspension_reinstatement_closure",
          true
        ],
        [
          "EQ",
          "other_approval_matters",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:suspension_limit",
    "desc": "停業申請以一次為限且停業期間不得超過一年",
    "expr": [
      "EQ",
      "suspension_limit_ok",
      [
        "AND",
        [
          "LE",
          "suspension_application_count",
          1
        ],
        [
          "LE",
          "suspension_period_months",
          12
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:suspension_permit_revoked_if_no_reinstatement",
    "desc": "停業屆期未申請復業或申請復業未獲核准者，廢止營業許可",
    "expr": [
      "EQ",
      "suspension_permit_revoked",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "suspension_period_expired",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "reinstatement_applied",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "reinstatement_applied",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "reinstatement_approved",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:unauthorized_suspension_revokes_permit",
    "desc": "未依規定申請停業而自行停業連續三個月以上者，廢止營業許可",
    "expr": [
      "EQ",
      "unauthorized_suspension_revokes_permit",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "suspension_applied",
            true
          ]
        ],
        [
          "GE",
          "unauthorized_suspension_months",
          3
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:fund_usage_restriction",
    "desc": "資金運用限制符合規定",
    "expr": [
      "EQ",
      "fund_usage_restriction_ok",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "fund_loaned_to_others",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fund_used_for_non_operating_real_estate",
            true
          ]
        ],
        [
          "OR",
          [
            "EQ",
            "fund_used_for_domestic_bank_deposits",
            true
          ],
          [
            "EQ",
            "fund_used_for_government_bonds",
            true
          ],
          [
            "EQ",
            "fund_used_for_treasury_bills_or_commercial_papers",
            true
          ],
          [
            "EQ",
            "fund_used_for_approved_mutual_funds",
            true
          ],
          [
            "EQ",
            "fund_used_for_other_approved_uses",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:guarantee_and_collateral_restriction",
    "desc": "非符合公司法第十六條第一項規定且未經本會核准者，不得為保證、背書或提供擔保",
    "expr": [
      "EQ",
      "guarantee_and_collateral_restriction_ok",
      [
        "OR",
        [
          "EQ",
          "complies_company_law_article_16_1",
          true
        ],
        [
          "EQ",
          "approved_by_authority",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:personnel_registration_required",
    "desc": "總經理、部門主管、分支機構經理人及業務人員應專任且執行前須登錄",
    "expr": [
      "EQ",
      "personnel_registration_ok",
      [
        "AND",
        [
          "EQ",
          "personnel_full_time",
          true
        ],
        [
          "EQ",
          "personnel_registered_before_duty",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:personnel_registration_prohibited_conditions",
    "desc": "有特定情事者不得登錄，已登錄者應撤銷",
    "expr": [
      "EQ",
      "personnel_registration_prohibited",
      [
        "OR",
        [
          "EQ",
          "has_article_68_condition",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "meets_qualification_requirements",
            true
          ]
        ],
        [
          "EQ",
          "violates_article_7",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:company_registration_documents_complete",
    "desc": "公司設立登記及申請核發營業執照文件齊備且符合規定",
    "expr": [
      "EQ",
      "company_registration_documents_complete",
      [
        "AND",
        [
          "EQ",
          "company_registration_certificate",
          true
        ],
        [
          "EQ",
          "company_articles",
          true
        ],
        [
          "EQ",
          "business_rules",
          true
        ],
        [
          "EQ",
          "shareholders_register_and_minutes",
          true
        ],
        [
          "EQ",
          "directors_register_and_minutes",
          true
        ],
        [
          "EQ",
          "supervisors_register",
          true
        ],
        [
          "EQ",
          "qualified_personnel_list_and_certificates",
          true
        ],
        [
          "EQ",
          "full_time_declaration",
          true
        ],
        [
          "EQ",
          "no_article_68_conditions_declaration",
          true
        ],
        [
          "EQ",
          "business_office_documents",
          true
        ],
        [
          "EQ",
          "independent_office_declaration",
          true
        ],
        [
          "EQ",
          "business_guarantee_deposit_certificate",
          true
        ],
        [
          "EQ",
          "association_membership_certificate",
          true
        ],
        [
          "EQ",
          "no_false_or_concealment_declaration",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:registration_within_6_months",
    "desc": "應於許可日起六個月內完成公司設立登記及申請營業執照",
    "expr": [
      "EQ",
      "registration_within_6_months",
      [
        "AND",
        [
          "LE",
          "months_since_permit",
          6
        ],
        [
          "EQ",
          "company_registration_completed",
          true
        ],
        [
          "EQ",
          "business_license_applied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:registration_extension_allowed",
    "desc": "有正當理由得申請展延一次，展延期限以六個月為限",
    "expr": [
      "EQ",
      "registration_extension_allowed",
      [
        "AND",
        [
          "EQ",
          "has_justifiable_reason",
          true
        ],
        [
          "LE",
          "extension_count",
          1
        ],
        [
          "LE",
          "extension_period_months",
          6
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:membership_required",
    "desc": "非加入同業公會不得開業",
    "expr": [
      "EQ",
      "membership_required",
      [
        "EQ",
        "joined_trade_association",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:client_assessment_required",
    "desc": "接受客戶委任應充分知悉並評估客戶投資知識、經驗、財務狀況及風險承受度",
    "expr": [
      "EQ",
      "client_assessment_done",
      [
        "AND",
        [
          "EQ",
          "client_investment_knowledge_assessed",
          true
        ],
        [
          "EQ",
          "client_investment_experience_assessed",
          true
        ],
        [
          "EQ",
          "client_financial_status_assessed",
          true
        ],
        [
          "EQ",
          "client_risk_tolerance_assessed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:written_contract_required",
    "desc": "提供分析意見或推介建議時應訂定書面證券投資顧問契約",
    "expr": [
      "EQ",
      "written_contract_signed",
      [
        "EQ",
        "contract_signed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "securities_investment_advisory:contract_mandatory_items",
    "desc": "證券投資顧問契約應載明法定事項",
    "expr": [
      "EQ",
      "contract_mandatory_items_complete",
      [
        "AND",
        [
          "EQ",
          "contract_party_names_and_addresses",
          true
        ],
        [
          "EQ",
          "contract_rights_obligations_liabilities",
          true
        ],
        [
          "EQ",
          "contract_scope_of_advice",
          true
        ],
        [
          "EQ",
          "contract_service_methods",
          true
        ],
        [
          "EQ",
          "contract_fees_and_payment_methods",
          true
        ],
        [
          "EQ",
          "contract_confidentiality_obligation",
          true
        ],
        [
          "EQ",
          "contract_no_disclosure_without_consent",
          true
        ],
        [
          "EQ",
          "contract_no_client_fund_receipt_or_profit_sharing",
          true
        ],
        [
          "EQ",
          "contract_modification_and_termination",
          true
        ],
        [
          "EQ",
          "contract_effective_date_and_duration",
          true
        ],
        [
          "EQ",
          "contract_client_7_day_termination_right",
          true
        ],
        [
          "EQ",
          "contract_refund_ratio_and_method",
          true
        ],
        [
          "EQ",
          "contract_dispute_resolution_and_jurisdiction",
          true
        ],
        [
          "EQ",
          "contract_other_mandated_items",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities_investment_advisory"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反任一法定規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "business_types_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "change_approval_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "suspension_limit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "suspension_permit_revoked",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "unauthorized_suspension_revokes_permit",
            false
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fund_usage_restriction_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "guarantee_and_collateral_restriction_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_registration_ok",
            true
          ]
        ],
        [
          "EQ",
          "personnel_registration_prohibited",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "company_registration_documents_complete",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "registration_within_6_months",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "registration_extension_allowed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "membership_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "client_assessment_done",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "written_contract_signed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "contract_mandatory_items_complete",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]