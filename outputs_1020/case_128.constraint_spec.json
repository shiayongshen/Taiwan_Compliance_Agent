[
  {
    "id": "audit:approval_required",
    "desc": "會計師辦理查核簽證須經主管機關核准",
    "expr": [
      "EQ",
      "approval_required",
      [
        "EQ",
        "audit_engagement_approved",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:follow_rules",
    "desc": "會計師辦理查核簽證應依主管機關查核簽證規則辦理",
    "expr": [
      "EQ",
      "follow_rules",
      [
        "EQ",
        "audit_followed_regulations",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:financial_report_available",
    "desc": "財務報告應備置於公司及分支機構供股東及債權人查閱或抄錄",
    "expr": [
      "EQ",
      "financial_report_available",
      [
        "EQ",
        "financial_report_placed_at_company_and_branches",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:sufficient_evidence",
    "desc": "會計師應依審計準則500號獲取足夠與適切之查核證據",
    "expr": [
      "EQ",
      "sufficient_evidence_obtained",
      [
        "EQ",
        "audit_evidence_sufficient_and_appropriate",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:documentation_updated",
    "desc": "會計師應設置並持續更新查核相關檔案",
    "expr": [
      "EQ",
      "documentation_updated",
      [
        "EQ",
        "audit_documentation_established_and_updated",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:management_informed_and_action_taken",
    "desc": "管理階層及治理單位已被告知財務報表須修改且採取必要行動",
    "expr": [
      "EQ",
      "management_informed_and_action_taken",
      [
        "AND",
        [
          "EQ",
          "management_informed_of_modifications",
          true
        ],
        [
          "EQ",
          "governance_informed_of_modifications",
          true
        ],
        [
          "EQ",
          "management_and_governance_took_necessary_actions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:auditor_action_taken",
    "desc": "查核人員已採取適當行動避免財務報表使用者信賴原查核報告",
    "expr": [
      "EQ",
      "auditor_action_taken",
      [
        "EQ",
        "auditor_took_appropriate_actions",
        true
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "audit:error_penalty_level",
    "desc": "會計師查核簽證錯誤或疏漏處分等級（0=無錯誤,1=警告,2=停止簽證,3=撤銷核准）",
    "expr": [
      "EQ",
      "error_penalty_level",
      [
        "CASE",
        [
          "EQ",
          "audit_error",
          false
        ],
        0,
        [
          "AND",
          [
            "EQ",
            "audit_error",
            true
          ],
          [
            "EQ",
            "penalty_warning",
            true
          ]
        ],
        1,
        [
          "AND",
          [
            "EQ",
            "audit_error",
            true
          ],
          [
            "EQ",
            "penalty_suspend",
            true
          ]
        ],
        2,
        [
          "AND",
          [
            "EQ",
            "audit_error",
            true
          ],
          [
            "EQ",
            "penalty_revoke",
            true
          ]
        ],
        3,
        0
      ]
    ],
    "weight": 1,
    "domain": "audit"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反核准、規則遵守、查核證據、檔案更新、錯誤處分等規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "approval_required",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "follow_rules",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "sufficient_evidence_obtained",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "documentation_updated",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "audit_error",
            true
          ],
          [
            "GT",
            "error_penalty_level",
            0
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]