          "fhc_shareholding_percent",
          5.0
        ],
        [
          "EQ",
          "fhc_reported_within_10_days",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_approval_required",
    "desc": "同一人或同一關係人持有金融控股公司股份超過10%、25%、50%需事先申請核准",
    "expr": [
      "EQ",
      "fhc:shareholding_approval_required",
      [
        "OR",
        [
          "GT",
          "fhc_shareholding_percent",
          10.0
        ],
        [
          "GT",
          "fhc_shareholding_percent",
          25.0
        ],
        [
          "GT",
          "fhc_shareholding_percent",
          50.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_approval_obtained",
    "desc": "已取得主管機關核准持有金融控股公司股份",
    "expr": [
      "EQ",
      "fhc:shareholding_approval_obtained",
      [
        "EQ",
        "fhc_approval_obtained",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:illegal_shareholding",
    "desc": "未依規定申報或未經核准持有金融控股公司股份",
    "expr": [
      "EQ",
      "fhc:illegal_shareholding",
      [
        "OR",
        [
          "AND",
          [
            "GT",
            "fhc_shareholding_percent",
            5.0
          ],
          [
            "NOT",
            [
              "EQ",
              "fhc_reported_within_10_days",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "GT",
            "fhc_shareholding_percent",
            10.0
          ],
          [
            "NOT",
            [
              "EQ",
              "fhc_approval_obtained",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:illegal_shareholding_disposal_ordered",
    "desc": "主管機關命令限期處分超過部分股份",
    "expr": [
      "EQ",
      "fhc:illegal_shareholding_disposal_ordered",
      [
        "EQ",
        "fhc_disposal_ordered",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:illegal_pledge_setting",
    "desc": "同一人或同一關係人持有金融控股公司股份超過10%不得設定質權予子公司",
    "expr": [
      "EQ",
      "fhc:illegal_pledge_setting",
      [
