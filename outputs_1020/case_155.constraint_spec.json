        ],
        [
          "EQ",
          "fhc_pledge_to_subsidiary",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "fhc_pledge_exemption_before_conversion",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
