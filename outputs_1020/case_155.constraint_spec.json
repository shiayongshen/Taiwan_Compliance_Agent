  {
    "id": "fhc:non_preferential_transaction_approved",
    "desc": "授信以外交易條件不得優於其他同類對象，且經董事會三分之二以上出席及四分之三以上決議",
    "expr": [
      "EQ",
      "non_preferential_transaction_approved",
      [
        "AND",
        [
          "GE",
          "board_attendance_ratio",
          66.67
        ],
        [
          "GE",
          "board_approval_ratio",
          75.0
        ],
        [
          "EQ",
          "transaction_condition_not_preferential",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_preferential_transaction_subject",
    "desc": "授信以外交易對象分類",
    "expr": [
      "EQ",
      "non_preferential_transaction_subject",
      [
        "CASE",
        [
          "EQ",
          "transaction_with_fhc_and_responsible_or_major_shareholder",
          true
        ],
        1,
        [
          "EQ",
          "transaction_with_responsible_or_major_shareholder_enterprise",
          true
        ],
        2,
        [
          "EQ",
          "transaction_with_fhc_related_enterprise_and_responsible_or_major_shareholder",
          true
        ],
        3,
        [
          "EQ",
          "transaction_with_fhc_subsidiary_and_responsible",
          true
        ],
        4,
        0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_single_related_transaction_limit_ok",
    "desc": "銀行子公司與單一關係人交易金額不超過淨值10%",
    "expr": [
      "EQ",
      "bank_subsidiary_single_related_transaction_limit_ok",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "bank_subsidiary_single_related_transaction_amount",
            "bank_subsidiary_net_worth"
          ],
          100.0
        ],
        10.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_all_related_transaction_limit_ok",
    "desc": "銀行子公司與所有利害關係人交易總額不超過淨值20%",
    "expr": [
