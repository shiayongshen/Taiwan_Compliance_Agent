[
  {
    "id": "insurance:license_and_guarantee_compliance",
    "desc": "保險代理人、經紀人、公證人須經主管機關許可，繳存保證金並投保相關保險，且領有執業證照後始得經營或執行業務",
    "expr": [
      "EQ",
      "license_and_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "approved_by_authority",
          true
        ],
        [
          "GE",
          "guarantee_deposit_amount",
          "minimum_guarantee_deposit"
        ],
        [
          "EQ",
          "relevant_insurance_purchased",
          true
        ],
        [
          "EQ",
          "license_held",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:relevant_insurance_type_compliance",
    "desc": "保險代理人、公證人須投保責任保險；保險經紀人須投保責任保險及保證保險",
    "expr": [
      "EQ",
      "relevant_insurance_type_compliance",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "is_agent_or_notary",
            true
          ],
          [
            "EQ",
            "liability_insurance_purchased",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "is_broker",
            true
          ],
          [
            "EQ",
            "liability_insurance_purchased",
            true
          ],
          [
            "EQ",
            "guarantee_insurance_purchased",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:single_license_requirement",
    "desc": "兼有保險代理人、經紀人、公證人資格者，僅得擇一申領執業證照",
    "expr": [
      "EQ",
      "single_license_requirement",
      [
        "LE",
        [
          "SUM",
          "agent_license_held",
          "broker_license_held",
          "notary_license_held"
        ],
        1
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:fixed_office_and_accounting",
    "desc": "保險代理人、經紀人、公證人應有固定業務處所，並專設帳簿記載業務收支",
    "expr": [
      "EQ",
      "fixed_office_and_accounting",
      [
        "AND",
        [
          "EQ",
          "has_fixed_office",
          true
        ],
        [
          "EQ",
          "has_dedicated_accounting_books",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_requirement",
    "desc": "保險代理人公司、經紀人公司為公開發行公司或具一定規模者，應建立內部控制、稽核制度與招攬處理制度及程序",
    "expr": [
      "EQ",
      "internal_control_requirement",
      [
        "IMPLIES",
        [
          "OR",
          [
            "EQ",
            "is_publicly_listed",
            true
          ],
          [
            "GE",
            "company_scale",
            "certain_scale_threshold"
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "audit_system_established",
            true
          ],
          [
            "EQ",
            "solicitation_handling_system_established",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_of_care_and_fidelity",
    "desc": "保險經紀人應以善良管理人之注意義務及忠實義務為被保險人洽訂保險契約或提供相關服務",
    "expr": [
      "EQ",
      "broker_duty_of_care_and_fidelity",
      [
        "AND",
        [
          "EQ",
          "broker_exercises_duty_of_care",
          true
        ],
        [
          "EQ",
          "broker_exercises_fidelity",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_provide_written_report_and_disclose_fee",
    "desc": "保險經紀人於主管機關指定範圍內洽訂保險契約前，應主動提供書面分析報告，收取報酬者應明確告知報酬標準",
    "expr": [
      "EQ",
      "broker_provide_written_report_and_disclose_fee",
      [
        "AND",
        [
          "EQ",
          "written_analysis_report_provided",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "fee_charged",
            true
          ],
          [
            "EQ",
            "fee_disclosed_clearly",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_duty_to_understand_and_document",
    "desc": "個人執業經紀人、經紀人公司及銀行應確實瞭解要保人需求及商品適合度，並於文件簽章或電子方式記錄",
    "expr": [
      "EQ",
      "broker_duty_to_understand_and_document",
      [
        "AND",
        [
          "EQ",
          "insured_needs_understood",
          true
        ],
        [
          "EQ",
          "product_suitability_assessed",
          true
        ],
        [
          "EQ",
          "document_signed_or_electronically_confirmed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_document_retention",
    "desc": "個人執業經紀人、經紀人公司及銀行應將有關文件留存建檔備供查閱",
    "expr": [
      "EQ",
      "broker_document_retention",
      [
        "EQ",
        "documents_retained_and_archived",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_internal_operation_compliance",
    "desc": "經紀人公司及銀行應依法令及主管機關規定訂定內部作業規範並落實執行",
    "expr": [
      "EQ",
      "broker_internal_operation_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_operation_regulations_established",
          true
        ],
        [
          "EQ",
          "internal_operation_regulations_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_disclose_shareholding_info",
    "desc": "經紀人公司或銀行持有保險公司表決權股份超過10%或反之，經紀人應於洽訂保險契約前揭露該資訊",
    "expr": [
      "EQ",
      "broker_disclose_shareholding_info",
      [
        "IMPLIES",
        [
          "OR",
          [
            "GT",
            "broker_company_shareholding_ratio",
            10.0
          ],
          [
            "GT",
            "insurance_company_shareholding_ratio",
            10.0
          ]
        ],
        [
          "EQ",
          "shareholding_info_disclosed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:broker_compliance_with_prohibited_acts",
    "desc": "個人執業經紀人、經紀人公司、銀行及受任用經紀人不得有保險經紀人管理規則第49條所列違法行為",
    "expr": [
      "EQ",
      "broker_compliance_with_prohibited_acts",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "false_report_on_license_application",
            true
          ],
          [
            "EQ",
            "contract_with_unapproved_insurer",
            true
          ],
          [
            "EQ",
            "conceal_important_contract_info",
            true
          ],
          [
            "EQ",
            "coerce_or_induce_contract",
            true
          ],
          [
            "EQ",
            "misleading_promotion_or_recruitment",
            true
          ],
          [
            "EQ",
            "induce_policy_cancellation_or_loan",
            true
          ],
          [
            "EQ",
            "misappropriate_insurance_funds",
            true
          ],
          [
            "EQ",
            "permit_others_use_license",
            true
          ],
          [
            "EQ",
            "criminal_conviction_for_fraud_or_forgery",
            true
          ],
          [
            "EQ",
            "operate_outside_license_scope",
            true
          ],
          [
            "EQ",
            "charge_unapproved_fees_or_commissions",
            true
          ],
          [
            "EQ",
            "illegal_insurance_claims",
            true
          ],
          [
            "EQ",
            "spread_false_information",
            true
          ],
          [
            "EQ",
            "authorize_others_to_operate",
            true
          ],
          [
            "EQ",
            "transfer_application_documents_without_consent",
            true
          ],
          [
            "EQ",
            "employ_unqualified_recruiters",
            true
          ],
          [
            "EQ",
            "fail_to_cancel_license_within_deadline",
            true
          ],
          [
            "EQ",
            "unauthorized_suspension_or_termination_of_business",
            true
          ],
          [
            "EQ",
            "fail_to_reappoint_broker_after_resignation",
            true
          ],
          [
            "EQ",
            "fail_to_report_to_broker_association",
            true
          ],
          [
            "EQ",
            "unauthorized_use_of_insurance_advertisement",
            true
          ],
          [
            "EQ",
            "pay_commission_to_non_actual_recruiters",
            true
          ],
          [
            "EQ",
            "fail_to_confirm_suitability_for_elderly_clients",
            true
          ],
          [
            "EQ",
            "sell_unapproved_foreign_policy_discount_products",
            true
          ],
          [
            "EQ",
            "submit_false_or_incomplete_reports",
            true
          ],
          [
            "EQ",
            "hold_conflicting_positions",
            true
          ],
          [
            "EQ",
            "induce_contract_termination_or_loan_payment",
            true
          ],
          [
            "EQ",
            "fail_to_fill_recruitment_report_truthfully",
            true
          ],
          [
            "EQ",
            "other_violations_of_rules_or_laws",
            true
          ],
          [
            "EQ",
            "damage_insurance_reputation",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "insurance:penalty_conditions",
    "desc": "處罰條件：違反許可、保證金、保險投保、執業證照規定或違反管理規則及禁止行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "license_and_guarantee_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "relevant_insurance_type_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "single_license_requirement",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fixed_office_and_accounting",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_requirement",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_of_care_and_fidelity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_provide_written_report_and_disclose_fee",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_duty_to_understand_and_document",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_document_retention",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_internal_operation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_disclose_shareholding_info",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "broker_compliance_with_prohibited_acts",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]