[
  {
    "id": "securities:violation_penalty_level",
    "desc": "主管機關對違反法令事業之處分等級（1=警告,2=解除職務,3=停止募集或新增業務,4=停業,5=廢止營業許可,6=其他處置,0=無處分）",
    "expr": [
      "EQ",
      "violation_penalty_level",
      [
        "CASE",
        [
          "EQ",
          "warning",
          true
        ],
        1,
        [
          "EQ",
          "order_dismiss_officer",
          true
        ],
        2,
        [
          "EQ",
          "suspend_fund_raising_or_new_business",
          true
        ],
        3,
        [
          "EQ",
          "suspend_business",
          true
        ],
        4,
        [
          "EQ",
          "revoke_business_license",
          true
        ],
        5,
        [
          "EQ",
          "other_necessary_measures",
          true
        ],
        6,
        0
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_violation",
    "desc": "董事、監察人、經理人或受僱人違反法令且影響業務正常執行",
    "expr": [
      "EQ",
      "personnel_violation",
      [
        "AND",
        [
          "EQ",
          "violate_law_or_related_regulations",
          true
        ],
        [
          "EQ",
          "affect_normal_business",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:personnel_violation_penalty",
    "desc": "主管機關命令停止執行業務或解除職務處分",
    "expr": [
      "EQ",
      "personnel_violation_penalty",
      [
        "OR",
        [
          "EQ",
          "order_stop_business_within_one_year",
          true
        ],
        [
          "EQ",
          "order_dismiss_officer",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:violation_fine",
    "desc": "違反特定條文規定之罰鍰情形",
    "expr": [
      "EQ",
      "violation_fine",
      [
        "OR",
        [
          "EQ",
          "operate_without_approval",
          true
        ],
        [
          "EQ",
          "violate_investment_scope_rules_14_1_18_1_56_1",
          true
        ],
        [
          "EQ",
          "violate_investment_scope_rules_16_4",
          true
        ],
        [
          "EQ",
          "violate_rules_16_1_19_1_51_1_59",
          true
        ],
        [
          "EQ",
          "violate_diversification_ratio_58_2",
          true
        ],
        [
          "EQ",
          "operate_without_business_license_63_1",
          true
        ],
        [
          "EQ",
          "violate_behavior_rules_69",
          true
        ],
        [
          "EQ",
          "violate_restriction_rules_70",
          true
        ],
        [
          "EQ",
          "violate_branch_establishment_rules_72_1",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "trust:personnel_prohibited_behaviors",
    "desc": "證券投資信託事業負責人及業務人員禁止行為",
    "expr": [
      "EQ",
      "personnel_prohibited_behaviors",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "leak_confidential_info",
            true
          ],
          [
            "EQ",
            "self_or_others_trading_conflict",
            true
          ],
          [
            "EQ",
            "fraudulent_or_misleading_behavior",
            true
          ],
          [
            "EQ",
            "not_return_commission_to_fund",
            true
          ],
          [
            "EQ",
            "provide_specific_benefits_to_promote",
            true
          ],
          [
            "EQ",
            "sell_proxy_voting_rights_for_benefits",
            true
          ],
          [
            "EQ",
            "manipulate_security_prices",
            true
          ],
          [
            "EQ",
            "transfer_orders_between_accounts",
            true
          ],
          [
            "EQ",
            "public_promotion_or_price_forecast",
            true
          ],
          [
            "EQ",
            "use_nonprofessional_to_recruit_or_pay_unreasonable_commission",
            true
          ],
          [
            "EQ",
            "agent_investment_except_legal_agent",
            true
          ],
          [
            "EQ",
            "other_harmful_behaviors",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:personnel_confidentiality",
    "desc": "負責人及業務人員保守客戶資料秘密",
    "expr": [
      "EQ",
      "personnel_confidentiality",
      [
        "EQ",
        "keep_client_data_confidential",
        true
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:prohibited_trading_during_fund_holding",
    "desc": "負責人及關係人於基金持有期間不得交易該公司股票及衍生商品",
    "expr": [
      "EQ",
      "prohibited_trading_during_fund_holding",
      [
        "IMPLIES",
        [
          "EQ",
          "fund_holding_company_stock_or_derivatives",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "trade_company_stock_or_derivatives",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:related_persons_definition",
    "desc": "關係人定義符合規定",
    "expr": [
      "EQ",
      "related_persons_definition",
      [
        "OR",
        [
          "EQ",
          "related_persons_natural_person",
          true
        ],
        [
          "EQ",
          "related_persons_corporate",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:related_persons_natural_person",
    "desc": "自然人關係人定義",
    "expr": [
      "EQ",
      "related_persons_natural_person",
      [
        "AND",
        [
          "EQ",
          "person_is_natural_person",
          true
        ],
        [
          "EQ",
          "includes_spouse_and_second_degree_relatives",
          true
        ],
        [
          "EQ",
          "includes_enterprise_controlled_by_person_or_spouse",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:related_persons_corporate",
    "desc": "法人關係人定義",
    "expr": [
      "EQ",
      "related_persons_corporate",
      [
        "AND",
        [
          "EQ",
          "person_is_corporate",
          true
        ],
        [
          "EQ",
          "includes_same_source_controlled_corporate",
          true
        ],
        [
          "EQ",
          "includes_mutual_control_corporate",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:prohibited_trading_delegated_investment",
    "desc": "全權委託投資業務專責人員及關係人禁止交易規定",
    "expr": [
      "EQ",
      "prohibited_trading_delegated_investment",
      [
        "IMPLIES",
        [
          "EQ",
          "delegated_investment_holding_company_stock_or_derivatives",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "trade_company_stock_or_derivatives_delegated",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "trust:prohibited_delegated_investment_behaviors",
    "desc": "全權委託投資業務禁止行為",
    "expr": [
      "EQ",
      "prohibited_delegated_investment_behaviors",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "use_insider_info_for_others",
            true
          ],
          [
            "EQ",
            "harm_client_interests",
            true
          ],
          [
            "EQ",
            "profit_loss_sharing_agreement",
            true
          ],
          [
            "EQ",
            "self_or_others_trading",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "relative_trading_exception",
              true
            ],
            [
              "NOT",
              [
                "EQ",
                "intentional_counterparty_trading",
                true
              ]
            ]
          ],
          [
            "EQ",
            "use_client_account_for_self_or_others",
            true
          ],
          [
            "EQ",
            "delegate_or_transfer_contract",
            true
          ],
          [
            "EQ",
            "unauthorized_order_transfer",
            true
          ],
          [
            "EQ",
            "ignore_investment_report",
            true
          ],
          [
            "EQ",
            "other_harmful_behaviors_delegated",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "trust"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反法令或命令，或人員違規，或違反罰鍰條件時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "violation_fine",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_violation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_prohibited_behaviors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "personnel_confidentiality",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_trading_during_fund_holding",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_trading_delegated_investment",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_delegated_investment_behaviors",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]