[
  {
    "id": "insurance:internal_control_established",
    "desc": "已建立內部控制制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_executed",
    "desc": "已確實執行內部控制制度",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:audit_system_established",
    "desc": "已建立稽核制度",
    "expr": [
      "EQ",
      "audit_system_established",
      [
        "EQ",
        "audit_system_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:audit_system_executed",
    "desc": "已確實執行稽核制度",
    "expr": [
      "EQ",
      "audit_system_executed",
      [
        "EQ",
        "audit_system_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:handling_system_established",
    "desc": "已建立招攬處理制度及程序",
    "expr": [
      "EQ",
      "handling_system_established",
      [
        "EQ",
        "handling_system_established_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:handling_system_executed",
    "desc": "已確實執行招攬處理制度及程序",
    "expr": [
      "EQ",
      "handling_system_executed",
      [
        "EQ",
        "handling_system_executed_flag",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_compliance",
    "desc": "內部控制制度建立且執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:audit_system_compliance",
    "desc": "稽核制度建立且執行",
    "expr": [
      "EQ",
      "audit_system_compliance",
      [
        "AND",
        [
          "EQ",
          "audit_system_established",
          true
        ],
        [
          "EQ",
          "audit_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:handling_system_compliance",
    "desc": "招攬處理制度及程序建立且執行",
    "expr": [
      "EQ",
      "handling_system_compliance",
      [
        "AND",
        [
          "EQ",
          "handling_system_established",
          true
        ],
        [
          "EQ",
          "handling_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_audit_handling_compliance",
    "desc": "內部控制、稽核及招攬處理制度均建立且執行",
    "expr": [
      "EQ",
      "internal_control_audit_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_compliance",
          true
        ],
        [
          "EQ",
          "audit_system_compliance",
          true
        ],
        [
          "EQ",
          "handling_system_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:required_to_establish_system",
    "desc": "應於次一年內建立內部控制、稽核及招攬處理制度及程序（公開發行公司或營收達2億）",
    "expr": [
      "EQ",
      "required_to_establish_system",
      [
        "OR",
        [
          "EQ",
          "is_publicly_listed_company",
          true
        ],
        [
          "GE",
          "annual_revenue",
          200000000
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:system_establishment_compliance",
    "desc": "符合建立內部控制、稽核及招攬處理制度及程序之規定",
    "expr": [
      "EQ",
      "system_establishment_compliance",
      [
        "IMPLIES",
        [
          "EQ",
          "required_to_establish_system",
          true
        ],
        [
          "EQ",
          "internal_control_audit_handling_compliance",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立或未確實執行內部控制、稽核制度或招攬處理制度及程序時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "AND",
        [
          "EQ",
          "required_to_establish_system",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_audit_handling_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]