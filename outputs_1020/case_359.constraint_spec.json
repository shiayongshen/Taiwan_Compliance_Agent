          "order_stop_sale_or_limit_products",
          true
        ],
        [
          "EQ",
          "order_capital_increase",
          true
        ],
        [
          "EQ",
          "order_dismiss_manager_or_staff",
          true
        ],
        [
          "EQ",
          "revoke_meeting_resolution",
          true
        ],
        [
          "EQ",
          "dismiss_director_or_supervisor",
          true
        ],
        [
          "EQ",
          "other_necessary_measures",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:dismiss_director_supervisor_registration",
    "desc": "解除董（理）事、監察人職務並通知主管機關廢止登記",
    "expr": [
      "EQ",
      "dismiss_director_supervisor_registration",
      [
        "AND",
        [
          "EQ",
          "dismiss_director_or_supervisor",
          true
        ],
        [
          "EQ",
          "notify_authority_to_cancel_registration",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_insufficient_measures_executed",
    "desc": "資本嚴重不足等級4採取對應措施",
