[
  {
    "id": "insurance:responsible_person_qualification",
    "desc": "保險業負責人具備資格條件",
    "expr": [
      "EQ",
      "responsible_person_qualification",
      [
        "EQ",
        "meets_qualification_requirements",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:responsible_person_conflict_adjusted",
    "desc": "保險業負責人兼職限制及利益衝突已調整",
    "expr": [
      "EQ",
      "responsible_person_conflict_adjusted",
      [
        "OR",
        [
          "EQ",
          "no_violation_of_conflict_restrictions",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "violation_of_conflict_restrictions",
            true
          ],
          [
            "EQ",
            "adjustment_made_within_deadline",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:responsible_person_dismissed",
    "desc": "保險業負責人因資格不符或未調整而被解任",
    "expr": [
      "EQ",
      "responsible_person_dismissed",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "responsible_person_qualification",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "violation_of_conflict_restrictions",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "adjustment_made_within_deadline",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_limit_per_unit",
    "desc": "單一放款金額不得超過資金百分之五",
    "expr": [
      "EQ",
      "loan_guarantee_limit_per_unit",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "single_loan_amount",
            "insurance_capital"
          ],
          100.0
        ],
        5.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_total_limit",
    "desc": "放款總額不得超過資金百分之三十五",
    "expr": [
      "EQ",
      "loan_total_limit",
      [
        "LE",
        [
          "MUL",
          [
            "DIV",
            "total_loan_amount",
            "insurance_capital"
          ],
          100.0
        ],
        35.0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_sufficient_collateral",
    "desc": "對負責人、職員或主要股東之擔保放款有十足擔保且條件不優於其他同類放款",
    "expr": [
      "EQ",
      "loan_guarantee_sufficient_collateral",
      [
        "AND",
        [
          "EQ",
          "sufficient_collateral_provided",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "loan_conditions_better_than_others",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_board_approval",
    "desc": "擔保放款達規定金額以上經董事會三分之二出席及四分之三同意",
    "expr": [
      "EQ",
      "loan_guarantee_board_approval",
      [
        "IMPLIES",
        [
          "GE",
          "loan_amount",
          "regulatory_threshold"
        ],
        [
          "AND",
          [
            "GE",
            "board_attendance_ratio",
            0.6666667
          ],
          [
            "GE",
            "board_approval_ratio",
            0.75
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_compliance",
    "desc": "擔保放款符合擔保條件及董事會決議",
    "expr": [
      "EQ",
      "loan_guarantee_compliance",
      [
        "AND",
        [
          "EQ",
          "loan_guarantee_sufficient_collateral",
          true
        ],
        [
          "EQ",
          "loan_guarantee_board_approval",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_and_loan_limit",
    "desc": "合併計算投資及質押放款不得超過資金百分之十及公司業主權益百分之十",
    "expr": [
      "EQ",
      "investment_and_loan_limit",
      [
        "AND",
        [
          "LE",
          [
            "MUL",
            [
              "DIV",
              "investment_and_pledged_loan_amount",
              "insurance_capital"
            ],
            100.0
          ],
          10.0
        ],
        [
          "LE",
          [
            "MUL",
            [
              "DIV",
              "investment_and_pledged_loan_amount",
              "issuer_equity"
            ],
            100.0
          ],
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:same_person_loan_limit",
    "desc": "同一人、同一關係人或同一關係企業放款及交易限制",
    "expr": [
      "EQ",
      "same_person_loan_limit",
      [
        "LE",
        "loan_and_other_transaction_amount",
        "regulatory_limit"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_shareholder_rights_exchange",
    "desc": "不得以信託、委任或其他方式進行股權交換或利益輸送",
    "expr": [
      "EQ",
      "prohibited_shareholder_rights_exchange",
      [
        "NOT",
        [
          "EQ",
          "engaged_in_prohibited_equity_exchange",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholder_meeting_vote_documented",
