[
  {
    "id": "forex:declaration_required",
    "desc": "新臺幣五十萬元以上等值外匯收支或交易應申報",
    "expr": [
      "EQ",
      "declaration_required",
      [
        "GE",
        "forex_amount_ntd",
        500000.0
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:declaration_made",
    "desc": "依規定申報",
    "expr": [
      "EQ",
      "declaration_made",
      [
        "AND",
        [
          "EQ",
          "declaration_required",
          true
        ],
        [
          "EQ",
          "declaration_submitted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:declaration_truthful",
    "desc": "申報事項無不實之虞",
    "expr": [
      "EQ",
      "declaration_truthful",
      [
        "NOT",
        [
          "EQ",
          "declaration_has_falsehood",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:query_response_ok",
    "desc": "受查詢者據實說明",
    "expr": [
      "EQ",
      "query_response_ok",
      [
        "EQ",
        "query_response_truthful",
        true
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:violation_declaration",
    "desc": "違反第6-1條故意不申報或申報不實",
    "expr": [
      "EQ",
      "violation_declaration",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "declaration_required",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "declaration_submitted",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "declaration_required",
            true
          ],
          [
            "EQ",
            "declaration_submitted",
            true
          ],
          [
            "EQ",
            "declaration_has_falsehood",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:violation_query_response",
    "desc": "受查詢未於限期內提出說明或為虛偽說明",
    "expr": [
      "EQ",
      "violation_query_response",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "query_response_submitted_in_time",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "query_response_truthful",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "forex:violation_forex_sale",
    "desc": "違反第7條規定不結售或不存入外匯",
    "expr": [
      "EQ",
      "violation_forex_sale",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "forex_sold_to_central_bank",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "forex_deposited_to_central_bank_or_designated_bank",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "forex"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反申報義務或查詢說明義務或外匯結售存入義務時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "violation_declaration",
          true
        ],
        [
          "EQ",
          "violation_query_response",
          true
        ],
        [
          "EQ",
          "violation_forex_sale",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]