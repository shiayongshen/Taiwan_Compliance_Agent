[
  {
    "id": "fhc:non_credit_transaction_conditions_met",
    "desc": "授信以外交易條件符合董事會出席及決議比例要求",
    "expr": [
      "EQ",
      "non_credit_transaction_conditions_met",
      [
        "AND",
        [
          "GE",
          "board_attendance_ratio",
          0.6666666667
        ],
        [
          "GE",
          "board_approval_ratio",
          0.75
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_counterparty_in_scope",
    "desc": "授信以外交易對象屬於法定範圍",
    "expr": [
      "EQ",
      "non_credit_transaction_counterparty_in_scope",
      [
        "OR",
        "is_fhc_and_its_responsible_and_major_shareholders",
        "is_fhc_responsible_and_major_shareholders_sole_proprietorship_or_partnership_or_enterprise_or_representative_group",
        "is_fhc_related_enterprise_and_its_responsible_and_major_shareholders",
        "is_fhc_bank_insurance_securities_subsidiary_or_subsidiary_responsible"
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_condition_not_better_than_others",
    "desc": "授信以外交易條件不得優於其他同類對象",
    "expr": [
      "EQ",
      "non_credit_transaction_condition_not_better_than_others",
      [
        "EQ",
        "transaction_condition_better_than_others",
        false
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_compliance",
    "desc": "授信以外交易符合條件、對象範圍及董事會決議要求",
    "expr": [
      "EQ",
      "non_credit_transaction_compliance",
      [
        "AND",
        [
          "EQ",
          "non_credit_transaction_counterparty_in_scope",
          true
        ],
        [
          "EQ",
          "non_credit_transaction_condition_not_better_than_others",
          true
        ],
        [
          "EQ",
          "non_credit_transaction_conditions_met",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_type_in_scope",
    "desc": "授信以外交易類型屬於法定範圍",
    "expr": [
      "EQ",
      "non_credit_transaction_type_in_scope",
      [
        "OR",
        [
          "EQ",
          "transaction_type_invest_or_purchase_securities",
          true
        ],
        [
          "EQ",
          "transaction_type_purchase_real_estate_or_other_assets",
          true
        ],
        [
          "EQ",
          "transaction_type_sell_securities_real_estate_or_other_assets",
          true
        ],
        [
          "EQ",
          "transaction_type_contract_payment_or_service",
          true
        ],
        [
          "EQ",
          "transaction_type_agent_broker_commission_service",
          true
        ],
        [
          "EQ",
          "transaction_type_third_party_related_transactions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:non_credit_transaction_securities_exclusion",
    "desc": "有價證券不包括銀行子公司發行之可轉讓定期存單",
    "expr": [
      "EQ",
      "non_credit_transaction_securities_exclusion",
      [
        "NOT",
        [
          "EQ",
          "transaction_securities_include_bank_subsidiary_negotiable_cd",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_single_counterparty_limit_ok",
    "desc": "銀行子公司與單一關係人交易金額不超過淨值10%",
    "expr": [
      "EQ",
      "bank_subsidiary_single_counterparty_limit_ok",
      [
        "LE",
        "bank_subsidiary_single_counterparty_transaction_amount",
        [
          "MUL",
          "bank_subsidiary_net_worth",
          0.1
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_subsidiary_all_counterparty_limit_ok",
    "desc": "銀行子公司與所有利害關係人交易總額不超過淨值20%",
    "expr": [
      "EQ",
      "bank_subsidiary_all_counterparty_limit_ok",
      [
        "LE",
        "bank_subsidiary_all_counterparty_transaction_amount",
        [
          "MUL",
          "bank_subsidiary_net_worth",
          0.2
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_executed",
    "desc": "內部控制及稽核制度確實執行",
    "expr": [
      "EQ",
      "internal_control_executed",
      [
        "EQ",
        "internal_control_system_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_compliance",
    "desc": "內部控制及稽核制度建立且確實執行",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反授信以外交易條件、對象範圍、董事會決議或銀行子公司交易限額，或未建立或執行內部控制制度時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "non_credit_transaction_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_subsidiary_single_counterparty_limit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bank_subsidiary_all_counterparty_limit_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]