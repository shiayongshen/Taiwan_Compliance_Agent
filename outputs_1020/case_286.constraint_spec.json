            "EQ",
            "bill_finance:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "bill_finance:penalties_applied",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "fhc:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "fhc:corrective_action_taken",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "fhc:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "fhc:penalties_applied",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "epayment:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "epayment:corrective_action_taken",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "epayment:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "epayment:penalties_applied",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "insurance:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance:corrective_action_taken",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "insurance:violation_occurred",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "insurance:penalties_applied",
              true
            ]
          ]
        ],
