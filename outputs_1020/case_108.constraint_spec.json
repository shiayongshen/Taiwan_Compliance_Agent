  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反第171-1條規定或違反第148-1、148-2、148-3條規定，或資本不足等級未執行對應措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "EQ",
          "penalty_171_1",
          true
        ],
        [
          "EQ",
          "penalty_171_2",
          true
        ],
        [
          "EQ",
          "penalty_171_3",
          true
        ],
        [
          "EQ",
          "penalty_171_4",
          true
        ],
        [
          "EQ",
          "penalty_171_5",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_severely_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_significantly_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_insufficient_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
