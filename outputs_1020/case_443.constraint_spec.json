[
  {
    "id": "securities:prohibited_trading_period",
    "desc": "負責人及關係人於基金持有期間不得從事該公司股票及具股權性質衍生商品交易",
    "expr": [
      "EQ",
      "prohibited_trading_period",
      [
        "IMPLIES",
        [
          "EQ",
          "fund_holding_stock_or_equity_derivative",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "person_or_related_party_trading",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:trading_declaration_required",
    "desc": "負責人及關係人從事公司股票及具股權性質衍生商品交易應申報",
    "expr": [
      "EQ",
      "trading_declaration_required",
      [
        "IMPLIES",
        [
          "EQ",
          "person_or_related_party_trading",
          true
        ],
        [
          "EQ",
          "trading_reported_to_fund",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:good_faith_duty",
    "desc": "負責人及業務人員應以善良管理人注意義務及忠實義務執行業務",
    "expr": [
      "EQ",
      "good_faith_duty",
      [
        "EQ",
        "duty_of_care_and_loyalty_observed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:prohibited_behaviors",
    "desc": "負責人及業務人員不得有法令禁止之不當行為",
    "expr": [
      "EQ",
      "prohibited_behaviors",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "insider_trading_or_leakage",
            true
          ],
          [
            "EQ",
            "self_dealing_or_conflict_of_interest",
            true
          ],
          [
            "EQ",
            "fraudulent_or_misleading_acts",
            true
          ],
          [
            "EQ",
            "failure_to_return_commission_or_benefits_to_fund",
            true
          ],
          [
            "EQ",
            "providing_or_receiving_undue_benefits_for_promotion",
            true
          ],
          [
            "EQ",
            "selling_proxy_votes_for_money_or_benefits",
            true
          ],
          [
            "EQ",
            "manipulating_security_prices_or_harming_investors",
            true
          ],
          [
            "EQ",
            "improper_account_transfer_between_fund_and_others",
            true
          ],
          [
            "EQ",
            "public_promotion_or_forecasting_of_specific_securities",
            true
          ],
          [
            "EQ",
            "using_non_professional_personnel_or_unreasonable_commissions",
            true
          ],
          [
            "EQ",
            "unauthorized_agent_trading_except_legal_representative",
            true
          ],
          [
            "EQ",
            "other_acts_harming_beneficiaries_or_fund_operations",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "securities:confidentiality_duty",
    "desc": "負責人及業務人員應保守受益人及客戶資料秘密",
    "expr": [
      "EQ",
      "confidentiality_duty",
      [
        "EQ",
        "confidentiality_observed",
        true
      ]
    ],
    "weight": 1,
    "domain": "securities"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反禁止交易期間規定、未申報交易、違反善良管理義務、從事禁止行為或違反保密義務時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "fund_holding_stock_or_equity_derivative",
            true
          ],
          [
            "EQ",
            "person_or_related_party_trading",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "person_or_related_party_trading",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "trading_reported_to_fund",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "good_faith_duty",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_behaviors",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "confidentiality_duty",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]