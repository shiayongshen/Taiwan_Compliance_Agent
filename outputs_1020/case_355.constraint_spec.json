[
  {
    "id": "insurance:investment_limit_financial_bonds",
    "desc": "金融債券等投資總額不得超過保險業資金35%",
    "expr": [
      "EQ",
      "investment_limit_financial_bonds",
      [
        "LE",
        "financial_bonds_total",
        [
          "MUL",
          "insurance_funds",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_per_company_amount",
    "desc": "每一公司股票投資金額不得超過保險業資金5%",
    "expr": [
      "EQ",
      "investment_limit_stock_per_company_amount",
      [
        "LE",
        "stock_investment_per_company_amount",
        [
          "MUL",
          "insurance_funds",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_per_company_shares",
    "desc": "每一公司股票投資股份數不得超過該公司已發行股份總數10%",
    "expr": [
      "EQ",
      "investment_limit_stock_per_company_shares",
      [
        "LE",
        "stock_investment_per_company_shares",
        [
          "MUL",
          "company_total_shares",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_and_equity_securities_per_company_amount",
    "desc": "每一公司股票及其他股權性質有價證券投資總額不得超過保險業資金5%",
    "expr": [
      "EQ",
      "investment_limit_stock_and_equity_securities_per_company_amount",
      [
        "LE",
        "stock_and_equity_securities_per_company_amount",
        [
          "MUL",
          "insurance_funds",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_corporate_bonds_per_company_amount",
    "desc": "每一公司公司債及免保證商業本票投資總額不得超過保險業資金5%",
    "expr": [
      "EQ",
      "investment_limit_corporate_bonds_per_company_amount",
      [
        "LE",
        "corporate_bonds_and_commercial_paper_per_company_amount",
        [
          "MUL",
          "insurance_funds",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_corporate_bonds_per_company_equity",
    "desc": "每一公司公司債及免保證商業本票投資總額不得超過該公司業主權益10%",
    "expr": [
      "EQ",
      "investment_limit_corporate_bonds_per_company_equity",
      [
        "LE",
        "corporate_bonds_and_commercial_paper_per_company_amount",
        [
          "MUL",
          "company_equity",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_fund_total_amount",
    "desc": "證券投資信託基金及共同信託基金投資總額不得超過保險業資金10%",
    "expr": [
      "EQ",
      "investment_limit_fund_total_amount",
      [
        "LE",
        "fund_investment_total_amount",
        [
          "MUL",
          "insurance_funds",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_fund_per_fund_beneficiary_shares",
    "desc": "每一基金受益憑證投資不得超過該基金已發行受益憑證總額10%",
    "expr": [
      "EQ",
      "investment_limit_fund_per_fund_beneficiary_shares",
      [
        "LE",
        "fund_investment_per_fund_beneficiary_shares",
        [
          "MUL",
          "fund_total_beneficiary_shares",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_securitized_products_total",
    "desc": "證券化商品及其他核准有價證券投資總額不得超過保險業資金10%",
    "expr": [
      "EQ",
      "investment_limit_securitized_products_total",
      [
        "LE",
        "securitized_products_total_amount",
        [
          "MUL",
          "insurance_funds",
          10.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:investment_limit_stock_and_corporate_bonds_combined",
    "desc": "股票及公司債投資總額合計不得超過保險業資金35%",
    "expr": [
      "EQ",
      "investment_limit_stock_and_corporate_bonds_combined",
      [
        "LE",
        [
          "ADD",
          "stock_investment_total_amount",
          "corporate_bonds_investment_total_amount"
        ],
        [
          "MUL",
          "insurance_funds",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:prohibited_investment_behavior",
    "desc": "禁止保險業及其代表人擔任被投資公司董事、監察人、行使表決權、指派經理人、擔任信託監察人及參與經營",
    "expr": [
      "EQ",
      "prohibited_investment_behavior",
      [
        "NOT",
        [
          "OR",
          "insurance_or_representative_is_director_or_supervisor",
          "insurance_or_representative_exercises_voting_rights",
          "insurance_or_representative_appoints_manager",
          "insurance_or_representative_is_trust_supervisor",
          "insurance_or_representative_participates_in_management"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反投資限額或禁止行為時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "investment_limit_financial_bonds",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_per_company_amount",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_per_company_shares",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_and_equity_securities_per_company_amount",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_corporate_bonds_per_company_amount",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_corporate_bonds_per_company_equity",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_fund_total_amount",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_fund_per_fund_beneficiary_shares",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_securitized_products_total",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_limit_stock_and_corporate_bonds_combined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "prohibited_investment_behavior",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]