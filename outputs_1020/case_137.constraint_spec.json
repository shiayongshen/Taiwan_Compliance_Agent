  {
    "id": "insurance:loan_allowance_minimum_met",
    "desc": "備抵呆帳金額符合最低標準",
    "expr": [
      "EQ",
      "loan_allowance_minimum_met",
      [
        "OR",
        [
          "GE",
          "allowance_amount",
          [
            "ADD",
            [
              "MUL",
              [
                "SUB",
                "loan_class_1_amount",
                [
                  "ADD",
                  "life_insurance_loan",
                  "prepaid_premium",
                  "gov_claim"
                ]
              ],
              0.005
            ],
            [
              "MUL",
              "loan_class_2_amount",
              0.02
            ],
            [
              "MUL",
              "loan_class_3_amount",
              0.1
            ],
            [
              "MUL",
              "loan_class_4_amount",
              0.5
            ],
            [
              "MUL",
              "loan_class_5_amount",
              1.0
            ]
          ]
        ],
        [
          "GE",
          "allowance_amount",
          [
            "MUL",
            [
              "ADD",
              [
                "SUB",
                "loan_class_1_amount",
                [
                  "ADD",
                  "life_insurance_loan",
                  "prepaid_premium",
                  "gov_claim"
                ]
              ],
              "loan_class_2_amount",
              "loan_class_3_amount",
              "loan_class_4_amount",
              "loan_class_5_amount"
            ],
            0.01
          ]
        ],
        [
          "GE",
          "allowance_amount",
          "unsecured_overdue_loan_amount"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
