        "personal_data_preservation_procedure_compliant",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_execution_compliance",
    "desc": "依第六條、第七條、第八條及前條所訂定之招攬、核保及理賠處理制度及程序確實執行",
    "expr": [
      "EQ",
      "underwriting_execution_compliance",
      [
        "EQ",
        "underwriting_systems_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:underwriting_staff_discipline",
    "desc": "對未依規定執行業務之招攬、核保及理賠人員予以警告或適當處置",
    "expr": [
      "EQ",
      "underwriting_staff_discipline",
      [
        "EQ",
        "staff_discipline_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_compliance_full",
    "desc": "內部控制及稽核制度建立且執行符合規定",
    "expr": [
      "EQ",
      "internal_control_compliance_full",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_compliance_full",
    "desc": "內部處理制度及程序建立且執行符合規定",
    "expr": [
      "EQ",
      "internal_handling_compliance_full",
      [
        "AND",
        [
          "EQ",
          "internal_handling_established",
          true
        ],
        [
          "EQ",
          "internal_handling_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立或未執行內部控制或稽核制度，或未建立或未執行內部處理制度或程序時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "internal_control_compliance_full",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_compliance_full",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]