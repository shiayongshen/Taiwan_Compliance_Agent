        "report_to_authority_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:insurance_notification_mechanism_compliance",
    "desc": "保險通報機制執行及查詢作業符合規定",
    "expr": [
      "EQ",
      "insurance_notification_mechanism_compliance",
      [
        "EQ",
        "notification_mechanism_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:personal_data_preservation_compliance",
