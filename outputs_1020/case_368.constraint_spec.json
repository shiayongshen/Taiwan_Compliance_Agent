[
  {
    "id": "bank:money_market_or_credit_card_business_permit",
    "desc": "經營貨幣市場業務或信用卡業務須經中央主管機關許可",
    "expr": [
      "EQ",
      "money_market_or_credit_card_business_permit",
      [
        "IMPLIES",
        [
          "EQ",
          "operates_money_market_or_credit_card_business",
          true
        ],
        [
          "EQ",
          "central_authority_permit_granted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:cash_card_or_credit_card_interest_rate_limit",
    "desc": "現金卡利率或信用卡循環信用利率不得超過年利率15%",
    "expr": [
      "EQ",
      "cash_card_or_credit_card_interest_rate_limit",
      [
        "AND",
        [
          "LE",
          "cash_card_interest_rate_annual_percent",
          15.0
        ],
        [
          "LE",
          "credit_card_revolving_interest_rate_annual_percent",
          15.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:violation_penalty_applicable",
    "desc": "違反銀行法或授權命令中強制或禁止規定者，處罰適用",
    "expr": [
      "EQ",
      "violation_penalty_applicable",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "law_or_order_mandatory_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "law_or_order_prohibition_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "law_or_order_required_action_compliance",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "credit_card:reporting_and_disclosure_compliance",
    "desc": "信用卡業務機構依主管機關及中央銀行規定申報及揭露資料且資料正確",
    "expr": [
      "EQ",
      "reporting_and_disclosure_compliance",
      [
        "AND",
        [
          "EQ",
          "reporting_to_authorities",
          true
        ],
        [
          "EQ",
          "disclosure_on_website",
          true
        ],
        [
          "EQ",
          "data_truthfulness",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:bad_debt_provisioning",
    "desc": "逾期帳款備抵呆帳提列符合規定",
    "expr": [
      "EQ",
      "bad_debt_provisioning",
      [
        "AND",
        [
          "GE",
          "bad_debt_provision_1_to_3_months",
          [
            "MUL",
            "total_advance_amount",
            0.02
          ]
        ],
        [
          "GE",
          "bad_debt_provision_3_to_6_months",
          [
            "MUL",
            "total_advance_amount",
            0.5
          ]
        ],
        [
          "GE",
          "bad_debt_provision_over_6_months",
          "bad_debt_provision_amount_over_6_months"
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:bad_debt_write_off",
    "desc": "逾期六個月未繳足帳款應於三個月內轉銷為呆帳",
    "expr": [
      "EQ",
      "bad_debt_write_off",
      [
        "IMPLIES",
        [
          "GT",
          "overdue_minimum_payment_months",
          6
        ],
        [
          "AND",
          [
            "LE",
            "write_off_within_months_after_6_months",
            3
          ],
          [
            "EQ",
            "bad_debt_write_off_completed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:write_off_approval_and_reporting",
    "desc": "逾期帳款轉銷須依董(理)事會授權核准並彙報",
    "expr": [
      "EQ",
      "write_off_approval_and_reporting",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "write_off_approved_by_authorized_personnel",
            true
          ],
          [
            "EQ",
            "write_off_reported_to_board",
            true
          ]
        ],
        [
          "EQ",
          "foreign_credit_card_company_authorized_procedure",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:overdue_ratio_adjustment",
    "desc": "逾期帳款比率超過主管機關規定應調整並接受監理措施",
    "expr": [
      "EQ",
      "overdue_ratio_adjustment",
      [
        "IMPLIES",
        [
          "GT",
          "overdue_account_ratio",
          "regulatory_overdue_ratio_limit"
        ],
        [
          "EQ",
          "adjustment_and_supervisory_measures_taken",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "credit_card:internal_control_and_audit_established",
    "desc": "信用卡業務機構建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_and_audit_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "credit_card"
  },
  {
    "id": "bank:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "IMPLIES",
      [
        "AND",
        [
          "EQ",
          "law_or_order_mandatory_compliance",
          true
        ],
        [
          "EQ",
          "law_or_order_prohibition_compliance",
          true
        ],
        [
          "EQ",
          "law_or_order_required_action_compliance",
          true
        ],
        [
          "EQ",
          "cash_card_or_credit_card_interest_rate_limit",
          true
        ],
        [
          "EQ",
          "reporting_and_disclosure_compliance",
          true
        ],
        [
          "EQ",
          "bad_debt_provisioning",
          true
        ],
        [
          "EQ",
          "bad_debt_write_off",
          true
        ],
        [
          "EQ",
          "write_off_approval_and_reporting",
          true
        ],
        [
          "EQ",
          "internal_control_and_audit_established",
          true
        ],
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "operates_money_market_or_credit_card_business",
              true
            ]
          ],
          [
            "EQ",
            "central_authority_permit_granted",
            true
          ]
        ],
        [
          "OR",
          [
            "LE",
            "overdue_account_ratio",
            "regulatory_overdue_ratio_limit"
          ],
          [
            "EQ",
            "adjustment_and_supervisory_measures_taken",
            true
          ]
        ]
      ],
      [
        "EQ",
        "penalty",
        false
      ]
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "bank:penalty_conditions",
    "desc": "處罰條件：違反銀行法或信用卡業務管理辦法相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "operates_money_market_or_credit_card_business",
            true
          ],
          [
            "NOT",
            [
              "EQ",
              "central_authority_permit_granted",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "AND",
            [
              "LE",
              "cash_card_interest_rate_annual_percent",
              15.0
            ],
            [
              "LE",
              "credit_card_revolving_interest_rate_annual_percent",
              15.0
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "law_or_order_mandatory_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "law_or_order_prohibition_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "law_or_order_required_action_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "reporting_and_disclosure_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bad_debt_provisioning",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "bad_debt_write_off",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "write_off_approval_and_reporting",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "GT",
            "overdue_account_ratio",
            "regulatory_overdue_ratio_limit"
          ],
          [
            "NOT",
            [
              "EQ",
              "adjustment_and_supervisory_measures_taken",
              true
            ]
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]