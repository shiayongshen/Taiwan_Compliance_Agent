[
  {
    "id": "fhc:subsidiary_business_scope_ok",
    "desc": "子公司業務限於投資及對被投資事業之管理",
    "expr": [
      "EQ",
      "subsidiary_business_scope_ok",
      [
        "AND",
        [
          "EQ",
          "subsidiary_business_investment",
          true
        ],
        [
          "EQ",
          "subsidiary_business_management",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:investment_target_approved",
    "desc": "投資事業為主管機關核准之範圍",
    "expr": [
      "EQ",
      "investment_target_approved",
      [
        "OR",
        [
          "EQ",
          "investment_in_fhc",
          true
        ],
        [
          "EQ",
          "investment_in_bank",
          true
        ],
        [
          "EQ",
          "investment_in_bill_finance",
          true
        ],
        [
          "EQ",
          "investment_in_credit_card",
          true
        ],
        [
          "EQ",
          "investment_in_trust",
          true
        ],
        [
          "EQ",
          "investment_in_insurance",
          true
        ],
        [
          "EQ",
          "investment_in_securities",
          true
        ],
        [
          "EQ",
          "investment_in_futures",
          true
        ],
        [
          "EQ",
          "investment_in_venture_capital",
          true
        ],
        [
          "EQ",
          "investment_in_foreign_financial_institution_approved",
          true
        ],
        [
          "EQ",
          "investment_in_other_financial_related_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:bank_includes_types",
    "desc": "銀行業包括商業銀行、專業銀行及信託投資公司",
    "expr": [
      "EQ",
      "bank_type_valid",
      [
        "OR",
        [
          "EQ",
          "bank_is_commercial",
          true
        ],
        [
          "EQ",
          "bank_is_professional",
          true
        ],
        [
          "EQ",
          "bank_is_trust_investment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:insurance_includes_types",
    "desc": "保險業包括財產保險業、人身保險業、再保險公司、保險代理人及經紀人",
    "expr": [
      "EQ",
      "insurance_type_valid",
      [
        "OR",
        [
          "EQ",
          "insurance_is_property",
          true
        ],
        [
          "EQ",
          "insurance_is_life",
          true
        ],
        [
          "EQ",
          "insurance_is_reinsurance",
          true
        ],
        [
          "EQ",
          "insurance_is_agent",
          true
        ],
        [
          "EQ",
          "insurance_is_broker",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:securities_includes_types",
    "desc": "證券業包括證券商、證券投資信託事業、證券投資顧問事業",
    "expr": [
      "EQ",
      "securities_type_valid",
      [
        "OR",
        [
          "EQ",
          "securities_is_broker",
          true
        ],
        [
          "EQ",
          "securities_is_trust",
          true
        ],
        [
          "EQ",
          "securities_is_advisor",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:futures_includes_types",
    "desc": "期貨業包括期貨商、槓桿交易商、期貨信託事業、期貨經理事業及期貨顧問事業",
    "expr": [
      "EQ",
      "futures_type_valid",
      [
        "OR",
        [
          "EQ",
          "futures_is_broker",
          true
        ],
        [
          "EQ",
          "futures_is_leveraged_trader",
          true
        ],
        [
          "EQ",
          "futures_is_trust",
          true
        ],
        [
          "EQ",
          "futures_is_manager",
          true
        ],
        [
          "EQ",
          "futures_is_advisor",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:investment_approval_status",
    "desc": "投資事業申請核准後，主管機關未於期限內反對視為核准",
    "expr": [
      "EQ",
      "investment_approved",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "investment_target_in_1_to_9",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "authority_opposed_within_15_days",
              false
            ],
            [
              "NOT",
              [
                "EQ",
                "authority_opposed_within_15_days",
                true
              ]
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "investment_target_in_10_or_11",
            true
          ],
          [
            "OR",
            [
              "EQ",
              "authority_opposed_within_30_days",
              false
            ],
            [
              "NOT",
              [
                "EQ",
                "authority_opposed_within_30_days",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:investment_without_approval_prohibited",
    "desc": "未經核准不得進行申請之投資行為",
    "expr": [
      "EQ",
      "investment_without_approval_prohibited",
      [
        "IMPLIES",
        [
          "NOT",
          [
            "EQ",
            "investment_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_performed",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_business_or_investment_exceed_limit",
    "desc": "子公司業務或投資逾越法令規定範圍",
    "expr": [
      "EQ",
      "subsidiary_business_or_investment_exceed_limit",
      [
        "OR",
        [
          "EQ",
          "subsidiary_business_exceed_limit",
          true
        ],
        [
          "EQ",
          "subsidiary_investment_exceed_limit",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:adjustment_ordered",
    "desc": "主管機關限期命金融控股公司調整逾越範圍之子公司業務或投資",
    "expr": [
      "EQ",
      "adjustment_ordered",
      [
        "IMPLIES",
        [
          "EQ",
          "subsidiary_business_or_investment_exceed_limit",
          true
        ],
        [
          "EQ",
          "authority_order_adjustment",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:adjustment_period_limit",
    "desc": "調整期限最長三年，得申請延長二次，每次二年",
    "expr": [
      "EQ",
      "adjustment_period_valid",
      [
        "AND",
        [
          "LE",
          "adjustment_period_years",
          3
        ],
        [
          "OR",
          [
            "EQ",
            "adjustment_extension_times",
            0
          ],
          [
            "AND",
            [
              "LE",
              "adjustment_extension_times",
              2
            ],
            [
              "LE",
              "adjustment_extension_years_per_time",
              2
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:fhc_officer_not_manager_of_venture_invested",
    "desc": "金融控股公司負責人或職員不得擔任創業投資事業所投資事業經理人",
    "expr": [
      "EQ",
      "fhc_officer_not_manager_of_venture_invested",
      [
        "NOT",
        [
          "EQ",
          "fhc_officer_is_manager_of_venture_invested",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:subsidiary_capital_reduction_approval",
    "desc": "子公司減資應事先申請核准",
    "expr": [
      "EQ",
      "subsidiary_capital_reduction_approved",
      [
        "IMPLIES",
        [
          "EQ",
          "subsidiary_capital_reduction_applied",
          true
        ],
        [
          "EQ",
          "subsidiary_capital_reduction_approval_granted",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_and_audit_established",
    "desc": "金融控股公司應建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "audit_system_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_and_audit_executed",
    "desc": "金融控股公司應確實執行內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_executed",
      [
        "AND",
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "audit_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:violation_penalty_conditions",
    "desc": "違反法令、章程或有礙健全經營之虞時主管機關得為處分",
    "expr": [
      "EQ",
      "violation_penalty_applicable",
      [
        "OR",
        [
          "EQ",
          "violate_law",
          true
        ],
        [
          "EQ",
          "violate_articles",
          true
        ],
        [
          "EQ",
          "impair_sound_operation",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_imposed_for_violation",
    "desc": "違反規定時主管機關得處分",
    "expr": [
      "EQ",
      "penalty_imposed_for_violation",
      [
        "IMPLIES",
        [
          "EQ",
          "violation_penalty_applicable",
          true
        ],
        [
          "EQ",
          "penalty_imposed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholder_reporting_compliance",
    "desc": "同一人或同一關係人持股超過規定比例應申報及申請核准",
    "expr": [
      "EQ",
      "shareholder_reporting_compliance",
      [
        "AND",
        [
          "IMPLIES",
          [
            "GT",
            "shareholding_percent",
            5.0
          ],
          [
            "EQ",
            "shareholding_reported",
            true
          ]
        ],
        [
          "IMPLIES",
          [
            "OR",
            [
              "GT",
              "shareholding_percent",
              10.0
            ],
            [
              "GT",
              "shareholding_percent",
              25.0
            ],
            [
              "GT",
              "shareholding_percent",
              50.0
            ]
          ],
          [
            "EQ",
            "shareholding_approval_granted",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_excess_no_voting_right",
    "desc": "未申報或未核准持股超過部分無表決權",
    "expr": [
      "EQ",
      "shareholding_excess_no_voting_right",
      [
        "IMPLIES",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "shareholding_reported",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "shareholding_approval_granted",
              true
            ]
          ]
        ],
        [
          "EQ",
          "excess_shares_no_voting_right",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:shareholding_excess_must_dispose",
    "desc": "主管機關命限期處分超過部分股份",
    "expr": [
      "EQ",
      "shareholding_excess_must_dispose",
      [
        "IMPLIES",
        [
          "EQ",
          "excess_shares_no_voting_right",
          true
        ],
        [
          "EQ",
          "authority_order_dispose_excess_shares",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_system_comprehensive",
    "desc": "內部控制制度涵蓋所有營運活動並訂定適當政策及程序",
    "expr": [
      "EQ",
      "internal_control_system_comprehensive",
      [
        "AND",
        [
          "EQ",
          "internal_control_covers_all_operations",
          true
        ],
        [
          "EQ",
          "internal_control_policies_and_procedures_defined",
          true
        ],
        [
          "EQ",
          "internal_control_policies_and_procedures_reviewed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_required_policies",
    "desc": "內部控制制度應包含組織規程、業務規範及處理手冊等多項政策",
    "expr": [
      "EQ",
      "internal_control_required_policies_defined",
      [
        "AND",
        [
          "EQ",
          "organization_rules_defined",
          true
        ],
        [
          "EQ",
          "business_regulations_defined",
          true
        ],
        [
          "EQ",
          "operation_manual_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:internal_control_subsidiary_management",
    "desc": "內部控制制度應包含子公司管理及共同行銷管理",
    "expr": [
      "EQ",
      "internal_control_subsidiary_management_defined",
      [
        "AND",
        [
          "EQ",
          "subsidiary_management_defined",
          true
        ],
        [
          "EQ",
          "joint_marketing_management_defined",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反金融控股公司法第36條、第51條、第54條、第60條及相關規定時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "subsidiary_business_scope_ok",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_target_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "investment_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_executed",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "shareholder_reporting_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "fhc_officer_not_manager_of_venture_invested",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "subsidiary_capital_reduction_approved",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_system_comprehensive",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_required_policies_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_subsidiary_management_defined",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "violation_penalty_applicable",
            false
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]