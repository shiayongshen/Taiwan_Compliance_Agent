    "expr": [
      "EQ",
      "penalty_violation_financial_business",
      [
        "OR",
        [
          "EQ",
          "capital_level_4_penalty_condition",
          true
        ],
        [
          "EQ",
          "supervisory_measures_applicable",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
