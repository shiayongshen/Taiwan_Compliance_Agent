[
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            0.25
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            0.25
          ],
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.0
          ],
          [
            "LT",
            [
              "DIV",
              "own_capital",
              "risk_capital"
            ],
            1.0
          ]
        ],
        2,
        [
          "GE",
          [
            "DIV",
            "own_capital",
            "risk_capital"
          ],
          1.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_ratio_minimum",
    "desc": "自有資本與風險資本比率不得低於一定比率",
    "expr": [
      "EQ",
      "capital_ratio_minimum",
      [
        "GE",
        [
          "DIV",
          "own_capital",
          "risk_capital"
        ],
        "minimum_ratio"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:net_worth_ratio_minimum",
    "desc": "淨值比率不得低於一定比率",
    "expr": [
      "EQ",
      "net_worth_ratio_minimum",
      [
        "GE",
        "net_worth_ratio",
        "minimum_net_worth_ratio"
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_info_reported",
    "desc": "保險業依規定申報資本等級相關資訊",
    "expr": [
      "EQ",
      "capital_info_reported",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "annual_report_submitted",
            true
          ],
          [
            "LE",
            "annual_report_submission_months",
            3
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "semiannual_report_submitted",
            true
          ],
          [
            "LE",
            "semiannual_report_submission_months",
            2
          ]
        ],
        [
          "EQ",
          "special_report_ordered",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_info_reported_exclude_takeover",
    "desc": "依法接管之保險業不適用申報規定",
    "expr": [
      "EQ",
      "capital_info_reported_exclude_takeover",
      [
        "OR",
        [
          "EQ",
          "under_takeover",
          false
        ],
        [
          "EQ",
          "capital_info_reported",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本比率或淨值比率低於最低標準，或未依規定申報資本等級資訊時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "capital_ratio_minimum",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "net_worth_ratio_minimum",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "under_takeover",
            false
          ],
          [
            "NOT",
            [
              "EQ",
              "capital_info_reported",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]