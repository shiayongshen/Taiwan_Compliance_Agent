[
  {
    "id": "aml:internal_control_established",
    "desc": "建立洗錢防制內部控制與稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "AND",
        [
          "EQ",
          "control_procedures_established",
          true
        ],
        [
          "EQ",
          "training_held_regularly",
          true
        ],
        [
          "EQ",
          "dedicated_personnel_assigned",
          true
        ],
        [
          "EQ",
          "risk_assessment_report_updated",
          true
        ],
        [
          "EQ",
          "audit_procedures_established",
          true
        ],
        [
          "EQ",
          "other_designated_matters_complied",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:control_procedures_established",
    "desc": "防制洗錢及打擊資恐之作業及控制程序已建立",
    "expr": [
      "EQ",
      "control_procedures_established",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:training_held_regularly",
    "desc": "定期舉辦或參加防制洗錢之在職訓練",
    "expr": [
      "EQ",
      "training_held_regularly",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:dedicated_personnel_assigned",
    "desc": "指派專責人員負責協調監督防制洗錢作業及控制程序執行",
    "expr": [
      "EQ",
      "dedicated_personnel_assigned",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:risk_assessment_report_updated",
    "desc": "備置並定期更新防制洗錢及打擊資恐風險評估報告",
    "expr": [
      "EQ",
      "risk_assessment_report_updated",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:audit_procedures_established",
    "desc": "建立稽核程序",
    "expr": [
      "EQ",
      "audit_procedures_established",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:other_designated_matters_complied",
    "desc": "遵守其他經中央目的事業主管機關指定之事項",
    "expr": [
      "EQ",
      "other_designated_matters_complied",
      true
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:internal_control_compliance",
    "desc": "洗錢防制內部控制與稽核制度完整且符合規定",
    "expr": [
      "EQ",
      "internal_control_compliance",
      [
        "EQ",
        "internal_control_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:inspection_cooperation",
    "desc": "配合中央目的事業主管機關查核，不規避、拒絕或妨礙查核",
    "expr": [
      "EQ",
      "inspection_cooperation",
      [
        "NOT",
        [
          "EQ",
          "inspection_obstruction",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:financial_institution",
    "desc": "為金融機構",
    "expr": [
      "EQ",
      "financial_institution",
      [
        "OR",
        [
          "EQ",
          "institution_type",
          1
        ],
        [
          "EQ",
          "institution_type",
          2
        ],
        [
          "EQ",
          "institution_type",
          3
        ],
        [
          "EQ",
          "institution_type",
          4
        ],
        [
          "EQ",
          "institution_type",
          5
        ],
        [
          "EQ",
          "institution_type",
          6
        ],
        [
          "EQ",
          "institution_type",
          7
        ],
        [
          "EQ",
          "institution_type",
          8
        ],
        [
          "EQ",
          "institution_type",
          9
        ],
        [
          "EQ",
          "institution_type",
          10
        ],
        [
          "EQ",
          "institution_type",
          11
        ],
        [
          "EQ",
          "institution_type",
          12
        ],
        [
          "EQ",
          "institution_type",
          13
        ],
        [
          "EQ",
          "institution_type",
          14
        ],
        [
          "EQ",
          "institution_type",
          15
        ],
        [
          "EQ",
          "institution_type",
          16
        ],
        [
          "EQ",
          "institution_type",
          17
        ],
        [
          "EQ",
          "institution_type",
          18
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:designated_non_financial_business",
    "desc": "為指定之非金融事業或人員",
    "expr": [
      "EQ",
      "designated_non_financial_business",
      [
        "OR",
        [
          "EQ",
          "non_financial_type",
          1
        ],
        [
          "EQ",
          "non_financial_type",
          2
        ],
        [
          "EQ",
          "non_financial_type",
          3
        ],
        [
          "EQ",
          "non_financial_type",
          4
        ],
        [
          "EQ",
          "non_financial_type",
          5
        ],
        [
          "EQ",
          "non_financial_type",
          6
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "aml:compliance_with_internal_control_requirement",
    "desc": "金融機構及指定非金融事業或人員依洗錢防制法第7條建立並執行內部控制制度",
    "expr": [
      "EQ",
      "compliance_with_internal_control_requirement",
      [
        "AND",
        [
          "OR",
          [
            "EQ",
            "financial_institution",
            true
          ],
          [
            "EQ",
            "designated_non_financial_business",
            true
          ]
        ],
        [
          "EQ",
          "internal_control_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "aml"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：未建立制度或妨礙查核時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "OR",
            [
              "EQ",
              "financial_institution",
              true
            ],
            [
              "EQ",
              "designated_non_financial_business",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "internal_control_established",
              true
            ]
          ]
        ],
        [
          "EQ",
          "inspection_obstruction",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]