[
  {
    "id": "fhc:capital_level",
    "desc": "保險業資本等級分類（1=資本適足, 2=資本不足, 3=資本顯著不足, 4=資本嚴重不足, 0=未分類）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            [
              "MUL",
              [
                "DIV",
                "capital_adequacy_ratio",
                "risk_capital"
              ],
              100.0
            ],
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  "risk_capital"
                ],
                100.0
              ],
              50.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  "risk_capital"
                ],
                100.0
              ],
              150.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev",
                  1.0
                ],
                100.0
              ],
              3.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio",
                  1.0
                ],
                100.0
              ],
              3.0
            ],
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev",
                  1.0
                ],
                100.0
              ],
              0.0
            ]
          ]
        ],
        3,
        [
          "OR",
          [
            "AND",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  "risk_capital"
                ],
                100.0
              ],
              150.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "capital_adequacy_ratio",
                  "risk_capital"
                ],
                100.0
              ],
              200.0
            ]
          ],
          [
            "AND",
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev",
                  1.0
                ],
                100.0
              ],
              2.0
            ],
            [
              "LT",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio",
                  1.0
                ],
                100.0
              ],
              2.0
            ],
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev",
                  1.0
                ],
                100.0
              ],
              0.0
            ]
          ]
        ],
        2,
        [
          "AND",
          [
            "GE",
            [
              "MUL",
              [
                "DIV",
                "capital_adequacy_ratio",
                "risk_capital"
              ],
              100.0
            ],
            200.0
          ],
          [
            "OR",
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio_prev",
                  1.0
                ],
                100.0
              ],
              3.0
            ],
            [
              "GE",
              [
                "MUL",
                [
                  "DIV",
                  "net_worth_ratio",
                  1.0
                ],
                100.0
              ],
              3.0
            ]
          ]
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_level_lowest",
    "desc": "保險業資本等級以較低等級為最終資本等級",
    "expr": [
      "EQ",
      "final_capital_level",
      "capital_level"
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_adequacy_ratio",
    "desc": "保險業資本適足率計算",
    "expr": [
      "EQ",
      "capital_adequacy_ratio",
      [
        "MUL",
        [
          "DIV",
          "own_capital",
          "risk_capital"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:net_worth_ratio",
    "desc": "保險業淨值比率計算",
    "expr": [
      "EQ",
      "net_worth_ratio",
      [
        "MUL",
        [
          "DIV",
          "owner_equity",
          "total_assets_excluding_investment_accounts"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:net_worth_ratio_prev",
    "desc": "保險業最近一期淨值比率",
    "expr": [
      "EQ",
      "net_worth_ratio_prev",
      [
        "MUL",
        [
          "DIV",
          "owner_equity_prev",
          "total_assets_excluding_investment_accounts_prev"
        ],
        100.0
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_adequacy_compliance",
    "desc": "資本適足率及淨值比率符合最低標準",
    "expr": [
      "EQ",
      "capital_adequacy_compliance",
      [
        "AND",
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        [
          "OR",
          [
            "GE",
            "net_worth_ratio",
            3.0
          ],
          [
            "GE",
            "net_worth_ratio_prev",
            3.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_insufficient",
    "desc": "資本不足等級（2、3、4）",
    "expr": [
      "EQ",
      "capital_insufficient",
      [
        "GE",
        "final_capital_level",
        2
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_severely_insufficient_measures_executed",
    "desc": "資本嚴重不足等級措施已執行",
    "expr": [
      "EQ",
      "severely_insufficient_measures_executed",
      [
        "EQ",
        "level_4_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_significantly_insufficient_measures_executed",
    "desc": "資本顯著不足等級措施已執行",
    "expr": [
      "EQ",
      "significantly_insufficient_measures_executed",
      [
        "EQ",
        "level_3_measures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "fhc:capital_insufficient_measures_executed",
    "desc": "資本不足等級措施已執行",
    "expr": [
      "EQ",
      "insufficient_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "fhc"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：資本不足且未執行對應等級措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "AND",
          [
            "EQ",
            "final_capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "severely_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "final_capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "significantly_insufficient_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "final_capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "insufficient_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]