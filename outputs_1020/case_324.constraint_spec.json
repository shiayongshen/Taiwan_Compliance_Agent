[
  {
    "id": "insurance:real_estate_investment_limit",
    "desc": "不動產投資總額除自用不動產外不得超過資金30%，自用不動產不得超過業主權益總額",
    "expr": [
      "EQ",
      "real_estate_investment_limit",
      [
        "AND",
        [
          "LE",
          [
            "SUB",
            "total_real_estate_investment",
            "self_use_real_estate_investment"
          ],
          [
            "MUL",
            "capital_fund",
            30.0
          ]
        ],
        [
          "LE",
          "self_use_real_estate_investment",
          "owner_equity"
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_legal_valuation",
    "desc": "不動產取得及處分應經合法不動產鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_legal_valuation",
      [
        "EQ",
        "legal_valuation_done",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_immediate_use_exemption",
    "desc": "依住宅法興辦社會住宅且僅供租賃者，不受即時利用並有收益限制",
    "expr": [
      "EQ",
      "real_estate_immediate_use_exemption",
      [
        "EQ",
        "social_housing_only_rental",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_immediate_use_and_income",
    "desc": "不動產投資以即時利用並有收益者為限（除社會住宅外）",
    "expr": [
      "EQ",
      "real_estate_immediate_use_and_income",
      [
        "OR",
        [
          "EQ",
          "real_estate_immediate_use_exemption",
          true
        ],
        [
          "EQ",
          "real_estate_immediate_use_and_income_confirmed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_type_limit_per_unit",
    "desc": "第一款至第三款放款每一單位放款金額不得超過資金5%",
    "expr": [
      "EQ",
      "loan_type_limit_per_unit",
      [
        "LE",
        "single_loan_amount",
        [
          "MUL",
          "capital_fund",
          5.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_type_limit_total",
    "desc": "第一款至第三款放款總額不得超過資金35%",
    "expr": [
      "EQ",
      "loan_type_limit_total",
      [
        "LE",
        "total_loan_amount",
        [
          "MUL",
          "capital_fund",
          35.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_condition",
    "desc": "對負責人、職員或主要股東等利害關係人擔保放款應有十足擔保且條件不得優於其他同類放款",
    "expr": [
      "EQ",
      "loan_guarantee_condition",
      [
        "AND",
        [
          "EQ",
          "full_guarantee",
          true
        ],
        [
          "EQ",
          "no_better_terms_than_others",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_guarantee_approval",
    "desc": "擔保放款達主管機關規定金額以上，應經三分之二以上董事出席及四分之三以上同意",
    "expr": [
      "EQ",
      "loan_guarantee_approval",
      [
        "IMPLIES",
        [
          "GE",
          "guaranteed_loan_amount",
          "regulatory_threshold"
        ],
        [
          "AND",
          [
            "GE",
            "board_attendance_ratio",
            0.6666667
          ],
          [
            "GE",
            "board_approval_ratio",
            0.75
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:loan_investment_combined_limit",
    "desc": "有價證券投資與以該公司有價證券為質放款合併計算不得超過資金10%及公司業主權益10%",
    "expr": [
      "EQ",
      "loan_investment_combined_limit",
      [
        "AND",
        [
          "LE",
          [
            "ADD",
            "investment_in_securities",
            "loan_secured_by_securities"
          ],
          [
            "MUL",
            "capital_fund",
            10.0
          ]
        ],
        [
          "LE",
          [
            "ADD",
            "investment_in_securities",
            "loan_secured_by_securities"
          ],
          [
            "MUL",
            "issuer_owner_equity",
            10.0
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_types",
    "desc": "國外投資限於外匯存款、國外有價證券、核准保險相關事業及其他核准投資",
    "expr": [
      "EQ",
      "foreign_investment_types",
      [
        "OR",
        [
          "EQ",
          "foreign_investment_foreign_currency_deposit",
          true
        ],
        [
          "EQ",
          "foreign_investment_foreign_securities",
          true
        ],
        [
          "EQ",
          "foreign_investment_approved_insurance_related",
          true
        ],
        [
          "EQ",
          "foreign_investment_other_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_limit",
    "desc": "國外投資總額最高不得超過資金45%，特定項目金額不計入限額",
    "expr": [
      "EQ",
      "foreign_investment_limit",
      [
        "LE",
        "total_foreign_investment",
        [
          "MUL",
          "capital_fund",
          45.0
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:foreign_investment_exclusions",
    "desc": "不計入國外投資限額之金額包括核准銷售非投資型外幣保險商品、國內外幣計價股權債券憑證、核准國外保險相關事業及其他核准項目",
    "expr": [
      "EQ",
      "foreign_investment_exclusions",
      [
        "AND",
        [
          "EQ",
          "approved_non_investment_foreign_currency_insurance",
          true
        ],
        [
          "EQ",
          "investment_in_domestic_foreign_currency_securities",
          true
        ],
        [
          "EQ",
          "approved_foreign_insurance_related_investment",
          true
        ],
        [
          "EQ",
          "other_approved_exclusions",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:related_party_loan_limit_and_approval",
    "desc": "對負責人、職員或主要股東等利害關係人擔保放款應有十足擔保且條件不得優於其他同類放款，達規定金額以上須董事會同意",
    "expr": [
      "EQ",
      "related_party_loan_limit_and_approval",
      [
        "AND",
        [
          "EQ",
          "loan_guarantee_condition",
          true
        ],
        [
          "EQ",
          "loan_guarantee_approval",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_audit_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_and_audit_established",
      [
        "EQ",
        "internal_control_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_system_established",
    "desc": "建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_system_established",
      [
        "EQ",
        "internal_handling_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_4_measures_executed",
    "desc": "資本嚴重不足等級4措施已執行",
    "expr": [
      "EQ",
      "level_4_measures_executed",
      [
        "EQ",
        "level_4_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_3_measures_executed",
    "desc": "資本顯著不足等級3措施已執行",
    "expr": [
      "EQ",
      "level_3_measures_executed",
      [
        "EQ",
        "level_3_measures_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:level_2_measures_executed",
    "desc": "資本不足等級2措施已執行",
    "expr": [
      "EQ",
      "level_2_measures_executed",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反不動產投資限制或未經合法鑑價或不符放款擔保條件或未建立內部控制及稽核制度或資本不足且未執行對應措施時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_limit",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_legal_valuation",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "loan_guarantee_condition",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_and_audit_established",
            true
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            4
          ],
          [
            "NOT",
            [
              "EQ",
              "level_4_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            3
          ],
          [
            "NOT",
            [
              "EQ",
              "level_3_measures_executed",
              true
            ]
          ]
        ],
        [
          "AND",
          [
            "EQ",
            "capital_level",
            2
          ],
          [
            "NOT",
            [
              "EQ",
              "level_2_measures_executed",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]