[
  {
    "id": "insurance:real_estate_investment_compliance",
    "desc": "不動產投資符合即時利用有收益及投資額度限制",
    "expr": [
      "EQ",
      "real_estate_investment_compliance",
      [
        "OR",
        [
          "EQ",
          "social_housing_only_for_rent",
          true
        ],
        [
          "AND",
          [
            "EQ",
            "real_estate_investment_immediate_use_and_income",
            true
          ],
          [
            "LE",
            [
              "SUB",
              "total_real_estate_investment",
              "self_use_real_estate_investment"
            ],
            [
              "MUL",
              "capital",
              0.3
            ]
          ],
          [
            "LE",
            "self_use_real_estate_investment",
            "owner_equity"
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:real_estate_valuation_compliance",
    "desc": "不動產取得及處分經合法鑑價機構評價",
    "expr": [
      "EQ",
      "real_estate_valuation_compliance",
      [
        "EQ",
        "real_estate_valuation_by_legal_institution",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_established",
    "desc": "建立內部控制及稽核制度",
    "expr": [
      "EQ",
      "internal_control_established",
      [
        "EQ",
        "internal_control_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_handling_established",
    "desc": "建立內部處理制度及程序",
    "expr": [
      "EQ",
      "internal_handling_established",
      [
        "EQ",
        "internal_handling_system_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:capital_level",
    "desc": "資本等級分類（1=適足, 2=不足, 3=顯著不足, 4=嚴重不足）",
    "expr": [
      "EQ",
      "capital_level",
      [
        "CASE",
        [
          "OR",
          [
            "LT",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "net_worth",
            0.0
          ]
        ],
        4,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            50.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "GE",
            "net_worth_ratio",
            0.0
          ],
          [
            "LT",
            "net_worth_ratio",
            2.0
          ]
        ],
        3,
        [
          "AND",
          [
            "GE",
            "capital_adequacy_ratio",
            150.0
          ],
          [
            "LT",
            "capital_adequacy_ratio",
            200.0
          ]
        ],
        2,
        [
          "GE",
          "capital_adequacy_ratio",
          200.0
        ],
        1,
        0
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_submitted_and_approved",
    "desc": "已提交且核定財務或業務改善計畫",
    "expr": [
      "EQ",
      "improvement_plan_submitted_and_approved",
      [
        "AND",
        [
          "EQ",
          "improvement_plan_submitted",
          true
        ],
        [
          "EQ",
          "improvement_plan_approved",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:improvement_plan_completed_within_deadline",
    "desc": "於主管機關規定期限內完成增資、改善計畫或合併",
    "expr": [
      "EQ",
      "improvement_plan_completed_within_deadline",
      [
        "OR",
        [
          "EQ",
          "capital_increase_completed",
          true
        ],
        [
          "EQ",
          "financial_improvement_completed",
          true
        ],
        [
          "EQ",
          "business_improvement_completed",
          true
        ],
        [
          "EQ",
          "merger_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:severely_insufficient_and_no_improvement",
    "desc": "資本嚴重不足且未於期限完成增資或改善計畫",
    "expr": [
      "EQ",
      "severely_insufficient_and_no_improvement",
      [
        "AND",
        [
          "EQ",
          "capital_level",
          4
        ],
        [
          "NOT",
          [
            "EQ",
            "improvement_plan_completed_within_deadline",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:significantly_worsened_and_no_approved_plan",
    "desc": "財務或業務狀況顯著惡化且未提出核定改善計畫",
    "expr": [
      "EQ",
      "significantly_worsened_and_no_approved_plan",
      [
        "AND",
        [
          "EQ",
          "financial_or_business_condition_worsened",
          true
        ],
        [
          "NOT",
          [
            "EQ",
            "improvement_plan_submitted_and_approved",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:internal_control_and_handling_compliance",
    "desc": "內部控制及稽核制度與內部處理制度及程序均已建立",
    "expr": [
      "EQ",
      "internal_control_and_handling_compliance",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_handling_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:penalty_conditions",
    "desc": "處罰條件：違反不動產投資限制、未經合法鑑價、未建立內部控制或處理制度，或資本嚴重不足且未完成改善計畫時處罰",
    "expr": [
      "EQ",
      "penalty",
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "real_estate_investment_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "real_estate_valuation_compliance",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_control_established",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "internal_handling_established",
            true
          ]
        ],
        [
          "EQ",
          "severely_insufficient_and_no_improvement",
          true
        ],
        [
          "EQ",
          "significantly_worsened_and_no_approved_plan",
          true
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]