[
  {
    "id": "insurance:prohibited_share_exchange",
    "desc": "不得與被投資公司或第三人以信託、委任或其他契約約定或以協議、授權或其他方法進行股權交換或利益輸送",
    "expr": [
      "EQ",
      "prohibited_share_exchange",
      [
        "NOT",
        [
          "OR",
          [
            "EQ",
            "share_exchange_trust_agreement",
            true
          ],
          [
            "EQ",
            "share_exchange_commission_agreement",
            true
          ],
          [
            "EQ",
            "share_exchange_other_contract",
            true
          ],
          [
            "EQ",
            "share_exchange_agreement",
            true
          ],
          [
            "EQ",
            "share_exchange_authorization",
            true
          ],
          [
            "EQ",
            "share_exchange_other_method",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:protect_insured_interest",
    "desc": "不得損及要保人、被保險人或受益人之利益",
    "expr": [
      "EQ",
      "protect_insured_interest",
      [
        "EQ",
        "insured_interest_not_harmed",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholder_meeting_vote_analysis",
    "desc": "出席被投資公司股東會前，應將行使表決權之評估分析作業作成說明",
    "expr": [
      "EQ",
      "shareholder_meeting_vote_analysis",
      [
        "EQ",
        "vote_evaluation_analysis_prepared",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:shareholder_meeting_vote_record_report",
    "desc": "各該次股東會後，將行使表決權之書面紀錄提報董事會",
    "expr": [
      "EQ",
      "shareholder_meeting_vote_record_report",
      [
        "EQ",
        "vote_record_reported_to_board",
        true
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
    "id": "insurance:proxy_solicitor_prohibition",
    "desc": "不得擔任被投資公司之委託書徵求人或委託他人擔任委託書徵求人",
    "expr": [
      "EQ",
      "proxy_solicitor_prohibition",
      [
        "AND",
        [
          "NOT",
          [
            "EQ",
            "proxy_solicitor_self",
            true
          ]
        ],
        [
          "NOT",
          [
            "EQ",
            "proxy_solicitor_agent",
            true
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "insurance"
  },
  {
