[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序且確實執行",
    "expr": [
      "AND",
      [
        "EQ",
        "internal_control_established",
        true
      ],
      [
        "EQ",
        "internal_handling_system_established",
        true
      ],
      [
        "EQ",
        "outsourcing_internal_procedures_established",
        true
      ],
      [
        "EQ",
        "derivative_business_internal_procedures_established",
        true
      ],
      [
        "EQ",
        "internal_control_executed",
        true
      ],
      [
        "EQ",
        "internal_handling_system_executed",
        true
      ],
      [
        "EQ",
        "outsourcing_internal_procedures_executed",
        true
      ],
      [
        "EQ",
        "derivative_business_internal_procedures_executed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_composition_elements",
    "desc": "內部控制制度應包含控制環境、風險評估、控制作業、資訊與溝通、監督作業",
    "expr": [
      "AND",
      [
        "EQ",
        "control_environment_established",
        true
      ],
      [
        "EQ",
        "risk_assessment_established",
        true
      ],
      [
        "EQ",
        "control_activities_established",
        true
      ],
      [
        "EQ",
        "information_and_communication_established",
        true
      ],
      [
        "EQ",
        "monitoring_activities_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policies_and_procedures",
    "desc": "內部控制制度應訂定組織規程、業務規範及處理手冊等政策及程序並適時檢討修訂",
    "expr": [
      "AND",
      [
        "EQ",
        "organization_regulations_established",
        true
      ],
      [
        "EQ",
        "business_standards_and_manuals_established",
        true
      ],
      [
        "EQ",
        "policies_and_procedures_reviewed_and_updated",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_unit_duties",
    "desc": "法令遵循單位應建立法令傳達系統、確認作業規章更新、出具法令遵循意見、訂定評估程序、施以法規訓練及督導執行",
    "expr": [
      "AND",
      [
        "EQ",
        "legal_compliance_communication_system_established",
        true
      ],
      [
        "EQ",
        "operation_rules_updated_according_to_laws",
        true
      ],
      [
        "EQ",
        "legal_compliance_opinion_issued_before_new_business",
        true
      ],
      [
        "EQ",
        "legal_compliance_evaluation_procedures_established",
        true
      ],
      [
        "EQ",
        "legal_regulation_training_provided",
        true
      ],
      [
        "EQ",
        "legal_compliance_supervision_implemented",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_unit_established",
    "desc": "設置獨立專責風險控管單位並定期向董監事會報告",
    "expr": [
      "AND",
      [
        "EQ",
        "independent_risk_control_unit_established",
        true
      ],
      [
        "EQ",
        "risk_control_reports_to_board_regularly",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_principles",
    "desc": "銀行風險控管機制應監控資本適足性、流動性風險、資產配置及資訊安全",
    "expr": [
      "AND",
      [
        "EQ",
        "capital_adequacy_monitored",
        true
      ],
      [
        "EQ",
        "liquidity_risk_management_established",
        true
      ],
      [
        "EQ",
        "asset_allocation_and_risk_management_established",
        true
      ],
      [
        "EQ",
        "asset_quality_and_loss_provisioning_established",
        true
      ],
      [
        "EQ",
        "information_security_and_emergency_plan_established",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:derivative_business_staff_qualification",
    "desc": "衍生性金融商品業務人員具備專業資格條件",
    "expr": [
      "EQ",
      "derivative_business_staff_qualified",
      [
        "OR",
        [
          "GE",
          "derivative_training_months",
          3
        ],
        [
          "EQ",
          "derivative_business_license_held",
          true
        ],
        [
          "GE",
          "derivative_business_internship_years",
          1
        ],
        [
          "GE",
          "derivative_business_experience_months",
          6
        ],
        [
          "EQ",
          "structured_product_sales_qualified",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_business_permit",
    "desc": "銀行辦理外匯業務應依規定申請許可或完成備查程序",
    "expr": [
      "OR",
      [
        "EQ",
        "forex_business_permit_obtained",
        true
      ],
      [
        "EQ",
        "forex_business_filing_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_derivative_business_permit",
    "desc": "指定銀行辦理外匯衍生性商品業務應依類別申請許可或函報備查",
    "expr": [
      "OR",
      [
        "EQ",
        "forex_derivative_business_permit_obtained",
        true
      ],
      [
        "EQ",
        "forex_derivative_business_filing_completed",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:board_and_committee_internal_control_inclusion",
    "desc": "股票上市或證券商買賣之金融控股公司及銀行業應將薪資報酬委員會納入內部控制制度",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "is_listed_or_securities_traded",
        true
      ],
      [
        "EQ",
        "compensation_committee_included_in_internal_control",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:audit_committee_internal_control_inclusion",
    "desc": "設置審計委員會者，內部控制制度應包括審計委員會議事運作管理",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "audit_committee_established",
        true
      ],
      [
        "EQ",
        "audit_committee_management_included_in_internal_control",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:subsidiary_control_requirements",
    "desc": "金融控股公司及銀行業應訂定子公司控制作業並督促國外子公司建立內部控制制度",
    "expr": [
      "AND",
      [
        "EQ",
        "subsidiary_control_operations_established",
        true
      ],
      [
        "OR",
        [
          "NOT",
          [
            "EQ",
            "subsidiary_is_foreign",
            true
          ]
        ],
        [
          "EQ",
          "foreign_subsidiary_internal_control_supervised",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:group_anti_money_laundering_program",
    "desc": "應建立集團整體性防制洗錢及打擊資恐計畫及資訊分享政策程序",
    "expr": [
      "EQ",
      "group_anti_money_laundering_program_established",
      true
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:policy_revision_participation",
    "desc": "作業及管理規章訂定、修訂或廢止應有法令遵循、內部稽核及風險管理單位參與",
    "expr": [
      "EQ",
      "policy_revision_with_compliance_audit_risk_management_participation",
      true
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_unit_foreign_operations_duties",
    "desc": "法令遵循單位督導國外營業單位蒐集法規資料、執行評估及確保資源適足",
    "expr": [
      "AND",
      [
        "EQ",
        "foreign_operations_regulation_data_collected",
        true
      ],
      [
        "EQ",
        "foreign_operations_compliance_self_assessment_performed",
        true
      ],
      [
        "EQ",
        "foreign_operations_compliance_supervisor_qualified",
        true
      ],
      [
        "EQ",
        "foreign_operations_compliance_resources_adequate",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_unit_foreign_operations_risk_verification",
    "desc": "對高風險業務委請外部專家驗證法令遵循風險自行評估及監控機制有效性",
    "expr": [
      "IMPLIES",
      [
        "EQ",
        "foreign_operations_high_risk_business",
        true
      ],
      [
        "EQ",
        "external_expert_verification_of_compliance_risk_assessment",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_self_assessment_frequency",
    "desc": "法令遵循自行評估每半年至少辦理一次並送法令遵循單位備查",
    "expr": [
      "AND",
      [
        "GE",
        "legal_compliance_self_assessment_frequency_per_year",
        2
      ],
      [
        "EQ",
        "legal_compliance_self_assessment_results_reported",
        true
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_self_assessment_responsible_person",
    "desc": "各單位自行評估應由主管指定專人辦理",
    "expr": [
      "EQ",
      "self_assessment_responsible_person_assigned",
      true
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:legal_compliance_self_assessment_document_retention",
    "desc": "自行評估工作底稿及資料應至少保存五年",
    "expr": [
      "GE",
      "self_assessment_document_retention_years",
      5
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有 constraint 成立則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_and_audit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_composition_elements",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policies_and_procedures",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:legal_compliance_unit_duties",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_unit_established",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_mechanism_principles",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:derivative_business_staff_qualification",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_business_permit",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_derivative_business_permit",
              true
            ]
          ],
          [
            "NOT",
            [
              "IMPLIES",
              [
                "EQ",
                "is_listed_or_securities_traded",
                true
              ],
              [
                "EQ",
                "compensation_committee_included_in_internal_control",
                true
              ]
            ]
          ],
          [
            "NOT",
            [
              "IMPLIES",
              [
                "EQ",
                "audit_committee_established",
                true
              ],
              [
                "EQ",
                "audit_committee_management_included_in_internal_control",
                true
              ]
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:subsidiary_control_requirements",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:group_anti_money_laundering_program_established",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "policy_revision_with_compliance_audit_risk_management_participation",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:legal_compliance_unit_foreign_operations_duties",
              true
            ]
          ],
          [
            "NOT",
            [
              "IMPLIES",
              [
                "EQ",
                "foreign_operations_high_risk_business",
                true
              ],
              [
                "EQ",
                "external_expert_verification_of_compliance_risk_assessment",
                true
              ]
            ]
          ],
          [
            "NOT",
            [
              "AND",
              [
                "GE",
                "legal_compliance_self_assessment_frequency_per_year",
                2
              ],
              [
                "EQ",
                "legal_compliance_self_assessment_results_reported",
                true
              ]
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "self_assessment_responsible_person_assigned",
              true
            ]
          ],
          [
            "NOT",
            [
              "GE",
              "self_assessment_document_retention_years",
              5
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]