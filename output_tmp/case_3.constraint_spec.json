[
  {
    "id": "bank:internal_control_and_audit_mandatory",
    "desc": "銀行是否建立內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序且確實執行",
    "expr": [
      "EQ",
      "bank:internal_control_and_audit_mandatory",
      [
        "AND",
        [
          "EQ",
          "internal_control_established",
          true
        ],
        [
          "EQ",
          "internal_control_executed",
          true
        ],
        [
          "EQ",
          "internal_handling_system_established",
          true
        ],
        [
          "EQ",
          "internal_handling_system_executed",
          true
        ],
        [
          "EQ",
          "internal_operation_system_established",
          true
        ],
        [
          "EQ",
          "internal_operation_system_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_unit_mandatory",
    "desc": "銀行法令遵循單位應建立適當法令傳達、更新、評估及訓練制度",
    "expr": [
      "EQ",
      "bank:law_compliance_unit_mandatory",
      [
        "AND",
        [
          "EQ",
          "law_regulation_communication_system_established",
          true
        ],
        [
          "EQ",
          "law_regulation_updated_timely",
          true
        ],
        [
          "EQ",
          "law_compliance_evaluation_defined",
          true
        ],
        [
          "EQ",
          "law_compliance_evaluation_executed",
          true
        ],
        [
          "EQ",
          "law_compliance_training_provided",
          true
        ],
        [
          "EQ",
          "law_compliance_supervision_executed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_unit_mandatory",
    "desc": "銀行設置獨立專責風險控管單位並定期報告董監事會",
    "expr": [
      "EQ",
      "bank:risk_control_unit_mandatory",
      [
        "AND",
        [
          "EQ",
          "independent_risk_control_unit_established",
          true
        ],
        [
          "EQ",
          "risk_control_report_to_board_regularly",
          true
        ],
        [
          "IMPLIES",
          [
            "EQ",
            "major_risk_found",
            true
          ],
          [
            "AND",
            [
              "EQ",
              "risk_control_measures_taken",
              true
            ],
            [
              "EQ",
              "risk_reported_to_board_immediately",
              true
            ]
          ]
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:risk_control_mechanism_principles",
    "desc": "銀行風險控管機制應包含資本適足性監控、流動性管理、資產配置、資產品質評估及資訊安全",
    "expr": [
      "EQ",
      "bank:risk_control_mechanism_principles",
      [
        "AND",
        [
          "EQ",
          "capital_adequacy_monitoring_established",
          true
        ],
        [
          "EQ",
          "liquidity_management_mechanism_established",
          true
        ],
        [
          "EQ",
          "asset_allocation_risk_management_established",
          true
        ],
        [
          "EQ",
          "asset_quality_evaluation_and_loss_provisioning_established",
          true
        ],
        [
          "EQ",
          "information_security_and_emergency_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_composition_elements",
    "desc": "銀行內部控制制度應包含控制環境、風險評估、控制作業、資訊與溝通及監督作業",
    "expr": [
      "EQ",
      "bank:internal_control_composition_elements",
      [
        "AND",
        [
          "EQ",
          "control_environment_established",
          true
        ],
        [
          "EQ",
          "risk_assessment_established",
          true
        ],
        [
          "EQ",
          "control_activities_established",
          true
        ],
        [
          "EQ",
          "information_and_communication_established",
          true
        ],
        [
          "EQ",
          "monitoring_activities_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:internal_control_policies_and_procedures",
    "desc": "銀行內部控制制度應訂定組織規程、業務規範及處理手冊並適時檢討修訂",
    "expr": [
      "EQ",
      "bank:internal_control_policies_and_procedures",
      [
        "AND",
        [
          "EQ",
          "organization_rules_and_responsibilities_defined",
          true
        ],
        [
          "EQ",
          "business_standards_and_handbooks_defined",
          true
        ],
        [
          "EQ",
          "policies_and_procedures_reviewed_and_updated",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:subsidiary_control_and_anti_money_laundering",
    "desc": "銀行應督促子公司建立內部控制制度並建立集團整體防制洗錢及打擊資恐計畫",
    "expr": [
      "EQ",
      "bank:subsidiary_control_and_anti_money_laundering",
      [
        "AND",
        [
          "EQ",
          "subsidiary_internal_control_established",
          true
        ],
        [
          "EQ",
          "group_anti_money_laundering_plan_established",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_foreign_units",
    "desc": "銀行法令遵循單位應督導國外營業單位執行法令遵循及風險評估",
    "expr": [
      "EQ",
      "bank:law_compliance_foreign_units",
      [
        "AND",
        [
          "EQ",
          "foreign_units_financial_regulations_collected",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_evaluation_executed",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_resources_adequate",
          true
        ],
        [
          "EQ",
          "foreign_units_law_compliance_risk_monitoring_established",
          true
        ],
        [
          "EQ",
          "foreign_units_external_expert_verification_done",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:law_compliance_self_evaluation_frequency",
    "desc": "銀行各單位應每半年至少辦理一次法令遵循自行評估並保存資料",
    "expr": [
      "EQ",
      "bank:law_compliance_self_evaluation_frequency",
      [
        "AND",
        [
          "GE",
          "law_compliance_self_evaluation_frequency_per_year",
          2
        ],
        [
          "EQ",
          "law_compliance_self_evaluation_records_retained",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:foreign_exchange_business_permit",
    "desc": "銀行辦理外匯業務應依規定申請許可或完成備查程序",
    "expr": [
      "EQ",
      "bank:foreign_exchange_business_permit",
      [
        "OR",
        [
          "EQ",
          "foreign_exchange_business_permit_obtained",
          true
        ],
        [
          "EQ",
          "foreign_exchange_business_filing_completed",
          true
        ]
      ]
    ],
    "weight": 1,
    "domain": "bank"
  },
  {
    "id": "bank:penalty_violation_internal_control",
    "desc": "未依規定建立或執行內部控制及稽核制度、內部處理制度與程序、內部作業制度與程序者，應受罰",
    "expr": [
      "EQ",
      "bank:penalty_violation_internal_control",
      [
        "NOT",
        [
          "AND",
          [
            "EQ",
            "internal_control_established",
            true
          ],
          [
            "EQ",
            "internal_control_executed",
            true
          ],
          [
            "EQ",
            "internal_handling_system_established",
            true
          ],
          [
            "EQ",
            "internal_handling_system_executed",
            true
          ],
          [
            "EQ",
            "internal_operation_system_established",
            true
          ],
          [
            "EQ",
            "internal_operation_system_executed",
            true
          ]
        ]
      ]
    ],
    "weight": 2,
    "domain": "bank"
  },
  {
    "id": "meta:penalty_default_false",
    "desc": "預設不處罰",
    "expr": [
      "EQ",
      "penalty",
      false
    ],
    "weight": 0,
    "domain": "meta"
  },
  {
    "id": "meta:no_penalty_if_all_pass",
    "desc": "若所有 constraint 成立則 penalty 為 false",
    "expr": [
      "EQ",
      "penalty",
      [
        "NOT",
        [
          "OR",
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_and_audit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:law_compliance_unit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_unit_mandatory",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:risk_control_mechanism_principles",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_composition_elements",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:internal_control_policies_and_procedures",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:subsidiary_control_and_anti_money_laundering",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:law_compliance_foreign_units",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:law_compliance_self_evaluation_frequency",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:foreign_exchange_business_permit",
              true
            ]
          ],
          [
            "NOT",
            [
              "EQ",
              "bank:penalty_violation_internal_control",
              false
            ]
          ]
        ]
      ]
    ],
    "weight": 0,
    "domain": "meta"
  }
]